@page "/"

<PageTitle>JitHub | GitHub, native to Windows</PageTitle>

<HeadContent>
    <meta name="description" content="JitHub is a calmer, native GitHub client for Windows with repositories, issues, pull requests, code, rich files, commits, Stars, Gists, profiles, and live color themes." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="JitHub | GitHub, native to Windows" />
    <meta property="og:description" content="A calmer native Windows workspace for repositories, issues, pull requests, code, commits, Stars, Gists, and profiles." />
    <meta property="og:image" content="/media/showcase/home-workspace-light.png" />
    <meta property="og:image:width" content="3200" />
    <meta property="og:image:height" content="1800" />
    <meta property="og:image:alt" content="JitHub's customizable Home workspace on Windows." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="JitHub | GitHub, native to Windows" />
    <meta name="twitter:description" content="A calmer native Windows workspace for everyday GitHub work." />
    <meta name="twitter:image" content="/media/showcase/home-workspace-light.png" />
    <meta name="twitter:image:alt" content="JitHub's customizable Home workspace on Windows." />
</HeadContent>

<section class="landing-grid">
    <section class="product-hero" id="intro" aria-labelledby="hero-title">
        <ThemeImage Media="LandingPageContent.HomeWorkspace"
                    Class="product-hero__image"
                    Loading="eager"
                    FetchPriority="high" />
        <div class="product-hero__copy">
            <p class="eyebrow eyebrow--hero">GitHub, native to Windows</p>
            <h1 id="hero-title">JitHub</h1>
            <p class="product-hero__lede">
                A native Windows app for repositories, issues, pull requests, code, and the everyday work around them.
            </p>
            <div class="button-row button-row--hero">
                <a class="button button--primary" href="https://apps.microsoft.com/store/detail/jithub/9MXRBJBB552V" target="_blank" rel="noopener noreferrer">
                    Get JitHub
                </a>
                <a class="button button--hero-ghost" href="https://github.com/JitHubApp/JitHubV2" target="_blank" rel="noopener noreferrer">
                    View source
                </a>
            </div>
        </div>
        <p class="product-hero__caption">@LandingPageContent.HomeWorkspace.Caption</p>
    </section>

    <aside class="page-rail surface-card" aria-label="Landing page navigation">
        <div class="page-rail__block">
            <p class="page-rail__eyebrow">On this page</p>
            <nav class="page-rail__nav" aria-label="Page sections">
                <a href="#intro">JitHub</a>
                @foreach (ShowcaseChapter chapter in LandingPageContent.Chapters)
                {
                    <a href="#@chapter.Id">@chapter.Eyebrow</a>
                }
                <a href="#themes">Color themes</a>
                <a href="#capabilities">Everything included</a>
            </nav>
        </div>

        <div class="page-rail__block page-rail__proof">
            <p class="page-rail__eyebrow">Built for Windows</p>
            <p class="page-rail__note">
                Native AOT across x86, x64, and ARM64, with cached-first loading and accessible controls throughout.
            </p>
        </div>
    </aside>

    <div class="page-content">
        <section class="trust-strip" aria-label="JitHub engineering qualities">
            <div class="trust-strip__intro">
                <p class="eyebrow">Built for Windows</p>
                <p>Native where it counts, useful when the connection changes.</p>
            </div>
            <ul class="trust-strip__list">
                <li>Native AOT <span>x86, x64, ARM64</span></li>
                <li>Cached first <span>Offline-aware</span></li>
                <li>Accessible <span>Keyboard and High Contrast</span></li>
                <li>Private diagnostics <span>No account identifiers</span></li>
            </ul>
        </section>

        <div class="chapter-list">
            @foreach (ShowcaseChapter chapter in LandingPageContent.Chapters)
            {
                <section class="showcase-chapter @(chapter.FeaturedMedia is null ? "showcase-chapter--text" : "showcase-chapter--visual")"
                         id="@chapter.Id"
                         aria-labelledby="@($"{chapter.Id}-title")">
                    <div class="showcase-chapter__copy">
                        <p class="eyebrow">@chapter.Eyebrow</p>
                        <h2 id="@($"{chapter.Id}-title")">@chapter.Title</h2>
                        <p class="showcase-chapter__description">@chapter.Description</p>
                    </div>

                    <ul class="showcase-chapter__highlights">
                        @foreach (string highlight in chapter.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>

                    @if (chapter.FeaturedMedia is { } media)
                    {
                        <figure class="product-frame product-frame--@media.Id">
                            <ThemeImage Media="media" Class="product-frame__image" />
                            <figcaption>@media.Caption</figcaption>
                        </figure>
                    }

                </section>
            }
        </div>

        <section class="theme-library" id="themes" aria-labelledby="themes-title">
            <header class="theme-library__heading">
                <p class="eyebrow">Color themes</p>
                <h2 id="themes-title">Choose a color theme in Settings.</h2>
                <p>
                    Twenty color families are included. Each supports Light and Dark and applies immediately.
                    High Contrast, transparency, and reduced motion continue to follow Windows.
                </p>
            </header>

            <div class="theme-library__list">
                @foreach (ThemePaletteStory palette in LandingPageContent.FeaturedThemePalettes)
                {
                    <article class="theme-option">
                        <div class="theme-option__copy">
                            <h3>@palette.Name</h3>
                            <p>@palette.Description</p>
                        </div>
                        <div class="theme-option__previews">
                            <div class="theme-preview">
                                <span class="theme-preview__label">Light</span>
                                <div class="theme-swatch"
                                     role="img"
                                     aria-label="@($"{palette.Name} light color preview")"
                                     style="@PaletteStyle(palette.Light)">
                                    <span class="theme-swatch__rail" aria-hidden="true"></span>
                                    <span class="theme-swatch__surface" aria-hidden="true">
                                        <span class="theme-swatch__accent"></span>
                                        <span class="theme-swatch__ink"></span>
                                    </span>
                                </div>
                            </div>
                            <div class="theme-preview">
                                <span class="theme-preview__label">Dark</span>
                                <div class="theme-swatch"
                                     role="img"
                                     aria-label="@($"{palette.Name} dark color preview")"
                                     style="@PaletteStyle(palette.Dark)">
                                    <span class="theme-swatch__rail" aria-hidden="true"></span>
                                    <span class="theme-swatch__surface" aria-hidden="true">
                                        <span class="theme-swatch__accent"></span>
                                        <span class="theme-swatch__ink"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </article>
                }

                <ul class="theme-library__index" aria-label="More included color themes">
                    @foreach (ThemePaletteStory palette in LandingPageContent.AdditionalThemePalettes)
                    {
                        <li title="@palette.Description">
                            <span class="theme-chip" aria-hidden="true" style="@PaletteStyle(palette.Dark)">
                                <span class="theme-chip__rail"></span>
                                <span class="theme-chip__accent"></span>
                            </span>
                            <span>@palette.Name</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="capability-index" id="capabilities" aria-labelledby="capabilities-title">
            <header class="section-heading">
                <p class="eyebrow">What you can do</p>
                <h2 id="capabilities-title">The main parts of GitHub, close at hand.</h2>
                <p>
                    JitHub covers the everyday repository work as well as the account, library, and file tools around it.
                </p>
            </header>

            <div class="capability-groups">
                @foreach (CapabilityGroup group in LandingPageContent.CapabilityGroups)
                {
                    <section class="capability-group" aria-labelledby="@($"{group.Id}-title")">
                        <h3 id="@($"{group.Id}-title")">@group.Title</h3>
                        <div class="capability-group__items">
                            @foreach (CapabilityItem item in group.Items)
                            {
                                <article class="capability-item">
                                    <h4>@item.Title</h4>
                                    <p>@item.Description</p>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </section>

        <section class="closing-cta surface-card" aria-labelledby="closing-title">
            <div>
                <p class="eyebrow">For Windows</p>
                <h2 id="closing-title">Try JitHub on your desktop.</h2>
                <p>Install JitHub from the Microsoft Store, or explore the complete open source project.</p>
            </div>
            <div class="button-row">
                <a class="button button--primary" href="https://apps.microsoft.com/store/detail/jithub/9MXRBJBB552V" target="_blank" rel="noopener noreferrer">
                    Open Microsoft Store
                </a>
                <a class="button button--ghost" href="https://github.com/JitHubApp/JitHubV2" target="_blank" rel="noopener noreferrer">
                    Browse the repository
                </a>
            </div>
        </section>
    </div>
</section>

@code {
    private static string PaletteStyle(JitHub.Models.ThemePalettePreview preview) =>
        $"--theme-canvas:{preview.Canvas};--theme-rail:{preview.Rail};--theme-surface:{preview.Surface};--theme-accent:{preview.Accent};--theme-ink:{preview.Ink}";
}
