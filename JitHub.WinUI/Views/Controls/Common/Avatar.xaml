<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Common.Avatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Button
            x:Name="ProfileButton"
            AutomationProperties.AutomationId="{x:Bind ProfileAutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ProfileAccessibleName, Mode=OneWay}"
            Click="ProfileButton_Click"
            CornerRadius="{x:Bind ContainerCornerRadius, Mode=OneWay}"
            IsHitTestVisible="{x:Bind IsProfileAvailable, Mode=OneWay}"
            IsTabStop="{x:Bind IsProfileAvailable, Mode=OneWay}"
            KeyDown="ProfileButton_KeyDown"
            Style="{StaticResource AppIdentityButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ProfileToolTip, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <Grid
                    Width="{x:Bind Size, Converter={StaticResource SizeToLengthConverter}, Mode=OneWay}"
                    Height="{x:Bind Size, Converter={StaticResource SizeToLengthConverter}, Mode=OneWay}"
                    CornerRadius="50">
                    <local:CachedImage
                        SourceUrl="{x:Bind Url, Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <Border
                        x:Name="HoverRing"
                        BorderBrush="{ThemeResource AppAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="50"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </Grid>
                <TextBlock
                    Margin="10,0,0,0"
                    MaxWidth="220"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ShowLogin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
        </Button>
    </Grid>
    
</UserControl>

