<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Common.CreditPersonaleButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Button
        Background="Transparent"
        BorderThickness="0"
        Click="{x:Bind OnClick, Mode=OneWay}">
        <Border
            Padding="16"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppRadiusLarge}">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="6">
                <PersonPicture
                    ProfilePicture="{x:Bind Person.ImageSource, Mode=OneWay}"
                    Width="86"
                    Margin="0 0 0 6"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                    Text="{x:Bind Person.PersonaleName, Mode=OneWay}"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource ListItemSecondaryTextBlockStyle}"
                    Text="{x:Bind Person.Role, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </Button>
</UserControl>

