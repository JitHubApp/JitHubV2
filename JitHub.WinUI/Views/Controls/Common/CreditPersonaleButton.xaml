<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Common.CreditPersonaleButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Button
        Width="{ThemeResource AppDimension172}"
        Height="{ThemeResource AppDimension204}"
        Padding="{ThemeResource AppPadding0}"
        AutomationProperties.AutomationId="{x:Bind Person.AutomationId, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind Person.AccessibleName, Mode=OneWay}"
        Style="{StaticResource AppQuietButtonStyle}"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Background="{ThemeResource AppTransparentBrush}"
        BorderThickness="{ThemeResource AppZeroThickness}"
        Click="{x:Bind OnClick, Mode=OneWay}">
        <Border
            Width="{ThemeResource AppDimension172}"
            Height="{ThemeResource AppDimension204}"
            Padding="{ThemeResource AppPadding16}"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="{ThemeResource AppHairlineBorderThickness}"
            CornerRadius="{ThemeResource AppRadiusLarge}">
            <StackPanel
                Width="{ThemeResource AppDimension140}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{ThemeResource AppGap6}">
                <PersonPicture
                    ProfilePicture="{x:Bind Person.ImageSource, Mode=OneWay}"
                    Width="{ThemeResource AppDimension86}"
                    Margin="{ThemeResource AppMargin0_0_0_6}"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                    Text="{x:Bind Person.PersonaleName, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource ListItemSecondaryTextBlockStyle}"
                    Text="{x:Bind Person.Role, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Border>
    </Button>
</UserControl>

