<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Issue.RepoIssueListPane"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:github="using:JitHub.Models.GitHub"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels.Pages">
    <UserControl.Resources>
        <Style x:Key="RepoIssuesPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
        </Style>
        <DataTemplate x:Key="RepoIssueListItemTemplate" x:DataType="github:GitHubIssue">
            <Grid
                MinHeight="50"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind AutomationName}"
                PointerEntered="IssueListItem_PointerEntered"
                RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontFamily="{ThemeResource AppUiFontFamily}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppInkBrush}"
                    MaxLines="2"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Text="#" />
                        <TextBlock
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Text="{x:Bind Number}" />
                    </StackPanel>
                    <common:Avatar
                        Grid.Column="1"
                        AutomationInstanceId="{x:Bind AutomationId}"
                        DisplayName="{x:Bind User.Login}"
                        Login="{x:Bind User.Login}"
                        MaxWidth="150"
                        NavigationSource="issue_list_author"
                        ShowLogin="True"
                        Size="SMALL"
                        VerticalAlignment="Center"
                        Url="{x:Bind User.AvatarUrl}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                        Text="{x:Bind UpdatedAt, Converter={StaticResource TimeAgoConverter}}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        x:Uid="PagesRepoIssuePageRepoIssuesListHost"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="RepoIssuesListHost"
        AutomationProperties.Name="Issue list pane"
        Padding="10"
        Style="{StaticResource RepoIssuesPanelStyle}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Style="{StaticResource AppWorkspaceHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="PagesRepoIssuePageRepoIssuesCloseListPaneButton"
                        x:Name="CloseListPaneButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="RepoIssuesCloseListPaneButton"
                        AutomationProperties.Name="Close issue list"
                        Click="CloseListPaneButton_Click"
                        Style="{StaticResource AppToolbarButtonStyle}"
                        ToolTipService.ToolTip="Close issues"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE8FD;" />
                    </Button>
                    <toolkit:Segmented
                        x:Uid="PagesRepoIssuePageRepoIssuesStateSegmented"
                        x:Name="IssueStateSegmented"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="RepoIssuesStateSegmented"
                        AutomationProperties.Name="Issue state filter"
                        SelectedIndex="0"
                        SelectionChanged="IssueStateSegmented_SelectionChanged">
                        <toolkit:SegmentedItem x:Uid="PagesRepoIssuePageRepoIssuesStateOpen" AutomationProperties.AutomationId="RepoIssuesState_Open" AutomationProperties.Name="Show open issues" Content="Open" />
                        <toolkit:SegmentedItem x:Uid="PagesRepoIssuePageRepoIssuesStateClosed" AutomationProperties.AutomationId="RepoIssuesState_Closed" AutomationProperties.Name="Show closed issues" Content="Closed" />
                        <toolkit:SegmentedItem x:Uid="PagesRepoIssuePageRepoIssuesStateAll" AutomationProperties.AutomationId="RepoIssuesState_All" AutomationProperties.Name="Show all issues" Content="All" />
                    </toolkit:Segmented>
                    <Button
                        x:Uid="PagesRepoIssuePageRepoIssuesNewIssueButton"
                        Grid.Column="2"
                        MinWidth="58"
                        MinHeight="34"
                        Padding="12,6"
                        AutomationProperties.AutomationId="RepoIssuesNewIssueButton"
                        AutomationProperties.Name="New issue"
                        Click="NewIssueButton_Click"
                        Content="New"
                        IsEnabled="{x:Bind ViewModel.CanCreateIssue, Mode=OneWay}"
                        Style="{StaticResource AppAccentButtonStyle}"
                        ToolTipService.ToolTip="Create a new issue" />
                </Grid>
                <Grid Grid.Row="1" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="PagesRepoIssuePageRepoIssuesSearchBox"
                            x:Name="IssueSearchBox"
                            AutomationProperties.AutomationId="RepoIssuesSearchBox"
                            AutomationProperties.Name="Filter repository issues"
                            PlaceholderText="Filter issues..."
                            Style="{StaticResource AppCommandSearchTextBoxStyle}"
                            TextChanged="IssueSearchBox_TextChanged" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Uid="PagesRepoIssuePageRepoIssuesScopeComboBox"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="RepoIssuesScopeComboBox"
                            AutomationProperties.Name="Issue scope"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.ScopeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedScopeOption, Mode=TwoWay}"
                            SelectionChanged="IssueFilterComboBox_SelectionChanged"
                            Style="{StaticResource AppCompactComboBoxStyle}" />
                        <ComboBox
                            x:Uid="PagesRepoIssuePageRepoIssuesSortComboBox"
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="RepoIssuesSortComboBox"
                            AutomationProperties.Name="Sort issues by"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                            SelectionChanged="IssueFilterComboBox_SelectionChanged"
                            Style="{StaticResource AppCompactComboBoxStyle}" />
                    </Grid>
                    <ComboBox
                        x:Uid="PagesRepoIssuePageRepoIssuesDirectionComboBox"
                        Grid.Row="2"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RepoIssuesDirectionComboBox"
                        AutomationProperties.Name="Issue sort direction"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.DirectionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDirectionOption, Mode=TwoWay}"
                        SelectionChanged="IssueFilterComboBox_SelectionChanged"
                        Style="{StaticResource AppCompactComboBoxStyle}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel
                    Style="{StaticResource AppEmptyStatePanelStyle}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock x:Uid="PagesRepoIssuePageTextBlockNoIssuesMatchThisView" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="No issues match this view." />
                </StackPanel>
                <ListView
                    x:Uid="PagesRepoIssuePageRepoIssuesList"
                    x:Name="IssuesList"
                    AutomationProperties.AutomationId="RepoIssuesList"
                    AutomationProperties.Name="Repository issues"
                    Background="Transparent"
                    BorderThickness="0"
                    ContainerContentChanging="IssuesList_ContainerContentChanging"
                    IsItemClickEnabled="True"
                    ItemClick="IssuesList_ItemClick"
                    ItemContainerStyle="{StaticResource AppWorkspaceCardListRowStyle}"
                    ItemTemplate="{StaticResource RepoIssueListItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedIssue, Mode=TwoWay}"
                    SelectionMode="Single" />
            </Grid>
            <InfoBar
                x:Uid="PagesRepoIssuePageRepoIssuesScopeNotice"
                Grid.Row="2"
                AutomationProperties.AutomationId="RepoIssuesScopeNotice"
                AutomationProperties.Name="Issue result scope"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasIssueListScopeNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.IssueListScopeNotice, Mode=OneWay}"
                Severity="Warning"
                Style="{StaticResource AppStatusInfoBarStyle}" />
        </Grid>
    </Border>
</UserControl>
