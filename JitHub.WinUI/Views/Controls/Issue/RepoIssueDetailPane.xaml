<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Issue.RepoIssueDetailPane"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:github="using:JitHub.Models.GitHub"
    xmlns:labs="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels.Pages">
    <UserControl.Resources>
        <Style x:Key="RepoIssuesPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
        </Style>

        <DataTemplate x:Key="RepoIssueCommentTemplate" x:DataType="github:GitHubIssueComment">
            <Border
                Margin="0,0,0,12"
                Padding="14"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <common:Avatar
                            AutomationInstanceId="{x:Bind AvatarAutomationId}"
                            DisplayName="{x:Bind AuthorDisplayName}"
                            Login="{x:Bind AuthorProfileLogin}"
                            NavigationSource="issue_comment"
                            ShowLogin="False"
                            Size="SMALL"
                            Url="{x:Bind AuthorAvatarUrl}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource AppUiFontFamily}"
                            FontSize="{ThemeResource AppFontSize13}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppInkBrush}"
                            Text="{x:Bind AuthorDisplayName}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind CreatedAt, Converter={StaticResource TimeAgoConverter}}" />
                    </Grid>
                    <common:MarkdownViewer
                        HostKind="Comment"
                        AutomationInstanceId="{x:Bind MarkdownAutomationId}"
                        Grid.Row="1"
                        BaseUrl="https://github.com/"
                        DocumentSource="{x:Bind MarkdownSource}"
                        Text="{x:Bind Body}" />
                    <common:CommentInteractionBar
                        Grid.Row="2"
                        ActionRequested="CommentInteractionBar_ActionRequested"
                        AuthorLogin="{x:Bind User.Login}"
                        Body="{x:Bind Body}"
                        CanModerate="{x:Bind CanViewerModerate}"
                        CanReact="{x:Bind CanViewerReact}"
                        CanReply="{x:Bind CanViewerReply}"
                        HtmlUrl="{x:Bind HtmlUrl}"
                        IsMinimized="{x:Bind IsMinimized}"
                        IsPinned="{x:Bind IsPinned}"
                        NodeId="{x:Bind NodeId}"
                        TargetId="{x:Bind Id}"
                        TargetKind="IssueComment"
                        Reactions="{x:Bind Reactions}"
                        ViewerLogin="{x:Bind ViewerLogin}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        x:Uid="PagesRepoIssuePageRepoIssuesDetailHost"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="RepoIssuesDetailHost"
        AutomationProperties.Name="Issue detail pane"
        Padding="0"
        Style="{StaticResource RepoIssuesPanelStyle}">
        <Grid>
            <TextBlock
                x:Uid="PagesRepoIssuePageTextBlockSelectAnIssueToSeeDetails"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                Text="Select an issue to see details."
                Visibility="{x:Bind ViewModel.IsDetailPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <Grid Visibility="{x:Bind ViewModel.HasSelectedIssue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid x:Name="RepoIssuesDetailLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="RepoIssuesDetailHeader"
                        Padding="10,10,16,12"
                        labs:TransitionHelper.Id="IssueHeaderSurface"
                        AutomationProperties.AutomationId="RepoIssuesDetailHeader"
                        BorderBrush="{ThemeResource AppHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="PagesRepoIssuePageRepoIssuesOpenListPaneButton"
                        x:Name="RepoIssuesOpenListPaneButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Top"
                        labs:TransitionHelper.Id="IssueListButton"
                        AutomationProperties.AutomationId="RepoIssuesOpenListPaneButton"
                        AutomationProperties.Name="Open issue list"
                        Click="OpenListPaneButton_Click"
                        Style="{StaticResource AppToolbarButtonStyle}"
                        ToolTipService.ToolTip="Issues"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8FD;" />
                    </Button>
                    <StackPanel
                        x:Name="RepoIssuesDetailTitleHost"
                        Grid.Column="1"
                        Spacing="7">
                        <TextBlock
                            x:Name="RepoIssuesDetailTitleText"
                            labs:TransitionHelper.Id="IssueTitle"
                            AutomationProperties.AutomationId="RepoIssuesDetailTitle"
                            FontFamily="{ThemeResource AppDisplayFontFamily}"
                            FontSize="{ThemeResource AppFontSize25}"
                            Foreground="{ThemeResource AppInkBrush}"
                            MinHeight="64"
                            HorizontalAlignment="Stretch"
                            MaxLines="2"
                            Text="{x:Bind ViewModel.SelectedIssueTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedIssueTitle, Mode=OneWay}" />
                        <Grid x:Name="RepoIssuesDetailMetadata" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="{ThemeResource AppFontSize12}"
                                Foreground="{ThemeResource AppAccentBrush}"
                                Text="{x:Bind ViewModel.SelectedIssueNumberText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedIssueStateText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedIssueMetadataText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                    <StackPanel
                        x:Name="RepoIssuesExpandedActionHost"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        labs:TransitionHelper.Id="IssueActions"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Uid="PagesRepoIssuePageRepoIssuesEditButton"
                            MinHeight="34"
                            Padding="12,6"
                            AutomationProperties.AutomationId="RepoIssuesEditButton"
                            AutomationProperties.Name="Edit issue"
                            Click="EditIssueButton_Click"
                            Content="Edit"
                            IsEnabled="{x:Bind ViewModel.CanEditIssue, Mode=OneWay}"
                            Style="{StaticResource AppOutlineButtonStyle}"
                            ToolTipService.ToolTip="Edit issue" />
                        <Button
                            MinHeight="34"
                            Padding="12,6"
                            AutomationProperties.AutomationId="RepoIssuesToggleStateButton"
                            AutomationProperties.Name="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}"
                            Click="ToggleIssueStateButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanChangeIssueState, Mode=OneWay}"
                            Style="{StaticResource AppOutlineButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}">
                            <TextBlock
                                MaxWidth="96"
                                Text="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            x:Uid="PagesRepoIssuePageRepoIssuesOpenInspectorPaneButton"
                            x:Name="RepoIssuesOpenInspectorPaneButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="RepoIssuesOpenInspectorPaneButton"
                            AutomationProperties.Name="Open inspector"
                            Click="OpenInspectorPaneButton_Click"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="Inspector"
                            Visibility="Collapsed">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE9D2;" />
                        </Button>
                    </StackPanel>
                    <StackPanel
                        x:Name="RepoIssuesCompactActionHost"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <DropDownButton
                            x:Uid="PagesRepoIssuePageRepoIssuesCompactActionOverflowButton"
                            x:Name="RepoIssuesCompactActionOverflowButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="RepoIssuesCompactActionOverflowButton"
                            AutomationProperties.Name="More issue actions"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="More issue actions">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize15}" Glyph="&#xE712;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="PagesRepoIssuePageRepoIssuesCompactEditAction"
                                        AutomationProperties.AutomationId="RepoIssuesCompactEditAction"
                                        AutomationProperties.Name="Edit issue"
                                        Click="EditIssueButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanEditIssue, Mode=OneWay}"
                                        Text="Edit issue" />
                                    <MenuFlyoutItem
                                        x:Uid="PagesRepoIssuePageRepoIssuesCompactMetadataAction"
                                        AutomationProperties.AutomationId="RepoIssuesCompactMetadataAction"
                                        AutomationProperties.Name="Manage issue metadata"
                                        Click="MetadataButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanManageIssueMetadata, Mode=OneWay}"
                                        Text="Manage metadata" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="RepoIssuesCompactToggleStateAction"
                                        AutomationProperties.Name="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}"
                                        Click="ToggleIssueStateButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanChangeIssueState, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Uid="PagesRepoIssuePageRepoIssuesCompactOpenInspectorPaneButt"
                            x:Name="RepoIssuesCompactOpenInspectorPaneButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="RepoIssuesCompactOpenInspectorPaneButton"
                            AutomationProperties.Name="Open inspector"
                            Click="OpenInspectorPaneButton_Click"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="Inspector"
                            Visibility="Collapsed">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE9D2;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    x:Uid="ControlsIssueRepoIssueDetailPaneConversationScrollViewer"
                    x:Name="IssueConversationScrollViewer"
                    Grid.Row="1"
                    Padding="18"
                    AutomationProperties.AutomationId="RepoIssuesConversationScrollViewer"
                    AutomationProperties.Name="Issue conversation"
                    HorizontalScrollBarVisibility="Disabled"
                    SizeChanged="IssueConversationScrollViewer_SizeChanged"
                    ViewChanged="IssueConversationScrollViewer_ViewChanged"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="IssueConversationStackPanel"
                        Spacing="16">
                        <Border
                            Padding="16"
                            Background="{ThemeResource AppCanvasInsetBrush}"
                            BorderBrush="{ThemeResource AppHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource AppRadiusSmall}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <common:Avatar
                                        AutomationInstanceId="{x:Bind ViewModel.SelectedIssueAuthorAutomationId, Mode=OneWay}"
                                        Login="{x:Bind ViewModel.SelectedIssueAuthorLogin, Mode=OneWay}"
                                        NavigationSource="issue_detail_author"
                                        ShowLogin="False"
                                        Size="SMALL"
                                        Url="{x:Bind ViewModel.SelectedIssueAuthorAvatarUrl, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource AppUiFontFamily}"
                                        FontSize="{ThemeResource AppFontSize13}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AppInkBrush}"
                                        Text="{x:Bind ViewModel.SelectedIssueAuthorDisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        x:Uid="PagesRepoIssuePageTextBlockAuthor"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                        Text="Author" />
                                </Grid>
                                <common:MarkdownViewer
                                    HostKind="Conversation"
                                    AutomationInstanceId="RepoIssuesBody"
                                    Grid.Row="1"
                                    BaseUrl="https://github.com/"
                                    DocumentSource="{x:Bind ViewModel.IssueBodyMarkdownSource, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.IssueBodyText, Mode=OneWay}" />
                                <common:CommentInteractionBar
                                    x:Uid="ControlsIssueRepoIssueDetailPaneBodyInteractionBar"
                                    Grid.Row="2"
                                    AutomationProperties.AutomationId="RepoIssuesBodyInteractionBar"
                                    AutomationProperties.Name="Issue body actions"
                                    ActionRequested="CommentInteractionBar_ActionRequested"
                                    AuthorLogin="{x:Bind ViewModel.SelectedIssueAuthorLogin, Mode=OneWay}"
                                    Body="{x:Bind ViewModel.IssueBodyText, Mode=OneWay}"
                                    CanEdit="{x:Bind ViewModel.CanEditIssue, Mode=OneWay}"
                                    CanReact="{x:Bind ViewModel.CanReactToIssue, Mode=OneWay}"
                                    CanReply="{x:Bind ViewModel.IsAddCommentEnabled, Mode=OneWay}"
                                    HtmlUrl="{x:Bind ViewModel.SelectedIssueHtmlUrl, Mode=OneWay}"
                                    Reactions="{x:Bind ViewModel.SelectedIssueReactions, Mode=OneWay}"
                                    TargetId="{x:Bind ViewModel.SelectedIssueReactionTargetId, Mode=OneWay}"
                                    TargetKind="Issue"
                                    ViewerLogin="{x:Bind ViewModel.AuthenticatedLogin, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="PagesRepoIssuePageTextBlockComments"
                                FontFamily="{ThemeResource AppDisplayFontFamily}"
                                FontSize="{ThemeResource AppFontSize20}"
                                Foreground="{ThemeResource AppInkBrush}"
                                Text="Comments" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                IsActive="{x:Bind ViewModel.IsDetailLoading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            x:Uid="PagesRepoIssuePageTextBlockNoCommentsYet"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="No comments yet."
                            Visibility="{x:Bind ViewModel.IsIssueCommentsEmptyVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <ItemsControl
                            AutomationProperties.AutomationId="RepoIssuesCommentsList"
                            ItemTemplate="{StaticResource RepoIssueCommentTemplate}"
                            ItemsSource="{x:Bind ViewModel.IssueComments, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <Border
                    x:Name="IssueCommentComposerHost"
                    Grid.Row="2"
                    Padding="12,8"
                    BorderBrush="{ThemeResource AppHairlineBrush}"
                    BorderThickness="0,1,0,0">
                    <Button
                        x:Uid="ControlsIssueRepoIssueDetailPaneOpenCommentButton"
                        x:Name="RepoIssuesOpenCommentButton"
                        MinHeight="36"
                        MinWidth="112"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="RepoIssuesOpenCommentButton"
                        AutomationProperties.Name="Open issue comment editor"
                        IsEnabled="{x:Bind ViewModel.IsAddCommentEnabled, Mode=OneWay}"
                        Style="{StaticResource AppAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Foreground="{ThemeResource AppAccentForegroundBrush}" Symbol="Message" />
                            <TextBlock
                                x:Uid="ControlsIssueRepoIssueDetailPaneOpenCommentLabel"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AppAccentForegroundBrush}"
                                Text="Comment" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout
                                x:Name="IssueCommentFlyout"
                                Closed="IssueCommentFlyout_Closed"
                                Opened="IssueCommentFlyout_Opened"
                                Placement="TopEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="460" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border Width="440" Padding="16">
                                    <common:MarkdownForm
                                        x:Uid="PagesRepoIssuePageRepoIssuesCommentBox"
                                        x:Name="IssueCommentForm"
                                        AutomationProperties.AutomationId="RepoIssuesCommentBox"
                                        AutomationProperties.Name="Issue comment"
                                        AutomationInstanceId="RepoIssuesCommentBox"
                                        DocumentSource="{x:Bind ViewModel.IssueCommentMarkdownSource, Mode=OneWay}"
                                        EditorHeight="140"
                                        IsEnabled="{x:Bind ViewModel.IsAddCommentEnabled, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.IssueCommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <common:MarkdownForm.ActionContent>
                                            <Button
                                                x:Uid="PagesRepoIssuePageRepoIssuesCommentButton"
                                                MinHeight="34"
                                                MinWidth="96"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.AutomationId="RepoIssuesCommentButton"
                                                AutomationProperties.Name="Post issue comment"
                                                Click="CommentButton_Click"
                                                Content="Comment"
                                                IsEnabled="{x:Bind ViewModel.IsAddCommentEnabled, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                        </common:MarkdownForm.ActionContent>
                                    </common:MarkdownForm>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Border>
                </Grid>

                <Grid
                    x:Name="RepoIssuesShyHeaderSurface"
                    Padding="10"
                    VerticalAlignment="Top"
                    labs:TransitionHelper.Id="IssueHeaderSurface"
                    AutomationProperties.AutomationId="RepoIssuesShyHeader"
                    Background="{ThemeResource AppTransientOverlayBrush}"
                    BorderBrush="{ThemeResource AppHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Canvas.ZIndex="10"
                    ColumnSpacing="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Uid="PagesRepoIssuePageRepoIssuesOpenListPaneButton"
                        x:Name="RepoIssuesShyOpenListPaneButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        labs:TransitionHelper.Id="IssueListButton"
                        AutomationProperties.AutomationId="RepoIssuesOpenListPaneButton"
                        AutomationProperties.Name="Open issue list"
                        Click="OpenListPaneButton_Click"
                        Style="{StaticResource AppToolbarButtonStyle}"
                        ToolTipService.ToolTip="Issues"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8FD;" />
                    </Button>

                    <TextBlock
                        x:Name="RepoIssuesShyDetailTitleText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        labs:TransitionHelper.Id="IssueTitle"
                        AutomationProperties.AutomationId="RepoIssuesDetailTitle"
                        FontFamily="{ThemeResource AppDisplayFontFamily}"
                        FontSize="{ThemeResource AppFontSize18}"
                        Foreground="{ThemeResource AppInkBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.SelectedIssueTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedIssueTitle, Mode=OneWay}" />

                    <StackPanel
                        x:Name="RepoIssuesShyActionHost"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        labs:TransitionHelper.Id="IssueActions"
                        Orientation="Horizontal"
                        Spacing="8">
                        <DropDownButton
                            x:Uid="PagesRepoIssuePageRepoIssuesCompactActionOverflowButton"
                            x:Name="RepoIssuesShyActionOverflowButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="RepoIssuesCompactActionOverflowButton"
                            AutomationProperties.Name="More issue actions"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="More issue actions">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize15}" Glyph="&#xE712;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="PagesRepoIssuePageRepoIssuesCompactEditAction" AutomationProperties.AutomationId="RepoIssuesCompactEditAction" AutomationProperties.Name="Edit issue" Click="EditIssueButton_Click" IsEnabled="{x:Bind ViewModel.CanEditIssue, Mode=OneWay}" Text="Edit issue" />
                                    <MenuFlyoutItem x:Uid="PagesRepoIssuePageRepoIssuesCompactMetadataAction" AutomationProperties.AutomationId="RepoIssuesCompactMetadataAction" AutomationProperties.Name="Manage issue metadata" Click="MetadataButton_Click" IsEnabled="{x:Bind ViewModel.CanManageIssueMetadata, Mode=OneWay}" Text="Manage metadata" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem AutomationProperties.AutomationId="RepoIssuesCompactToggleStateAction" AutomationProperties.Name="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}" Click="ToggleIssueStateButton_Click" IsEnabled="{x:Bind ViewModel.CanChangeIssueState, Mode=OneWay}" Text="{x:Bind ViewModel.ToggleIssueStateButtonText, Mode=OneWay}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Uid="PagesRepoIssuePageRepoIssuesCompactOpenInspectorPaneButt"
                            x:Name="RepoIssuesShyOpenInspectorPaneButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="RepoIssuesCompactOpenInspectorPaneButton"
                            AutomationProperties.Name="Open inspector"
                            Click="OpenInspectorPaneButton_Click"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="Inspector"
                            Visibility="Collapsed">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE9D2;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
