<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Commit.CommitDiffViewer"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commonconverters="using:JitHub.WinUI.Converters.Common"
    xmlns:commit="using:JitHub.WinUI.Views.Controls.Commit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:JitHub.Services"
    d:DesignHeight="640"
    d:DesignWidth="960"
    mc:Ignorable="d">
    <UserControl.Resources>
        <commonconverters:CommitDiffLineKindToBrushConverter x:Key="CommitDiffLineKindToBrushConverter" />

        <MenuFlyout x:Key="CommitDiffLineFlyout">
            <MenuFlyoutItem
                x:Uid="ControlsCommitCommitDiffViewerBindingAutomationId" AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="Copy selected diff text"
                Click="CopyDiffRowMenuItem_Click"
                Text="Copy" />
        </MenuFlyout>

        <DataTemplate x:Key="CommitDiffFileHeaderTemplate" x:DataType="services:CommitDiffRow">
            <Border
                Margin="0,10,0,0"
                Padding="12,9"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AppSurfaceSubtleBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="FileHeaderTextBlock"
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppInkBrush}"
                                Text="{x:Bind HeaderText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="11"
                                Foreground="{ThemeResource AppInkMutedBrush}"
                                Text="{x:Bind Status, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource AppSuccessBrush}"
                            Text="{x:Bind SummaryText, Mode=OneWay}" />
                        <Button
                            x:Uid="ControlsCommitCommitDiffViewerBindingCopyFileAutomationI" Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind CopyFileAutomationId, Mode=OneWay}"
                            AutomationProperties.Name="Copy file path"
                            Click="CopyFilePathButton_Click"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            ToolTipService.ToolTip="Copy file path">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommitDiffLineTemplate" x:DataType="services:CommitDiffRow">
            <Grid
                MinHeight="24"
                HorizontalAlignment="Stretch"
                Background="{x:Bind LineKind, Converter={StaticResource CommitDiffLineKindToBrushConverter}, ConverterParameter=background, Mode=OneWay}"
                ColumnSpacing="0"
                ContextFlyout="{StaticResource CommitDiffLineFlyout}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <TextBlock
                        Padding="8,4"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="12"
                        Foreground="{x:Bind LineKind, Converter={StaticResource CommitDiffLineKindToBrushConverter}, ConverterParameter=foreground, Mode=OneWay}"
                        Text="{x:Bind GutterText, Mode=OneWay}"
                        TextAlignment="Right" />
                <TextBlock
                        x:Name="DiffLineTextBlock"
                        Grid.Column="1"
                        Padding="4,4,12,4"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="12"
                        Foreground="{x:Bind LineKind, Converter={StaticResource CommitDiffLineKindToBrushConverter}, ConverterParameter=foreground, Mode=OneWay}"
                        Text="{x:Bind Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CommitDiffHunkHeaderTemplate" x:DataType="services:CommitDiffRow">
            <Grid
                MinHeight="26"
                Padding="0"
                HorizontalAlignment="Stretch"
                Background="{x:Bind LineKind, Converter={StaticResource CommitDiffLineKindToBrushConverter}, ConverterParameter=background, Mode=OneWay}"
                ColumnSpacing="0"
                ContextFlyout="{StaticResource CommitDiffLineFlyout}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <TextBlock
                        Padding="10,5"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Text="@"
                        TextAlignment="Right" />
                <TextBlock
                        x:Name="HunkTextBlock"
                        Grid.Column="1"
                        Padding="4,5,12,5"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Text="{x:Bind Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CommitDiffUnavailableTemplate" x:DataType="services:CommitDiffRow">
            <Border
                Margin="0,2,0,0"
                Padding="12,10"
                Background="{ThemeResource AppCanvasRaisedBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <TextBlock
                    x:Name="UnavailableTextBlock"
                    FontFamily="{ThemeResource AppBodyFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource AppInkMutedBrush}"
                    Text="{x:Bind Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommitDiffSearchNoResultsTemplate" x:DataType="services:CommitDiffRow">
            <Border
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <TextBlock
                    x:Name="SearchNoResultsTextBlock"
                    HorizontalAlignment="Center"
                    FontFamily="{ThemeResource AppBodyFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource AppInkMutedBrush}"
                    Text="{x:Bind Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <commit:CommitDiffRowTemplateSelector
            x:Key="CommitDiffRowTemplateSelector"
            DiffLineTemplate="{StaticResource CommitDiffLineTemplate}"
            FileHeaderTemplate="{StaticResource CommitDiffFileHeaderTemplate}"
            HunkHeaderTemplate="{StaticResource CommitDiffHunkHeaderTemplate}"
            SearchNoResultsTemplate="{StaticResource CommitDiffSearchNoResultsTemplate}"
            UnavailableDiffTemplate="{StaticResource CommitDiffUnavailableTemplate}" />

    </UserControl.Resources>

    <Grid Background="{ThemeResource AppCanvasInsetBrush}">
        <Border
            BorderBrush="{ThemeResource AppHairlineBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppRadiusSmall}">
            <ScrollViewer
                x:Name="DiffRowsScrollViewer"
                AutomationProperties.AutomationId="CommitDiffViewerRowsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsHorizontalScrollChainingEnabled="False"
                IsVerticalScrollChainingEnabled="True"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <ItemsRepeater
                    x:Name="DiffRowsRepeater"
                    AutomationProperties.AutomationId="CommitDiffViewerRows"
                    ItemTemplate="{StaticResource CommitDiffRowTemplateSelector}"
                    ItemsSource="{x:Bind RowProjection.Rows, Mode=OneWay}"
                    VerticalCacheLength="2">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
