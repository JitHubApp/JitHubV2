<UserControl
    x:Class="JitHub.WinUI.Views.Controls.Commit.CommitFileItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Expander
        Margin="{ThemeResource AppMargin0_4_0_0}"
        AutomationProperties.AutomationId="{Binding Filename}"
        AutomationProperties.Name="{Binding HeaderText}">
        <Expander.Header>
            <StackPanel Spacing="{ThemeResource AppGap2}">
                <TextBlock
                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                    Text="{Binding HeaderText}" />
                <TextBlock
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    Text="{Binding MetadataText}" />
            </StackPanel>
        </Expander.Header>
        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsHorizontalScrollChainingEnabled="False"
            IsVerticalScrollChainingEnabled="True"
            VerticalScrollBarVisibility="Disabled"
            ZoomMode="Disabled">
            <TextBlock
                FontFamily="Consolas"
                IsTextSelectionEnabled="True"
                Text="{Binding PatchDisplayText}"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Expander>
</UserControl>


