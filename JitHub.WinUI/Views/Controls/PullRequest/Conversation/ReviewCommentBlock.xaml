<UserControl
    x:Class="JitHub.WinUI.Views.Controls.PullRequest.Conversation.ReviewCommentBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JitHub.WinUI.Views.Controls.PullRequest.Conversation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:pullrequest="using:JitHub.WinUI.Views.Controls.PullRequest"
    xmlns:controls="using:JitHub.WinUI.Views.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:userviewmodels="using:JitHub.WinUI.ViewModels.UserViewModel"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid
        CornerRadius="{ThemeResource AppRadiusSmall}">
        <StackPanel
            Spacing="{ThemeResource AppGap8}">
            <common:CommentBlock>
                <common:CommentBlock.HeaderContent>
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}"/>
                </common:CommentBlock.HeaderContent>
                <common:CommentBlock.BodyContent>
                    <pullrequest:DiffTextBlock
                                                Patch="{x:Bind ViewModel.DiffHunk, Mode=OneWay}"/>
                </common:CommentBlock.BodyContent>
            </common:CommentBlock>
            <controls:UserCommentBlock
                Size="MEDIUM"
                ViewModel="{x:Bind ViewModel.BodyViewModel, Mode=OneWay}"/>
            <muxc:ItemsRepeater
                ItemsSource="{x:Bind ViewModel.Replies, Mode=OneWay}">
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="userviewmodels:UserCommentBlockViewModel">
                        <Grid>
                            <controls:UserCommentBlock
                                Size="MEDIUM"
                                ViewModel="{x:Bind Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
                <muxc:ItemsRepeater.Layout>
                    <muxc:StackLayout
                        Spacing="{ThemeResource AppGap12}">
                    </muxc:StackLayout>
                </muxc:ItemsRepeater.Layout>
            </muxc:ItemsRepeater>
            <muxc:Expander
                x:Uid="ControlsPullRequestConversationReviewCommentBlockXBindVi" x:Name="ReplyBox"
                Padding="{ThemeResource AppPadding8_0_8_8}"
                AutomationProperties.AutomationId="{x:Bind ViewModel.ReplyExpanderAutomationId, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.ReplyExpanderAutomationName, Mode=OneWay}"
                IsExpanded="{x:Bind ViewModel.ReplyBoxExpanded, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Reply">
                <muxc:Expander.Content>
                    <common:MarkdownForm
                        x:Name="ReplyMarkdownForm"
                        AutomationInstanceId="{x:Bind ViewModel.ReplyFormAutomationId, Mode=OneWay}"
                        DocumentSource="{x:Bind ViewModel.ReplyMarkdownSource, Mode=OneWay}"
                        Text="{x:Bind ViewModel.ReplyText, Mode=TwoWay}">
                        <common:MarkdownForm.ActionContent>
                            <StackPanel
                                Style="{StaticResource ActionPanel}">
                                <Button
                                    x:Uid="ControlsPullRequestConversationReviewCommentBlockXBindVi2" AutomationProperties.AutomationId="{x:Bind ViewModel.ReplyAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="Reply to review comment"
                                    Content="Comment"
                                    Style="{StaticResource AppAccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ReplyCommand, Mode=OneWay}"/>
                            </StackPanel>
                        </common:MarkdownForm.ActionContent>
                    </common:MarkdownForm>
                </muxc:Expander.Content>
            </muxc:Expander>
            <InfoBar
                x:Uid="ControlsPullRequestConversationReviewCommentBlockReplyError"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasReplyError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ReplyErrorMessage, Mode=OneWay}"
                Severity="Error"
                Style="{StaticResource AppErrorInfoBarStyle}" />
        </StackPanel>
    </Grid>
</UserControl>



