<UserControl
    x:Class="JitHub.WinUI.Views.Controls.PullRequest.Conversation.PullRequestTimelineItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activities="using:JitHub.Models.Activities"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PullRequestTimelineInlineLinkForegroundBrush" Color="{ThemeResource AppAccentColor}" />
        <SolidColorBrush x:Key="PullRequestTimelineInlineLinkForegroundPointerOverBrush" Color="{ThemeResource AppAccentHoverColor}" />
        <SolidColorBrush x:Key="PullRequestTimelineInlineLinkForegroundPressedBrush" Color="{ThemeResource AppAccentPressedColor}" />
    </UserControl.Resources>

    <Border
        x:Name="TimelineCard"
        Padding="{ThemeResource AppPadding4_8}"
        HorizontalAlignment="Stretch"
            Background="{ThemeResource AppTransparentBrush}"
        BorderThickness="{ThemeResource AppZeroThickness}">
        <Grid
            x:Name="Root"
            ColumnSpacing="{ThemeResource AppGap12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <common:Avatar
                x:Name="ActorAvatar"
                Margin="{ThemeResource AppMargin0_2_0_0}"
                NavigationSource="pull_request_timeline"
                VerticalAlignment="Top"
                ShowLogin="False"
                Size="SMALL" />

            <StackPanel
                Grid.Column="1"
                Spacing="{ThemeResource AppGap7}">
                <Grid ColumnSpacing="{ThemeResource AppGap8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="IconBorder"
                        Width="{ThemeResource AppDimension25}"
                        Height="{ThemeResource AppDimension25}"
                        Margin="{ThemeResource AppMargin0_1_0_0}"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                        CornerRadius="{ThemeResource AppRadiusSmall}">
                        <FontIcon
                            x:Name="IconGlyph"
                            FontFamily="{StaticResource SegoeFluentIcons}"
                            FontSize="{ThemeResource AppFontSize12}" />
                    </Border>

                    <RichTextBlock
                        x:Name="SentenceRichTextBlock"
                        Grid.Column="1"
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="{ThemeResource AppFontSize15}"
                        Foreground="{ThemeResource AppInkBrush}"
                        IsTextSelectionEnabled="False"
                        LineHeight="{ThemeResource AppLineHeight24}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <TextBlock
                    x:Name="TimestampTextBlock"
                    Margin="{ThemeResource AppMargin33_Neg4_0_0}"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}" />

                <Border
                    x:Name="DetailsBorder"
                    Margin="{ThemeResource AppMargin33_0_0_0}"
                    Padding="{ThemeResource AppPadding10_0_0_0}"
                    BorderThickness="{ThemeResource AppLeftStrongBorderThickness}"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="DetailsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{ThemeResource AppGap4}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="activities:ActivityCardDetailViewModel">
                                <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                        FontSize="{ThemeResource AppFontSize11}"
                                        Foreground="{ThemeResource AppInkMutedBrush}"
                                        Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
