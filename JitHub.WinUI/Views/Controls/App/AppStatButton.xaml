<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.AppStatButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Button
        Style="{StaticResource AppStatButtonStyle}"
        Command="{Binding Command, ElementName=Root}"
        AutomationProperties.AutomationId="{Binding AutomationId, ElementName=Root}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Foreground="{Binding IconForeground, ElementName=Root}"
                FontFamily="{StaticResource SegoeFluentIcons}"
                Glyph="{Binding IconGlyph, ElementName=Root}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource ListItemTitleTextBlockStyle}"
                Text="{Binding ValueText, ElementName=Root}" />
        </Grid>
    </Button>
</UserControl>
