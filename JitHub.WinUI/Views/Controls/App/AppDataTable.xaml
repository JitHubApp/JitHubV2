<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.AppDataTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="ControlsAppAppDataTableCsvPreviewDataTable"
    x:Name="Root"
    AutomationProperties.AutomationId="CsvPreviewDataTable"
    AutomationProperties.Name="CSV table"
    IsTabStop="True"
    KeyDown="Root_KeyDown"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded"
    d:DesignHeight="480"
    d:DesignWidth="760"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AppDataTableListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource AppContentListRowStyle}">
            <Setter Property="MinHeight" Value="{ThemeResource AppDimension34}" />
            <Setter Property="Margin" Value="{ThemeResource AppMargin0}" />
            <Setter Property="Padding" Value="{ThemeResource AppPadding0}" />
            <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="AppDataTableHeaderCellStyle" TargetType="Border">
            <Setter Property="Height" Value="{ThemeResource AppDimension40}" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppRightBottomHairlineBorderThickness}" />
        </Style>

        <Style x:Key="AppDataTableHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource AppStableButtonBaseStyle}">
            <Setter Property="Height" Value="{ThemeResource AppDimension39}" />
            <Setter Property="Padding" Value="{ThemeResource AppPadding12_0_10_0}" />
            <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppZeroThickness}" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusNone}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="AppDataTableResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="{ThemeResource AppDimension8}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
        </Style>

        <Style x:Key="AppDataTableCellStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="{ThemeResource AppDimension34}" />
            <Setter Property="Padding" Value="{ThemeResource AppPadding12_6}" />
            <Setter Property="Background" Value="{ThemeResource AppRowBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppRightBottomHairlineBorderThickness}" />
        </Style>

        <Style x:Key="AppDataTableHoverCellStyle" TargetType="Border" BasedOn="{StaticResource AppDataTableCellStyle}">
            <Setter Property="Background" Value="{ThemeResource AppRowHoverBrush}" />
        </Style>

        <Style x:Key="AppDataTableSelectedCellStyle" TargetType="Border" BasedOn="{StaticResource AppDataTableCellStyle}">
            <Setter Property="Background" Value="{ThemeResource AppRowSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppHairlineBorderThickness}" />
        </Style>

        <Style x:Key="AppDataTableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppMonoFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource AppMetaFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AppDataTableHoverCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDataTableCellTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AppRowHoverForegroundBrush}" />
        </Style>

        <Style x:Key="AppDataTableSelectedCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDataTableCellTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AppRowSelectedForegroundBrush}" />
        </Style>

        <DataTemplate x:Key="AppDataTableRowTemplate" x:DataType="app:AppDataTableRowModel">
            <app:AppDataTableRowPresenter
                CellStyle="{StaticResource AppDataTableCellStyle}"
                CellTextStyle="{StaticResource AppDataTableCellTextStyle}"
                HoverCellStyle="{StaticResource AppDataTableHoverCellStyle}"
                HoverCellTextStyle="{StaticResource AppDataTableHoverCellTextStyle}"
                Model="{x:Bind Mode=OneTime}"
                SelectedCellStyle="{StaticResource AppDataTableSelectedCellStyle}"
                SelectedCellTextStyle="{StaticResource AppDataTableSelectedCellTextStyle}" />
        </DataTemplate>

    </UserControl.Resources>

    <Border
        Background="{ThemeResource AppCanvasBrush}"
        BorderBrush="{ThemeResource AppOutlineBrush}"
        BorderThickness="{ThemeResource AppHairlineBorderThickness}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="HeaderScroller"
                Grid.Row="0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ViewChanged="HeaderScroller_ViewChanged">
                <Grid x:Name="HeaderGrid" />
            </ScrollViewer>

            <ListView
                x:Uid="ControlsAppAppDataTableCsvPreviewDataTableRows" x:Name="RowsList"
                Grid.Row="1"
                AutomationProperties.AutomationId="CsvPreviewDataTableRows"
                AutomationProperties.Name="CSV rows"
                ContainerContentChanging="RowsList_ContainerContentChanging"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource AppDataTableListItemStyle}"
                ItemTemplate="{StaticResource AppDataTableRowTemplate}"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled" />

            <Grid
                x:Name="StatusOverlay"
                Grid.Row="1"
                Padding="{ThemeResource AppPadding24}"
                Background="{ThemeResource AppCanvasBrush}">
                <TextBlock
                    x:Name="StatusText"
                    MaxWidth="{ThemeResource AppDimension520}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AppInkMutedBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
