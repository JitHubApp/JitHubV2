<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.AppContributorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="ContributorRoot"
        Margin="0,0,0,10"
        Padding="12"
        Background="{ThemeResource AppSurfaceSubtleBrush}"
        BorderBrush="{ThemeResource AppHairlineBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource AppRadiusSmall}">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="64"
                Height="64"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="32">
                <Image
                    x:Name="ContributorPicture"
                    Stretch="UniformToFill" />
            </Border>
            <StackPanel
                Grid.Column="1"
                Spacing="4">
                <TextBlock
                    x:Name="ContributorNameText"
                    Style="{StaticResource ListItemTitleTextBlockStyle}" />
                <TextBlock
                    x:Name="ContributorRoleText"
                    Style="{StaticResource ListItemSecondaryTextBlockStyle}" />
                <TextBlock
                    x:Name="ContributorDescriptionText"
                    MaxWidth="620"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel
                    x:Name="LinksPanel"
                    Orientation="Horizontal" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
