<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.AppContributorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="ContributorRoot"
        Margin="{ThemeResource AppMargin0_0_0_10}"
        Padding="{ThemeResource AppPadding12}"
        Background="{ThemeResource AppSurfaceSubtleBrush}"
        BorderBrush="{ThemeResource AppHairlineBrush}"
        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
        CornerRadius="{ThemeResource AppRadiusSmall}">
        <Grid ColumnSpacing="{ThemeResource AppGap14}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{ThemeResource AppGridLength76}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="{ThemeResource AppDimension64}"
                Height="{ThemeResource AppDimension64}"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                CornerRadius="{ThemeResource AppRadiusCircle}">
                <Image
                    x:Name="ContributorPicture"
                    Stretch="UniformToFill" />
            </Border>
            <StackPanel
                Grid.Column="1"
                Spacing="{ThemeResource AppGap4}">
                <TextBlock
                    x:Name="ContributorNameText"
                    Style="{StaticResource ListItemTitleTextBlockStyle}" />
                <TextBlock
                    x:Name="ContributorRoleText"
                    Style="{StaticResource ListItemSecondaryTextBlockStyle}" />
                <TextBlock
                    x:Name="ContributorDescriptionText"
                    MaxWidth="{ThemeResource AppDimension620}"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel
                    x:Name="LinksPanel"
                    Orientation="Horizontal" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
