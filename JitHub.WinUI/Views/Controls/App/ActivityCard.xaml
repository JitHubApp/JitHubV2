<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.ActivityCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activities="using:JitHub.Models.Activities"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    MaxWidth="{ThemeResource AppDimension920}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StaticResource x:Key="ActivityInlineLinkForegroundBrush" ResourceKey="AppAccentBrush" />

        <Style
            x:Key="ActivityInlineButtonStyle"
            BasedOn="{StaticResource AppQuietButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="{ThemeResource AppDimension0}" />
            <Setter Property="MinHeight" Value="{ThemeResource AppDimension0}" />
            <Setter Property="Padding" Value="{ThemeResource AppPadding7_3}" />
            <Setter Property="Margin" Value="{ThemeResource AppMargin2_0}" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppHairlineBorderThickness}" />
            <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        Margin="{ThemeResource AppMargin0_0_0_12}"
        Padding="{ThemeResource AppPadding16}"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource AppSurfaceBrush}"
        BorderBrush="{x:Bind ViewModel.Tone, Converter={StaticResource ActivityToneToBrushConverter}, ConverterParameter=Border, Mode=OneWay}"
        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
        CornerRadius="{ThemeResource AppRadiusLarge}">
        <Grid ColumnSpacing="{ThemeResource AppGap12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <common:Avatar
                Margin="{ThemeResource AppMargin0_3_0_0}"
                AutomationInstanceId="{x:Bind ViewModel.EventId, Mode=OneWay}"
                VerticalAlignment="Top"
                Login="{x:Bind ViewModel.ActorLogin, Mode=OneWay}"
                NavigationSource="dashboard_activity_actor"
                ShowLogin="False"
                Size="SMALL"
                Url="{x:Bind ViewModel.ActorAvatarUrl, Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                Spacing="{ThemeResource AppGap10}">
                <Grid ColumnSpacing="{ThemeResource AppGap8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="{ThemeResource AppDimension26}"
                        Height="{ThemeResource AppDimension26}"
                        Margin="{ThemeResource AppMargin0_1_0_0}"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AppSurfaceSubtleBrush}"
                        BorderBrush="{x:Bind ViewModel.Tone, Converter={StaticResource ActivityToneToBrushConverter}, ConverterParameter=Border, Mode=OneWay}"
                        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                        CornerRadius="{ThemeResource AppRadiusSmall}">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIcons}"
                            FontSize="{ThemeResource AppFontSize13}"
                            Foreground="{x:Bind ViewModel.Tone, Converter={StaticResource ActivityToneToBrushConverter}, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />
                    </Border>

                    <RichTextBlock
                        x:Name="SentenceRichTextBlock"
                        Grid.Column="1"
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="{ThemeResource AppFontSize15}"
                        Foreground="{ThemeResource AppInkBrush}"
                        IsTextSelectionEnabled="False"
                        LineHeight="{ThemeResource AppLineHeight25}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <TextBlock
                    Margin="{ThemeResource AppMargin34_Neg4_0_0}"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.TimestampText, Mode=OneWay}" />

                <Border
                    Padding="{ThemeResource AppPadding12_0_0_0}"
                    BorderBrush="{x:Bind ViewModel.Tone, Converter={StaticResource ActivityToneToBrushConverter}, ConverterParameter=Border, Mode=OneWay}"
                    BorderThickness="{ThemeResource AppLeftStrongBorderThickness}"
                    Visibility="{x:Bind ViewModel.HasDetails, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Details, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{ThemeResource AppGap4}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="activities:ActivityCardDetailViewModel">
                                <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SegoeFluentIcons}"
                                        FontSize="{ThemeResource AppFontSize11}"
                                        Foreground="{ThemeResource AppInkMutedBrush}"
                                        Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
