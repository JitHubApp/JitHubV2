<UserControl
    x:Class="JitHub.WinUI.Views.Controls.App.AdaptiveWorkspace"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="WorkspaceRoot"
        AutomationProperties.AccessibilityView="Raw"
    Background="{ThemeResource AppTransparentBrush}"
        KeyDown="WorkspaceRoot_KeyDown"
        SizeChanged="WorkspaceRoot_SizeChanged">
        <Grid.Clip>
            <RectangleGeometry x:Name="WorkspaceClip" />
        </Grid.Clip>
        <Grid
            x:Name="InlineGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeadingColumn" Width="{ThemeResource AppGridLength0}" />
                <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                <ColumnDefinition x:Name="TrailingColumn" Width="{ThemeResource AppGridLength0}" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                x:Name="LeadingInlinePresenter"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
            <ContentPresenter
                x:Name="PrimaryPresenter"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
            <ContentPresenter
                x:Name="TrailingInlinePresenter"
                Grid.Column="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>

        <StackPanel
            x:Name="PaneButtonHost"
            Margin="{ThemeResource AppMargin4_10_0_0}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Vertical"
            Spacing="{ThemeResource AppGap8}">
            <Button
                x:Uid="AdaptiveWorkspaceOpenLeadingPaneButton" x:Name="OpenLeadingPaneButton"
                Width="{ThemeResource AppDimension38}"
                Height="{ThemeResource AppDimension38}"
                Padding="{ThemeResource AppPadding0}"
                AutomationProperties.AutomationId="AdaptiveWorkspaceOpenLeadingPaneButton"
                AutomationProperties.Name="Open list"
                Click="OpenLeadingPaneButton_Click"
                Style="{StaticResource AppToolbarButtonStyle}"
                ToolTipService.ToolTip="{Binding LeadingPaneLabel, ElementName=Root}">
                <FontIcon
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="{ThemeResource AppFontSize15}"
                    Glyph="&#xE8FD;" />
            </Button>
            <Button
                x:Uid="AdaptiveWorkspaceOpenTrailingPaneButton" x:Name="OpenTrailingPaneButton"
                Width="{ThemeResource AppDimension38}"
                Height="{ThemeResource AppDimension38}"
                Padding="{ThemeResource AppPadding0}"
                AutomationProperties.AutomationId="AdaptiveWorkspaceOpenTrailingPaneButton"
                AutomationProperties.Name="Open inspector"
                Click="OpenTrailingPaneButton_Click"
                Style="{StaticResource AppToolbarButtonStyle}"
                ToolTipService.ToolTip="{Binding TrailingPaneLabel, ElementName=Root}">
                <FontIcon
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="{ThemeResource AppFontSize15}"
                    Glyph="&#xE9D2;" />
            </Button>
        </StackPanel>

        <Grid
            x:Name="DrawerOverlay"
            HorizontalAlignment="Left"
            AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource AppTransparentBrush}"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Border
                x:Uid="AdaptiveWorkspaceLeftDrawer" x:Name="LeftDrawer"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="AdaptiveWorkspaceLeftDrawer"
                AutomationProperties.Name="List drawer"
                Background="{ThemeResource AppCanvasBrush}"
                BorderThickness="{ThemeResource AppZeroThickness}"
                IsTabStop="True"
                TabFocusNavigation="Cycle">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LeftDrawerTransform" X="-336" />
                </Border.RenderTransform>
                <Grid>
                    <Button
                        x:Name="LeftDrawerStartFocusSentinel"
                        Width="{ThemeResource AppDimension1}"
                        Height="{ThemeResource AppDimension1}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        GotFocus="LeftDrawerStartFocusSentinel_GotFocus"
                        IsHitTestVisible="False"
                        IsTabStop="True"
                        Opacity="{ThemeResource AppOpacityTransparent}"
                        TabIndex="-2147483648" />
                    <ContentPresenter
                        x:Name="LeadingDrawerPresenter"
                        HorizontalContentAlignment="Stretch"
                        TabFocusNavigation="Cycle"
                        VerticalContentAlignment="Stretch" />
                    <Button
                        x:Name="LeftDrawerEndFocusSentinel"
                        Width="{ThemeResource AppDimension1}"
                        Height="{ThemeResource AppDimension1}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AccessibilityView="Raw"
                        GotFocus="LeftDrawerEndFocusSentinel_GotFocus"
                        IsHitTestVisible="False"
                        IsTabStop="True"
                        Opacity="{ThemeResource AppOpacityTransparent}"
                        TabIndex="2147483647" />
                </Grid>
            </Border>
            <Border
                x:Uid="AdaptiveWorkspaceRightDrawer" x:Name="RightDrawer"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="AdaptiveWorkspaceRightDrawer"
                AutomationProperties.Name="Inspector drawer"
                Background="{ThemeResource AppCanvasBrush}"
                BorderThickness="{ThemeResource AppZeroThickness}"
                IsTabStop="True"
                TabFocusNavigation="Cycle">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RightDrawerTransform" X="260" />
                </Border.RenderTransform>
                <Grid>
                    <Button
                        x:Name="RightDrawerStartFocusSentinel"
                        Width="{ThemeResource AppDimension1}"
                        Height="{ThemeResource AppDimension1}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        GotFocus="RightDrawerStartFocusSentinel_GotFocus"
                        IsHitTestVisible="False"
                        IsTabStop="True"
                        Opacity="{ThemeResource AppOpacityTransparent}"
                        TabIndex="-2147483648" />
                    <ContentPresenter
                        x:Name="TrailingDrawerPresenter"
                        HorizontalContentAlignment="Stretch"
                        TabFocusNavigation="Cycle"
                        VerticalContentAlignment="Stretch" />
                    <Button
                        x:Name="RightDrawerEndFocusSentinel"
                        Width="{ThemeResource AppDimension1}"
                        Height="{ThemeResource AppDimension1}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AccessibilityView="Raw"
                        GotFocus="RightDrawerEndFocusSentinel_GotFocus"
                        IsHitTestVisible="False"
                        IsTabStop="True"
                        Opacity="{ThemeResource AppOpacityTransparent}"
                        TabIndex="2147483647" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
