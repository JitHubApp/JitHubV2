<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.Renderers.CodePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:codeviewer="using:JitHub.WinUI.Views.Controls.CodeViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:JitHub.Models.CodeViewer"
    x:Name="Root"
    Background="{ThemeResource AppCanvasBrush}"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <codeviewer:CodeEditorControl
            x:Name="Editor"
            FilePath="{x:Bind ViewModel.CurrentFile.Path, Mode=OneWay}"
            FindRequested="Editor_FindRequested"
            IsReadOnlyEditor="True"
            LanguageId="{x:Bind ViewModel.LanguageId, Mode=OneWay}"
            Text="{x:Bind ViewModel.Text, Mode=OneWay}" />

        <StackPanel
            Margin="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="2">
            <Button
                x:Uid="RepoCodeFindButton"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="RepoCodeFindButton"
                AutomationProperties.Name="Find in file"
                Click="FindButton_Click"
                Style="{StaticResource AppToolbarButtonStyle}"
                ToolTipService.ToolTip="Find in file (Ctrl+F)">
                <FontIcon FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE721;" />
            </Button>
            <Button
                x:Name="SymbolsButton"
                x:Uid="RepoCodeSymbolsButton"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="RepoCodeSymbolsButton"
                AutomationProperties.Name="File outline"
                Click="SymbolsButton_Click"
                Style="{StaticResource AppToolbarButtonStyle}"
                ToolTipService.ToolTip="File outline">
                <FontIcon FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8A9;" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Grid Width="300" MaxHeight="420">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Uid="RepoCodeOutlineHeading"
                                Margin="4,0,4,8"
                                Foreground="{ThemeResource AppInkBrush}"
                                FontWeight="SemiBold"
                                Text="File outline" />
                            <ListView
                                x:Name="SymbolsList"
                                x:Uid="RepoCodeSymbolsList"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="RepoCodeSymbolsList"
                                AutomationProperties.Name="File symbols"
                                ContainerContentChanging="SymbolsList_ContainerContentChanging"
                                IsItemClickEnabled="True"
                                ItemClick="SymbolsList_ItemClick"
                                UseSystemFocusVisuals="True"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CodeSymbol">
                                        <Grid
                                            Padding="8,6"
                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                Background="{ThemeResource AppTransparentBrush}"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock
                                                    Foreground="{ThemeResource AppInkBrush}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource AppInkMutedBrush}"
                                                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                    Text="{x:Bind Kind}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AppInkMutedBrush}"
                                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                                Text="{x:Bind LocationText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="NoSymbolsText"
                                x:Uid="RepoCodeOutlineEmptyState"
                                Grid.Row="1"
                                Padding="8"
                                AutomationProperties.AutomationId="RepoCodeOutlineEmptyState"
                                Foreground="{ThemeResource AppInkMutedBrush}"
                                Text="Outline is not available for this file."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Uid="RepoCodeCopyLineLinkButton"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="RepoCodeCopyLineLinkButton"
                AutomationProperties.Name="Copy link to current line"
                Click="CopyLineLinkButton_Click"
                Style="{StaticResource AppToolbarButtonStyle}"
                ToolTipService.ToolTip="Copy link to current line">
                <FontIcon FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE71B;" />
            </Button>
        </StackPanel>

        <Border
            x:Name="FindPanel"
            Margin="8,44,8,8"
            Padding="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FindTextBox"
                    x:Uid="RepoCodeFindTextBox"
                    Height="32"
                    AutomationProperties.AutomationId="RepoCodeFindTextBox"
                    AutomationProperties.Name="Find text"
                    KeyDown="FindTextBox_KeyDown"
                    PlaceholderText="Find in file"
                    Style="{StaticResource AppTextBoxStyle}"
                    TextChanged="FindTextBox_TextChanged" />
                <Button
                    x:Uid="RepoCodePreviousMatchButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="RepoCodePreviousMatchButton"
                    AutomationProperties.Name="Previous match"
                    Click="PreviousMatchButton_Click"
                    Style="{StaticResource AppToolbarButtonStyle}"
                    ToolTipService.ToolTip="Previous match">
                    <FontIcon FontSize="{ThemeResource AppFontSize13}" Glyph="&#xE70E;" />
                </Button>
                <Button
                    x:Uid="RepoCodeNextMatchButton"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="RepoCodeNextMatchButton"
                    AutomationProperties.Name="Next match"
                    Click="NextMatchButton_Click"
                    Style="{StaticResource AppToolbarButtonStyle}"
                    ToolTipService.ToolTip="Next match">
                    <FontIcon FontSize="{ThemeResource AppFontSize13}" Glyph="&#xE70D;" />
                </Button>
                <Button
                    x:Uid="RepoCodeCloseFindButton"
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="RepoCodeCloseFindButton"
                    AutomationProperties.Name="Close find"
                    Click="CloseFindButton_Click"
                    Style="{StaticResource AppToolbarButtonStyle}"
                    ToolTipService.ToolTip="Close find (Esc)">
                    <FontIcon FontSize="{ThemeResource AppFontSize12}" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <TextBlock
            x:Name="FindStatus"
            x:Uid="RepoCodeFindStatus"
            Margin="12,82,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="RepoCodeFindStatus"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource AppInkMutedBrush}"
            Style="{StaticResource SectionSecondaryTextBlockStyle}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
