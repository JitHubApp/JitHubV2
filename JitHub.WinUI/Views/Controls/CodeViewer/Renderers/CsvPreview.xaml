<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.Renderers.CsvPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:codeviewer="using:JitHub.WinUI.Views.Controls.CodeViewer"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppCanvasBrush}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border
            Grid.Row="0"
            Padding="8,6"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="0,0,0,1">
            <controls:Segmented
                x:Uid="CsvPreviewViewMode" x:Name="ViewModeSegmented"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="CsvPreviewViewMode"
                AutomationProperties.Name="CSV view mode"
                SelectionChanged="ViewModeSegmented_SelectionChanged"
                SelectionMode="Single">
                <controls:SegmentedItem x:Uid="CsvPreviewViewModeRich" AutomationProperties.AutomationId="CsvPreviewViewMode_Rich" AutomationProperties.Name="Rich CSV view" Content="Rich" />
                <controls:SegmentedItem x:Uid="CsvPreviewViewModePlain" AutomationProperties.AutomationId="CsvPreviewViewMode_Plain" AutomationProperties.Name="Plain CSV view" Content="Plain" />
            </controls:Segmented>
        </Border>

        <!--  Rich: app-owned virtualized table  -->
        <app:AppDataTable
            x:Uid="ControlsCodeViewerRenderersCsvPreviewCsvPreviewDataGrid" x:Name="DataTable"
            Grid.Row="1"
            AutomationProperties.AutomationId="CsvPreviewDataGrid"
            AutomationProperties.Name="CSV table"
            Visibility="Visible" />

        <!--  Plain: raw text editor  -->
        <codeviewer:CodeEditorControl
            x:Name="PlainEditor"
            Grid.Row="1"
            IsReadOnlyEditor="True"
            LanguageId="text"
            Visibility="Collapsed" />

    </Grid>

</UserControl>
