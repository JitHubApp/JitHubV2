<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.Renderers.UnsupportedPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppCanvasBrush}"
    d:DesignHeight="400"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{ThemeResource AppDimension480}" Padding="{ThemeResource AppPadding24}">
        <StackPanel Spacing="{ThemeResource AppGap12}">

            <FontIcon
                FontSize="{ThemeResource AppFontSize48}"
                Foreground="{ThemeResource AppInkMutedBrush}"
                Glyph="&#xE7BA;" />

            <TextBlock
                x:Uid="RepoCodeUnsupportedTitle"
                Style="{StaticResource SectionTitleTextBlockStyle}"
                Text="Preview not available"
                TextAlignment="Center" />

            <TextBlock
                x:Name="BodyText"
                Foreground="{ThemeResource AppInkMutedBrush}"
                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{ThemeResource AppGap8}">
                <TextBlock
                    x:Name="MetaText"
                    Foreground="{ThemeResource AppInkMutedBrush}"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Margin="{ThemeResource AppMargin0_8_0_0}"
                Orientation="Horizontal"
                Spacing="{ThemeResource AppGap8}">
                <Button
                    x:Name="OpenOnGitHubButton"
                    x:Uid="RepoCodeUnsupportedOpenOnGitHubButton"
                    AutomationProperties.AutomationId="RepoCodeUnsupportedOpenOnGitHubButton"
                    AutomationProperties.Name="Open file on GitHub"
                    Click="OpenOnGitHub_Click"
                    Content="Open on github.com"
                    Style="{StaticResource AppAccentButtonStyle}" />
                <Button
                    x:Name="CopyUrlButton"
                    x:Uid="RepoCodeUnsupportedCopyRawUrlButton"
                    AutomationProperties.AutomationId="RepoCodeUnsupportedCopyRawUrlButton"
                    AutomationProperties.Name="Copy raw file link"
                    Click="CopyUrl_Click"
                    Content="Copy raw URL"
                    Style="{StaticResource AppQuietButtonStyle}" />
            </StackPanel>

        </StackPanel>
    </Grid>

</UserControl>
