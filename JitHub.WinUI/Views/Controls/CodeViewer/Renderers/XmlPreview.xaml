<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.Renderers.XmlPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:codeviewer="using:JitHub.WinUI.Views.Controls.CodeViewer"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppCanvasBrush}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="{ThemeResource AppPadding8_6}"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="{ThemeResource AppBottomHairlineBorderThickness}">
            <app:AppSegmented
                x:Uid="ControlsCodeViewerRenderersXmlPreviewXmlPreviewViewMode" x:Name="ViewModeSegmented"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="XmlPreviewViewMode"
                AutomationProperties.Name="XML view mode"
                SelectionChanged="ViewModeSegmented_SelectionChanged"
                Style="{StaticResource AppContentSizedSegmentedStyle}"
                SelectionMode="Single">
                <app:AppSegmentedItem x:Uid="ControlsCodeViewerRenderersXmlPreviewXmlPreviewViewModeR" AutomationProperties.AutomationId="XmlPreviewViewMode_Rich" AutomationProperties.Name="Formatted XML view" Content="Rich" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
                <app:AppSegmentedItem x:Uid="ControlsCodeViewerRenderersXmlPreviewXmlPreviewViewModeP" AutomationProperties.AutomationId="XmlPreviewViewMode_Plain" AutomationProperties.Name="Plain XML view" Content="Plain" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
            </app:AppSegmented>
        </Border>

        <codeviewer:CodeEditorControl
            x:Name="Editor"
            Grid.Row="1"
            IsReadOnlyEditor="True"
            LanguageId="xml" />

    </Grid>

</UserControl>
