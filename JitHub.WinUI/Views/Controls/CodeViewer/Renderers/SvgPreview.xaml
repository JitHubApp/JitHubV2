<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.Renderers.SvgPreview"
    x:Uid="ControlsCodeViewerRenderersSvgPreviewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AutomationId="SvgPreviewRoot"
    AutomationProperties.Name="SVG preview"
    Background="{ThemeResource AppCanvasBrush}"
    d:DesignHeight="500"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="SvgScrollViewer"
        x:Uid="ControlsCodeViewerRenderersSvgPreviewScrollViewer"
        AutomationProperties.AutomationId="SvgPreviewScrollViewer"
        AutomationProperties.Name="Zoomable SVG canvas"
        HorizontalScrollBarVisibility="Auto"
        MaxZoomFactor="8"
        MinZoomFactor="0.1"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Enabled">
        <Grid>
            <app:AppSvgViewport
                x:Name="SvgViewport"
                x:Uid="ControlsCodeViewerRenderersSvgPreviewViewport"
                AutomationProperties.AutomationId="SvgPreviewViewport"
                AutomationProperties.Name="Rendered SVG"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed" />
            <TextBlock
                x:Uid="ControlsCodeViewerRenderersSvgPreviewErrorText" x:Name="ErrorText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AppInkMutedBrush}"
                Text="Unable to render this SVG."
                Visibility="Collapsed" />
        </Grid>
    </ScrollViewer>

</UserControl>
