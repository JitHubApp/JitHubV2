<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.FilePreviewHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:JitHub.WinUI.ViewModels.CodeViewer"
    xmlns:renderers="using:JitHub.WinUI.Views.Controls.CodeViewer.Renderers"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource AppCanvasBrush}">

    <Grid x:Name="Root">
        <Grid x:Name="LoadingState"
              Canvas.ZIndex="2"
              Visibility="Collapsed"
              Margin="12"
              HorizontalAlignment="Right"
              VerticalAlignment="Top">
            <Border
                Padding="8"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppOutlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <muxc:ProgressRing IsActive="True" Width="18" Height="18" />
            </Border>
        </Grid>

        <Border x:Name="ErrorState"
                Canvas.ZIndex="3"
                Visibility="Collapsed"
                MaxWidth="520"
                Margin="12"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppOutlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusLarge}">
            <StackPanel>
                <TextBlock x:Name="ErrorMessageText"
                           Style="{StaticResource SectionSecondaryTextBlockStyle}"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid x:Name="EmptyState"
              Visibility="Visible"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AppInkMutedBrush}" />
                <TextBlock x:Uid="RepoCodeEmptyPreview"
                           Style="{StaticResource SectionSecondaryTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="Select a file to preview" />
            </StackPanel>
        </Grid>

        <ContentPresenter
            x:Name="RendererHost"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
