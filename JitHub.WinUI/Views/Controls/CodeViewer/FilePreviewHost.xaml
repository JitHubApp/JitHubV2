<UserControl
    x:Class="JitHub.WinUI.Views.Controls.CodeViewer.FilePreviewHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:JitHub.WinUI.ViewModels.CodeViewer"
    xmlns:renderers="using:JitHub.WinUI.Views.Controls.CodeViewer.Renderers"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource AppCanvasBrush}">

    <Grid x:Name="Root">
        <Grid x:Name="LoadingState"
              Canvas.ZIndex="2"
              Visibility="Collapsed"
              Margin="{ThemeResource AppMargin12}"
              HorizontalAlignment="Right"
              VerticalAlignment="Top">
            <Border
                Padding="{ThemeResource AppPadding8}"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppOutlineBrush}"
                BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <muxc:ProgressRing IsActive="True" Width="{ThemeResource AppDimension18}" Height="{ThemeResource AppDimension18}" />
            </Border>
        </Grid>

        <Border x:Name="ErrorState"
                Canvas.ZIndex="3"
                Visibility="Collapsed"
                MaxWidth="{ThemeResource AppDimension520}"
                Margin="{ThemeResource AppMargin12}"
                Padding="{ThemeResource AppPadding12}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppOutlineBrush}"
                BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                CornerRadius="{ThemeResource AppRadiusLarge}">
            <StackPanel>
                <TextBlock x:Name="ErrorMessageText"
                           Style="{StaticResource SectionSecondaryTextBlockStyle}"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid x:Name="EmptyState"
              Visibility="Visible"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel Spacing="{ThemeResource AppGap6}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="{ThemeResource AppFontSize32}" Foreground="{ThemeResource AppInkMutedBrush}" />
                <TextBlock x:Uid="RepoCodeEmptyPreview"
                           Style="{StaticResource SectionSecondaryTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="Select a file to preview" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="CachedCodeRendererHost"
            AutomationProperties.AccessibilityView="Raw"
            Visibility="Collapsed" />

        <ContentPresenter
            x:Name="RendererHost"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
