<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appcontrols="using:JitHub.WinUI.Views.Controls.App"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:models="using:JitHub.Models">
    <DataTemplate x:Key="ForkRepo">
        <Button
            AutomationProperties.AutomationId="{Binding Id}"
            AutomationProperties.Name="{Binding FullName}"
            Margin="{ThemeResource AppMargin0_0_4_0}"
            Style="{StaticResource AppQuietButtonStyle}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
        Background="{ThemeResource AppTransparentBrush}"
            BorderThickness="{ThemeResource AppZeroThickness}"
            Command="{Binding DetailNavigationCommand}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap4}">
                    <appcontrols:AppIcon
                        VerticalAlignment="Center"
                        IconBrush="{ThemeResource AppInkMutedBrush}"
                        IconKind="Fork"
                        IconSize="16" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="ForkRepoSearchResult">
        <Button
            AutomationProperties.AutomationId="{Binding Id}"
            AutomationProperties.Name="{Binding FullName}"
            Style="{StaticResource AppQuietButtonStyle}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Command="{Binding DetailNavigationCommand, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <appcontrols:AppIcon
                    Grid.Column="0"
                    Margin="{ThemeResource AppMargin0_5_5_0}"
                    VerticalAlignment="Top"
                    IconBrush="{ThemeResource AppInkMutedBrush}"
                    IconKind="Fork"
                    IconSize="16" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding FullName, Mode=OneWay}" />
                    <TextBlock Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <appcontrols:AppIcon
                            VerticalAlignment="Center"
                            IconBrush="{ThemeResource AppWarmAccentBrush}"
                            IconKind="Star"
                            IconSize="14" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding StargazersCount, Converter={StaticResource NumberToKizedStringConverter}, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="SelectableForkRepo">
        <Border Style="{StaticResource Container}">
            <CheckBox
                AutomationProperties.AutomationId="{Binding Id}"
                AutomationProperties.Name="{Binding FullName}"
                IsChecked="{Binding Selected, Mode=TwoWay}">
                <Grid Margin="{ThemeResource AppMargin16_0_0_0}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <appcontrols:AppIcon
                        Grid.Column="0"
                        Margin="{ThemeResource AppMargin0_5_5_0}"
                        VerticalAlignment="Top"
                        IconBrush="{ThemeResource AppInkMutedBrush}"
                        IconKind="Fork"
                        IconSize="16" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FullName, Mode=OneWay}" />
                        <TextBlock Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap4}">
                            <appcontrols:AppIcon
                                VerticalAlignment="Center"
                                IconBrush="{ThemeResource AppWarmAccentBrush}"
                                IconKind="Star"
                                IconSize="14" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding StargazersCount, Converter={StaticResource NumberToKizedStringConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </CheckBox>
        </Border>
    </DataTemplate>
</ResourceDictionary>




