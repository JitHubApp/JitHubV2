<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appcontrols="using:JitHub.WinUI.Views.Controls.App">
    <DataTemplate x:Key="RepoListItem">
        <Button
            AutomationProperties.AutomationId="{Binding Id}"
            AutomationProperties.Name="{Binding FullName}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
        Background="{ThemeResource AppTransparentBrush}"
            BorderThickness="{ThemeResource AppZeroThickness}"
            Command="{Binding DetailNavigationCommand}"
            Style="{StaticResource AppQuietButtonStyle}">
            <Grid
                Margin="{ThemeResource AppMargin10_0}"
                Padding="{ThemeResource AppPadding10}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{StaticResource BorderGray}"
                BorderThickness="{ThemeResource AppBottomHairlineBorderThickness}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource TitleStyle}"
                        Text="{Binding Name}" />
                    <Grid
                        Grid.Column="1"
                        Padding="{ThemeResource AppPadding5_2}"
                        HorizontalAlignment="Right"
                        BorderBrush="{StaticResource BorderGray}"
                        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                        CornerRadius="{ThemeResource AppRadiusSmall}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <appcontrols:AppIcon
                            Grid.Column="0"
                            Margin="{ThemeResource AppMargin0_0_5_0}"
                            VerticalAlignment="Center"
                            IconBrush="{ThemeResource AppWarmAccentBrush}"
                            IconKind="Star"
                            IconSize="12" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource AppFontSize14}"
                            Text="{Binding StargazersCount}" />
                    </Grid>

                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource AppInkSubtleBrush}"
                    Text="{Binding Description}" />
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="{ThemeResource AppMargin0_0_15_0}"
                        Text="{Binding Language}"
                        Visibility="{Binding Language, Converter={StaticResource LanguageToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource TimeAgoConverter}, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>



