<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:issue="using:JitHub.WinUI.Views.Controls.Issue"
    xmlns:images="using:JitHub.WinUI.Views.Controls.Images">
    <DataTemplate x:Key="LabeledEventTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{ThemeResource AppGridLength48}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <images:Avatar
                AutomationInstanceId="{Binding ActorAutomationId, Mode=OneWay}"
                NavigationSource="legacy_issue_timeline_actor"
                Grid.Column="0"
                HorizontalAlignment="Center"
                Login="{Binding Actor.Login, Mode=OneWay}"
                Url="{Binding Actor.AvatarUrl, Mode=OneWay}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{ThemeResource AppGap4}">
                <TextBlock VerticalAlignment="Center" Text="{Binding Actor.Login, Mode=OneWay}" />
                <TextBlock x:Uid="DataTemplatesIssueEventLabeledEventTextBlockAddedALabel" VerticalAlignment="Center" Text="added a label" />
                <issue:RepoLabel VerticalAlignment="Center" Label="{Binding Label, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}, ConverterParameter='', Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>



