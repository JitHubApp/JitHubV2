                                        Text="{Binding PullRequestDiffSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                        Text="{Binding PullRequestDiffSearchMatchCountText}" />
                                    <Button
                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsPreviousDiffMatc" Grid.Column="3"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        AutomationProperties.AutomationId="RepoPullRequestsPreviousDiffMatch"
                                        AutomationProperties.Name="Previous diff match"
                                        Click="PreviousDiffMatchButton_Click"
                                        IsEnabled="{Binding HasPullRequestDiffSearchMatches}"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Previous match">
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="13" Glyph="&#xE70E;" />
                                    </Button>
                                    <Button
                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsNextDiffMatch" Grid.Column="4"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        AutomationProperties.AutomationId="RepoPullRequestsNextDiffMatch"
                                        AutomationProperties.Name="Next diff match"
                                        Click="NextDiffMatchButton_Click"
                                        IsEnabled="{Binding HasPullRequestDiffSearchMatches}"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Next match">
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="13" Glyph="&#xE70D;" />
                                    </Button>
                                </Grid>
                                <commit:CommitDiffViewer
                                    Grid.Row="1"
                                    AutomationProperties.AutomationId="RepoPullRequestsDiffViewer"
                                    RowProjection="{Binding PullRequestDiffRowProjection}"
                                    SelectedSearchMatchIndex="{Binding SelectedPullRequestDiffSearchMatchIndex}" />
                            </Grid>

                            <Border
                                x:Name="PullRequestCommentFormHost"
                                Grid.Row="2"
                                Padding="12,8"
                                BorderBrush="{ThemeResource AppHairlineBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding IsConversationSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button
                                    x:Uid="RepoPullRequestsOpenCommentButton"
                                    x:Name="RepoPullRequestsOpenCompactCommentButton"
                                    MinHeight="36"
                                    MinWidth="112"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="RepoPullRequestsOpenCompactCommentButton"
                                    AutomationProperties.Name="Open pull request comment editor"
                                    IsEnabled="{Binding IsPullRequestCommentEnabled}"
                                    Style="{StaticResource AppAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Foreground="{ThemeResource AppAccentForegroundBrush}" Symbol="Message" />
                                        <TextBlock
                                            x:Uid="RepoPullRequestsOpenCommentLabel"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppAccentForegroundBrush}"
                                            Text="Comment" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="PullRequestCommentFlyout"
                                            Closed="CompactCommentFlyout_Closed"
                                            Opened="CompactCommentFlyout_Opened"
                                            Placement="TopEdgeAlignedRight">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MaxWidth" Value="460" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <Border Width="440" Padding="16">
                                                <common:MarkdownForm
                                                    x:Name="PullRequestCompactCommentForm"
                                                    AutomationProperties.AutomationId="RepoPullRequestsCompactCommentBox"
                                                    AutomationInstanceId="RepoPullRequestsCompactCommentBox"
                                                    DocumentSource="{Binding PullRequestCommentMarkdownSource}"
                                                    EditorHeight="140"
                                                    Text="{Binding PullRequestCommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <common:MarkdownForm.ActionContent>
                                                        <Button
                                                            x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactCommentBu" MinHeight="34"
                                                            MinWidth="96"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.AutomationId="RepoPullRequestsCompactCommentButton"
                                                            AutomationProperties.Name="Post pull request comment"
                                                            Click="CommentButton_Click"
                                                            Content="Comment"
                                                            IsEnabled="{Binding IsPullRequestCommentEnabled}"
                                                            Style="{StaticResource AppAccentButtonStyle}" />
                                                    </common:MarkdownForm.ActionContent>
                                                </common:MarkdownForm>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Border>
                            </Grid>

                            <Grid
                                x:Name="PullRequestShyHeaderSurface"
                                Padding="8,6,10,6"
                                VerticalAlignment="Top"
                                labs:TransitionHelper.Id="PullRequestHeaderSurface"
                                AutomationProperties.AutomationId="RepoPullRequestsShyHeader"
                                Background="{ThemeResource AppTransientOverlayBrush}"
                                BorderBrush="{ThemeResource AppHairlineBrush}"
                                BorderThickness="0,0,0,1"
                                Canvas.ZIndex="10"
                                ColumnSpacing="10"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsOpenListPaneButt"
                                    x:Name="RepoPullRequestsShyOpenListPaneButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    labs:TransitionHelper.Id="PullRequestListButton"
                                    AutomationProperties.AutomationId="RepoPullRequestsOpenListPaneButton"
                                    AutomationProperties.Name="Open pull request list"
                                    Click="OpenListPaneButton_Click"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Pull requests"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE8FD;" />
                                </Button>

                                <TextBlock
                                    x:Name="PullRequestShyDetailTitle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    labs:TransitionHelper.Id="PullRequestTitle"
                                    AutomationProperties.AutomationId="RepoPullRequestsDetailTitle"
                                    FontFamily="{ThemeResource AppDisplayFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    MaxLines="1"
                                    Text="{Binding SelectedPullRequestTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{Binding SelectedPullRequestTitle}" />

                                <StackPanel
                                    x:Name="RepoPullRequestsShyHeaderActions"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    labs:TransitionHelper.Id="PullRequestActions"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ComboBox
                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionSegmented"
                                        x:Name="PullRequestShySectionComboBox"
                                        Width="164"
                                        labs:TransitionHelper.Id="PullRequestSectionSelector"
                                        AutomationProperties.AutomationId="RepoPullRequestsShySectionComboBox"
                                        AutomationProperties.Name="Pull request section"
                                        SelectedIndex="0"
                                        SelectionChanged="PullRequestShySectionComboBox_SelectionChanged"
                                        Style="{StaticResource AppCompactComboBoxStyle}">
                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionConversat" AutomationProperties.AutomationId="RepoPullRequestsShySection_Conversation" AutomationProperties.Name="Show pull request conversation" Content="Conversation" />
                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionFiles" AutomationProperties.AutomationId="RepoPullRequestsShySection_Files" AutomationProperties.Name="Show changed files" Content="Files" />
                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionCommits" AutomationProperties.AutomationId="RepoPullRequestsShySection_Commits" AutomationProperties.Name="Show pull request commits" Content="Commits" />
                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionReviews" AutomationProperties.AutomationId="RepoPullRequestsShySection_Reviews" AutomationProperties.Name="Show pull request reviews" Content="Reviews" />
                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionTimeline" AutomationProperties.AutomationId="RepoPullRequestsShySection_Timeline" AutomationProperties.Name="Show pull request timeline" Content="Timeline" />
                                    </ComboBox>
                                    <DropDownButton
                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactActionsBu"
                                        x:Name="RepoPullRequestsShyActionsButton"
                                        MinHeight="34"
                                        MinWidth="74"
                                        Padding="10,6"
                                        AutomationProperties.AutomationId="RepoPullRequestsCompactActionsButton"
                                        AutomationProperties.Name="More pull request actions"
                                        Content="More"
                                        IsEnabled="{Binding ArePullRequestActionsEnabled}"
                                        Style="{StaticResource AppOutlineButtonStyle}"
                                        ToolTipService.ToolTip="Pull request actions">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem AutomationProperties.AutomationId="RepoPullRequestsCompactToggleStateAction" AutomationProperties.Name="{Binding TogglePullRequestStateButtonText}" Click="TogglePullRequestStateButton_Click" IsEnabled="{Binding IsTogglePullRequestStateEnabled}" Text="{Binding TogglePullRequestStateButtonText}" />
                                                <MenuFlyoutItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactSubmitRev" AutomationProperties.AutomationId="RepoPullRequestsCompactSubmitReviewAction" AutomationProperties.Name="Submit pull request review" Click="SubmitReviewButton_Click" IsEnabled="{Binding CanSubmitPullRequestReview}" Text="Submit review" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactMergeComm" AutomationProperties.AutomationId="RepoPullRequestsCompactMergeCommitAction" AutomationProperties.Name="Create merge commit" Click="MergeCommitMenuItem_Click" IsEnabled="{Binding CanMergeWithMergeCommit}" Text="Create merge commit" />
                                                <MenuFlyoutItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactSquashMer" AutomationProperties.AutomationId="RepoPullRequestsCompactSquashMergeAction" AutomationProperties.Name="Squash and merge" Click="SquashMergeMenuItem_Click" IsEnabled="{Binding CanMergeWithSquash}" Text="Squash and merge" />
                                                <MenuFlyoutItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsCompactRebaseMer" AutomationProperties.AutomationId="RepoPullRequestsCompactRebaseMergeAction" AutomationProperties.Name="Rebase and merge" Click="RebaseMergeMenuItem_Click" IsEnabled="{Binding CanMergeWithRebase}" Text="Rebase and merge" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button
                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsOpenInspectorPan"
                                        x:Name="RepoPullRequestsShyOpenInspectorPaneButton"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        AutomationProperties.AutomationId="RepoPullRequestsOpenInspectorPaneButton"
                                        AutomationProperties.Name="Open inspector"
                                        Click="OpenInspectorPaneButton_Click"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Inspector"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE9D2;" />
                                    </Button>
                                </StackPanel>

                                <ComboBox
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionSegmented"
                                    x:Name="PullRequestSectionComboBox"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="RepoPullRequestsSectionComboBox"
                                    AutomationProperties.Name="Pull request section"
                                    SelectedIndex="0"
                                    SelectionChanged="PullRequestSectionComboBox_SelectionChanged"
                                    Style="{StaticResource AppCompactComboBoxStyle}"
                                    Visibility="Collapsed">
                                    <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionConversat" AutomationProperties.AutomationId="RepoPullRequestsCompactSection_Conversation" AutomationProperties.Name="Show pull request conversation" Content="Conversation" />
                                    <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionFiles" AutomationProperties.AutomationId="RepoPullRequestsCompactSection_Files" AutomationProperties.Name="Show changed files" Content="Files" />
                                    <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionCommits" AutomationProperties.AutomationId="RepoPullRequestsCompactSection_Commits" AutomationProperties.Name="Show pull request commits" Content="Commits" />
                                    <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionReviews" AutomationProperties.AutomationId="RepoPullRequestsCompactSection_Reviews" AutomationProperties.Name="Show pull request reviews" Content="Reviews" />
                                    <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSectionTimeline" AutomationProperties.AutomationId="RepoPullRequestsCompactSection_Timeline" AutomationProperties.Name="Show pull request timeline" Content="Timeline" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </app:AdaptiveWorkspace.PrimaryPane>

            <app:AdaptiveWorkspace.TrailingPane>
                <Border
                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsInspector" x:Name="PullRequestInspectorHost"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="RepoPullRequestsInspector"
                    AutomationProperties.Name="Pull request inspector"
                    Padding="16,6,10,16"
                    Style="{StaticResource RepoPullRequestsPanelStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockInspector" VerticalAlignment="Center"
                                    FontFamily="{ThemeResource AppDisplayFontFamily}"
                                    FontSize="21"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Inspector" />
                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsCloseInspectorPa" x:Name="RepoPullRequestsCloseInspectorPaneButton"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.AutomationId="RepoPullRequestsCloseInspectorPaneButton"
                                    AutomationProperties.Name="Close inspector"
                                    Click="CloseWorkspaceDrawerButton_Click"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Close inspector"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE9D2;" />
                                </Button>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockStatus" FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Status" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource AppAccentBrush}" />
                                    <TextBlock
                                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                        Text="{Binding SelectedPullRequestStateText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{Binding MergeStatusText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{Binding BranchSummaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockReviewers" FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Reviewers" />
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockNoReviewersRequested" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                    Text="No reviewers requested"
                                    Visibility="{Binding HasNoRequestedReviewers, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource RepoPullRequestReviewerActorTemplate}"
                                    ItemsSource="{Binding RequestedReviewers}"
                                    Visibility="{Binding HasRequestedReviewers, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockAssignees" FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Assignees" />
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockNoOneAssigned" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                    Text="No one assigned"
                                    Visibility="{Binding HasNoAssignees, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource RepoPullRequestAssigneeActorTemplate}"
                                    ItemsSource="{Binding SelectedAssignees}"
                                    Visibility="{Binding HasAssignees, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockLabels" FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Labels" />
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockNoLabels" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                    Text="No labels"
                                    Visibility="{Binding HasNoLabels, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource RepoPullRequestLabelTemplate}"
                                    ItemsSource="{Binding SelectedLabels}"
                                    Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="PagesRepoPullRequestPageTextBlockMilestone" FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Milestone" />
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{Binding MilestoneTitle}" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsEditButton" MinHeight="34"
                                    Padding="12,6"
                                    AutomationProperties.AutomationId="RepoPullRequestsEditButton"
                                    AutomationProperties.Name="Edit pull request"
                                    Click="EditPullRequestButton_Click"
                                    Content="Edit"
                                    IsEnabled="{Binding CanEditPullRequest}"
                                    Style="{StaticResource AppOutlineButtonStyle}" />
                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsMetadataButton" MinHeight="34"
                                    Padding="12,6"
                                    AutomationProperties.AutomationId="RepoPullRequestsMetadataButton"
                                    AutomationProperties.Name="Edit pull request metadata"
                                    Click="MetadataButton_Click"
                                    Content="Metadata"
                                    IsEnabled="{Binding CanManagePullRequestMetadata}"
                                    Style="{StaticResource AppOutlineButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </app:AdaptiveWorkspace.TrailingPane>
        </app:AdaptiveWorkspace>
    </Grid>
</Page>

