<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JitHub.WinUI.Views.Pages.RepoPullRequestPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:commit="using:JitHub.WinUI.Views.Controls.Commit"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:github="using:JitHub.Models.GitHub"
    xmlns:labs="using:CommunityToolkit.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels.Pages"
    Background="{ThemeResource AppTransparentBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="RepoPullRequestsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
        </Style>

        <ItemsPanelTemplate x:Key="RepoPullRequestVirtualizingItemsPanel">
            <ItemsStackPanel CacheLength="8" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="RepoPullRequestListItemTemplate" x:DataType="github:GitHubPullRequest">
            <Grid
                MinHeight="52"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="{ThemeResource AppTransparentBrush}"
                RowSpacing="5"
                PointerEntered="PullRequestListItem_PointerEntered"
                PointerPressed="PullRequestListItem_PointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontFamily="{ThemeResource AppUiFontFamily}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppInkBrush}"
                    MaxLines="2"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Text="{x:Bind Number, Mode=OneWay}" />
                    <common:Avatar
                        Grid.Column="1"
                        AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                        ContainerCornerRadius="{ThemeResource AppRadiusSmall}"
                        DisplayName="{x:Bind User.Login, Mode=OneWay}"
                        Login="{x:Bind User.Login, Mode=OneWay}"
                        MaxWidth="240"
                        NavigationSource="pull_request_list_author"
                        ShowLogin="True"
                        Size="SMALL"
                        VerticalAlignment="Center"
                        Url="{x:Bind User.AvatarUrl, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource AppInkMutedBrush}"
                        Text="{x:Bind Head.GitRef, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                        Text="{x:Bind UpdatedAt, Converter={StaticResource TimeAgoConverter}, Mode=OneWay}"
                        TextAlignment="Right" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestCommentTemplate" x:DataType="github:GitHubIssueComment">
            <Border
                Margin="0,0,0,12"
                Padding="14"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <common:Avatar
                            AutomationInstanceId="{x:Bind AvatarAutomationId, Mode=OneWay}"
                            DisplayName="{x:Bind AuthorDisplayName, Mode=OneWay}"
                            Login="{x:Bind AuthorProfileLogin, Mode=OneWay}"
                            NavigationSource="pull_request_comment"
                            ShowLogin="False"
                            Size="SMALL"
                            Url="{x:Bind AuthorAvatarUrl, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource AppUiFontFamily}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppInkBrush}"
                            Text="{x:Bind AuthorDisplayName, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind CreatedAt, Converter={StaticResource TimeAgoConverter}, Mode=OneWay}" />
                    </Grid>
                    <common:MarkdownViewer
                        HostKind="Comment"
                        AutomationInstanceId="{x:Bind MarkdownAutomationId, Mode=OneWay}"
                        Grid.Row="1"
                        BaseUrl="https://github.com/"
                        DocumentSource="{x:Bind MarkdownSource, Mode=OneWay}"
                        Text="{x:Bind Body, Mode=OneWay}" />
                    <common:CommentInteractionBar
                        Grid.Row="2"
                        ActionRequested="CommentInteractionBar_ActionRequested"
                        AuthorLogin="{x:Bind User.Login, Mode=OneWay}"
                        Body="{x:Bind Body, Mode=OneWay}"
                        CanModerate="{x:Bind CanViewerModerate, Mode=OneWay}"
                        CanReact="{x:Bind CanViewerReact, Mode=OneWay}"
                        CanReply="{x:Bind CanViewerReply, Mode=OneWay}"
                        HtmlUrl="{x:Bind HtmlUrl, Mode=OneWay}"
                        IsMinimized="{x:Bind IsMinimized, Mode=OneWay}"
                        IsPinned="{x:Bind IsPinned, Mode=OneWay}"
                        NodeId="{x:Bind NodeId, Mode=OneWay}"
                        TargetId="{x:Bind Id, Mode=OneWay}"
                        TargetKind="PullRequestComment"
                        Reactions="{x:Bind Reactions, Mode=OneWay}"
                        ViewerLogin="{x:Bind ViewerLogin, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestCommitTemplate" x:DataType="github:GitHubCommit">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <common:Avatar
                        AutomationInstanceId="{x:Bind ShortSha, Mode=OneWay}"
                        DisplayName="{x:Bind AuthorDisplayName, Mode=OneWay}"
                        Login="{x:Bind AuthorProfileLogin, Mode=OneWay}"
                        NavigationSource="pull_request_commit_author"
                        ShowLogin="False"
                        Size="SMALL"
                        Url="{x:Bind AuthorAvatarUrl, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontFamily="{ThemeResource AppUiFontFamily}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppInkBrush}"
                            MaxLines="2"
                            Text="{x:Bind SummaryMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{x:Bind AuthorDisplayName, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Text="{x:Bind ShortSha, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestTimelineTemplate" x:DataType="github:GitHubIssueEvent">
            <Grid
                Margin="0,0,0,12"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                    <common:Avatar
                        AutomationInstanceId="{x:Bind ActorAutomationId, Mode=OneWay}"
                        DisplayName="{x:Bind ActorDisplayName, Mode=OneWay}"
                        Login="{x:Bind ActorProfileLogin, Mode=OneWay}"
                        NavigationSource="pull_request_timeline_actor"
                        ShowLogin="False"
                        Size="SMALL"
                        Url="{x:Bind ActorAvatarUrl, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="13"
                        Foreground="{ThemeResource AppInkBrush}"
                        Text="{x:Bind Summary, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{x:Bind MetaText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate
            x:Key="RepoPullRequestReviewTemplate"
            x:DataType="viewmodels:IPullRequestReviewItem">
            <Border
                Margin="0,0,0,12"
                Padding="14"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <common:Avatar
                                AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                                DisplayName="{x:Bind ReviewerLogin, Mode=OneWay}"
                                Login="{x:Bind ReviewerProfileLogin, Mode=OneWay}"
                                NavigationSource="pull_request_reviewer"
                                ShowLogin="False"
                                Size="SMALL"
                                Url="{x:Bind ReviewerAvatarUrl, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource AppUiFontFamily}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppInkBrush}"
                                Text="{x:Bind ReviewerLogin, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                Text="{x:Bind StateText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind SubmittedAtText, Mode=OneWay}" />
                    </Grid>
                    <common:MarkdownViewer
                        HostKind="Comment"
                        AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                        BaseUrl="https://github.com/"
                        DocumentSource="{x:Bind MarkdownSource, Mode=OneWay}"
                        Text="{x:Bind BodyText, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Threads, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:IPullRequestReviewThreadItem">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource AppHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource AppRadiusSmall}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                                FontSize="11"
                                                Foreground="{ThemeResource AppAccentBrush}"
                                                Text="{x:Bind PathDisplayText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                Text="{x:Bind CreatedAtText, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock
                                            FontFamily="{ThemeResource AppMonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{ThemeResource AppInkMutedBrush}"
                                            MaxLines="4"
                                            Text="{x:Bind DiffHunkText, Mode=OneWay}"
                                            TextWrapping="NoWrap" />
                                        <common:MarkdownViewer
                                            HostKind="Comment"
                                            AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                                            BaseUrl="https://github.com/"
                                            DocumentSource="{x:Bind MarkdownSource, Mode=OneWay}"
                                            Text="{x:Bind CommentBody, Mode=OneWay}" />
                                        <common:CommentInteractionBar
                                            ActionRequested="CommentInteractionBar_ActionRequested"
                                            AuthorLogin="{x:Bind CommentAuthorLogin, Mode=OneWay}"
                                            Body="{x:Bind CommentBody, Mode=OneWay}"
                                            CanModerate="{x:Bind CanModerate, Mode=OneWay}"
                                            CanReact="{x:Bind CanReact, Mode=OneWay}"
                                            CanReply="{x:Bind CanReply, Mode=OneWay}"
                                            HtmlUrl="{x:Bind CommentHtmlUrl, Mode=OneWay}"
                                            IsMinimized="{x:Bind IsMinimized, Mode=OneWay}"
                                            NodeId="{x:Bind CommentNodeId, Mode=OneWay}"
                                            Reactions="{x:Bind Reactions, Mode=OneWay}"
                                            TargetId="{x:Bind CommentId, Mode=OneWay}"
                                            TargetKind="PullRequestReviewComment"
                                            ViewerLogin="{x:Bind ViewerLogin, Mode=OneWay}" />
                                        <ItemsControl ItemsSource="{x:Bind Replies, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="18,2,0,2"
                                                        Padding="12,8,0,8"
                                                        BorderBrush="{ThemeResource AppHairlineBrush}"
                                                        BorderThickness="1,0,0,0">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource AppInkBrush}"
                                                                    Text="{Binding UserLogin}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                                    Text="{Binding CreatedAtText}" />
                                                            </Grid>
                                                            <common:MarkdownViewer
                                                                HostKind="Comment"
                                                                AutomationInstanceId="{Binding AutomationId}"
                                                                BaseUrl="https://github.com/"
                                                                DocumentSource="{Binding MarkdownSource}"
                                                                Text="{Binding Body}" />
                                                            <common:CommentInteractionBar
                                                                ActionRequested="CommentInteractionBar_ActionRequested"
                                                                AuthorLogin="{Binding AuthorLogin}"
                                                                Body="{Binding Body}"
                                                                CanModerate="{Binding CanModerate}"
                                                                CanReact="{Binding CanReact}"
                                                                CanReply="{Binding CanReply}"
                                                                HtmlUrl="{Binding HtmlUrl}"
                                                                IsMinimized="{Binding IsMinimized}"
                                                                NodeId="{Binding NodeId}"
                                                                Reactions="{Binding Reactions}"
                                                                TargetId="{Binding Id}"
                                                                TargetKind="PullRequestReviewComment"
                                                                ViewerLogin="{Binding ViewerLogin}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <common:MarkdownForm
                                            AutomationInstanceId="{x:Bind ReplyFormAutomationId, Mode=OneWay}"
                                            DocumentSource="{x:Bind ReplyMarkdownSource, Mode=OneWay}"
                                            EditorHeight="160"
                                            Text="{x:Bind ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <common:MarkdownForm.ActionContent>
                                                <Button
                                                    x:Uid="PagesRepoPullRequestPageBindingReplyAutomationId" MinHeight="32"
                                                    MinWidth="72"
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.AutomationId="{x:Bind ReplyAutomationId, Mode=OneWay}"
                                                    AutomationProperties.Name="Reply to review comment"
                                                    Click="ReviewReplyButton_Click"
                                                    Content="{x:Bind ReplyButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsReplyEnabled, Mode=OneWay}"
                                                    Style="{StaticResource AppOutlineButtonStyle}" />
                                            </common:MarkdownForm.ActionContent>
                                        </common:MarkdownForm>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestLabelTemplate" x:DataType="github:GitHubLabel">
            <Border
                Margin="0,0,6,6"
                Padding="8,4"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{x:Bind Color, Converter={StaticResource HexColorToColorStringConverter}, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource AppInkBrush}"
                        Text="{x:Bind Name, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestReviewerActorTemplate" x:DataType="github:GitHubActor">
            <Grid
                MinHeight="34"
                Margin="0,0,0,6"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <common:Avatar
                    AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                    Login="{x:Bind Login, Mode=OneWay}"
                    NavigationSource="pull_request_requested_reviewer"
                    ShowLogin="False"
                    Size="SMALL"
                    Url="{x:Bind AvatarUrl, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    Text="{x:Bind Login, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RepoPullRequestAssigneeActorTemplate" x:DataType="github:GitHubActor">
            <Grid
                MinHeight="34"
                Margin="0,0,0,6"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <common:Avatar
                    AutomationInstanceId="{x:Bind AutomationId, Mode=OneWay}"
                    Login="{x:Bind Login, Mode=OneWay}"
                    NavigationSource="pull_request_assignee"
                    ShowLogin="False"
                    Size="SMALL"
                    Url="{x:Bind AvatarUrl, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    Text="{x:Bind Login, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Uid="PagesRepoPullRequestPageRepoPullRequestsPageRoot" x:Name="PerformanceRoot"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="RepoPullRequestsPageRoot"
        AutomationProperties.Name="Repository pull requests"
        Padding="{ThemeResource AppPagePadding}">
        <app:AdaptiveWorkspace
            x:Name="PullRequestsWorkspace"
            AutomationProperties.AutomationId="RepoPullRequestsAdaptiveWorkspace"
            AutomationIdPrefix="RepoPullRequests"
            LeadingPaneLabel="Pull requests"
            LeadingPaneWidth="348"
            MediumBreakpoint="860"
            ModeChanged="PullRequestsWorkspace_ModeChanged"
            NarrowBreakpoint="620"
            ShowPaneButtons="False"
            TrailingPaneLabel="Inspector"
            TrailingPaneWidth="276"
            WideBreakpoint="1260">
            <app:AdaptiveWorkspace.LeadingPane>
                <Border
                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsListHost" x:Name="PullRequestListHost"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="RepoPullRequestsListHost"
                    AutomationProperties.Name="Pull request list pane"
                    Padding="8,6,10,10"
                    Style="{StaticResource RepoPullRequestsPanelStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="0" Style="{StaticResource AppWorkspaceHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsCloseListPaneBut" x:Name="RepoPullRequestsCloseListPaneButton"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="RepoPullRequestsCloseListPaneButton"
                                    AutomationProperties.Name="Close pull request list"
                                    Click="CloseWorkspaceDrawerButton_Click"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Close pull requests"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE8FD;" />
                                </Button>
                                <toolkit:Segmented
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsStateSegmented" x:Name="PullRequestStateSegmented"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="RepoPullRequestsStateSegmented"
                                    AutomationProperties.Name="Pull request state filter"
                                    SelectedIndex="0"
                                    SelectionChanged="PullRequestStateSegmented_SelectionChanged">
                                    <toolkit:SegmentedItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsStateOpen" AutomationProperties.AutomationId="RepoPullRequestsState_Open" AutomationProperties.Name="Show open pull requests" Content="Open" />
                                    <toolkit:SegmentedItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsStateClosed" AutomationProperties.AutomationId="RepoPullRequestsState_Closed" AutomationProperties.Name="Show closed pull requests" Content="Closed" />
                                    <toolkit:SegmentedItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsStateAll" AutomationProperties.AutomationId="RepoPullRequestsState_All" AutomationProperties.Name="Show all pull requests" Content="All" />
                                </toolkit:Segmented>
                                <Button
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsNewButton" Grid.Column="2"
                                    MinHeight="34"
                                    MinWidth="58"
                                    Padding="12,6"
                                    AutomationProperties.AutomationId="RepoPullRequestsNewButton"
                                    AutomationProperties.Name="Create pull request"
                                    Click="NewPullRequestButton_Click"
                                    Content="New"
                                    Style="{StaticResource AppAccentButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsSearchBox" x:Name="PullRequestSearchBox"
                                    AutomationProperties.AutomationId="RepoPullRequestsSearchBox"
                                    AutomationProperties.Name="Filter pull requests"
                                    PlaceholderText="Filter pull requests..."
                                    Style="{StaticResource AppCommandSearchTextBoxStyle}"
                                    TextChanged="PullRequestSearchBox_TextChanged" />
                                <Button
                                    Grid.Column="1"
                                    x:Uid="PagesRepoPullRequestPageRepoPullRequestsFilterButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.AutomationId="RepoPullRequestsFilterButton"
                                    AutomationProperties.Name="Pull request filters"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Filters">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="14" Glyph="&#xE71C;" />
                                    <Button.Flyout>
                                        <Flyout Opened="PullRequestFiltersFlyout_Opened" Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="260" Spacing="10">
                                                <TextBlock
                                                    x:Uid="PagesRepoPullRequestPageTextBlockPullRequestFilters"
                                                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                    Text="Pull request filters" />
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Uid="PagesRepoPullRequestPageTextBlockPullRequestSort" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Sort by" />
                                                    <ComboBox
                                                        x:Uid="PagesRepoPullRequestPageRepoPullRequestsSortComboBox" x:Name="PullRequestSortComboBox"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="RepoPullRequestsSortComboBox"
                                                        AutomationProperties.Name="Sort pull requests"
                                                        SelectedIndex="0"
                                                        SelectionChanged="PullRequestFilterComboBox_SelectionChanged"
                                                        Style="{StaticResource AppCompactComboBoxStyle}">
                                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSortUpdated" AutomationProperties.AutomationId="RepoPullRequestsSort_Updated" AutomationProperties.Name="Updated" Content="Updated" />
                                                        <ComboBoxItem x:Uid="PagesRepoPullRequestPageRepoPullRequestsSortCreated" AutomationProperties.AutomationId="RepoPullRequestsSort_Created" AutomationProperties.Name="Created" Content="Created" />
