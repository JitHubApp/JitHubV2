<Page
    x:Class="JitHub.WinUI.Views.Pages.ShellPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JitHub.WinUI.Views.Pages"
    xmlns:models="using:JitHub.Models.GitHub"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels"
    xmlns:appcontrols="using:JitHub.WinUI.Views.Controls.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:user="using:JitHub.WinUI.Views.Controls.Profile"
    SizeChanged="Page_SizeChanged"
    Background="Transparent">
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="ModalContent.Width" Value="768"/>
                        <Setter Target="ModalContent.HorizontalAlignment" Value="Center"/>
                        <Setter Target="SearchBoxContainer.Width" Value="440"/>
                        <Setter Target="SearchBoxContainer.HorizontalAlignment" Value="Center"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="ModalContent.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="SearchBoxContainer.HorizontalAlignment" Value="Stretch"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="TitleBarHost"
            MinHeight="60"
            Background="{ThemeResource AppCanvasRaisedBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="192"/>
            </Grid.ColumnDefinitions>
            <StackPanel
                Spacing="12"
                Margin="20,14"
                Grid.Column="0"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Image
                    x:Name="AppLogoShellPage"
                    VerticalAlignment="Center"
                    Width="20"
                    Height="20"
                    Source="ms-appx:///Assets/JitHubLogo.png"/>
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ListItemTitleTextBlockStyle}"
                        Text="JitHub"/>
                    <Border
                        Background="{ThemeResource AppWarmAccentBrush}"
                        Padding="8 2"
                        Margin="6 0 0 0"
                        Visibility="{x:Bind ViewModel.FeatureService.ProLicense, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        CornerRadius="{ThemeResource AppRadiusPill}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ListItemSecondaryTextBlockStyle}"
                            Foreground="{ThemeResource AppWarmAccentForegroundBrush}"
                            Text="Pro">
                            <animations:Implicit.ShowAnimations>
                                <animations:ScaleAnimation Duration="0:0:0.5" From="0" To="1"/>
                            </animations:Implicit.ShowAnimations>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Grid
                Margin="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
                <Border
                    x:Name="SearchBoxContainer"
                    Padding="14,6"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource AppRadiusPill}"
                    AutomationProperties.AutomationId="ShellSearchBoxContainer">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <muxc:ProgressRing
                            Grid.Column="0"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.Searching, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Searching, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        <AutoSuggestBox
                            Grid.Column="1"
                            x:Name="SearchBox"
                            AutomationProperties.AutomationId="ShellSearchBox"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            QuerySubmitted="{x:Bind ViewModel.OpenRepo, Mode=OneWay}"
                            UpdateTextOnSelect="False"
                            PlaceholderText="Search repositories by owner/name or keyword">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GitHubRepository">
                                    <TextBlock Text="{x:Bind FullName, Mode=OneWay}"/>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                            <AutoSuggestBox.QueryIcon>
                                <muxc:AnimatedIcon x:Name="FindAnimatedIcon">
                                    <muxc:AnimatedIcon.Source>
                                        <animatedvisuals:AnimatedFindVisualSource/>
                                    </muxc:AnimatedIcon.Source>
                                    <muxc:AnimatedIcon.FallbackIconSource>
                                        <muxc:SymbolIconSource Symbol="Find"/>
                                    </muxc:AnimatedIcon.FallbackIconSource>
                                </muxc:AnimatedIcon>
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel
                Spacing="12"
                Margin="0 4 20 4"
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <!--<user:ProfileButton OnClickCommand="{x:Bind ViewModel.GoToProfilePageCommand}"/>-->
                <Button
                    x:Name="ShellMenuButton"
                    AutomationProperties.AutomationId="ShellMenuButton"
                    Style="{StaticResource AppToolbarButtonStyle}">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE712;"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem
                                Text="Submit Feedback"
                                Click="{x:Bind ViewModel.GoToFeedbackPage, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xED15;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Share JitHub With Others"
                                Click="{x:Bind ViewModel.OnShareJitHub, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="Sign Out"
                                Click="{x:Bind ViewModel.OnSignOut,Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Settings"
                                Click="{x:Bind ViewModel.GoToSettingsPage, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Dev Console"
                                Visibility="{Binding ViewModel.DevMode, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="{x:Bind ViewModel.OnOpenDevConsole, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xEC7A;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Design Lab"
                                Visibility="{Binding ViewModel.DevMode, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="{x:Bind ViewModel.GoToDesignLabPage, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xF158;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <muxc:TabView
            Grid.Row="1"
            Style="{StaticResource JitTabViewStyle}"
            Background="{ThemeResource AppCanvasRaisedBrush}"
            TabItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
            AddTabButtonClick="TabView_AddTabButtonClick"
            TabCloseRequested="TabView_TabCloseRequested"
            SelectionChanged="TabView_SelectionChanged"
            CanReorderTabs="True"
            IsAddTabButtonVisible="True">
            <muxc:TabView.TabStripHeader>
                <Button
                    Command="{x:Bind ViewModel.GoHomeCommand}"
                    Margin="8 0 0 0"
                    Style="{StaticResource AppToolbarButtonStyle}"
                    HorizontalContentAlignment="Left"
                    VerticalAlignment="Bottom">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE80F;"/>
                </Button>
            </muxc:TabView.TabStripHeader>
        </muxc:TabView>
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="Modal"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="Collapsed"
            Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid
                x:Name="ModalContent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource AppOutlineBrush}"
                BorderThickness="1"
                Background="{ThemeResource AppOverlayBrush}"
                CornerRadius="{ThemeResource AppRadiusLarge}">
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.5" From="0" To="1.0"/>
                    <animations:TranslationAnimation EasingType="Cubic" Duration="0:0:0.5" From="0, 200, 0" To="0"/>
                </animations:Implicit.ShowAnimations>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="0"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.UseHeader, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="16 0 0 0"
                            Style="{StaticResource SectionTitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"/>
                        <Button
                            Padding="0"
                            Margin="16"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE711;"
                            CornerRadius="{ThemeResource AppRadiusSmall}"
                            Width="32"
                            Height="32"
                            BorderThickness="0"
                            Style="{StaticResource AppToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.InLineModalClodeCommand, Mode=OneWay}"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"/>
                    </Grid>
                    <ContentPresenter
                        Grid.Row="1"
                        Canvas.ZIndex="100"
                        Content="{x:Bind ViewModel.Content, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Grid>
        <muxc:InfoBar
            Grid.Row="1"
            x:Name="NotificationBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Margin="16"/>
    </Grid>
</Page>



