                                                                Text="{x:Bind Policy}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"
                                                                ToolTipService.ToolTip="{x:Bind Policy}" />
                                                            <TextBlock
                                                                Grid.Row="3"
                                                                Grid.ColumnSpan="2"
                                                                MaxWidth="720"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                Text="{x:Bind HealthDetail}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

