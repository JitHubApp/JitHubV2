<Page
    x:Class="JitHub.WinUI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appcontrols="using:JitHub.WinUI.Views.Controls.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pageViewModels="using:JitHub.WinUI.ViewModels.Pages"
    mc:Ignorable="d"
    Background="{ThemeResource AppTransparentBrush}"
    SizeChanged="SettingsPage_SizeChanged">

    <Grid
        x:Name="SettingsRootGrid"
        Padding="{ThemeResource AppPagePadding}"
        AutomationProperties.AutomationId="SettingsRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsWidthStates">
                <VisualState x:Name="WideSettingsState" />
                <VisualState x:Name="CompactSettingsState">
                    <VisualState.Setters>
                        <Setter Target="SettingsSectionRail.Visibility" Value="Collapsed" />
                        <Setter Target="CompactSectionPicker.Visibility" Value="Visible" />
                        <Setter Target="CompactSectionPicker.MinWidth" Value="0" />
                        <Setter Target="CompactSectionPicker.MaxWidth" Value="1000" />
                        <Setter Target="CompactSectionPicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CompactSectionPicker.(Grid.Row)" Value="1" />
                        <Setter Target="CompactSectionPicker.(Grid.Column)" Value="0" />
                        <Setter Target="CompactSectionPicker.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SettingsWorkspace.ColumnSpacing" Value="0" />
                        <Setter Target="SettingsContentPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsContentPanel.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowSettingsState">
                    <VisualState.Setters>
                        <Setter Target="SettingsRootGrid.Padding" Value="12" />
                        <Setter Target="SettingsLayout.RowSpacing" Value="0" />
                        <Setter Target="SettingsHeader.RowSpacing" Value="10" />
                        <Setter Target="SettingsSectionRail.Visibility" Value="Collapsed" />
                        <Setter Target="CompactSectionPicker.Visibility" Value="Visible" />
                        <Setter Target="CompactSectionPicker.MinWidth" Value="0" />
                        <Setter Target="CompactSectionPicker.MaxWidth" Value="1000" />
                        <Setter Target="CompactSectionPicker.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CompactSectionPicker.(Grid.Row)" Value="1" />
                        <Setter Target="CompactSectionPicker.(Grid.Column)" Value="0" />
                        <Setter Target="CompactSectionPicker.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SettingsWorkspace.ColumnSpacing" Value="0" />
                        <Setter Target="SettingsContentPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsContentPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SettingsContentScrollViewer.Padding" Value="12" />
                        <Setter Target="ThemeOptionsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="ThemeOptionsGrid.RowSpacing" Value="10" />
                        <Setter Target="SystemThemeButton.(Grid.Column)" Value="0" />
                        <Setter Target="SystemThemeButton.(Grid.Row)" Value="0" />
                        <Setter Target="LightThemeButton.(Grid.Column)" Value="0" />
                        <Setter Target="LightThemeButton.(Grid.Row)" Value="1" />
                        <Setter Target="DarkThemeButton.(Grid.Column)" Value="0" />
                        <Setter Target="DarkThemeButton.(Grid.Row)" Value="2" />
                        <Setter Target="SettingsDeveloperModeRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsDeveloperModeToggle.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsDeveloperModeToggle.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsDeveloperModeToggle.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsSignOutRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsSignOutButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsSignOutButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsSignOutButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsDiagnosticsRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsDiagnosticsToggle.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsDiagnosticsToggle.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsDiagnosticsToggle.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsStoreTelemetryRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsStoreTelemetryToggle.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsStoreTelemetryToggle.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsStoreTelemetryToggle.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsClearQueryCacheRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsClearQueryCacheButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsClearQueryCacheButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsClearQueryCacheButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsClearStarLibraryRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsClearStarLibraryButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsClearStarLibraryButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsClearStarLibraryButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsClearImageCacheRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsClearImageCacheButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsClearImageCacheButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsClearImageCacheButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsClearRepoFileCacheRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsClearRepoFileCacheButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsClearRepoFileCacheButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsClearRepoFileCacheButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsClearAllCacheRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsClearAllCacheButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsClearAllCacheButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsClearAllCacheButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsAboutVersionRow.RowSpacing" Value="10" />
                        <Setter Target="SettingsViewSourceButton.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsViewSourceButton.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsViewSourceButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="SettingsLayout"
            MaxWidth="1080"
            HorizontalAlignment="Stretch"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="SettingsHeader"
                ColumnSpacing="16"
                Style="{StaticResource AppWorkspaceHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="PagesSettingsPageSettingsPageTitle" AutomationProperties.AutomationId="SettingsPageTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource PageTitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.SettingsTitle, Mode=OneWay}" />
                <ComboBox
                    x:Uid="PagesSettingsPageSettingsCompactSectionPicker" x:Name="CompactSectionPicker"
                    Grid.Column="1"
                    MinWidth="220"
                    MaxWidth="280"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="SettingsCompactSectionPicker"
                    AutomationProperties.Name="{x:Bind ViewModel.SectionPickerAutomationName, Mode=OneWay}"
                    DropDownOpened="CompactSectionPicker_DropDownOpened"
                    SelectionChanged="SettingsSectionSelectionChanged"
                    Style="{StaticResource AppCompactComboBoxStyle}"
                    Visibility="Collapsed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="pageViewModels:SettingsSectionItem">
                            <Grid
                                MinHeight="36"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="{ThemeResource AppFontSize14}"
                                    Foreground="{ThemeResource AppInkMutedBrush}"
                                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MaxLines="2"
                                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="SettingsErrorBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatusError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Severity="Error"
                Style="{StaticResource AppErrorInfoBarStyle}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="PagesSettingsPageSettingsRetryButton" AutomationProperties.AutomationId="SettingsRetryButton"
                        AutomationProperties.Name="Retry loading settings data"
                        Click="RetryDiagnosticsButton_Click"
                        Content="Retry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid
                x:Name="SettingsWorkspace"
                Grid.Row="2"
                Margin="0,10,0,0"
                MinHeight="0"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="SettingsSectionRail"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource AppRadiusMedium}"
                    Padding="8">
                        <ListView
                            x:Uid="PagesSettingsPageSettingsSectionList" x:Name="SettingsSectionList"
                            AutomationProperties.AutomationId="SettingsSectionList"
                            AutomationProperties.Name="Settings sections"
                        ContainerContentChanging="SettingsSectionList_ContainerContentChanging"
                        ItemContainerStyle="{StaticResource AppCompactNavigationRowStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionChanged="SettingsSectionSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pageViewModels:SettingsSectionItem">
                                <Grid
                                    MinHeight="42"
                                    ColumnSpacing="10"
                                    Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="{ThemeResource AppFontSize15}"
                                        Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxLines="3"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ListItemTitleTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border
                    x:Name="SettingsContentPanel"
                    Grid.Column="1"
                    Background="{ThemeResource AppCanvasInsetBrush}"
                    BorderBrush="{ThemeResource AppOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource AppRadiusMedium}">
                    <ScrollViewer
                        x:Name="SettingsContentScrollViewer"
                        Padding="18"
                        AutomationProperties.AutomationId="SettingsContentScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <Grid>
                            <StackPanel
                                AutomationProperties.AutomationId="SettingsAppearanceSection"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsAppearanceSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <appcontrols:AppSectionHeader x:Uid="PagesSettingsPageAppSectionHeaderAppearance" Title="Appearance" />
                                <Border
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                    Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock
                                            x:Uid="PagesSettingsPageTextBlockTheme" Style="{StaticResource ListItemTitleTextBlockStyle}"
                                            AutomationProperties.AutomationId="SettingsThemeHeading"
                                            Text="Theme" />
                                        <Grid
                                            x:Name="ThemeOptionsGrid"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <RadioButton
                                                x:Uid="PagesSettingsPageSettingsThemeSystem" x:Name="SystemThemeButton"
                                                AutomationProperties.AutomationId="SettingsThemeSystem"
                                                AutomationProperties.Name="Use system theme"
                                                Checked="SystemThemeButton_Checked"
                                                GroupName="SettingsTheme"
                                                HorizontalAlignment="Stretch"
                                                MinWidth="0"
                                Style="{StaticResource AppThemeCardRadioButtonStyle}">
                                                <Border
                                                    Height="140"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                                    Padding="16">
                                                    <Grid>
                                                        <Border
                                                            Background="{ThemeResource AppAccentBrush}"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Opacity="0.08"
                                                            Visibility="{x:Bind ViewModel.IsSystemThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Border
                                                            BorderBrush="{ThemeResource AppAccentBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Visibility="{x:Bind ViewModel.IsSystemThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Grid RowSpacing="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <FontIcon
                                                                HorizontalAlignment="Left"
                                                                FontSize="{ThemeResource AppFontSize24}"
                                                                Foreground="{ThemeResource AppAccentBrush}"
                                                                Glyph="&#xE770;" />
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="4">
                                                                <TextBlock
                                                                    x:Uid="PagesSettingsPageTextBlockSystem" FontSize="{ThemeResource AppFontSize15}"
                                                                    AutomationProperties.AutomationId="SettingsThemeSystemLabel"
                                                                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                                    MaxLines="2"
                                                                    TextWrapping="Wrap"
                                                                    Text="System" />
                                                            </StackPanel>
                                                            <Grid Grid.Row="2">
                                                                <Ellipse
                                                                    Width="16"
                                                                    Height="16"
                                                                    HorizontalAlignment="Left"
                                                                    Stroke="{ThemeResource AppOutlineStrongBrush}"
                                                                    StrokeThickness="1.4" />
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    HorizontalAlignment="Left"
                                                                    Fill="{ThemeResource AppAccentBrush}"
                                                                    Margin="4,0,0,0"
                                                                    Visibility="{x:Bind ViewModel.IsSystemThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </RadioButton>

                                            <RadioButton
                                                x:Uid="PagesSettingsPageSettingsThemeLight" x:Name="LightThemeButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="SettingsThemeLight"
                                                AutomationProperties.Name="Use light theme"
                                                Checked="LightThemeButton_Checked"
                                                GroupName="SettingsTheme"
                                                HorizontalAlignment="Stretch"
                                                MinWidth="0"
                                Style="{StaticResource AppThemeCardRadioButtonStyle}">
                                                <Border
                                                    Height="140"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                                    Padding="16">
                                                    <Grid>
                                                        <Border
                                                            Background="{ThemeResource AppAccentBrush}"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Opacity="0.08"
                                                            Visibility="{x:Bind ViewModel.IsLightThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Border
                                                            BorderBrush="{ThemeResource AppAccentBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Visibility="{x:Bind ViewModel.IsLightThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Grid RowSpacing="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <FontIcon
                                                                HorizontalAlignment="Left"
                                                                FontSize="{ThemeResource AppFontSize24}"
                                                                Foreground="{ThemeResource AppAccentBrush}"
                                                                Glyph="&#xE706;" />
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="4">
                                                                <TextBlock
                                                                    x:Uid="PagesSettingsPageTextBlockLight" FontSize="{ThemeResource AppFontSize15}"
                                                                    AutomationProperties.AutomationId="SettingsThemeLightLabel"
                                                                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                                    MaxLines="2"
                                                                    TextWrapping="Wrap"
                                                                    Text="Light" />
                                                            </StackPanel>
                                                            <Grid Grid.Row="2">
                                                                <Ellipse
                                                                    Width="16"
                                                                    Height="16"
                                                                    HorizontalAlignment="Left"
                                                                    Stroke="{ThemeResource AppOutlineStrongBrush}"
                                                                    StrokeThickness="1.4" />
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    HorizontalAlignment="Left"
                                                                    Fill="{ThemeResource AppAccentBrush}"
                                                                    Margin="4,0,0,0"
                                                                    Visibility="{x:Bind ViewModel.IsLightThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </RadioButton>

                                            <RadioButton
                                                x:Uid="PagesSettingsPageSettingsThemeDark" x:Name="DarkThemeButton"
                                                Grid.Column="2"
                                                AutomationProperties.AutomationId="SettingsThemeDark"
                                                AutomationProperties.Name="Use dark theme"
                                                Checked="DarkThemeButton_Checked"
                                                GroupName="SettingsTheme"
                                                HorizontalAlignment="Stretch"
                                                MinWidth="0"
                                Style="{StaticResource AppThemeCardRadioButtonStyle}">
                                                <Border
                                                    Height="140"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                                    Padding="16">
                                                    <Grid>
                                                        <Border
                                                            Background="{ThemeResource AppAccentBrush}"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Opacity="0.08"
                                                            Visibility="{x:Bind ViewModel.IsDarkThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Border
                                                            BorderBrush="{ThemeResource AppAccentBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="{ThemeResource AppRadiusMedium}"
                                                            Margin="-16"
                                                            Visibility="{x:Bind ViewModel.IsDarkThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        <Grid RowSpacing="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <FontIcon
                                                                HorizontalAlignment="Left"
                                                                FontSize="{ThemeResource AppFontSize24}"
                                                                Foreground="{ThemeResource AppAccentBrush}"
                                                                Glyph="&#xE708;" />
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="4">
                                                                <TextBlock
                                                                    x:Uid="PagesSettingsPageTextBlockDark" FontSize="{ThemeResource AppFontSize15}"
                                                                    AutomationProperties.AutomationId="SettingsThemeDarkLabel"
                                                                    Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                                    MaxLines="2"
                                                                    TextWrapping="Wrap"
                                                                    Text="Dark" />
                                                            </StackPanel>
                                                            <Grid Grid.Row="2">
                                                                <Ellipse
                                                                    Width="16"
                                                                    Height="16"
                                                                    HorizontalAlignment="Left"
                                                                    Stroke="{ThemeResource AppOutlineStrongBrush}"
                                                                    StrokeThickness="1.4" />
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    HorizontalAlignment="Left"
                                                                    Fill="{ThemeResource AppAccentBrush}"
                                                                    Margin="4,0,0,0"
                                                                    Visibility="{x:Bind ViewModel.IsDarkThemeSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </RadioButton>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel
                                AutomationProperties.AutomationId="SettingsGeneralSection"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsGeneralSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <appcontrols:AppSectionHeader x:Uid="PagesSettingsPageAppSectionHeaderGeneral" Title="General" />
                                <Border
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                    Padding="16">
                                    <Grid
                                        x:Name="SettingsDeveloperModeRow"
                                        ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                x:Uid="PagesSettingsPageTextBlockDeveloperMode" Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                Text="Developer mode" />
                                            <TextBlock
                                                x:Uid="PagesSettingsPageTextBlockEnableDebugFacingAffordancesTh" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                Text="Enable debug-facing affordances that are useful while building and validating JitHub."
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Uid="PagesSettingsPageSettingsDeveloperModeToggle" x:Name="SettingsDeveloperModeToggle"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="SettingsDeveloperModeToggle"
                                            AutomationProperties.Name="Developer mode"
                                            IsOn="{x:Bind ViewModel.IsDeveloperMode, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                    Padding="16">
                                    <Grid
                                        x:Name="SettingsSignOutRow"
                                        ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                x:Uid="PagesSettingsPageTextBlockSignOut" Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                Text="Sign out" />
                                            <TextBlock
                                                x:Uid="PagesSettingsPageTextBlockRemoveTheActiveGitHubSessionFr" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                Text="Remove the active GitHub session from this app instance."
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="PagesSettingsPageSettingsSignOutButton" x:Name="SettingsSignOutButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="SettingsSignOutButton"
                                            AutomationProperties.Name="Sign out of JitHub"
                                            Click="SignOutButton_Click"
                                            Content="Sign out" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel
                                AutomationProperties.AutomationId="SettingsPrivacySection"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.IsPrivacySelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <appcontrols:AppSectionHeader x:Uid="PagesSettingsPageAppSectionHeaderPrivacy" Title="Privacy" />
                                <Border
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource AppRadiusMedium}"
                                    Padding="16">
                                    <StackPanel Spacing="16">
                                        <Grid
                                            x:Name="SettingsDiagnosticsRow"
                                            ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    x:Uid="PagesSettingsPageTextBlockLocalDiagnostics" Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                    Text="Local diagnostics" />
                                                <TextBlock
                                                    x:Uid="PagesSettingsPageTextBlockWriteSanitizedEventsAndPerform" Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                                    Text="Write sanitized events and performance timings to a local NDJSON file."
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Uid="PagesSettingsPageSettingsDiagnosticsToggle" x:Name="SettingsDiagnosticsToggle"
