                                                Text="Native Windows GitHub client with vNext foundations."
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="PagesSettingsPageSettingsViewSourceButton" x:Name="SettingsViewSourceButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="SettingsViewSourceButton"
                                            AutomationProperties.Name="View JitHub source"
                                            Click="ViewSourceButton_Click"
                                            Content="View source" />
                                    </Grid>
                                </Border>

                                <appcontrols:AppSectionHeader x:Uid="PagesSettingsPageAppSectionHeaderContributors" Title="Contributors" />

