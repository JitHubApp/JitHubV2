<Page
    x:Class="JitHub.WinUI.Views.Pages.RepoCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:cv="using:JitHub.WinUI.Views.Controls.CodeViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid
        x:Name="RootGrid"
        x:Uid="RepoCodePageRoot"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="RepoCodePageRoot"
        AutomationProperties.Name="Repository code"
        KeyDown="RootGrid_KeyDown">

        <app:AdaptiveWorkspace
            x:Name="CodeWorkspace"
            x:Uid="RepoCodeAdaptiveWorkspace"
            AutomationProperties.AutomationId="RepoCodeAdaptiveWorkspace"
            AutomationProperties.Name="Repository code workspace"
            AutomationIdPrefix="RepoCode"
            LeadingPaneLabel="Repository files"
            LeadingPaneWidth="280"
            MediumBreakpoint="980"
            ModeChanged="CodeWorkspace_ModeChanged"
            NarrowBreakpoint="720"
            ShowPaneButtons="False"
            WideBreakpoint="1260">
            <app:AdaptiveWorkspace.LeadingPane>
                <Border
                    x:Name="FileTreeHost"
                    x:Uid="RepoCodeFileTreeHost"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="RepoCodeFileTreeHost"
                    AutomationProperties.Name="Repository files panel"
                    Background="{ThemeResource AppCanvasInsetBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="FileTreeDrawerHeader"
                            Padding="8,6"
                            Visibility="Collapsed">
                            <Button
                                x:Name="CloseFileTreeButton"
                                x:Uid="RepoCodeCloseFileTreeButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="RepoCodeCloseFileTreeButton"
                                AutomationProperties.Name="Close repository files"
                                Click="CloseFileTreeButton_Click"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Close repository files">
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIcons}"
                                    FontSize="14"
                                    Glyph="&#xE8FD;" />
                            </Button>
                        </Grid>
                        <cv:RepoFileTreeView
                            x:Name="FileTree"
                            Grid.Row="1"
                            DataContext="{x:Bind ViewModel.Tree, Mode=OneWay}"
                            FileInvoked="FileTree_FileInvoked" />
                    </Grid>
                </Border>
            </app:AdaptiveWorkspace.LeadingPane>

            <app:AdaptiveWorkspace.PrimaryPane>
                <Grid
                    x:Name="CodeReadingHost"
                    x:Uid="RepoCodeReadingHost"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="RepoCodeReadingHost"
                    AutomationProperties.Name="Code reading area">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <cv:RepoCodeBreadcrumb
                        x:Name="Breadcrumb"
                        Grid.Row="0"
                        CanGoBack="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        CanGoForward="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        DataContext="{x:Bind ViewModel.Breadcrumb, Mode=OneWay}"
                        FileTreeRequested="Breadcrumb_FileTreeRequested"
                        GoBackCommand="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                        GoForwardCommand="{x:Bind ViewModel.GoForwardCommand, Mode=OneWay}" />

                    <cv:FilePreviewHost
                        x:Name="PreviewHost"
                        Grid.Row="1"
                        DataContext="{x:Bind ViewModel.Preview, Mode=OneWay}" />
                </Grid>
            </app:AdaptiveWorkspace.PrimaryPane>
        </app:AdaptiveWorkspace>

        <muxc:InfoBar
            x:Name="ErrorBanner"
            x:Uid="RepoCodeStatusBar"
            MaxWidth="720"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning"
            Style="{StaticResource AppStatusInfoBarStyle}"
            Title="Repository code status" />
    </Grid>
</Page>
