<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JitHub.WinUI.Views.Pages.GistsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appControls="using:JitHub.WinUI.Views.Controls.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels.Pages"
    x:DataType="viewmodels:GistsPageViewModel"
    Background="{ThemeResource AppCanvasBrush}"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="GistEditorContentTextBoxStyle"
            BasedOn="{StaticResource AppTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="{ThemeResource AppDimension180}" />
            <Setter Property="Padding" Value="{ThemeResource AppPadding12_10}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppMonoFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource AppFontSize13}" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
            <Setter Property="IsTextPredictionEnabled" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <DataTemplate x:Key="GistEditorFileTemplate" x:DataType="viewmodels:GistEditorFileDraft">
            <Grid
                MinWidth="{ThemeResource AppDimension0}"
                ColumnSpacing="{ThemeResource AppGap8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{ThemeResource AppGridLength20}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="{ThemeResource AppFontSize14}"
                    Foreground="{ThemeResource AppInkMutedBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource AppUiFontFamily}"
                    FontSize="{ThemeResource AppFontSize13}"
                    Foreground="{ThemeResource AppInkBrush}"
                    MaxLines="1"
                    Text="{x:Bind Filename, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GistRowTemplate" x:DataType="viewmodels:GistViewItem">
            <Grid
                MinHeight="{ThemeResource AppDimension68}"
                Padding="{ThemeResource AppPadding10_8}"
                ColumnSpacing="{ThemeResource AppGap10}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{ThemeResource AppGridLength24}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="{ThemeResource AppMargin0_2_0_0}"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="{ThemeResource AppFontSize15}"
                    Foreground="{ThemeResource AppAccentBrush}"
                    Glyph="&#xE943;" />
                <StackPanel Grid.Column="1" MinWidth="{ThemeResource AppDimension0}" Spacing="{ThemeResource AppGap4}">
                    <TextBlock
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="{ThemeResource AppFontSize14}"
                        FontWeight="{ThemeResource AppFontWeightSemibold}"
                        Foreground="{ThemeResource AppInkBrush}"
                        MaxLines="1"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap8}">
                        <TextBlock
                            MaxWidth="{ThemeResource AppDimension170}"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind FileSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind UpdatedText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="{ThemeResource AppPadding7_3}"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                    CornerRadius="{ThemeResource AppRadiusSmall}">
                    <TextBlock
                        FontSize="{ThemeResource AppFontSize11}"
                        Foreground="{ThemeResource AppInkMutedBrush}"
                        Text="{x:Bind VisibilityText, Mode=OneWay}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <appControls:AdaptiveWorkspace
        x:Name="GistsWorkspace"
        AutomationIdPrefix="Gists"
        LeadingPaneLabel="Gist library"
        LeadingPaneWidth="344"
        MediumBreakpoint="760"
        ModeChanged="GistsWorkspace_ModeChanged"
        NarrowBreakpoint="560"
        ShowPaneButtons="True"
        WideBreakpoint="1120">
        <appControls:AdaptiveWorkspace.LeadingPane>
            <Grid
                x:Name="GistsLibraryRoot"
                AutomationProperties.AutomationId="GistsLibraryPane"
                Background="{ThemeResource AppCanvasBrush}"
                Padding="{ThemeResource AppPadding14_14_12_12}"
                RowSpacing="{ThemeResource AppGap10}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="GistsHeaderGrid" Style="{StaticResource AppWorkspaceHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap9}">
                        <FontIcon
                            VerticalAlignment="Center"
                            Style="{StaticResource AppWorkspaceHeaderIconStyle}"
                            Glyph="&#xE943;" />
                        <TextBlock
                            x:Uid="PagesGistsPageTextBlockGists"
                            VerticalAlignment="Center"
                            Style="{StaticResource AppWorkspaceTitleTextBlockStyle}"
                            Text="Gists" />
                    </StackPanel>
                    <Button
                        x:Uid="PagesGistsPageGistsNew" x:Name="GistsNewButton"
                        Grid.Column="1"
                        MinWidth="{ThemeResource AppDimension74}"
                        AutomationProperties.AutomationId="GistsNew"
                        AutomationProperties.Name="New gist"
                        Command="{x:Bind ViewModel.NewGistCommand}"
                        Style="{StaticResource AppOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap6}">
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize13}" Glyph="&#xE710;" />
                            <TextBlock x:Uid="PagesGistsPageGistsNewButtonText" x:Name="GistsNewButtonText" VerticalAlignment="Center" Text="New" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBox
                        x:Uid="PagesGistsPageGistsSearch" x:Name="GistsSearchBox"
                        AutomationProperties.AutomationId="GistsSearch"
                        AutomationProperties.Name="Search gists"
                        PlaceholderText="Search gists"
                        Style="{StaticResource AppCommandLeadingIconSearchTextBoxStyle}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <FontIcon
                        Margin="{ThemeResource AppMargin12_0_0_0}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="{ThemeResource AppFontSize13}"
                        Foreground="{ThemeResource AppInkSubtleBrush}"
                        Glyph="&#xE721;"
                        IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="{ThemeResource AppGap8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Uid="PagesGistsPageGistsVisibilityFilter" x:Name="GistVisibilityFilterComboBox"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="GistsVisibilityFilter"
                        AutomationProperties.Name="Filter by visibility"
                        SelectedIndex="0"
                        SelectionChanged="GistVisibilityFilter_SelectionChanged"
                        Style="{StaticResource AppCompactComboBoxStyle}">
                        <ComboBoxItem x:Uid="PagesGistsPageGistsVisibilityAll" AutomationProperties.AutomationId="GistsVisibility_All" AutomationProperties.Name="Show all gists" Content="All gists" />
                        <ComboBoxItem x:Uid="PagesGistsPageGistsVisibilityPublic" AutomationProperties.AutomationId="GistsVisibility_Public" AutomationProperties.Name="Show public gists" Content="Public" />
                        <ComboBoxItem x:Uid="PagesGistsPageGistsVisibilitySecret" AutomationProperties.AutomationId="GistsVisibility_Secret" AutomationProperties.Name="Show secret gists" Content="Secret" />
                    </ComboBox>
                    <ComboBox
                        x:Uid="PagesGistsPageGistsSort" x:Name="GistSortComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="GistsSort"
                        AutomationProperties.Name="Sort gists"
                        SelectedIndex="0"
                        SelectionChanged="GistSort_SelectionChanged"
                        Style="{StaticResource AppCompactComboBoxStyle}">
                        <ComboBoxItem x:Uid="PagesGistsPageGistsSortUpdated" AutomationProperties.AutomationId="GistsSort_Updated" AutomationProperties.Name="Sort by recently updated" Content="Updated" />
                        <ComboBoxItem x:Uid="PagesGistsPageGistsSortNewest" AutomationProperties.AutomationId="GistsSort_Newest" AutomationProperties.Name="Sort by newest" Content="Newest" />
                        <ComboBoxItem x:Uid="PagesGistsPageGistsSortOldest" AutomationProperties.AutomationId="GistsSort_Oldest" AutomationProperties.Name="Sort by oldest" Content="Oldest" />
                        <ComboBoxItem x:Uid="PagesGistsPageGistsSortTitle" AutomationProperties.AutomationId="GistsSort_Title" AutomationProperties.Name="Sort by title" Content="Title" />
                    </ComboBox>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="{ThemeResource AppGap6}">
                    <InfoBar
                        AutomationProperties.AutomationId="GistsDurabilityStatus"
                        IsOpen="{x:Bind ViewModel.IsDurabilityWarningVisible, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.DurabilityWarningMessage, Mode=OneWay}"
                        Severity="Warning"
                        Style="{StaticResource AppStatusInfoBarStyle}" />
                    <InfoBar
                        AutomationProperties.AutomationId="GistsStatus"
                        IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Style="{StaticResource AppErrorInfoBarStyle}" />
                </StackPanel>

                <Grid Grid.Row="4">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{ThemeResource AppGap7}"
                        Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ProgressRing Width="{ThemeResource AppDimension24}" Height="{ThemeResource AppDimension24}" IsActive="True" />
                        <TextBlock x:Uid="PagesGistsPageTextBlockLoadingGists" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Loading gists" />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource AppEmptyStatePanelStyle}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIcons}"
                            FontSize="{ThemeResource AppFontSize26}"
                            Foreground="{ThemeResource AppInkSubtleBrush}"
                            Glyph="&#xE943;" />
                        <TextBlock x:Uid="PagesGistsPageTextBlockNoMatchingGists" FontWeight="{ThemeResource AppFontWeightSemibold}" Text="No matching gists" />
                    </StackPanel>
                    <ListView
                        x:Uid="PagesGistsPageGistsList" x:Name="GistsList"
                        AutomationProperties.AutomationId="GistsList"
                        AutomationProperties.Name="Gist library"
                                    Background="{ThemeResource AppTransparentBrush}"
                        BorderThickness="{ThemeResource AppZeroThickness}"
                        ContainerContentChanging="GistsList_ContainerContentChanging"
                        IsItemClickEnabled="True"
                        ItemClick="GistsList_ItemClick"
                        KeyDown="GistsList_KeyDown"
                        SelectionChanged="GistsList_SelectionChanged"
                        ItemTemplate="{StaticResource GistRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Gists, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedGistItem, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource AppDenseFlatListRowStyle}" />
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <ProgressBar
                    Grid.Row="5"
                    Height="{ThemeResource AppDimension2}"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </appControls:AdaptiveWorkspace.LeadingPane>

        <appControls:AdaptiveWorkspace.PrimaryPane>
            <Grid
                x:Name="GistsDetailRoot"
                AutomationProperties.AutomationId="GistsDetailPane"
                Padding="{ThemeResource AppPadding18_14_18_16}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{ThemeResource AppGap8}"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="{ThemeResource AppFontSize32}"
                        Foreground="{ThemeResource AppInkSubtleBrush}"
                        Glyph="&#xE943;" />
                    <TextBlock x:Uid="PagesGistsPageTextBlockSelectAGist" FontSize="{ThemeResource AppFontSize17}" FontWeight="{ThemeResource AppFontWeightSemibold}" Text="Select a gist" />
                    <TextBlock x:Uid="PagesGistsPageTextBlockChooseAGistFromTheLibraryToPrevie" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Choose a gist from the library to preview its files." />
                </StackPanel>

                <Grid Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" RowSpacing="{ThemeResource AppGap10}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="{ThemeResource AppGap12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="{ThemeResource AppDimension0}" Spacing="{ThemeResource AppGap5}">
                            <TextBlock
                                x:Name="GistsDetailTitleText"
                                AutomationProperties.AutomationId="GistsDetailTitle"
                                FontFamily="{ThemeResource AppDisplayFontFamily}"
                                FontSize="{ThemeResource AppFontSize27}"
                                Foreground="{ThemeResource AppInkBrush}"
                                MaxLines="2"
                                Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource AppUiFontFamily}"
                                FontSize="{ThemeResource AppMetaFontSize}"
                                TextTrimming="CharacterEllipsis">
                                <Run Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.SelectedVisibilityText, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Foreground="{ThemeResource AppInkMutedBrush}" Text="{x:Bind ViewModel.SelectedUpdatedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="{ThemeResource AppGap4}">
                            <Button
                                x:Uid="PagesGistsPageGistsEdit" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsEdit"
                                AutomationProperties.Name="Edit gist"
                                Command="{x:Bind ViewModel.EditGistCommand}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Edit gist">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE70F;" />
                            </Button>
                            <Button
                                x:Uid="PagesGistsPageGistsCopyLink" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsCopyLink"
                                AutomationProperties.Name="Copy gist link"
                                Command="{x:Bind ViewModel.CopyLinkCommand}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy link">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                x:Uid="PagesGistsPageGistsShare" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsShare"
                                AutomationProperties.Name="Share gist"
                                Command="{x:Bind ViewModel.ShareCommand}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Share gist">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE72D;" />
                            </Button>
                            <Button
                                x:Uid="PagesGistsPageGistsDelete" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsDelete"
                                AutomationProperties.Name="Delete gist"
                                Command="{x:Bind ViewModel.DeleteGistCommand}"
                                Foreground="{ThemeResource AppDangerBrush}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Delete gist">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="{ThemeResource AppDimension1}" Fill="{ThemeResource AppHairlineBrush}" />

                    <Grid Grid.Row="2" RowSpacing="{ThemeResource AppGap4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Uid="PagesGistsPageGistsFilePicker" AutomationProperties.AutomationId="GistsFilePicker"
                            AutomationProperties.Name="Gist file"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Filename"
                            ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                            Style="{StaticResource AppCompactComboBoxStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{ThemeResource AppGap4}">
                            <Button
                                x:Uid="PagesGistsPageGistsCopyFile" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsCopyFile"
                                AutomationProperties.Name="Copy complete Gist file"
                                Command="{x:Bind ViewModel.CopyFileCommand}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy complete file">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                x:Uid="PagesGistsPageGistsSaveFile" Width="{ThemeResource AppDimension34}"
                                Height="{ThemeResource AppDimension34}"
                                AutomationProperties.AutomationId="GistsSaveFile"
                                AutomationProperties.Name="Save complete Gist file"
                                Command="{x:Bind ViewModel.SaveFileCommand}"
                                Style="{StaticResource AppToolbarButtonStyle}"
                                ToolTipService.ToolTip="Save complete file">
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE74E;" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedFileMeta, Mode=OneWay}" />
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Padding="{ThemeResource AppPadding10_8}"
                        Background="{ThemeResource AppCanvasInsetBrush}"
                        BorderBrush="{ThemeResource AppOutlineBrush}"
                        BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                        CornerRadius="{ThemeResource AppRadiusSmall}"
                        Visibility="{x:Bind ViewModel.IsSelectedFileTruncated, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Grid ColumnSpacing="{ThemeResource AppGap10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionSecondaryTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedFileTruncationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Uid="PagesGistsPageGistsLoadFullFile" Grid.Column="1"
                                AutomationProperties.AutomationId="GistsLoadFullFile"
                                AutomationProperties.Name="Load full Gist file"
                                Command="{x:Bind ViewModel.LoadFullFileCommand}"
                                Style="{StaticResource AppOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap8}">
                                    <ProgressRing
                                        Width="{ThemeResource AppDimension16}"
                                        Height="{ThemeResource AppDimension16}"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind ViewModel.IsFullFileLoading, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsFullFileLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock x:Uid="PagesGistsPageTextBlockLoadFullFile" VerticalAlignment="Center" Text="Load full file" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="4"
                        Padding="{ThemeResource AppPadding10_7}"
                        Background="{ThemeResource AppCanvasInsetBrush}"
                        CornerRadius="{ThemeResource AppRadiusSmall}"
                        Visibility="{x:Bind ViewModel.IsSelectedFilePreviewCapped, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="GistsFilePreviewLimit"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedFilePreviewStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="5">
                        <TextBox
                            x:Uid="PagesGistsPageGistsFilePreview" x:Name="GistsFilePreviewTextBox" AutomationProperties.AutomationId="GistsFilePreview"
                            AutomationProperties.Name="Gist file preview"
                            Padding="{ThemeResource AppPadding14_12}"
                            AcceptsReturn="True"
                            Background="{ThemeResource AppCanvasInsetBrush}"
                            BorderBrush="{ThemeResource AppHairlineBrush}"
                            BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            FontSize="{ThemeResource AppFontSize13}"
                            IsReadOnly="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Text="{x:Bind ViewModel.SelectedFileContent, Mode=OneWay}"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <ProgressRing
                            Width="{ThemeResource AppDimension26}"
                            Height="{ThemeResource AppDimension26}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsDetailLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </appControls:AdaptiveWorkspace.PrimaryPane>
    </appControls:AdaptiveWorkspace>
</Page>
