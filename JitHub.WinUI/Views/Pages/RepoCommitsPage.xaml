                                        <ItemsControl
                                            ItemTemplate="{StaticResource CommitCommentTemplate}"
                                            ItemsSource="{x:Bind ViewModel.CommitComments, Mode=OneWay}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer
