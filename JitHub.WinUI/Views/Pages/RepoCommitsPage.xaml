                                                Width="{ThemeResource AppCommandControlHeight}"
                                                Height="{ThemeResource AppCommandControlHeight}"
                                                Padding="{ThemeResource AppPadding0}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.AutomationId="RepoCommitsCompareSwapButton"
                                                AutomationProperties.Name="Swap base and compare references"
                                                Click="SwapCompareRefsButton_Click"
                                                IsEnabled="{x:Bind ViewModel.IsCompareInputEnabled, Mode=OneWay}"
                                                Style="{StaticResource AppToolbarButtonStyle}"
                                                ToolTipService.ToolTip="Swap references">
                                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8AB;" />
                                            </Button>
                                            <StackPanel Grid.Column="2" Spacing="{ThemeResource AppGap4}">
                                                <TextBlock
                                                    x:Uid="PagesRepoCommitsPageTextBlockCompareHead"
                                                    Style="{StaticResource AppInlineMetadataTextBlockStyle}"
                                                    Text="Compare" />
                                                <TextBox
                                                    x:Uid="PagesRepoCommitsPageRepoCommitsCompareHeadBox"
                                                    AutomationProperties.AutomationId="RepoCommitsCompareHeadBox"
                                                    AutomationProperties.Name="Compare head reference"
                                                    IsEnabled="{x:Bind ViewModel.IsCompareInputEnabled, Mode=OneWay}"
                                                    KeyDown="CompareRefBox_KeyDown"
                                                    PlaceholderText="Compare ref"
                                                    Style="{StaticResource AppCommandTextBoxStyle}"
                                                    Text="{x:Bind ViewModel.CompareHeadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="PagesRepoCommitsPageRepoCommitsCompareButton"
                                                Grid.Column="3"
                                                Height="{ThemeResource AppCommandControlHeight}"
                                                MinHeight="{ThemeResource AppCommandControlHeight}"
                                                Padding="{ThemeResource AppPadding12_6}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.AutomationId="RepoCommitsCompareButton"
                                                AutomationProperties.Name="Compare references"
                                                Click="CompareButton_Click"
                                                Content="Compare"
                                                IsEnabled="{x:Bind ViewModel.CanRunCompare, Mode=OneWay}"
                                                Style="{StaticResource AppAccentButtonStyle}" />
                                            <Button
                                                x:Uid="PagesRepoCommitsPageRepoCommitsCompareSearchButton"
                                                x:Name="CommitCompareSearchButton"
