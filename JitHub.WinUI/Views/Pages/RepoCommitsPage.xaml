                                        <commit:CommitDiffViewer
                                            x:Uid="PagesRepoCommitsPageRepoCommitsCompareDiffViewer"
                                            x:Name="CompareCommitDiffViewer"
                                            AutomationProperties.AccessibilityView="Control"
                                            AutomationProperties.AutomationId="RepoCommitsCompareDiffViewer"
                                            AutomationProperties.Name="Compare commit diff"
                                            ActionCompleted="CommitDiffViewer_ActionCompleted"
                                            RowProjection="{x:Bind ViewModel.CompareDiffRowProjection, Mode=OneWay}"
                                            SelectedSearchMatchIndex="{x:Bind ViewModel.SelectedDiffSearchMatchIndex, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsCompareDiffVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                        <StackPanel
                                            AutomationProperties.AutomationId="RepoCommitsCompareInitialState"
                                            Style="{StaticResource AppEmptyStatePanelStyle}"
                                            Visibility="{x:Bind ViewModel.IsCompareInitialStateVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <FontIcon Foreground="{ThemeResource AppAccentBrush}" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize25}" Glyph="&#xE8AB;" />
                                            <TextBlock x:Uid="PagesRepoCommitsPageTextBlockNoComparisonLoaded" Style="{StaticResource ListItemTitleTextBlockStyle}" Text="No comparison loaded" />
                                        </StackPanel>
                                        <StackPanel
                                            AutomationProperties.AutomationId="RepoCommitsCompareLoadingState"
                                            Style="{StaticResource AppEmptyStatePanelStyle}"
                                            Visibility="{x:Bind ViewModel.IsCompareLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <ProgressRing Width="{ThemeResource AppDimension24}" Height="{ThemeResource AppDimension24}" IsActive="{x:Bind ViewModel.IsCompareLoading, Mode=OneWay}" />
                                            <TextBlock x:Uid="PagesRepoCommitsPageTextBlockComparingChanges" Style="{StaticResource ListItemTitleTextBlockStyle}" Text="Comparing changes" />
                                        </StackPanel>
                                        <StackPanel
                                            AutomationProperties.AutomationId="RepoCommitsCompareNoChangesState"
                                            Style="{StaticResource AppEmptyStatePanelStyle}"
                                            Visibility="{x:Bind ViewModel.IsCompareNoChangesStateVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <FontIcon Foreground="{ThemeResource AppSuccessBrush}" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize25}" Glyph="&#xE8FB;" />
                                            <TextBlock x:Uid="PagesRepoCommitsPageTextBlockNoFileChanges" Style="{StaticResource ListItemTitleTextBlockStyle}" Text="No file changes" />
                                        </StackPanel>
                                        <StackPanel
                                            AutomationProperties.AutomationId="RepoCommitsCompareErrorState"
                                            Style="{StaticResource AppEmptyStatePanelStyle}"
                                            Visibility="{x:Bind ViewModel.IsCompareErrorStateVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <FontIcon Foreground="{ThemeResource AppDangerBrush}" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize25}" Glyph="&#xEA39;" />
                                            <TextBlock x:Uid="PagesRepoCommitsPageTextBlockComparisonUnavailable" Style="{StaticResource ListItemTitleTextBlockStyle}" Text="Comparison unavailable" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Grid
                                x:Name="CommitDetailShyHeaderSurface"
                                Grid.RowSpan="3"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="RepoCommitsDetailShyHeader"
                                Canvas.ZIndex="20"
                                Visibility="Collapsed">
                                <Border
                                    labs:TransitionHelper.Id="CommitDetailHeaderChrome"
                                    Background="{ThemeResource AppTransientOverlayBrush}"
                                    BorderBrush="{ThemeResource AppHairlineBrush}"
                                    BorderThickness="{ThemeResource AppBottomHairlineBorderThickness}"
                                    IsHitTestVisible="False" />
                                <Grid Padding="{ThemeResource AppPadding8_6}" ColumnSpacing="{ThemeResource AppGap8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Uid="PagesRepoCommitsPageRepoCommitsOpenListPaneButton"
                                        x:Name="RepoCommitsShyOpenListPaneButton"
                                        Width="{ThemeResource AppDimension34}"
                                        Height="{ThemeResource AppDimension34}"
                                        Padding="{ThemeResource AppPadding0}"
                                        VerticalAlignment="Center"
                                        labs:TransitionHelper.Id="CommitDetailListButton"
                                        AutomationProperties.AutomationId="RepoCommitsShyOpenListPaneButton"
                                        AutomationProperties.Name="Open commit list"
                                        Click="OpenListPaneButton_Click"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Commits"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8FD;" />
                                    </Button>
                                    <Grid Grid.Column="1" ColumnSpacing="{ThemeResource AppGap10}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            labs:TransitionHelper.Id="CommitDetailTitle"
                                            FontFamily="{ThemeResource AppDisplayFontFamily}"
                                            FontSize="{ThemeResource AppFontSize16}"
                                            Foreground="{ThemeResource AppInkBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind ViewModel.SelectedCommitTitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedCommitTitle, Mode=OneWay}" />
                                        <app:AppSegmented
                                            x:Uid="PagesRepoCommitsPageRepoCommitsSectionSegmented"
                                            x:Name="CommitShySectionSegmented"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            labs:TransitionHelper.Id="CommitDetailTabs"
                                            AutomationProperties.AutomationId="RepoCommitsShySectionSegmented"
                                            AutomationProperties.Name="Commit section"
                                            FontSize="{ThemeResource AppFontSize11}"
                                            SelectedIndex="0"
                                            SelectionChanged="CommitSectionSegmented_SelectionChanged"
                                            Style="{StaticResource AppContentSizedSegmentedStyle}">
                                            <app:AppSegmentedItem x:Uid="PagesRepoCommitsPageRepoCommitsSectionDiff" AutomationProperties.AutomationId="RepoCommitsShySection_Diff" AutomationProperties.Name="Show commit diff" Content="Diff" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
                                            <app:AppSegmentedItem x:Uid="PagesRepoCommitsPageRepoCommitsSectionComments" AutomationProperties.AutomationId="RepoCommitsShySection_Comments" AutomationProperties.Name="Show commit comments" Content="Comments" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
                                            <app:AppSegmentedItem x:Uid="PagesRepoCommitsPageRepoCommitsSectionChecks" AutomationProperties.AutomationId="RepoCommitsShySection_Checks" AutomationProperties.Name="Show commit checks" Content="Checks" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
                                            <app:AppSegmentedItem x:Uid="PagesRepoCommitsPageRepoCommitsSectionCompare" AutomationProperties.AutomationId="RepoCommitsShySection_Compare" AutomationProperties.Name="Compare commits" Content="Compare" Style="{StaticResource AppContentSizedSegmentedItemStyle}" />
                                        </app:AppSegmented>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        labs:TransitionHelper.Id="CommitDetailActions"
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource AppGap6}">
                                        <Button
                                            x:Uid="PagesRepoCommitsPageRepoCommitsCopyShaButton"
                                            Width="{ThemeResource AppDimension34}"
                                            Height="{ThemeResource AppDimension34}"
                                            Padding="{ThemeResource AppPadding0}"
                                            AutomationProperties.AutomationId="RepoCommitsShyCopyShaButton"
                                            AutomationProperties.Name="Copy commit SHA"
                                            Click="CopyShaButton_Click"
                                            Style="{StaticResource AppToolbarButtonStyle}"
                                            ToolTipService.ToolTip="Copy SHA">
                                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8C8;" />
                                        </Button>
                                        <DropDownButton
                                            x:Uid="PagesRepoCommitsPageRepoCommitsShyOverflowButton"
                                            x:Name="CommitDetailShyOverflowButton"
                                            Width="{ThemeResource AppDimension34}"
                                            Height="{ThemeResource AppDimension34}"
                                            Padding="{ThemeResource AppPadding0}"
                                            AutomationProperties.AutomationId="RepoCommitsShyOverflowButton"
                                            AutomationProperties.Name="More commit actions"
                                            Style="{StaticResource AppToolbarButtonStyle}"
                                            ToolTipService.ToolTip="More commit actions">
                                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE712;" />
                                             <DropDownButton.Flyout>
                                                 <MenuFlyout>
                                                     <MenuFlyoutItem
                                                         x:Uid="PagesRepoCommitsPageRepoCommitsShyDiffFilesAction"
                                                         AutomationProperties.AutomationId="RepoCommitsShyDiffFilesAction"
                                                         AutomationProperties.Name="Changed files"
                                                         Click="CommitDiffFilesButton_Click"
                                                         Text="Changed files"
                                                         Visibility="{x:Bind ViewModel.IsDiffSectionVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                     <MenuFlyoutItem
                                                         x:Uid="PagesRepoCommitsPageRepoCommitsShyDiffSearchAction"
                                                         AutomationProperties.AutomationId="RepoCommitsShyDiffSearchAction"
                                                         AutomationProperties.Name="Search commit diff"
                                                         Click="CompactCommitDiffSearchMenuItem_Click"
                                                         Text="Search diff"
                                                         Visibility="{x:Bind ViewModel.IsDiffSectionVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                     <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsDiffSectionVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                     <MenuFlyoutItem x:Uid="PagesRepoCommitsPageRepoCommitsShyMessageAction" AutomationProperties.AutomationId="RepoCommitsShyMessageAction" AutomationProperties.Name="Commit message" Click="CompactCommitMessageMenuItem_Click" Text="Commit message" />
                                                    <MenuFlyoutItem x:Uid="PagesRepoCommitsPageRepoCommitsShyBrowseAction" AutomationProperties.AutomationId="RepoCommitsShyBrowseAction" AutomationProperties.Name="Browse files" Click="OpenCodeButton_Click" Text="Browse files" />
                                                    <MenuFlyoutItem x:Uid="PagesRepoCommitsPageRepoCommitsShyInspectorAction" AutomationProperties.AutomationId="RepoCommitsShyInspectorAction" AutomationProperties.Name="Inspector" Click="OpenInspectorPaneButton_Click" Text="Inspector" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </app:AdaptiveWorkspace.PrimaryPane>

            <app:AdaptiveWorkspace.TrailingPane>
                <Border
                    x:Uid="PagesRepoCommitsPageRepoCommitsInspectorHost" AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="RepoCommitsInspectorHost"
                    AutomationProperties.Name="Commit inspector"
                    Padding="{ThemeResource AppPadding12_10_16_12}"
                    Style="{StaticResource RepoCommitsPanelStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="{ThemeResource AppGap14}">
                            <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="PagesRepoCommitsPageTextBlockInspector" FontFamily="{ThemeResource AppDisplayFontFamily}"
                                    FontSize="{ThemeResource AppFontSize21}"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="Inspector" />
                                <Button
                                    x:Uid="PagesRepoCommitsPageRepoCommitsCloseInspectorPaneButton" x:Name="RepoCommitsCloseInspectorPaneButton"
                                    Grid.Column="1"
                                    Width="{ThemeResource AppDimension36}"
                                    Height="{ThemeResource AppDimension36}"
                                    Padding="{ThemeResource AppPadding0}"
                                    AutomationProperties.AutomationId="RepoCommitsCloseInspectorPaneButton"
                                    AutomationProperties.Name="Close inspector"
                                    Click="CloseWorkspaceDrawerButton_Click"
                                    Style="{StaticResource AppToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Close inspector"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE9D2;" />
                                </Button>
                            </Grid>

                            <StackPanel Spacing="{ThemeResource AppGap6}">
                                <TextBlock x:Uid="PagesRepoCommitsPageTextBlockStats" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Stats" />
                                <TextBlock
                                    FontFamily="{ThemeResource AppMonoFontFamily}"
                                    FontSize="{ThemeResource AppFontSize12}"
                                    Foreground="{ThemeResource AppInkBrush}"
                                    Text="{x:Bind ViewModel.SelectedCommitStatsText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="{ThemeResource AppGap6}">
                                <TextBlock x:Uid="PagesRepoCommitsPageTextBlockSignature" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Signature" />
                                <TextBlock
                                    FontFamily="{ThemeResource AppUiFontFamily}"
                                    FontSize="{ThemeResource AppFontSize12}"
                                    Foreground="{ThemeResource AppAccentBrush}"
                                    Text="{x:Bind ViewModel.SelectedCommitVerificationText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="{ThemeResource AppGap6}">
                                <TextBlock x:Uid="PagesRepoCommitsPageTextBlockParents" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="Parents" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ParentCommits, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="github:GitHubCommitParent">
                                            <TextBlock
                                                Margin="{ThemeResource AppMargin0_0_0_6}"
                                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                                FontSize="{ThemeResource AppFontSize12}"
                                                Foreground="{ThemeResource AppAccentBrush}"
                                                Text="{x:Bind ShortSha}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="{ThemeResource AppGap6}">
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.AssociatedPullRequestsText, Mode=OneWay}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource AssociatedPullRequestTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AssociatedPullRequests, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="{ThemeResource AppGap6}">
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCommitCommentsText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.CheckSummaryText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </app:AdaptiveWorkspace.TrailingPane>
        </app:AdaptiveWorkspace>
    </Grid>
</Page>
