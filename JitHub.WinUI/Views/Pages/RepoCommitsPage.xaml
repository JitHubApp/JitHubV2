                                        <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{ThemeResource AppGap4}">
                                                <TextBlock
                                                    x:Uid="PagesRepoCommitsPageTextBlockCompareBase"
                                                    Style="{StaticResource AppInlineMetadataTextBlockStyle}"
                                                    Text="Base" />
                                                <TextBox
                                                    x:Uid="PagesRepoCommitsPageRepoCommitsCompareBaseBox"
                                                    AutomationProperties.AutomationId="RepoCommitsCompareBaseBox"
                                                    AutomationProperties.Name="Compare base reference"
                                                    IsEnabled="{x:Bind ViewModel.IsCompareInputEnabled, Mode=OneWay}"
                                                    KeyDown="CompareRefBox_KeyDown"
                                                    PlaceholderText="Base ref"
                                                    Style="{StaticResource AppCommandTextBoxStyle}"
                                                    Text="{x:Bind ViewModel.CompareBaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="PagesRepoCommitsPageRepoCommitsCompareSwapButton"
