<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JitHub.WinUI.Views.Pages.RepoCommitsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:JitHub.WinUI.Views.Controls.App"
    xmlns:commit="using:JitHub.WinUI.Views.Controls.Commit"
    xmlns:common="using:JitHub.WinUI.Views.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:github="using:JitHub.Models.GitHub"
    xmlns:labs="using:CommunityToolkit.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:JitHub.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:JitHub.WinUI.ViewModels.Pages"
    x:DataType="viewmodels:RepoCommitsPageViewModel"
    Background="{ThemeResource AppTransparentBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="RepoCommitsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairlineBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource AppHairlineBorderThickness}" />
            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
        </Style>

        <DataTemplate x:Key="RepoCommitSectionLabelTemplate" x:DataType="x:String">
            <TextBlock
                AutomationProperties.AccessibilityView="Raw"
                MaxLines="2"
                Text="{x:Bind Mode=OneTime}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </DataTemplate>

        <DataTemplate x:Key="RepoCommitListItemTemplate" x:DataType="github:GitHubCommit">
            <Grid
                MinHeight="{ThemeResource AppDimension48}"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind AutomationName}"
                RowSpacing="{ThemeResource AppGap5}"
                PointerEntered="CommitListItem_PointerEntered">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontFamily="{ThemeResource AppUiFontFamily}"
                    FontSize="{ThemeResource AppFontSize13}"
                    FontWeight="{ThemeResource AppFontWeightSemibold}"
                    Foreground="{ThemeResource AppInkBrush}"
                    MaxLines="2"
                    Text="{x:Bind SummaryMessage}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <Grid Grid.Row="1" ColumnSpacing="{ThemeResource AppGap8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <common:Avatar
                        HorizontalAlignment="Left"
                        AutomationInstanceId="{x:Bind ShortSha}"
                        ContainerCornerRadius="{ThemeResource AppRadiusSmall}"
                        DisplayName="{x:Bind AuthorDisplayName}"
                        Login="{x:Bind AuthorProfileLogin}"
                        NavigationSource="commit_list_author"
                        ShowLogin="False"
                        Size="SMALL"
                        VerticalAlignment="Center"
                        Url="{x:Bind AuthorAvatarUrl}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                        TextTrimming="CharacterEllipsis">
                        <Run
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Text="{x:Bind ShortSha}" />
                        <Run Text="  " />
                        <Run
                            FontFamily="{ThemeResource AppUiFontFamily}"
                            FontWeight="{ThemeResource AppFontWeightSemibold}"
                            Foreground="{ThemeResource AppInkBrush}"
                            Text="{x:Bind AuthorDisplayName}" />
                        <Run Text="  ·  " />
                        <Run Text="{x:Bind AuthorDate, Mode=OneWay, Converter={StaticResource TimeAgoConverter}}" />
                        <Run Text="  ·  " />
                        <Run Text="{x:Bind Stats.SummaryText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CommitDiffTreeNodeTemplate" x:DataType="services:CommitDiffTreeNode">
            <TreeViewItem
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                ItemsSource="{x:Bind Children, Mode=OneWay}">
                <Grid MinHeight="{ThemeResource AppDimension32}" ColumnSpacing="{ThemeResource AppGap8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{ThemeResource AppGridLength20}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeFluentIcons}"
                        FontSize="{ThemeResource AppFontSize13}"
                        Foreground="{ThemeResource AppInkMutedBrush}"
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="{ThemeResource AppFontSize12}"
                        Foreground="{ThemeResource AppInkBrush}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="{ThemeResource AppFontSize10}"
                        Foreground="{ThemeResource AppInkMutedBrush}"
                        Text="{x:Bind SummaryText, Mode=OneWay}"
                        Visibility="{x:Bind HasSummary, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="CommitCommentTemplate" x:DataType="github:GitHubCommitComment">
            <Border
                Margin="{ThemeResource AppMargin0_0_0_12}"
                Padding="{ThemeResource AppPadding14}"
                Background="{ThemeResource AppCanvasInsetBrush}"
                BorderBrush="{ThemeResource AppHairlineBrush}"
                BorderThickness="{ThemeResource AppHairlineBorderThickness}"
                CornerRadius="{ThemeResource AppRadiusSmall}">
                <Grid RowSpacing="{ThemeResource AppGap12}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="{ThemeResource AppGap10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{ThemeResource AppGridLength32}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <common:Avatar
                            VerticalAlignment="Center"
                            AutomationInstanceId="{x:Bind AvatarAutomationId}"
                            ContainerCornerRadius="{ThemeResource AppRadiusSmall}"
                            DisplayName="{x:Bind AuthorDisplayName}"
                            Login="{x:Bind AuthorProfileLogin}"
                            NavigationSource="commit_comment"
                            ShowLogin="False"
                            Size="SMALL"
                            Url="{x:Bind AuthorAvatarUrl}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource AppUiFontFamily}"
                            FontSize="{ThemeResource AppFontSize13}"
                            FontWeight="{ThemeResource AppFontWeightSemibold}"
                            Foreground="{ThemeResource AppInkBrush}"
                            Text="{x:Bind AuthorDisplayName}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionSecondaryTextBlockStyle}"
                            Text="{x:Bind CreatedAt, Converter={StaticResource TimeAgoConverter}}" />
                    </Grid>
                    <common:MarkdownViewer
                        HostKind="Comment"
                        AutomationInstanceId="{x:Bind MarkdownAutomationId}"
                        Grid.Row="1"
                        BaseUrl="https://github.com/"
                        DocumentSource="{x:Bind MarkdownSource}"
                        Text="{x:Bind Body}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommitCheckRunTemplate" x:DataType="github:GitHubCheckRun">
            <Grid
                MinHeight="{ThemeResource AppDimension36}"
                Margin="{ThemeResource AppMargin0_0_0_8}"
                ColumnSpacing="{ThemeResource AppGap10}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{ThemeResource AppGridLength24}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SegoeFluentIcons}"
                    FontSize="{ThemeResource AppFontSize14}"
                    Foreground="{ThemeResource AppSuccessBrush}"
                    Glyph="&#xE930;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{ThemeResource AppGap2}">
                    <TextBlock
                        FontFamily="{ThemeResource AppUiFontFamily}"
                        FontSize="{ThemeResource AppFontSize13}"
                        Foreground="{ThemeResource AppInkBrush}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource SectionSecondaryTextBlockStyle}"
                        Text="{x:Bind App.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource AppUiFontFamily}"
                    FontSize="{ThemeResource AppFontSize11}"
                    Foreground="{ThemeResource AppAccentBrush}"
                    Text="{x:Bind Conclusion}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssociatedPullRequestTemplate" x:DataType="github:GitHubPullRequest">
            <Grid
                MinHeight="{ThemeResource AppDimension34}"
                Margin="{ThemeResource AppMargin0_0_0_8}"
                ColumnSpacing="{ThemeResource AppGap8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    FontSize="{ThemeResource AppFontSize11}"
                    Foreground="{ThemeResource AppAccentBrush}"
                    Text="{x:Bind Number}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource SectionSecondaryTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Uid="PagesRepoCommitsPageRepoCommitsPageRoot" x:Name="PerformanceRoot"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="RepoCommitsPageRoot"
        AutomationProperties.Name="Repository commits"
        Padding="{ThemeResource AppPagePadding}">
        <app:AdaptiveWorkspace
            x:Name="CommitsWorkspace"
            AutomationProperties.AutomationId="RepoCommitsAdaptiveWorkspace"
            AutomationIdPrefix="RepoCommits"
            LeadingPaneLabel="Commits"
            LeadingPaneWidth="320"
            MediumBreakpoint="880"
            ModeChanged="CommitsWorkspace_ModeChanged"
            NarrowBreakpoint="620"
            ShowPaneButtons="False"
            TrailingPaneLabel="Inspector"
            TrailingPaneWidth="240"
            WideBreakpoint="1000">
            <app:AdaptiveWorkspace.LeadingPane>
                <Border
                    AutomationProperties.AutomationId="RepoCommitsListHost"
                    Padding="{ThemeResource AppPadding10}"
                    Style="{StaticResource RepoCommitsPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="CommitListRailLayout"
                            RowSpacing="{ThemeResource AppGap10}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="CommitListExpandedHeaderSurface"
                                Padding="{ThemeResource AppPadding0}"
                                labs:TransitionHelper.Id="CommitListHeaderChrome">
                                <Grid ColumnSpacing="{ThemeResource AppGap8}" Style="{StaticResource AppWorkspaceHeaderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{ThemeResource AppGridLength96}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Uid="PagesRepoCommitsPageRepoCommitsCloseListPaneButton"
                                        x:Name="RepoCommitsCloseListPaneButton"
                                        Width="{ThemeResource AppDimension36}"
                                        Height="{ThemeResource AppDimension36}"
                                        Padding="{ThemeResource AppPadding0}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="RepoCommitsCloseListPaneButton"
                                        AutomationProperties.Name="Close commit list"
                                        Click="CloseWorkspaceDrawerButton_Click"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Close commits"
                                        Visibility="Collapsed">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE8FD;" />
                                    </Button>
                                    <TextBlock
                                        x:Uid="PagesRepoCommitsPageTextBlockCommits"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        labs:TransitionHelper.Id="CommitListHeaderTitle"
                                        FontFamily="{ThemeResource AppDisplayFontFamily}"
                                        FontSize="{ThemeResource AppFontSize16}"
                                        Foreground="{ThemeResource AppInkBrush}"
                                        MaxLines="1"
                                        Text="Commits"
                                        TextTrimming="CharacterEllipsis" />
                                     <ComboBox
                                         x:Uid="PagesRepoCommitsPageRepoCommitsBranchComboBox"
                                         x:Name="BranchComboBox"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         labs:TransitionHelper.Id="CommitListHeaderBranch"
                                         AutomationProperties.AutomationId="RepoCommitsBranchComboBox"
                                        AutomationProperties.Name="Commit branch"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{x:Bind ViewModel.Branches, Mode=OneWay}"
                                        PlaceholderText="Branch"
                                        SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}"
                                        SelectionChanged="BranchComboBox_SelectionChanged"
                                        Style="{StaticResource AppCompactComboBoxStyle}" />
                                    <Button
                                        x:Uid="PagesRepoCommitsPageRepoCommitsSearchButton"
                                        x:Name="CommitSearchButton"
                                        Grid.Column="3"
                                        Width="{ThemeResource AppDimension36}"
                                        Height="{ThemeResource AppDimension36}"
                                        Padding="{ThemeResource AppPadding0}"
                                        VerticalAlignment="Center"
                                        labs:TransitionHelper.Id="CommitListHeaderSearch"
                                        AutomationProperties.AutomationId="RepoCommitsSearchButton"
                                        AutomationProperties.Name="Search commit messages"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Search commits">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE721;" />
                                        <Button.Flyout>
                                             <Flyout
                                                 x:Name="CommitSearchFlyout"
                                                 Closed="CommitSearchFlyout_Closed"
                                                 Opened="CommitSearchFlyout_Opened"
                                                 Placement="BottomEdgeAlignedRight">
                                                 <StackPanel Width="{ThemeResource AppDimension280}" Spacing="{ThemeResource AppGap6}">
                                                     <TextBlock
                                                         x:Uid="PagesRepoCommitsPageTextBlockSearchCommitMessages"
                                                         Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                         Text="Search commit messages" />
                                                     <TextBox
                                                         x:Uid="PagesRepoCommitsPageRepoCommitsSearchBox"
                                                         x:Name="CommitSearchBox"
                                                         AutomationProperties.AutomationId="RepoCommitsSearchBox"
                                                         AutomationProperties.Name="Search commit messages"
                                                         PlaceholderText="Search messages..."
                                                         Style="{StaticResource AppCommandSearchTextBoxStyle}"
                                                         TextChanged="CommitFilterBox_TextChanged" />
                                                 </StackPanel>
                                             </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button
                                        x:Uid="PagesRepoCommitsPageRepoCommitsFilterButton"
                                        x:Name="CommitFiltersButton"
                                        Grid.Column="4"
                                        Width="{ThemeResource AppDimension36}"
                                        Height="{ThemeResource AppDimension36}"
                                        Padding="{ThemeResource AppPadding0}"
                                        VerticalAlignment="Center"
                                        labs:TransitionHelper.Id="CommitListHeaderFilters"
                                        AutomationProperties.AutomationId="RepoCommitsFilterButton"
                                        AutomationProperties.Name="Commit filters"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Filters">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE71C;" />
                                        <Button.Flyout>
                                            <Flyout x:Name="CommitFiltersFlyout" Opened="CommitFiltersFlyout_Opened" Placement="BottomEdgeAlignedRight">
                                                <StackPanel Width="{ThemeResource AppDimension280}" Spacing="{ThemeResource AppGap10}">
                                                    <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="PagesRepoCommitsPageTextBlockCommitFilters" VerticalAlignment="Center" Style="{StaticResource ListItemTitleTextBlockStyle}" Text="Commit filters" />
                                                        <Button
                                                            x:Uid="PagesRepoCommitsPageRepoCommitsClearFiltersButton"
                                                            Grid.Column="1"
                                                            MinHeight="{ThemeResource AppDimension32}"
                                                            AutomationProperties.AutomationId="RepoCommitsClearFiltersButton"
                                                            AutomationProperties.Name="Clear commit filters"
                                                            Click="ClearCommitFiltersButton_Click"
                                                            Content="Clear"
                                                            Style="{StaticResource AppQuietButtonStyle}" />
                                                    </Grid>
                                                    <TextBox
                                                        x:Uid="PagesRepoCommitsPageRepoCommitsPathFilterBox"
                                                        x:Name="PathFilterBox"
                                                        Header="Path"
                                                        AutomationProperties.AutomationId="RepoCommitsPathFilterBox"
                                                        AutomationProperties.Name="Filter commits by path"
                                                        PlaceholderText="src/components"
                                                        Style="{StaticResource AppCommandTextBoxStyle}"
                                                        TextChanged="CommitFilterBox_TextChanged" />
                                                    <TextBox
                                                        x:Uid="PagesRepoCommitsPageRepoCommitsAuthorFilterBox"
                                                        x:Name="AuthorFilterBox"
                                                        Header="Author"
                                                        AutomationProperties.AutomationId="RepoCommitsAuthorFilterBox"
                                                        AutomationProperties.Name="Filter commits by author"
                                                        PlaceholderText="Login or email"
                                                        Style="{StaticResource AppCommandTextBoxStyle}"
                                                        TextChanged="CommitFilterBox_TextChanged" />
                                                    <Grid ColumnSpacing="{ThemeResource AppGap8}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CalendarDatePicker
                                                            x:Uid="PagesRepoCommitsPageRepoCommitsSinceFilterPicker"
                                                            x:Name="SinceFilterPicker"
                                                            Header="From"
                                                            AutomationProperties.AutomationId="RepoCommitsSinceFilterPicker"
                                                            AutomationProperties.Name="Commits since date"
                                                            Date="{x:Bind ViewModel.SinceFilterDate, Mode=TwoWay}"
                                                            DateChanged="CommitDateFilter_DateChanged"
                                                            PlaceholderText="Start date"
                                                            Style="{StaticResource AppCompactCalendarDatePickerStyle}" />
                                                        <CalendarDatePicker
                                                            x:Uid="PagesRepoCommitsPageRepoCommitsUntilFilterPicker"
                                                            x:Name="UntilFilterPicker"
                                                            Grid.Column="1"
                                                            Header="To"
                                                            AutomationProperties.AutomationId="RepoCommitsUntilFilterPicker"
                                                            AutomationProperties.Name="Commits until date"
                                                            Date="{x:Bind ViewModel.UntilFilterDate, Mode=TwoWay}"
                                                            DateChanged="CommitDateFilter_DateChanged"
                                                            PlaceholderText="End date"
                                                            Style="{StaticResource AppCompactCalendarDatePickerStyle}" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap6}">
                                                        <Button
                                                            x:Uid="PagesRepoCommitsPageRepoCommitsSinceFilterChip"
                                                            MinHeight="{ThemeResource AppDimension26}"
                                                            Padding="{ThemeResource AppPadding8_3}"
                                                            AutomationProperties.AutomationId="RepoCommitsSinceFilterChip"
                                                            AutomationProperties.Name="{x:Bind ViewModel.SinceFilterLabel, Mode=OneWay}"
                                                            Click="ClearSinceFilterButton_Click"
                                                            Style="{StaticResource AppQuietButtonStyle}"
                                                            ToolTipService.ToolTip="Clear since date filter"
                                                            Visibility="{x:Bind ViewModel.HasSinceFilter, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap6}">
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SinceFilterLabel, Mode=OneWay}" />
                                                                <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize10}" Glyph="&#xE711;" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            x:Uid="PagesRepoCommitsPageRepoCommitsUntilFilterChip"
                                                            MinHeight="{ThemeResource AppDimension26}"
                                                            Padding="{ThemeResource AppPadding8_3}"
                                                            AutomationProperties.AutomationId="RepoCommitsUntilFilterChip"
                                                            AutomationProperties.Name="{x:Bind ViewModel.UntilFilterLabel, Mode=OneWay}"
                                                            Click="ClearUntilFilterButton_Click"
                                                            Style="{StaticResource AppQuietButtonStyle}"
                                                            ToolTipService.ToolTip="Clear until date filter"
                                                            Visibility="{x:Bind ViewModel.HasUntilFilter, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppGap6}">
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.UntilFilterLabel, Mode=OneWay}" />
                                                                <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize10}" Glyph="&#xE711;" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid
                                x:Name="CommitListHost"
                                Grid.Row="1">
                                <StackPanel
                                    Style="{StaticResource AppEmptyStatePanelStyle}"
                                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock x:Uid="PagesRepoCommitsPageTextBlockNoCommitsMatchThisView" Style="{StaticResource SectionSecondaryTextBlockStyle}" Text="No commits match this view." />
                                </StackPanel>
                                <ListView
                                    x:Uid="PagesRepoCommitsPageRepoCommitsList"
                                    x:Name="CommitsList"
                                    AutomationProperties.AutomationId="RepoCommitsList"
                                    AutomationProperties.Name="Commit history"
                                    Background="{ThemeResource AppTransparentBrush}"
                                    BorderThickness="{ThemeResource AppZeroThickness}"
                                    ContainerContentChanging="CommitsList_ContainerContentChanging"
                                    IsItemClickEnabled="True"
                                    ItemClick="CommitsList_ItemClick"
                                    ItemContainerStyle="{StaticResource AppWorkspaceCardListRowStyle}"
                                    ItemTemplate="{StaticResource RepoCommitListItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}"
                                    Loaded="CommitsList_Loaded"
                                    SelectedItem="{x:Bind ViewModel.SelectedCommit, Mode=OneWay}"
                                    SelectionChanged="CommitsList_SelectionChanged"
                                    SelectionMode="Single" />
                            </Grid>
                            <Grid
                                x:Name="CommitListShyHeaderSurface"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="RepoCommitsListShyHeader"
                                Canvas.ZIndex="10"
                                Visibility="Collapsed">
                                <Border
                                    labs:TransitionHelper.Id="CommitListHeaderChrome"
                                    Background="{ThemeResource AppTransientOverlayBrush}"
                                    BorderBrush="{ThemeResource AppHairlineBrush}"
                                    BorderThickness="{ThemeResource AppBottomHairlineBorderThickness}"
                                    IsHitTestVisible="False" />
                                  <Grid Padding="{ThemeResource AppPadding8_6}" ColumnSpacing="{ThemeResource AppGap8}">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="Auto" />
                                          <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock
                                          x:Uid="PagesRepoCommitsPageTextBlockCommits"
                                          VerticalAlignment="Center"
                                          labs:TransitionHelper.Id="CommitListHeaderTitle"
                                          FontFamily="{ThemeResource AppDisplayFontFamily}"
                                          FontSize="{ThemeResource AppFontSize16}"
                                          Foreground="{ThemeResource AppInkBrush}"
                                          MaxLines="1"
                                          Text="Commits"
                                          TextTrimming="CharacterEllipsis" />
                                      <TextBlock
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          labs:TransitionHelper.Id="CommitListHeaderBranch"
                                          FontFamily="{ThemeResource AppDisplayFontFamily}"
                                          FontSize="{ThemeResource AppFontSize16}"
                                          Foreground="{ThemeResource AppInkMutedBrush}"
                                          MaxLines="1"
                                          Text="{x:Bind ViewModel.SelectedBranchName, Mode=OneWay}"
                                          TextTrimming="CharacterEllipsis" />
                                      <Button
                                          x:Uid="PagesRepoCommitsPageRepoCommitsSearchButton"
                                          Grid.Column="2"
                                         Width="{ThemeResource AppDimension34}"
                                         Height="{ThemeResource AppDimension34}"
                                         Padding="{ThemeResource AppPadding0}"
                                         VerticalAlignment="Center"
                                         labs:TransitionHelper.Id="CommitListHeaderSearch"
                                         AutomationProperties.AutomationId="RepoCommitsCompactSearchButton"
                                         AutomationProperties.Name="Search commit messages"
                                         Click="CompactCommitSearchButton_Click"
                                         Style="{StaticResource AppToolbarButtonStyle}"
                                         ToolTipService.ToolTip="Search commits">
                                         <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE721;" />
                                     </Button>
                                      <Button
                                          x:Uid="PagesRepoCommitsPageRepoCommitsFilterButton"
                                          Grid.Column="3"
                                         Width="{ThemeResource AppDimension34}"
                                         Height="{ThemeResource AppDimension34}"
                                         Padding="{ThemeResource AppPadding0}"
                                         VerticalAlignment="Center"
                                         labs:TransitionHelper.Id="CommitListHeaderFilters"
                                        AutomationProperties.AutomationId="RepoCommitsCompactFilterButton"
                                        AutomationProperties.Name="Commit filters"
                                        Click="CompactCommitFiltersButton_Click"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Filters">
                                         <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE71C;" />
                                     </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                        <InfoBar
                            x:Uid="PagesRepoCommitsPageRepoCommitsScopeNotice" Grid.Row="1"
                            AutomationProperties.AutomationId="RepoCommitsScopeNotice"
                            AutomationProperties.Name="Commit result scope"
                            IsClosable="False"
