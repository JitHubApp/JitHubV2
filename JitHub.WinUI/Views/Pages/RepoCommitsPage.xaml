                                                Width="{ThemeResource AppCommandControlHeight}"
                                                Height="{ThemeResource AppCommandControlHeight}"
                                                Padding="{ThemeResource AppPadding0}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.AutomationId="RepoCommitsCompareSearchButton"
                                                AutomationProperties.Name="Search compare diff"
                                                IsEnabled="{x:Bind ViewModel.IsCompareDiffVisible, Mode=OneWay}"
                                                Style="{StaticResource AppToolbarButtonStyle}"
                                                ToolTipService.ToolTip="Search compare diff">
                                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize14}" Glyph="&#xE721;" />
                                                <Button.Flyout>
                                                    <Flyout
                                                        x:Name="CommitCompareSearchFlyout"
                                                        Closed="CommitCompareSearchFlyout_Closed"
                                                        Opened="CommitCompareSearchFlyout_Opened"
                                                        Placement="BottomEdgeAlignedRight">
                                                        <Grid Width="{ThemeResource AppDimension360}" RowSpacing="{ThemeResource AppGap6}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                x:Uid="PagesRepoCommitsPageTextBlockSearchCompareDiff"
                                                                Style="{StaticResource ListItemTitleTextBlockStyle}"
                                                                Text="Search comparison" />
                                                            <TextBox
                                                                x:Uid="PagesRepoCommitsPageRepoCommitsCompareDiffSearchBox"
                                                                x:Name="RepoCommitsCompareDiffSearchBox"
                                                                Grid.Row="1"
                                                                AutomationProperties.AutomationId="RepoCommitsCompareDiffSearchBox"
                                                                AutomationProperties.Name="Search compare diff"
                                                                PlaceholderText="Search diff..."
                                                                Style="{StaticResource AppCommandSearchTextBoxStyle}"
                                                                Text="{x:Bind ViewModel.DiffSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                TextChanged="DiffSearchBox_TextChanged" />
                                                            <Grid Grid.Row="2" ColumnSpacing="{ThemeResource AppGap6}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    MinWidth="{ThemeResource AppDimension72}"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource AppInlineMetadataTextBlockStyle}"
                                                                    Text="{x:Bind ViewModel.DiffSearchMatchCountText, Mode=OneWay}"
                                                                    TextAlignment="Right" />
                                                                <Button
                                                                    x:Uid="PagesRepoCommitsPageRepoCommitsComparePreviousDiffMatchB"
                                                                    Grid.Column="1"
                                                                    Width="{ThemeResource AppDimension34}"
                                                                    Height="{ThemeResource AppDimension34}"
                                                                    Padding="{ThemeResource AppPadding0}"
                                                                    AutomationProperties.AutomationId="RepoCommitsComparePreviousDiffMatchButton"
                                                                    AutomationProperties.Name="Previous compare diff search match"
                                                                    Command="{x:Bind ViewModel.PreviousDiffMatchCommand}"
                                                                    Style="{StaticResource AppToolbarButtonStyle}"
                                                                    Tag="previous"
                                                                    ToolTipService.ToolTip="Previous match">
                                                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize12}" Glyph="&#xE70E;" />
                                                                </Button>
                                                                <Button
                                                                    x:Uid="PagesRepoCommitsPageRepoCommitsCompareNextDiffMatchButto"
                                                                    Grid.Column="2"
                                                                    Width="{ThemeResource AppDimension34}"
                                                                    Height="{ThemeResource AppDimension34}"
                                                                    Padding="{ThemeResource AppPadding0}"
                                                                    AutomationProperties.AutomationId="RepoCommitsCompareNextDiffMatchButton"
                                                                    AutomationProperties.Name="Next compare diff search match"
                                                                    Command="{x:Bind ViewModel.NextDiffMatchCommand}"
                                                                    Style="{StaticResource AppToolbarButtonStyle}"
                                                                    Tag="next"
                                                                    ToolTipService.ToolTip="Next match">
                                                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" FontSize="{ThemeResource AppFontSize12}" Glyph="&#xE70D;" />
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="RepoCommitsCompareSummary"
                                        Style="{StaticResource AppInlineMetadataTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CompareSummaryText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.HasCompareSummary, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
