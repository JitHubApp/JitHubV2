                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="{ThemeResource AppGap12}">
                                        <TextBlock
                                            FontFamily="{ThemeResource AppDisplayFontFamily}"
                                            FontSize="{ThemeResource AppFontSize22}"
                                            Foreground="{ThemeResource AppInkBrush}"
                                            Text="{x:Bind ViewModel.CheckSummaryText, Mode=OneWay}" />
                                        <ItemsControl
                                            ItemTemplate="{StaticResource CommitCheckRunTemplate}"
                                            ItemsSource="{x:Bind ViewModel.CheckRuns, Mode=OneWay}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid
                                    x:Name="CommitCompareSection"
