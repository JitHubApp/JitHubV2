            <StaticResource x:Key="MarkdownRenderer.CodeInline.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlock.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlockGutter.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlockLineNumber.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.Diagram.FontFamily" ResourceKey="AppMonoFontFamily" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="MarkdownRenderer.CodeInline.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlock.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlockGutter.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlockLineNumber.FontFamily" ResourceKey="AppMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.Diagram.FontFamily" ResourceKey="AppMonoFontFamily" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MarkdownRenderer.CodeInline.FontFamily" ResourceKey="AppHighContrastMonoFontFamily" />
            <StaticResource x:Key="MarkdownRenderer.CodeBlock.FontFamily" ResourceKey="AppHighContrastMonoFontFamily" />
