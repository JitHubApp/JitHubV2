<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{ThemeResource AppUiFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{ThemeResource AppPadding0}" />
        <Setter Property="Margin" Value="{ThemeResource AppMargin0_0_0_8}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
    </Style>
    <Style TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
        <Setter Property="Background" Value="{ThemeResource AppCanvasInsetBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
    </Style>

    <Style TargetType="PersonPicture" BasedOn="{StaticResource DefaultPersonPictureStyle}">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
    </Style>
</ResourceDictionary>
