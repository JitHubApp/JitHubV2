<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CalendarDatePicker" TargetType="CalendarDatePicker" BasedOn="{StaticResource DefaultCalendarDatePicker}">
        <Setter Property="FontFamily" Value="{ThemeResource AppUiFontFamily}" />
        <Setter Property="Background" Value="{ThemeResource AppInputBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInkBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppOutlineBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppHairlineBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusMedium}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppDimension36}" />
    </Style>
    <Style TargetType="CalendarDatePicker" BasedOn="{StaticResource CalendarDatePicker}" />
</ResourceDictionary>
