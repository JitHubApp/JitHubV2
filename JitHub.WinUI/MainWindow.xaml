<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="JitHub.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JitHub.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="JitHub"
    mc:Ignorable="d">
    <Grid
        x:Name="RootLayout"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="JitHubMainWindowRoot"
        AutomationProperties.Name="JitHub application window"
        Background="{ThemeResource AppWindowBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Border
            x:Name="AppTitleBar"
            Height="{ThemeResource AppDimension40}"
            VerticalAlignment="Top"
        Background="{ThemeResource AppTransparentBrush}" />
        <Grid
            Width="{ThemeResource AppDimension0}"
            Height="{ThemeResource AppDimension0}"
            IsHitTestVisible="False"
            Opacity="{ThemeResource AppOpacityTransparent}"
            AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="TitleBarForegroundTokenProbe" Background="{ThemeResource AppInkBrush}" />
            <Border x:Name="TitleBarInactiveForegroundTokenProbe" Background="{ThemeResource AppInkMutedBrush}" />
            <Border x:Name="TitleBarHoverForegroundTokenProbe" Background="{ThemeResource AppRowHoverForegroundBrush}" />
            <Border x:Name="TitleBarPressedForegroundTokenProbe" Background="{ThemeResource AppRowPressedForegroundBrush}" />
            <Border x:Name="TitleBarHoverBackgroundTokenProbe" Background="{ThemeResource AppRowHoverBrush}" />
            <Border x:Name="TitleBarPressedBackgroundTokenProbe" Background="{ThemeResource AppRowPressedBrush}" />
            <Border x:Name="TitleBarTransparentTokenProbe" Background="{ThemeResource AppTransparentBrush}" />
        </Grid>
        <Frame
            x:Name="ContentFrame"
            AutomationProperties.AutomationId="MainContentFrame"
            AutomationProperties.AccessibilityView="Control" />
        <Grid
            x:Name="ContentDialogHost"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            IsHitTestVisible="False"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Button
                x:Name="DialogFocusSentinel"
                Width="{ThemeResource AppDimension1}"
                Height="{ThemeResource AppDimension1}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False"
                Opacity="{ThemeResource AppOpacityTransparent}" />
        </Grid>
        <Border
            x:Name="ActivationStatusHost"
            AutomationProperties.AutomationId="AppStatusHost"
            AutomationProperties.Name="Application status"
            Margin="{ThemeResource AppMargin12}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="{ThemeResource AppHairlineBorderThickness}"
            CornerRadius="{ThemeResource AppRadiusMedium}"
            Padding="{ThemeResource AppPadding10}"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ActivationStatusText"
                AutomationProperties.AutomationId="AppStatusText"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource AppInkBrush}"
                Text="Waiting for activation."
                TextWrapping="WrapWholeWords" />
        </Border>
    </Grid>
</Window>
