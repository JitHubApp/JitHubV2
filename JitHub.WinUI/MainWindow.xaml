<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="JitHub.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JitHub.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="JitHub"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootLayout"
        AutomationProperties.AccessibilityView="Control"
        AutomationProperties.AutomationId="JitHubMainWindowRoot"
        AutomationProperties.Name="JitHub application window"
        Background="{ThemeResource AppCanvasBrush}">
        <Border
            x:Name="AppTitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent" />
        <Frame
            x:Name="ContentFrame"
            AutomationProperties.AutomationId="MainContentFrame"
            AutomationProperties.AccessibilityView="Control" />
        <Grid
            x:Name="ContentDialogHost"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            IsHitTestVisible="False"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Button
                x:Name="DialogFocusSentinel"
                Width="1"
                Height="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False"
                Opacity="0" />
        </Grid>
        <Border
            x:Name="ActivationStatusHost"
            AutomationProperties.AutomationId="AppStatusHost"
            AutomationProperties.Name="Application status"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppOutlineBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppRadiusMedium}"
            Padding="10"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ActivationStatusText"
                AutomationProperties.AutomationId="AppStatusText"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource AppInkBrush}"
                Text="Waiting for activation."
                TextWrapping="WrapWholeWords" />
        </Border>
    </Grid>
</Window>
