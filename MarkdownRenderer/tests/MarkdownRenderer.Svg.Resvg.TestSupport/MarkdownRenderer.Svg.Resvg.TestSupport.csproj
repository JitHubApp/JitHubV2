<Project Sdk="Microsoft.NET.Sdk">
  <!-- Raster fixtures and pixel checks shared by the resvg unit tests and the
       resvg NativeAOT smoke. The package-only release-evidence consumer copies
       these same sources (eng/Invoke-SvgResvgReleaseEvidence.ps1). -->
  <PropertyGroup>
    <RootNamespace>MarkdownRenderer.Svg.Resvg.TestSupport</RootNamespace>
    <AssemblyName>MarkdownRenderer.Svg.Resvg.TestSupport</AssemblyName>
    <!-- Referenced by the multi-architecture resvg NativeAOT smoke, so it is
         architecture-neutral and analyzed like a shipping AOT library. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);$(MarkdownRendererTrimAndAotWarningsAsErrors)</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdownRenderer\MarkdownRenderer.csproj" />
  </ItemGroup>
</Project>
