<Project Sdk="Microsoft.NET.Sdk">
  <!-- Public-surface policy that PublicApiAnalyzers cannot express, checked
       with public reflection over every shipping assembly. Member signatures
       are tracked by each project's PublicAPI.*.txt files instead. -->
