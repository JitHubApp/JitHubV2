<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- x64 only. CI restores and publishes it with an explicit -r win-x64,
         so it keeps a single-RID lock graph instead of the multi-RID one. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supplies mt.exe for the Windows App SDK self-contained manifest step,
         so the executable builds outside a Developer PowerShell. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MarkdownRenderer.Mermaid\MarkdownRenderer.Mermaid.csproj" />
  </ItemGroup>
</Project>
