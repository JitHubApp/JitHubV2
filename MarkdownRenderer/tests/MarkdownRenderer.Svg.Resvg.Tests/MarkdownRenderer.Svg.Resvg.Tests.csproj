<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MarkdownRenderer.Svg.Resvg.Tests</RootNamespace>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == '' and '$(Platform)' == 'x86'">win-x86</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">win-arm64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == ''">win-x64</ResvgWorkerRid>
    <ResvgWorkerDirectory Condition="'$(ResvgWorkerDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\src\MarkdownRenderer.Svg.Resvg</ResvgWorkerDirectory>
    <UseWinUI>false</UseWinUI>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdownRenderer.Svg.Resvg\MarkdownRenderer.Svg.Resvg.csproj" />
    <ProjectReference Include="..\MarkdownRenderer.Svg.Resvg.TestSupport\MarkdownRenderer.Svg.Resvg.TestSupport.csproj" />
    <EmbeddedResource Include="..\..\src\MarkdownRenderer.Svg.Resvg\native\tests\fixtures\opaque-vp8-256.webp"
                      LogicalName="OpaqueVp8StreamingFixture" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(ResvgWorkerDirectory)\runtimes\$(ResvgWorkerRid)\native\MarkdownRenderer.Svg.Resvg.Worker.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>MarkdownRenderer.Svg.Resvg.Worker.exe</TargetPath>
      <Link>MarkdownRenderer.Svg.Resvg.Worker.exe</Link>
    </Content>
  </ItemGroup>

  <Target Name="ValidateResvgTestWorkerIdentity" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)..\..\src\MarkdownRenderer.Svg.Resvg\eng\Verify-ResvgWorkerIdentity.ps1&quot; -WorkerRoot &quot;$(ResvgWorkerDirectory)&quot; -Rid &quot;$(ResvgWorkerRid)&quot;" />
  </Target>
</Project>
