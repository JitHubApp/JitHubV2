<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MarkdownRenderer.Svg.Resvg.Tests</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == '' and '$(Platform)' == 'x86'">win-x86</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">win-arm64</ResvgWorkerRid>
    <ResvgWorkerRid Condition="'$(ResvgWorkerRid)' == ''">win-x64</ResvgWorkerRid>
    <ResvgWorkerDirectory Condition="'$(ResvgWorkerDirectory)' == ''">$(MSBuildThisFileDirectory)..\MarkdownRenderer.Svg.Resvg</ResvgWorkerDirectory>
    <UseWinUI>false</UseWinUI>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableMarkdownLayoutDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);MARKDOWN_LAYOUT_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(JitHubWindowsSdkBuildToolsVersion)" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer.Svg.Resvg\MarkdownRenderer.Svg.Resvg.csproj" />
    <Compile Include="..\MarkdownRenderer.Svg.Resvg.AotSmoke\SmokeRasterValidation.cs" Link="SmokeRasterValidation.cs" />
    <Compile Include="..\MarkdownRenderer.Svg.Resvg.AotSmoke\SmokeRasterDecodeFixture.cs" Link="SmokeRasterDecodeFixture.cs" />
    <EmbeddedResource Include="..\MarkdownRenderer.Svg.Resvg\native\tests\fixtures\opaque-vp8-256.webp"
                      LogicalName="OpaqueVp8StreamingFixture" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(ResvgWorkerDirectory)\runtimes\$(ResvgWorkerRid)\native\MarkdownRenderer.Svg.Resvg.Worker.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>MarkdownRenderer.Svg.Resvg.Worker.exe</TargetPath>
      <Link>MarkdownRenderer.Svg.Resvg.Worker.exe</Link>
    </Content>
  </ItemGroup>

  <Target Name="ValidateResvgTestWorkerIdentity" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)..\MarkdownRenderer.Svg.Resvg\eng\Verify-ResvgWorkerIdentity.ps1&quot; -WorkerRoot &quot;$(ResvgWorkerDirectory)&quot; -Rid &quot;$(ResvgWorkerRid)&quot;" />
  </Target>
</Project>
