<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MarkdownRenderer.Html</RootNamespace>
    <AssemblyName>MarkdownRenderer.Html</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>MarkdownRenderer.Html</PackageId>
    <Description>Budgeted native safe-HTML parsing and Win2D rendering for MarkdownRenderer, with no browser engine or executable content.</Description>
    <PackageTags>markdown;winui;html;security;windows</PackageTags>
    <MarkdownRendererPackageReadme>$(MSBuildProjectDirectory)\README.md</MarkdownRendererPackageReadme>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer\MarkdownRenderer.csproj" />
  </ItemGroup>
</Project>
