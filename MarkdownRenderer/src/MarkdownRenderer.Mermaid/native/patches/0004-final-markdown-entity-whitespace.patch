diff --git a/crates/merman-render/src/text/metrics.rs b/crates/merman-render/src/text/metrics.rs
index e572526d..f39bb66b 100644
--- a/crates/merman-render/src/text/metrics.rs
+++ b/crates/merman-render/src/text/metrics.rs
@@ -3348,3 +3348,137 @@ pub(crate) fn measure_wrapped_markdown_with_inline_styles(
         wrap_mode != WrapMode::HtmlLike,
     )
 }
+
+#[cfg(test)]
+mod final_markdown_entity_wrapping_tests {
+    use super::{
+        measure_wrapped_markdown_with_inline_styles,
+        mermaid_markdown_to_wrapped_final_svg_text_word_lines,
+    };
+    use crate::text::{
+        DeterministicTextMeasurer, MermaidMarkdownWordType, TextMeasurer, TextStyle, WrapMode,
+    };
+
+    fn word_lines(lines: &[Vec<crate::text::MermaidMarkdownWord>]) -> Vec<Vec<String>> {
+        lines
+            .iter()
+            .map(|line| line.iter().map(|word| word.text.clone()).collect())
+            .collect()
+    }
+
+    #[test]
+    fn entity_and_mixed_whitespace_wrap_at_decoded_word_boundaries() {
+        let measurer = DeterministicTextMeasurer::default();
+        let style = TextStyle::default();
+        let max_width = measurer
+            .measure_wrapped("foo", &style, None, WrapMode::SvgLike)
+            .width
+            .max(
+                measurer
+                    .measure_wrapped("bar", &style, None, WrapMode::SvgLike)
+                    .width,
+            )
+            + 0.25;
+
+        for source in ["foo bar", "foo&#32;bar", "foo &#32;bar"] {
+            let lines = mermaid_markdown_to_wrapped_final_svg_text_word_lines(
+                &measurer,
+                source,
+                &style,
+                Some(max_width),
+            );
+            assert_eq!(
+                word_lines(&lines),
+                vec![vec!["foo".to_string()], vec!["bar".to_string()]],
+                "{source:?}"
+            );
+            assert_eq!(
+                lines.iter().map(Vec::len).sum::<usize>(),
+                2,
+                "space remains one word boundary for {source:?}"
+            );
+            let metrics = measure_wrapped_markdown_with_inline_styles(
+                &measurer,
+                source,
+                &style,
+                Some(max_width),
+                WrapMode::SvgLike,
+            );
+            assert_eq!(metrics.line_count, 2, "{source:?}");
+        }
+    }
+
+    #[test]
+    fn entity_space_preserves_strong_and_cross_style_word_boundaries() {
+        let measurer = DeterministicTextMeasurer::default();
+        let style = TextStyle::default();
+        let strong_width = |source: &str| {
+            measure_wrapped_markdown_with_inline_styles(
+                &measurer,
+                source,
+                &style,
+                None,
+                WrapMode::SvgLike,
+            )
+            .width
+        };
+        let strong_width_limit = strong_width("**foo**").max(strong_width("**bar**")) + 0.25;
+        for source in ["**foo bar**", "**foo&#32;bar**"] {
+            let lines = mermaid_markdown_to_wrapped_final_svg_text_word_lines(
+                &measurer,
+                source,
+                &style,
+                Some(strong_width_limit),
+            );
+            assert_eq!(
+                word_lines(&lines),
+                vec![vec!["foo".to_string()], vec!["bar".to_string()]],
+                "{source:?}"
+            );
+            assert!(
+                lines
+                    .iter()
+                    .flatten()
+                    .all(|word| word.word_type == MermaidMarkdownWordType::Strong),
+                "{source:?}"
+            );
+            assert_eq!(
+                measure_wrapped_markdown_with_inline_styles(
+                    &measurer,
+                    source,
+                    &style,
+                    Some(strong_width_limit),
+                    WrapMode::SvgLike,
+                )
+                .line_count,
+                2,
+                "{source:?}"
+            );
+        }
+
+        let mixed_width_limit = strong_width("foo").max(strong_width("**bar**")) + 0.25;
+        let mixed = mermaid_markdown_to_wrapped_final_svg_text_word_lines(
+            &measurer,
+            "foo &#32;**bar**",
+            &style,
+            Some(mixed_width_limit),
+        );
+        assert_eq!(
+            word_lines(&mixed),
+            vec![vec!["foo".to_string()], vec!["bar".to_string()]]
+        );
+        assert_eq!(mixed[0][0].word_type, MermaidMarkdownWordType::Normal);
+        assert_eq!(mixed[1][0].word_type, MermaidMarkdownWordType::Strong);
+        assert_eq!(
+            measure_wrapped_markdown_with_inline_styles(
+                &measurer,
+                "foo &#32;**bar**",
+                &style,
+                Some(mixed_width_limit),
+                WrapMode::SvgLike,
+            )
+            .line_count,
+            2
+        );
+    }
+}
