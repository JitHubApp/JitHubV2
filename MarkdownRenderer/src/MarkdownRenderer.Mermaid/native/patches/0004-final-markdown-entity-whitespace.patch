+                                word_type: word.word_type,
+                                separator_before: pending_separator && !words.is_empty(),
+                            });
+                        }
+                        pending_separator = true;
+                    } else {
+                        text.push(character);
+                    }
+                }
+
+                if !text.is_empty() {
+                    words.push(MermaidMarkdownWord {
+                        text,
+                        word_type: word.word_type,
+                        separator_before: pending_separator && !words.is_empty(),
+                    });
+                    pending_separator = false;
+                }
+            }
