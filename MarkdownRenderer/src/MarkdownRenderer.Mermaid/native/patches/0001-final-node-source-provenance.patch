+        second_start + label_length,
+    )));
+    let third_start = source.find("third").expect("bare authored node id") as u32;
+    let third_marker = format!(
+        r#"data-mmir-node-id="third" data-mmir-source-start="{third_start}" data-mmir-source-end="{}""#,
+        third_start + "third".len() as u32,
+    );
+    let third_wrapper_start = svg
+        .find(&third_marker)
+        .expect("the bare final model node carries its exact identifier span");
+    let third_wrapper_end = svg[third_wrapper_start..]
+        .find('>')
+        .map(|offset| third_wrapper_start + offset)
+        .expect("node wrapper tag terminates");
+    let third_wrapper = &svg[third_wrapper_start..third_wrapper_end];
+    assert!(third_wrapper.contains(&third_marker));
+}
