+fn write_node_source_attrs(out: &mut String, node_id: &str, source_range: Option<(u32, u32)>) {
+    out.push_str(r#" data-mmir-node-id=""#);
+    // A node ID is an identity token, not label text: preserve Mermaid entity-looking sequences
+    // literally while escaping XML-sensitive characters for this quoted attribute.
+    escape_xml_raw_into(out, node_id);
+    out.push('"');
+    if let Some((source_start, source_end)) = source_range {
+        let _ = write!(
+            out,
+            r#" data-mmir-source-start="{source_start}" data-mmir-source-end="{source_end}""#
+        );
+    }
+}
