+    let marker = r#"data-mmir-node-id="A""#;
+    let wrapper_start = svg
+        .find(marker)
+        .expect("the final model node retains its canonical identity marker");
+    let wrapper_end = svg[wrapper_start..]
+        .find('>')
+        .map(|offset| wrapper_start + offset)
+        .expect("node wrapper tag terminates");
+    let wrapper = &svg[wrapper_start..wrapper_end];
+    assert!(!wrapper.contains("data-mmir-source-start"));
+    assert!(!wrapper.contains("data-mmir-source-end"));
+}
