+/// Finalizes Sequence's protected, parser-origin-aware text only after Sequence has classified
+/// syntax such as math delimiters and `<br>` line breaks. Generated atoms are decoded as their
+/// own source segments, so a decoded entity cannot synthesize a second atom or combine across an
+/// origin boundary. Authored entity references keep Sequence's existing full Mermaid decoder.
+pub(crate) fn sequence_visible_text(text: &str, mode: SequenceTextProjectionMode) -> String {
+    sequence_visible_text_with_checkpoint(text, mode, || Ok(()))
+        .expect("an infallible Sequence text projection cannot be cancelled")
+}
