+fn relation_title_and_both_terminal_titles_keep_exact_generated_entity_origins() {
+    let source = concat!(
+        "classDiagram\n",
+        "class A\n",
+        "class B\n",
+        "A \"left authored ﬂ°quot¶ß generated ﬂ°quot¶ß\" --> ",
