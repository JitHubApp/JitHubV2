+fn mindmap_exact_final_text_survives_resvg_safe_fallback_when_html_labels_are_disabled() {
+    let source = "---\nconfig:\n  htmlLabels: false\n---\nmindmap\n  root[Authored ﬂ°quot¶ß plus #quot;]\n    entity[Literal #amp;quot;]\n    markup[Literal #lt;b#gt;]\n    slash[Literal #92;n]\n";
+    let svg = render_mindmap_svg_from_text(source, "mindmap-final-text-fallback");
+    let session = RenderEnvironment::deterministic()
+        .begin_session()
+        .expect("begin fallback session");
+    let fallback = SvgPipeline::resvg_safe()
+        .process_to_string(&svg, &session)
+        .expect("resvg-safe fallback succeeds");
+    let document =
+        roxmltree::Document::parse(&fallback).expect("resvg-safe fallback remains valid XML");
+
+    let fallback_groups = document
+        .descendants()
+        .filter(|node| {
+            node.has_tag_name("g")
+                && node.attribute("data-merman-foreignobject") == Some("fallback")
+                && node.attribute("data-mmir-final-text") == Some("true")
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        fallback_groups.len(),
+        4,
+        "every source label gets a marked fallback group"
+    );
+    let fallback_text = fallback_groups
+        .into_iter()
+        .flat_map(|group| group.descendants().filter(|node| node.has_tag_name("text")))
+        .map(xml_text_content)
+        .collect::<String>();
+    assert!(fallback_text.contains("Authored ﬂ°quot¶ß plus \""));
+    assert!(
+        fallback_text.contains("Literal &quot;"),
+        "exact mode performs one ordinary HTML text decode, not recursive entity expansion: {fallback_text:?}"
+    );
+    assert!(
+        fallback_text.contains("Literal <b>"),
+        "encoded markup finalized as text remains text through fallback extraction: {fallback_text:?}"
+    );
+    assert!(
+        fallback_text.contains("Literal \\n"),
+        "exact mode must not reinterpret a finalized backslash-n as a line break: {fallback_text:?}"
+    );
+
+    // Unmarked/manual SVG remains on the established compatibility path. Its Mermaid wrapper
+    // spellings continue to be interpreted as placeholders rather than opting into exact mode.
+    let legacy_svg = r#"<svg xmlns="http://www.w3.org/2000/svg"><g><foreignObject width="200" height="48"><div xmlns="http://www.w3.org/1999/xhtml">ﬂ°quot¶ß &amp;quot; slash\nnext</div></foreignObject></g></svg>"#;
+    let legacy = SvgPipeline::resvg_safe()
+        .process_to_string(legacy_svg, &session)
+        .expect("legacy fallback succeeds");
+    let legacy_document =
+        roxmltree::Document::parse(&legacy).expect("legacy fallback remains valid XML");
+    let legacy_lines = legacy_document
+        .descendants()
+        .filter(|node| {
+            node.has_tag_name("text")
+                && node.attribute("class") == Some("merman-foreignobject-fallback-text")
+        })
+        .map(xml_text_content)
+        .collect::<Vec<_>>();
+    assert_eq!(
+        legacy_lines,
+        ["\" \" slash", "next"],
+        "unmarked input retains the compatibility placeholder, multi-pass entity, and backslash-n behavior"
+    );
+}
