+    mode: SequenceTextProjectionMode,
+    checkpoint: impl FnMut() -> Result<()>,
+) -> Result<String> {
+    sequence_project_visible_text_with_checkpoint(text, mode, true, checkpoint)
+}
+
+/// Finalizes an accessibility title/description after the common-db sanitizer has run. Unlike
+/// sequence_visible_text_with_checkpoint, this keeps permitted raw markup spellings as text;
+/// the root SVG sink XML-escapes the resulting plain text exactly once.
+pub(crate) fn sequence_accessibility_visible_text_with_checkpoint(
+    text: &str,
+    mode: SequenceTextProjectionMode,
+    checkpoint: impl FnMut() -> Result<()>,
+) -> Result<String> {
+    sequence_project_visible_text_with_checkpoint(text, mode, false, checkpoint)
+}
+
+fn sequence_project_visible_text_with_checkpoint(
+    text: &str,
+    mode: SequenceTextProjectionMode,
+    strip_raw_formatting_tags: bool,
+    mut checkpoint: impl FnMut() -> Result<()>,
+) -> Result<String> {
+    if mode == SequenceTextProjectionMode::Legacy {
+        checkpoint()?;
+        let visible = merman_core::entities::decode_mermaid_entities_to_unicode(text).into_owned();
+        checkpoint()?;
+        return Ok(visible);
+    }
+
+    const ATOM_ESCAPE: char = '\u{f0000}';
+    const GENERATED_ATOM: char = '\u{fe04}';
+
+    // Match native's current text cleanup before expanding entity-origin atoms. Authored raw
+    // formatting wrappers are stripped from the opaque source, while generated `<b>`-like
+    // contents remain hidden inside atoms until the completed text node is marked final.
+    let normalized = if strip_raw_formatting_tags {
+        Cow::Owned(
+            crate::text::strip_raw_label_formatting_tags_with_checkpoint(text, || checkpoint())?,
+        )
+    } else {
+        Cow::Borrowed(text)
+    };
+    let text = normalized.as_ref();
+    let mut output = String::with_capacity(text.len());
+    let mut cursor = 0usize;
+    while let Some(relative_start) = text[cursor..].find(ATOM_ESCAPE) {
+        checkpoint()?;
+        let start = cursor + relative_start;
+        output.push_str(
+            merman_core::entities::decode_mermaid_entities_to_unicode(&text[cursor..start])
+                .as_ref(),
+        );
+        let Some(end) = crate::entities::flowchart_projection_token_end(text, start) else {
+            output.push(ATOM_ESCAPE);
+            cursor = start + ATOM_ESCAPE.len_utf8();
+            continue;
+        };
+        let token = &text[start..end];
+        let selector = token.chars().nth(1);
+        let decoded = crate::entities::decode_flowchart_markdown_projection_tokens(token);
+        if selector == Some(GENERATED_ATOM) {
+            output.push_str(
+                merman_core::entities::decode_mermaid_entities_to_unicode(decoded.as_ref())
+                    .as_ref(),
+            );
+        } else {
+            output.push_str(decoded.as_ref());
+        }
+        cursor = end;
+    }
+    output.push_str(
+        merman_core::entities::decode_mermaid_entities_to_unicode(&text[cursor..]).as_ref(),
+    );
+    checkpoint()?;
+    Ok(output)
+}
+
+/// Builds the HTML/TeX callback input for a Sequence math label without allowing decoded entity
+/// atoms to participate in the callback's later syntax pass.
+///
+/// Sequence classifies authored `$$` and `<br>` on parser text. A math renderer receives HTML and
+/// may classify those delimiters again, so generated entity atoms must remain data even after
+/// their visible value is restored. In particular, generated dollars in prose are HTML-escaped,
+/// while generated dollars inside an already-classified formula are isolated as TeX text data.
+pub(crate) fn sequence_math_callback_text_with_checkpoint(
+    text: &str,
+    mode: SequenceTextProjectionMode,
+    mut checkpoint: impl FnMut() -> Result<()>,
+) -> Result<String> {
+    if mode == SequenceTextProjectionMode::Legacy {
+        return sequence_visible_text_with_checkpoint(text, mode, checkpoint);
+    }
+
+    let normalized =
+        crate::text::strip_raw_label_formatting_tags_with_checkpoint(text, || checkpoint())?;
+    let lines = crate::text::split_html_br_lines(&normalized);
+    let mut output = String::with_capacity(normalized.len());
+    for (line_index, line) in lines.iter().enumerate() {
+        checkpoint()?;
+        if let Some(parsed) = crate::math::parse_delimited_math_line(line) {
+            for fragment in parsed.fragments {
+                checkpoint()?;
+                append_sequence_math_callback_plain_text(
+                    &mut output,
+                    fragment.leading_text,
+                    false,
+                    &mut checkpoint,
+                )?;
+                append_sequence_math_callback_formula(
+                    &mut output,
+                    fragment.delimited,
+                    &mut checkpoint,
+                )?;
+            }
+            append_sequence_math_callback_plain_text(
+                &mut output,
+                parsed.trailing_text,
+                false,
+                &mut checkpoint,
+            )?;
+        } else {
+            append_sequence_math_callback_plain_text(&mut output, line, false, &mut checkpoint)?;
+        }
+
+        if line_index + 1 < lines.len() {
+            // All accepted authored `<br>` spellings are structural at this point. Canonicalizing
+            // them preserves the callback's line shape without exposing decoded atom text to its
+            // later delimiter scanner.
+            output.push_str("<br>");
+        }
+    }
+    checkpoint()?;
+    Ok(output)
+}
+
+fn append_sequence_math_callback_formula(
+    output: &mut String,
+    delimited: &str,
+    checkpoint: &mut impl FnMut() -> Result<()>,
+) -> Result<()> {
+    let Some(formula) = delimited
+        .strip_prefix("$$")
+        .and_then(|value| value.strip_suffix("$$"))
+    else {
+        return append_sequence_math_callback_plain_text(output, delimited, false, checkpoint);
+    };
+
+    output.push_str("$$");
+    append_sequence_math_callback_plain_text(output, formula, true, checkpoint)?;
+    output.push_str("$$");
+    Ok(())
+}
+
+fn append_sequence_math_callback_plain_text(
+    output: &mut String,
+    source: &str,
+    in_formula: bool,
+    checkpoint: &mut impl FnMut() -> Result<()>,
+) -> Result<()> {
+    const ATOM_ESCAPE: char = '\u{f0000}';
+    const GENERATED_ATOM: char = '\u{fe04}';
+
+    let mut cursor = 0usize;
+    while let Some(relative_start) = source[cursor..].find(ATOM_ESCAPE) {
+        checkpoint()?;
+        let start = cursor + relative_start;
+        output.push_str(&sequence_visible_text_with_checkpoint(
+            &source[cursor..start],
+            SequenceTextProjectionMode::Protected,
+            || checkpoint(),
+        )?);
+
+        let Some(end) = crate::entities::flowchart_projection_token_end(source, start) else {
+            // Malformed private frames use the same bounded visible fallback as ordinary text
+            // projection; never scan within a frame as though it were a generated delimiter.
+            output.push_str(&sequence_visible_text_with_checkpoint(
+                &source[start..start + ATOM_ESCAPE.len_utf8()],
+                SequenceTextProjectionMode::Protected,
+                || checkpoint(),
+            )?);
+            cursor = start + ATOM_ESCAPE.len_utf8();
+            continue;
+        };
+
+        let token = &source[start..end];
+        if token.chars().nth(1) == Some(GENERATED_ATOM) {
+            let visible = sequence_visible_text_with_checkpoint(
+                token,
+                SequenceTextProjectionMode::Protected,
+                || checkpoint(),
+            )?;
+            if in_formula {
+                // The enclosing delimiters were identified on source text. A generated dollar is
+                // data inside that formula, not a second delimiter for the callback to reparse.
+                for character in visible.chars() {
+                    checkpoint()?;
+                    if character == '$' {
+                        // Keep the literal dollar visually inside math without leaving a raw `$`
+                        // adjacent to authored source. A plain `\$` can still create `$$` when
+                        // the generated atom sits beside one authored dollar, causing the math
+                        // callback's delimiter scan to split a source-classified formula.
+                        output.push_str("\\text{\\$}");
+                    } else {
+                        output.push(character);
+                    }
+                }
+            } else {
+                append_sequence_generated_html_text(output, &visible, checkpoint)?;
+            }
+        } else {
+            output.push_str(&sequence_visible_text_with_checkpoint(
+                token,
+                SequenceTextProjectionMode::Protected,
+                || checkpoint(),
+            )?);
+        }
+        cursor = end;
+    }
+
+    output.push_str(&sequence_visible_text_with_checkpoint(
+        &source[cursor..],
+        SequenceTextProjectionMode::Protected,
+        || checkpoint(),
+    )?);
+    Ok(())
+}
+
+fn append_sequence_generated_html_text(
+    output: &mut String,
+    text: &str,
+    checkpoint: &mut impl FnMut() -> Result<()>,
+) -> Result<()> {
+    for character in text.chars() {
+        checkpoint()?;
+        match character {
+            '&' => output.push_str("&amp;"),
+            '<' => output.push_str("&lt;"),
+            '>' => output.push_str("&gt;"),
+            '"' => output.push_str("&quot;"),
+            '\'' => output.push_str("&#39;"),
+            '$' => output.push_str("&#36;"),
+            _ => output.push(character),
+        }
+    }
+    Ok(())
+}
