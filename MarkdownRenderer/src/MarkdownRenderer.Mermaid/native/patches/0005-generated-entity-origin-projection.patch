+        "title authored ﬂ°quot¶ß generated ﬂ°quot¶ß\n",
+    );
+    let generated = generated_every_second_marker(source);
+    assert_eq!(
+        generated.len(),
+        3,
+        "one generated origin per typed relation label field"
+    );
+
+    let (model, origins) = parse::parse_class_typed_controlled_with_entity_origins(
+        source,
+        &meta(),
+        &OperationControl::new(),
+        Some(&generated),
