new file mode 100644
index 000000000..47a405423
--- /dev/null
+++ b/crates/merman-render/src/text/raw_formatting_tags.rs
@@ -0,0 +1,287 @@
+/// Removes supported raw HTML formatting wrappers from a source label while preserving all
+/// authored whitespace and unknown/malformed markup. Work is bounded by a small multiple of the
+/// input size; the callback also lets operation owners preserve cancellation/resource checks
+/// during long scans and copies.
+pub(crate) fn strip_raw_label_formatting_tags_with_checkpoint<E>(
+    input: &str,
+    mut checkpoint: impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<String, E> {
+    const FORMATTING_TAGS: [&str; 13] = [
+        "b", "strong", "i", "em", "u", "s", "strike", "del", "sub", "sup", "small", "mark", "span",
+    ];
+    const SCAN_BUDGET_MULTIPLIER: usize = 4;
+    const MIN_SCAN_BUDGET: usize = 256;
+    const CHECKPOINT_BYTES: usize = 4 * 1024;
+
+    enum TagRead {
+        Recognized(usize),
+        NotRecognized,
+        BudgetExceeded,
+    }
+
+    fn checked_find_open_angle<E>(
+        input: &str,
+        from: usize,
+        checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<usize>, E> {
+        let bytes = input.as_bytes();
+        let mut next_checkpoint = from;
+        checkpoint()?;
+        for (index, byte) in bytes.iter().enumerate().skip(from) {
+            if index.saturating_sub(next_checkpoint) >= CHECKPOINT_BYTES {
+                checkpoint()?;
+                next_checkpoint = index;
+            }
+            if *byte == b'<' {
+                return Ok(Some(index));
+            }
+        }
+        checkpoint()?;
+        Ok(None)
+    }
+
+    fn checked_trim_end<'a, E>(
+        input: &'a str,
+        checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<&'a str, E> {
+        let mut end = input.len();
+        let mut scanned = 0usize;
+        let mut last_checkpoint = 0usize;
+        while end > 0 {
+            if scanned.saturating_sub(last_checkpoint) >= CHECKPOINT_BYTES {
+                checkpoint()?;
+                last_checkpoint = scanned;
+            }
+            let character = input[..end]
+                .chars()
+                .next_back()
+                .expect("end is a UTF-8 boundary before input start");
+            if !character.is_whitespace() {
+                break;
+            }
+            end -= character.len_utf8();
+            scanned = scanned.saturating_add(character.len_utf8());
+        }
+        Ok(&input[..end])
+    }
+
+    fn try_read_tag<E>(
+        input: &str,
+        start: usize,
+        scan_budget: &mut usize,
+        checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<TagRead, E> {
+        let bytes = input.as_bytes();
+        let mut quote = None;
+        let mut close = None;
+
+        for (offset, &byte) in bytes[start + 1..].iter().enumerate() {
+            if offset.is_multiple_of(CHECKPOINT_BYTES) {
+                checkpoint()?;
+            }
+            if *scan_budget == 0 {
+                return Ok(TagRead::BudgetExceeded);
+            }
+            *scan_budget -= 1;
+
+            if let Some(active_quote) = quote {
+                if byte == active_quote {
+                    quote = None;
+                }
+                continue;
+            }
+
+            match byte {
+                b'\'' | b'"' => quote = Some(byte),
+                b'>' => {
+                    close = Some(start + 1 + offset);
+                    break;
+                }
+                _ => {}
+            }
+        }
+
+        let Some(close) = close else {
+            return Ok(TagRead::NotRecognized);
+        };
+
+        let raw_tag = &input[start + 1..close];
+        if raw_tag.len() > *scan_budget {
+            return Ok(TagRead::BudgetExceeded);
+        }
+        *scan_budget -= raw_tag.len();
+
+        if raw_tag.is_empty() || raw_tag.chars().next().is_some_and(char::is_whitespace) {
+            return Ok(TagRead::NotRecognized);
+        }
+
+        let mut tag = raw_tag;
+        if let Some(without_slash) = tag.strip_prefix('/') {
+            if without_slash
+                .chars()
+                .next()
+                .is_some_and(char::is_whitespace)
+            {
+                return Ok(TagRead::NotRecognized);
+            }
+            tag = without_slash;
+        }
+
+        if tag.ends_with('/') {
+            tag = checked_trim_end(&tag[..tag.len() - 1], checkpoint)?;
+        }
+
+        let mut name_length = 0usize;
+        for (index, byte) in tag.as_bytes().iter().enumerate() {
+            if index.is_multiple_of(CHECKPOINT_BYTES) {
+                checkpoint()?;
+            }
+            if !byte.is_ascii_alphabetic() {
+                break;
+            }
+            name_length += 1;
+        }
+        if name_length == 0
+            || tag[name_length..]
+                .chars()
+                .next()
+                .is_some_and(|character| !character.is_whitespace())
+        {
+            return Ok(TagRead::NotRecognized);
+        }
+
+        let name = &tag[..name_length];
+        if FORMATTING_TAGS
+            .iter()
+            .any(|recognized| name.eq_ignore_ascii_case(recognized))
+        {
+            Ok(TagRead::Recognized(close + 1))
+        } else {
+            Ok(TagRead::NotRecognized)
+        }
+    }
+
+    checkpoint()?;
+    let mut scan_budget = input
+        .len()
+        .saturating_mul(SCAN_BUDGET_MULTIPLIER)
+        .max(MIN_SCAN_BUDGET);
+    let mut search_from = 0usize;
+    let mut copied_through = 0usize;
+    let mut output: Option<String> = None;
+
+    while let Some(marker) = checked_find_open_angle(input, search_from, &mut checkpoint)? {
+        match try_read_tag(input, marker, &mut scan_budget, &mut checkpoint)? {
+            TagRead::Recognized(end) => {
+                let output = output.get_or_insert_with(|| String::with_capacity(input.len()));
+                // Formatting wrappers are presentation, not word separators. Removing them
+                // must preserve exactly the whitespace that was authored between their contents.
+                append_checked(output, &input[copied_through..marker], &mut checkpoint)?;
+                copied_through = end;
+                search_from = end;
+            }
+            TagRead::NotRecognized => search_from = marker + 1,
+            TagRead::BudgetExceeded => {
+                let mut original = String::with_capacity(input.len());
+                append_checked(&mut original, input, &mut checkpoint)?;
+                return Ok(original);
+            }
+        }
+    }
+
+    match output {
+        Some(mut output) => {
+            append_checked(&mut output, &input[copied_through..], &mut checkpoint)?;
+            Ok(output)
+        }
+        None => {
+            let mut output = String::with_capacity(input.len());
+            append_checked(&mut output, input, &mut checkpoint)?;
+            Ok(output)
+        }
+    }
+}
+
+fn append_checked<E>(
+    output: &mut String,
+    value: &str,
+    checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<(), E> {
+    const CHECKPOINT_BYTES: usize = 4 * 1024;
+    let mut start = 0usize;
+    while start < value.len() {
+        checkpoint()?;
+        let mut end = start.saturating_add(CHECKPOINT_BYTES).min(value.len());
+        while !value.is_char_boundary(end) {
+            end -= 1;
+        }
+        output.push_str(&value[start..end]);
+        start = end;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::strip_raw_label_formatting_tags_with_checkpoint;
+    use std::convert::Infallible;
+
+    #[test]
+    fn strips_only_supported_tags_and_preserves_whitespace_and_unknown_markup() {
+        for (input, expected) in [
+            ("before <b>bold</b> after", "before bold after"),
+            (
+                "before <span class='x > y'>text</span> after",
+                "before text after",
+            ),
+            (
+                "before <unknown>text</unknown> after",
+                "before <unknown>text</unknown> after",
+            ),
+            ("before < b>text</ b> after", "before < b>text</ b> after"),
+            ("before <b>  text </b> after", "before   text  after"),
+        ] {
+            let actual =
+                strip_raw_label_formatting_tags_with_checkpoint(input, || Ok::<(), Infallible>(()))
+                    .expect("infallible checkpoint");
+            assert_eq!(actual, expected, "input: {input:?}");
+        }
+    }
+
+    #[test]
+    fn bounded_hostile_markup_is_preserved_without_exceeding_work_budget() {
+        let hostile = format!("{}<b", "<".repeat(4096));
+        let actual =
+            strip_raw_label_formatting_tags_with_checkpoint(&hostile, || Ok::<(), Infallible>(()))
+                .expect("infallible checkpoint");
+        assert_eq!(actual, hostile);
+    }
+
+    #[test]
+    fn chunked_copy_preserves_unicode_across_byte_boundaries() {
+        let prefix = "é".repeat(2048);
+        let suffix = "𐀀".repeat(1024);
+        let input = format!("{prefix}<b>😀</b>{suffix}");
+        let expected = format!("{prefix}😀{suffix}");
+        let actual =
+            strip_raw_label_formatting_tags_with_checkpoint(&input, || Ok::<(), Infallible>(()))
+                .expect("infallible checkpoint");
+
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn long_scans_observe_cancellation_checkpoints() {
+        let input = format!("{}<b>text</b>", "x".repeat(16 * 1024));
+        let mut checkpoints = 0usize;
+        let result = strip_raw_label_formatting_tags_with_checkpoint(&input, || {
+            checkpoints += 1;
+            if checkpoints == 3 {
+                return Err("cancelled");
+            }
+            Ok(())
+        });
+        assert_eq!(result, Err("cancelled"));
+        assert!(checkpoints >= 3);
+    }
+}
