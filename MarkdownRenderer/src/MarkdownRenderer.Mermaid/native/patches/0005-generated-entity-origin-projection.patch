+const MERMAID_LITERAL_PLACEHOLDER_ESCAPE: char = '\u{f0000}';
+const MERMAID_LITERAL_PLACEHOLDER_PREFIX: char = '\u{fe00}';
+const MERMAID_LITERAL_PLACEHOLDER_NUMERIC_PREFIX: char = '\u{fe01}';
+const MERMAID_LITERAL_PLACEHOLDER_SUFFIX: char = '\u{fe02}';
+const MERMAID_LITERAL_PLACEHOLDER_ESCAPE_ESCAPE: char = '\u{fe03}';
+const MERMAID_GENERATED_ENTITY_ATOM: char = '\u{fe04}';
+const GENERATED_ENTITY_ATOM_LENGTH_HEX_DIGITS: usize = 16;
