+
+        if let Some(title) = relation.relation_title_1.as_mut() {
+            let key = EntityLabelOriginKey::new(
+                EntityLabelFamily::Class,
+                owner,
+                CLASS_RELATION_TITLE1_SLOT,
+            );
+            *title = class_project_source(
+                render_context.entity_label_source(key),
+                title,
+                ordinal,
+                "relation endpoint 1 title",
+                &mut checkpoint,
+            )?;
+        }
+        if let Some(title) = relation.relation_title_2.as_mut() {
+            let key = EntityLabelOriginKey::new(
+                EntityLabelFamily::Class,
+                owner,
+                CLASS_RELATION_TITLE2_SLOT,
+            );
+            *title = class_project_source(
+                render_context.entity_label_source(key),
+                title,
+                ordinal,
+                "relation endpoint 2 title",
+                &mut checkpoint,
+            )?;
+        }
+    }
+    checkpoint()?;
