+                source,
+            ) {
+                return Ok(Err("duplicate sequence box title source owner".into()));
+            }
+        }
+        for (index, message) in self.messages.iter().enumerate() {
+            control.checkpoint()?;
+            let Ok(ordinal) = u32::try_from(index) else {
+                return Ok(Err(
+                    "sequence message source owner exceeds index range".into()
+                ));
+            };
+            let source = match message.source_span.clone() {
+                Some(span) => {
+                    match OriginTrackedText::from_source_span(code, span, Some(generated), control)?
