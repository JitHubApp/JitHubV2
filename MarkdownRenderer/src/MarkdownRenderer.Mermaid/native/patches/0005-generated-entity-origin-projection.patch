+/// Returns the end byte of one private, atomic literal-placeholder token in a sanitized flowchart
+/// text projection. The token is only emitted from exact source-origin ranges in `merman-core`.
+pub(crate) fn mermaid_literal_placeholder_escape_end(text: &str, start: usize) -> Option<usize> {
+    let rest = text.get(start..)?;
+    let mut chars = rest.chars();
+    if chars.next()? != MERMAID_LITERAL_PLACEHOLDER_ESCAPE {
+        return None;
+    }
+    let selector = chars.next()?;
+    matches!(
+        selector,
+        MERMAID_LITERAL_PLACEHOLDER_PREFIX
+            | MERMAID_LITERAL_PLACEHOLDER_NUMERIC_PREFIX
+            | MERMAID_LITERAL_PLACEHOLDER_SUFFIX
+            | MERMAID_LITERAL_PLACEHOLDER_ESCAPE_ESCAPE
+    )
+    .then_some(start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8() + selector.len_utf8())
+}
+
+pub(crate) fn decode_authored_mermaid_placeholder_tokens(text: &str) -> Cow<'_, str> {
+    if !text.contains(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        return Cow::Borrowed(text);
+    }
+
+    let mut output = String::with_capacity(text.len());
+    let mut cursor = 0usize;
+    let mut decoded_any = false;
+    while let Some(relative_start) = text[cursor..].find(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        let start = cursor + relative_start;
+        output.push_str(&text[cursor..start]);
+        if let Some(end) = mermaid_literal_placeholder_escape_end(text, start) {
+            let selector = text[start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8()..end]
+                .chars()
+                .next()
+                .expect("a recognized token contains a selector");
+            if selector == MERMAID_LITERAL_PLACEHOLDER_ESCAPE_ESCAPE {
+                output.push(MERMAID_LITERAL_PLACEHOLDER_ESCAPE);
+                cursor = end;
+                decoded_any = true;
+                continue;
+            }
+            output.push_str(match selector {
+                MERMAID_LITERAL_PLACEHOLDER_PREFIX => "ﬂ°",
+                MERMAID_LITERAL_PLACEHOLDER_NUMERIC_PREFIX => "ﬂ°°",
+                MERMAID_LITERAL_PLACEHOLDER_SUFFIX => "¶ß",
+                _ => unreachable!("the token scanner only accepts known selectors"),
+            });
+            cursor = end;
+            decoded_any = true;
+        } else {
+            output.push(MERMAID_LITERAL_PLACEHOLDER_ESCAPE);
+            cursor = start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8();
+        }
+    }
+
+    output.push_str(&text[cursor..]);
+    if decoded_any {
+        Cow::Owned(output)
+    } else {
+        Cow::Borrowed(text)
+    }
+}
