+pub(crate) fn project_state_diagram_render_model_with_semantic_context(
+    model: &StateDiagramModel,
+    render_context: &RenderSemanticContext,
+    sanitize_config: &MermaidConfig,
+    mut checkpoint: impl FnMut() -> Result<()>,
+) -> Result<StateDiagramModel> {
+    let mut projected = model.clone();
+    for (ordinal, node) in projected.nodes.iter_mut().enumerate() {
+        if ordinal.is_multiple_of(64) {
+            checkpoint()?;
+        }
+        let owner = u32::try_from(ordinal).map_err(|_| Error::InvalidModel {
+            message: "state render node ordinal exceeds the entity-origin index range".to_string(),
+        })?;
+        let label_key =
+            EntityLabelOriginKey::new(EntityLabelFamily::State, owner, STATE_NODE_LABEL_SLOT);
+        let current_label = node
+            .label
+            .as_ref()
+            .and_then(Value::as_str)
+            .unwrap_or(node.id.as_str());
+        let (mut label, label_is_exact) = state_project_source(
+            render_context.entity_label_source(label_key),
+            current_label,
+            sanitize_config,
+            ordinal,
+            "node label",
+            &mut checkpoint,
+        )?;
+
+        if matches!(node.shape.as_str(), "note" | "noteGroup") {
+            let note_key =
+                EntityLabelOriginKey::new(EntityLabelFamily::State, owner, STATE_NOTE_LABEL_SLOT);
+            let (note_label, note_is_exact) = state_project_source(
+                render_context.entity_label_source(note_key),
+                current_label,
+                sanitize_config,
+                ordinal,
+                "note label",
+                &mut checkpoint,
+            )?;
+            if note_is_exact && label_is_exact && note_label != label {
+                return Err(Error::InvalidModel {
+                    message: format!(
+                        "state note render source disagrees with node label at ordinal {ordinal}"
+                    ),
+                });
+            }
+            label = note_label;
+        }
+        node.label = Some(Value::String(label));
+
+        if let Some(descriptions) = node.description.as_mut() {
+            for (part, description) in descriptions.iter_mut().enumerate() {
+                if part.is_multiple_of(64) {
+                    checkpoint()?;
+                }
+                let part_ordinal = u32::try_from(part).map_err(|_| Error::InvalidModel {
+                    message: format!(
+                        "state description part ordinal exceeds the entity-origin index range for node {ordinal}"
+                    ),
+                })?;
+                let key = EntityLabelOriginKey::new_part(
+                    EntityLabelFamily::State,
+                    owner,
+                    STATE_NODE_DESCRIPTION_SLOT,
+                    part_ordinal,
+                );
+                *description = state_project_source(
+                    render_context.entity_label_source(key),
+                    description,
+                    sanitize_config,
+                    ordinal,
+                    "description",
+                    &mut checkpoint,
+                )?
+                .0;
+            }
+        }
+    }
+
+    for (ordinal, edge) in projected.edges.iter_mut().enumerate() {
+        if ordinal.is_multiple_of(64) {
+            checkpoint()?;
+        }
+        let owner = u32::try_from(ordinal).map_err(|_| Error::InvalidModel {
+            message: "state render edge ordinal exceeds the entity-origin index range".to_string(),
+        })?;
+        let key = EntityLabelOriginKey::new(EntityLabelFamily::State, owner, STATE_EDGE_LABEL_SLOT);
+        edge.label = state_project_source(
+            render_context.entity_label_source(key),
+            &edge.label,
+            sanitize_config,
+            ordinal,
+            "edge label",
+            &mut checkpoint,
+        )?
+        .0;
+    }
+    checkpoint()?;
+    Ok(projected)
+}
+
+fn state_project_source(
+    source: EntityLabelSource<'_>,
+    fallback: &str,
+    sanitize_config: &MermaidConfig,
+    owner_ordinal: usize,
+    role: &str,
+    checkpoint: &mut impl FnMut() -> Result<()>,
+) -> Result<(String, bool)> {
+    match source {
+        EntityLabelSource::Legacy => Ok((fallback.to_string(), false)),
+        EntityLabelSource::Exact(source) => {
+            let protected = source
+                .protect_for_markdown(|| checkpoint())?
+                .ok_or_else(|| Error::InvalidModel {
+                    message: format!(
+                        "state render source projection is invalid for {role} at ordinal {owner_ordinal}"
+                    ),
+                })?;
+            checkpoint()?;
+            let sanitized = merman_core::sanitize::sanitize_text(&protected, sanitize_config);
+            checkpoint()?;
+            Ok((sanitized, true))
+        }
+        EntityLabelSource::Unmapped => Err(Error::InvalidModel {
+            message: format!(
+                "state render source is missing for {role} at ordinal {owner_ordinal}"
+            ),
+        }),
+    }
 }
 
