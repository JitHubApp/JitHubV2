+    #[test]
+    fn all_private_use_input_uses_a_bounded_pair_prefix_and_safe_fixed_tokens() {
+        let source: String = (0xE000..0xF900).filter_map(char::from_u32).collect();
+        let value = Value::String(source.clone());
+        let codec = fresh_origin_token_codec(&source, &value, &crate::OperationControl::new())
+            .expect("active control")
