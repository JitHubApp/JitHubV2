+fn decode_flowchart_projection_token(
+    text: &str,
+    start: usize,
+) -> Result<Option<(usize, String)>, ()> {
+    let rest = text.get(start..).ok_or(())?;
+    let mut chars = rest.chars();
+    let Some(first) = chars.next() else {
+        return Err(());
+    };
+    if first != MERMAID_LITERAL_PLACEHOLDER_ESCAPE {
+        return Ok(None);
+    }
+    let Some(selector) = chars.next() else {
+        return Err(());
+    };
+    let token_end = start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8() + selector.len_utf8();
+    let value = match selector {
+        MERMAID_LITERAL_PLACEHOLDER_PREFIX => "ﬂ°".to_string(),
+        MERMAID_LITERAL_PLACEHOLDER_NUMERIC_PREFIX => "ﬂ°°".to_string(),
+        MERMAID_LITERAL_PLACEHOLDER_SUFFIX => "¶ß".to_string(),
+        MERMAID_LITERAL_PLACEHOLDER_ESCAPE_ESCAPE => MERMAID_LITERAL_PLACEHOLDER_ESCAPE.to_string(),
+        MERMAID_GENERATED_ENTITY_ATOM => {
+            let length_end = token_end
+                .checked_add(GENERATED_ENTITY_ATOM_LENGTH_HEX_DIGITS)
+                .ok_or(())?;
+            let length_text = text.get(token_end..length_end).ok_or(())?;
+            if !length_text.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+                return Err(());
+            }
+            let payload_len = usize::from_str_radix(length_text, 16).map_err(|_| ())?;
+            let payload_hex_len = payload_len.checked_mul(2).ok_or(())?;
+            let payload_end = length_end.checked_add(payload_hex_len).ok_or(())?;
+            let payload_hex = text.get(length_end..payload_end).ok_or(())?;
+            if !payload_hex.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+                return Err(());
+            }
+
+            let mut payload = Vec::with_capacity(payload_len);
+            for pair in payload_hex.as_bytes().chunks_exact(2) {
+                let high = decode_ascii_hex_nibble(pair[0]).ok_or(())?;
+                let low = decode_ascii_hex_nibble(pair[1]).ok_or(())?;
+                payload.push((high << 4) | low);
+            }
+            let payload = String::from_utf8(payload).map_err(|_| ())?;
+            return Ok(Some((payload_end, payload)));
+        }
+        _ => return Ok(None),
+    };
+    Ok(Some((token_end, value)))
+}
