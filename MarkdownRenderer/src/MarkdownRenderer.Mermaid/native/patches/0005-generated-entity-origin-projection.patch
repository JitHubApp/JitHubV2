+    match checkpoints.projection_mode() {
+        crate::sequence::SequenceTextProjectionMode::Legacy => {
+            // Keep direct/legacy models on the historical single entity-decode + XML-escape
+            // path. Calling sequence_visible_text first would make this escape decode twice.
+            checkpoints.checkpoint()?;
+            Ok((escape_xml_display(text).to_string(), ""))
+        }
+        crate::sequence::SequenceTextProjectionMode::Protected => {
+            let visible = crate::sequence::sequence_accessibility_visible_text_with_checkpoint(
+                text,
+                checkpoints.projection_mode(),
+                || checkpoints.checkpoint(),
+            )?;
+            let mut escaped = String::with_capacity(visible.len());
+            crate::svg::parity::util::escape_xml_raw_into(&mut escaped, &visible);
+            checkpoints.checkpoint()?;
+            Ok((
+                escaped,
+                crate::sequence::sequence_final_text_attribute(checkpoints.projection_mode()),
+            ))
+        }
+    }
+}
