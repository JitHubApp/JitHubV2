+fn wrap_protected_sequence_label_like_mermaid_lines(
+    label: &str,
+    measurer: &dyn TextMeasurer,
+    style: &TextStyle,
+    max_width_px: f64,
+    checkpoints: SequenceTextCheckpoints<'_>,
+) -> Result<Vec<String>> {
+    checkpoints.checkpoint()?;
+    if label.is_empty() {
+        return Ok(Vec::new());
+    }
+    if !max_width_px.is_finite() || max_width_px <= 0.0 {
+        return Ok(vec![label.to_string()]);
+    }
+
+    // Mermaid's authored `<br>` is recognized before entity decoding. Keep the same order for
+    // exact-origin atoms so a generated `<br>` remains visible label text rather than becoming
+    // a structural line break.
+    let explicit_lines = split_html_br_lines(label);
+    if explicit_lines.len() > 1 {
+        let mut lines = Vec::with_capacity(explicit_lines.len());
+        for line in explicit_lines {
+            checkpoints.checkpoint()?;
+            lines.push(line.to_string());
+        }
+        checkpoints.checkpoint()?;
+        return Ok(lines);
+    }
+
+    let words = protected_sequence_words(label, checkpoints)?;
+    if words.is_empty() {
+        return Ok(vec![label.to_string()]);
+    }
+
+    let sequence_measurer = SequenceWrapTextMeasurer {
+        measurer,
+        checkpoints,
+    };
+    let mut completed = Vec::new();
+    let mut next_line = String::new();
+
+    for (index, units) in words.iter().enumerate() {
+        checkpoints.checkpoint()?;
+        let word = units.concat();
+        let word_len =
+            sequence_wrap_width(&sequence_measurer, &format!("{word} "), style, checkpoints)?;
+        let next_len = sequence_wrap_width(&sequence_measurer, &next_line, style, checkpoints)?;
+        if word_len > max_width_px {
+            let mut broken_lines = Vec::new();
+            let mut remaining = String::new();
+            for (unit_index, unit) in units.iter().enumerate() {
+                checkpoints.checkpoint()?;
+                let candidate = format!("{remaining}{unit}");
+                let line_width =
+                    sequence_wrap_width(&sequence_measurer, &candidate, style, checkpoints)?;
+                if line_width >= max_width_px {
+                    let is_last = unit_index + 1 == units.len();
+                    if is_last {
+                        broken_lines.push(candidate);
+                    } else {
+                        broken_lines.push(format!("{candidate}-"));
+                    }
+                    remaining.clear();
+                } else {
+                    remaining = candidate;
+                }
+            }
+            completed.push(next_line.clone());
+            completed.extend(broken_lines);
+            next_line = remaining;
+        } else if next_len + word_len >= max_width_px {
+            completed.push(next_line.clone());
+            next_line = word;
+        } else if next_line.is_empty() {
+            next_line = word;
+        } else {
+            next_line.push(' ');
+            next_line.push_str(&word);
+        }
+
+        if index + 1 == words.len() {
+            completed.push(next_line.clone());
+        }
+    }
+
+    checkpoints.checkpoint()?;
+    Ok(completed
+        .into_iter()
+        .filter(|line| !line.is_empty())
+        .collect())
+}
+
+fn sequence_wrap_width(
+    measurer: &SequenceWrapTextMeasurer<'_>,
+    text: &str,
+    style: &TextStyle,
+    checkpoints: SequenceTextCheckpoints<'_>,
+) -> Result<f64> {
+    checkpoints.checkpoint()?;
+    let width = measurer
+        .measure_svg_simple_text_bbox_width_for_wrap_px(text, style)
+        .round();
+    checkpoints.checkpoint()?;
+    Ok(width)
+}
+
+fn protected_sequence_words(
+    label: &str,
+    checkpoints: SequenceTextCheckpoints<'_>,
+) -> Result<Vec<Vec<String>>> {
+    const ATOM_ESCAPE: char = '\u{f0000}';
+
+    let mut words = Vec::new();
+    let mut units = Vec::new();
+    let mut cursor = 0usize;
+    let mut scanned = 0usize;
+    while cursor < label.len() {
+        if scanned.is_multiple_of(64) {
+            checkpoints.checkpoint()?;
+        }
+        scanned += 1;
+        let rest = &label[cursor..];
+        if rest.starts_with(ATOM_ESCAPE)
+            && let Some(end) = crate::entities::flowchart_projection_token_end(label, cursor)
+        {
+            let atom = &label[cursor..end];
+            if sequence_visible_text(atom, SequenceTextProjectionMode::Protected) == " " {
+                if !units.is_empty() {
+                    words.push(std::mem::take(&mut units));
+                }
+            } else {
+                // A generated entity atom is one unsplittable wrapping unit, even when its
+                // decoded text contains multiple Unicode scalars or a private-use escape frame.
+                units.push(atom.to_string());
+            }
+            cursor = end;
+            continue;
+        }
+
+        let character = rest
+            .chars()
+            .next()
+            .expect("cursor before end has a Unicode scalar");
+        cursor += character.len_utf8();
+        if character == ' ' {
+            if !units.is_empty() {
+                words.push(std::mem::take(&mut units));
+            }
+        } else {
+            units.push(character.to_string());
+        }
+    }
+    if !units.is_empty() {
+        words.push(units);
+    }
+    checkpoints.checkpoint()?;
+    Ok(words)
+}
