+                SEQUENCE_MESSAGE_LABEL_SLOT,
+            )),
+            text,
+            "message label",
+            ordinal,
+            work_meter,
+        )?;
+    }
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
