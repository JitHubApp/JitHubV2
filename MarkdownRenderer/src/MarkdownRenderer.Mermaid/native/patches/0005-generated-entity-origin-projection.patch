+mod tests {
+    use super::sequence_accessibility_text_for_svg;
+    use crate::resources::{OperationWorkMeter, RenderResourcePolicy};
+    use crate::sequence::SequenceTextProjectionMode;
+    use crate::svg::parity::sequence::SequenceEmitCheckpoints;
+
+    #[test]
+    fn legacy_sequence_accessibility_text_keeps_historical_entity_decode() {
+        let meter = OperationWorkMeter::new(RenderResourcePolicy::unbounded_for_trusted_input());
+        let checkpoints = SequenceEmitCheckpoints::new(&meter, SequenceTextProjectionMode::Legacy);
+
+        let (serialized, final_text_attribute) = sequence_accessibility_text_for_svg(
+            "ﬂ°quot¶ß legacy &quot; and &amp;quot; <b>",
+            checkpoints,
+        )
+        .expect("legacy accessibility text projection");
+
+        assert_eq!(serialized, "&quot; legacy &quot; and &amp;quot; &lt;b>");
+        assert_eq!(final_text_attribute, "");
+    }
+}
