+}
+
+fn class_project_source(
+    source: EntityLabelSource<'_>,
+    fallback: &str,
+    owner_ordinal: usize,
+    role: &str,
+    checkpoint: &mut impl FnMut() -> Result<()>,
+) -> Result<String> {
+    match source {
+        EntityLabelSource::Legacy => Ok(fallback.to_string()),
+        EntityLabelSource::Exact(source) => source
+            .protect_for_markdown(|| checkpoint())?
+            .ok_or_else(|| Error::InvalidModel {
+                message: format!(
+                    "class render source projection is invalid for {role} at relation ordinal {owner_ordinal}"
+                ),
+            }),
+        EntityLabelSource::Unmapped => Err(Error::InvalidModel {
+            message: format!(
+                "class render source is missing for {role} at relation ordinal {owner_ordinal}"
+            ),
+        }),
+    }
+}
