+                let private_index = private_use_index(chars.next()?)?;
+                let ascii = chars.next()?;
+                if chars.next().is_some() || !ascii.is_ascii() {
+                    return None;
+                }
+                let ascii_index = ORIGIN_TOKEN_ASCII
+                    .iter()
+                    .position(|candidate| *candidate == ascii as u8)?;
+                private_index
+                    .checked_mul(ORIGIN_TOKEN_ASCII.len())?
+                    .checked_add(ascii_index)
+            }
+        }
+    }
+}
+
+fn fresh_origin_token_codec(
+    source: &str,
+    value: &Value,
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<Option<OriginTokenCodec>> {
+    // A single fresh scalar is a collision-proof prefix. Generated IDs use two other PUA scalars,
+    // so neither an authored run nor a replacement edge can synthesize another prefix.
+    const BMP_PRIVATE_USE_PAIR_COUNT: usize = BMP_PRIVATE_USE_COUNT * (BMP_PRIVATE_USE_COUNT - 1);
+    const PRIVATE_USE_PAIR_BITMAP_WORDS: usize =
+        BMP_PRIVATE_USE_PAIR_COUNT.div_ceil(u64::BITS as usize);
+
+    control.checkpoint()?;
+    let mut present = vec![false; BMP_PRIVATE_USE_COUNT];
+    let mut visited_values = 0usize;
+    collect_private_use_chars_controlled(source, &mut present, control)?;
+    collect_value_private_use_chars_controlled(value, &mut present, control, &mut visited_values)?;
+    if let Some(index) = present.iter().position(|is_present| !is_present) {
+        return Ok(char::from_u32(0xE000 + index as u32)
+            .map(|ch| OriginTokenCodec::new(OriginTokenPrefixKind::Scalar(ch))));
+    }
+
+    // The single-scalar path above normally allocates only the 6,400-byte presence table. The
+    // adversarial all-scalars-present fallback uses a fixed <5 MiB adjacency bitmap. Work stays
+    // linear in the admitted YAML source/materialization plus at most one more candidate than
+    // the number of observed adjacent pairs, rather than scanning all 40.96 million pairs.
+    const MAX_PAIR_BITMAP_BYTES: usize = PRIVATE_USE_PAIR_BITMAP_WORDS * 8;
+    debug_assert!(MAX_PAIR_BITMAP_BYTES <= 5 * 1024 * 1024);
+    let mut pairs = vec![0u64; PRIVATE_USE_PAIR_BITMAP_WORDS];
+    let mut pair_occurrences = 0usize;
+    collect_private_use_pairs_controlled(source, &mut pairs, control, &mut pair_occurrences)?;
+    collect_value_private_use_pairs_controlled(
+        value,
+        &mut pairs,
+        control,
+        &mut visited_values,
+        &mut pair_occurrences,
+    )?;
+    let candidate_count = pair_occurrences
+        .saturating_add(1)
+        .min(BMP_PRIVATE_USE_PAIR_COUNT);
+    let mut candidate = None;
+    for index in 0..candidate_count {
+        if index.is_multiple_of(4096) {
+            control.checkpoint()?;
+        }
+        if pairs[index / u64::BITS as usize] & (1u64 << (index % u64::BITS as usize)) == 0 {
+            candidate = Some(index);
+            break;
+        }
+    }
+    let Some(index) = candidate else {
+        // Given the parser's existing source/materialization budget, an all-used pair table is
+        // not reachable (it would require more distinct adjacent pairs than admitted scalars).
+        return Ok(None);
+    };
+    let first = index / (BMP_PRIVATE_USE_COUNT - 1);
+    let mut second = index % (BMP_PRIVATE_USE_COUNT - 1);
+    if second >= first {
+        second += 1;
+    }
+    let (Some(first), Some(second)) = (
+        char::from_u32(0xE000 + first as u32),
+        char::from_u32(0xE000 + second as u32),
+    ) else {
+        return Ok(None);
+    };
+    debug_assert_ne!(first, second);
+    let codec = OriginTokenCodec::new(OriginTokenPrefixKind::Pair(first, second));
+    debug_assert!(!source.contains(&codec.prefix));
+    Ok(Some(codec))
+}
+
+fn private_use_index(ch: char) -> Option<usize> {
+    (0xE000..0xF900)
+        .contains(&(ch as u32))
+        .then(|| ch as usize - 0xE000)
+}
+
+fn private_use_char_excluding(index: usize, excluded: char) -> Option<char> {
+    let excluded = private_use_index(excluded)?;
+    let raw_index = if index >= excluded {
+        index.checked_add(1)?
+    } else {
+        index
+    };
+    (raw_index < BMP_PRIVATE_USE_COUNT)
+        .then(|| char::from_u32(0xE000 + raw_index as u32))
+        .flatten()
+}
+
+fn private_use_index_excluding(ch: char, excluded: char) -> Option<usize> {
+    let index = private_use_index(ch)?;
+    let excluded = private_use_index(excluded)?;
+    (index != excluded).then_some(if index > excluded { index - 1 } else { index })
+}
+
+fn collect_private_use_chars_controlled(
+    text: &str,
+    present: &mut [bool],
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<()> {
+    let mut checkpoint_at = 0usize;
+    for (byte_index, ch) in text.char_indices() {
+        if byte_index.saturating_sub(checkpoint_at) >= 4 * 1024 {
+            control.checkpoint()?;
+            checkpoint_at = byte_index;
+        }
+        if let Some(index) = private_use_index(ch) {
+            present[index] = true;
+        }
+    }
+    control.checkpoint()?;
+    Ok(())
+}
+
+fn collect_value_private_use_chars_controlled(
+    value: &Value,
+    present: &mut [bool],
+    control: &crate::OperationControl,
+    visited_values: &mut usize,
+) -> crate::OperationControlResult<()> {
+    *visited_values = (*visited_values).saturating_add(1);
+    if visited_values.is_multiple_of(64) {
+        control.checkpoint()?;
+    }
+    match value {
+        Value::String(text) => collect_private_use_chars_controlled(text, present, control)?,
+        Value::Array(values) => {
+            for value in values {
+                collect_value_private_use_chars_controlled(
+                    value,
+                    present,
+                    control,
+                    visited_values,
+                )?;
+            }
+        }
+        Value::Object(values) => {
+            for (key, value) in values {
+                collect_private_use_chars_controlled(key, present, control)?;
+                collect_value_private_use_chars_controlled(
+                    value,
+                    present,
+                    control,
+                    visited_values,
+                )?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn collect_private_use_pairs_controlled(
+    text: &str,
+    present: &mut [u64],
+    control: &crate::OperationControl,
+    occurrences: &mut usize,
+) -> crate::OperationControlResult<()> {
+    let mut previous = None;
+    let mut checkpoint_at = 0usize;
+    for (byte_index, ch) in text.char_indices() {
+        if byte_index.saturating_sub(checkpoint_at) >= 4 * 1024 {
+            control.checkpoint()?;
+            checkpoint_at = byte_index;
+        }
+        if let Some(next) = private_use_index(ch) {
+            if let Some(first) = previous {
+                if first != next {
+                    let second_slot = if next > first { next - 1 } else { next };
+                    let index = first * (0xF900 - 0xE001) + second_slot;
+                    present[index / u64::BITS as usize] |= 1u64 << (index % u64::BITS as usize);
+                }
+                *occurrences = (*occurrences).saturating_add(1);
+            }
+            previous = Some(next);
+        } else {
+            previous = None;
+        }
+    }
+    control.checkpoint()?;
+    Ok(())
+}
+
+fn collect_value_private_use_pairs_controlled(
+    value: &Value,
+    present: &mut [u64],
+    control: &crate::OperationControl,
+    visited_values: &mut usize,
+    occurrences: &mut usize,
+) -> crate::OperationControlResult<()> {
+    *visited_values = (*visited_values).saturating_add(1);
+    if visited_values.is_multiple_of(64) {
+        control.checkpoint()?;
+    }
+    match value {
+        Value::String(text) => {
+            collect_private_use_pairs_controlled(text, present, control, occurrences)?
+        }
+        Value::Array(values) => {
+            for value in values {
+                collect_value_private_use_pairs_controlled(
+                    value,
+                    present,
+                    control,
+                    visited_values,
+                    occurrences,
+                )?;
+            }
+        }
+        Value::Object(values) => {
+            for (key, value) in values {
+                collect_private_use_pairs_controlled(key, present, control, occurrences)?;
+                collect_value_private_use_pairs_controlled(
+                    value,
+                    present,
+                    control,
+                    visited_values,
+                    occurrences,
+                )?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn replace_shape_data_origins_with_tokens(
+    source: &str,
+    origins: &[GeneratedEntityPlaceholder],
+    source_offset: usize,
+    codec: &OriginTokenCodec,
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<Option<String>> {
+    let maximum_origin_count =
+        crate::yaml_config::YAML_PARSER_MAX_INPUT_BYTES / MIN_ORIGIN_ENVELOPE_BYTES;
+    if origins.len() > maximum_origin_count {
+        return Ok(None);
+    }
+    let mut output = String::with_capacity(source.len());
+    let mut canonical_origins = HashMap::<&str, usize>::new();
+    let mut cursor = 0usize;
+    let mut previous_end = 0usize;
+    for (index, origin) in origins.iter().enumerate() {
+        if index.is_multiple_of(128) {
+            control.checkpoint()?;
+        }
+        let (Some(start), Some(prefix_end), Some(suffix_start), Some(end)) = (
+            origin.prefix.start.checked_add(source_offset),
+            origin.prefix.end.checked_add(source_offset),
+            origin.suffix.start.checked_add(source_offset),
+            origin.suffix.end.checked_add(source_offset),
+        ) else {
+            return Ok(None);
+        };
+        if start < previous_end
+            || start < cursor
+            || prefix_end > suffix_start
+            || end > source.len()
+            || !source.is_char_boundary(start)
+            || !source.is_char_boundary(prefix_end)
+            || !source.is_char_boundary(suffix_start)
+            || !source.is_char_boundary(end)
+            || !matches!(source.get(start..prefix_end), Some("ﬂ°" | "ﬂ°°"))
+            || source.get(suffix_start..end) != Some("¶ß")
+        {
+            return Ok(None);
+        }
+        let Some(entity_body) = source.get(prefix_end..suffix_start) else {
+            return Ok(None);
+        };
+        if entity_body.is_empty() || !is_ascii_entity_body_controlled(entity_body, control)? {
+            return Ok(None);
+        }
+        let (Some(before), Some(marker)) = (source.get(cursor..start), source.get(start..end))
+        else {
+            return Ok(None);
+        };
+        output.push_str(before);
+        let canonical_index = *canonical_origins.entry(marker).or_insert(index);
+        if !codec.append_token(canonical_index, &mut output) {
+            return Ok(None);
+        }
+        let estimated_scratch_bytes = canonical_origins
+            .capacity()
+            .saturating_mul(std::mem::size_of::<(&str, usize)>().saturating_add(16));
+        if estimated_scratch_bytes > MAX_ORIGIN_TOKEN_CANONICAL_SCRATCH_BYTES {
+            return Ok(None);
+        }
+        cursor = end;
+        previous_end = end;
+    }
+    let Some(after) = source.get(cursor..) else {
+        return Ok(None);
+    };
+    output.push_str(after);
+    Ok(Some(output))
+}
+
+fn is_ascii_entity_body_controlled(
+    entity_body: &str,
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<bool> {
+    for (index, byte) in entity_body.bytes().enumerate() {
+        if index.is_multiple_of(4096) && index != 0 {
+            control.checkpoint()?;
+        }
+        if !byte.is_ascii_alphanumeric() && byte != b'_' {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+fn restore_shape_data_tokens(
+    mut value: Value,
+    is_root: bool,
+    field: &str,
+    origins: &[GeneratedEntityPlaceholder],
+    codec: &OriginTokenCodec,
+    source: &str,
+    label_origins: &mut Vec<GeneratedEntityPlaceholder>,
+    control: &crate::OperationControl,
+    visited_values: &mut usize,
+) -> crate::OperationControlResult<Result<Value, String>> {
+    *visited_values = (*visited_values).saturating_add(1);
+    if visited_values.is_multiple_of(64) {
+        control.checkpoint()?;
+    }
+    match &mut value {
+        Value::String(text) => {
+            let preserve = is_root;
+            let (restored, found_origins) = match restore_shape_data_token_string(
+                text, preserve, origins, codec, source, control,
+            )? {
+                Ok(restored) => restored,
+                Err(error) => return Ok(Err(error)),
+            };
+            *text = restored;
+            if preserve {
+                label_origins.extend(found_origins);
+            }
+        }
+        Value::Array(values) => {
+            for value in values {
+                *value = match restore_shape_data_tokens(
+                    std::mem::take(value),
+                    false,
+                    field,
+                    origins,
+                    codec,
+                    source,
+                    label_origins,
+                    control,
+                    visited_values,
+                )? {
+                    Ok(value) => value,
+                    Err(error) => return Ok(Err(error)),
+                };
+            }
+        }
+        Value::Object(values) => {
+            let mut restored_values = serde_json::Map::new();
+            for (key, value) in std::mem::take(values) {
+                let (key, _) = match restore_shape_data_token_string(
+                    &key, false, origins, codec, source, control,
+                )? {
+                    Ok(restored) => restored,
+                    Err(error) => return Ok(Err(error)),
+                };
+                let is_label = is_root && key == field;
+                let value = match restore_shape_data_tokens(
+                    value,
+                    is_label,
+                    field,
+                    origins,
+                    codec,
+                    source,
+                    label_origins,
+                    control,
+                    visited_values,
+                )? {
+                    Ok(value) => value,
+                    Err(error) => return Ok(Err(error)),
+                };
+                restored_values.insert(key, value);
+            }
+            *values = restored_values;
+        }
+        _ => {}
+    }
+    Ok(Ok(value))
+}
+
+fn restore_shape_data_token_string(
+    input: &str,
+    preserve_entity_markers: bool,
+    origins: &[GeneratedEntityPlaceholder],
+    codec: &OriginTokenCodec,
+    source: &str,
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<Result<(String, Vec<GeneratedEntityPlaceholder>), String>> {
+    let mut output = String::with_capacity(input.len());
+    let mut mapped_origins = Vec::new();
+    let mut cursor = 0usize;
+    while let Some(start) = find_substring_controlled(input, &codec.prefix, cursor, control)? {
+        output.push_str(&input[cursor..start]);
+        let Some(token_end) = start
+            .checked_add(codec.token_byte_len())
+            .filter(|end| *end <= input.len())
+        else {
+            return Ok(Err(
+                "truncated generated Mermaid shapeData token".to_string()
+            ));
+        };
+        let Some(token) = input.get(start..token_end) else {
+            return Ok(Err(
+                "invalid generated Mermaid shapeData token boundary".to_string()
+            ));
+        };
+        let Some(index) = codec.decode_index(token) else {
+            return Ok(Err("invalid generated Mermaid shapeData token".to_string()));
+        };
+        let Some(origin) = origins.get(index) else {
+            return Ok(Err(
+                "unknown generated Mermaid shapeData token origin".to_string()
+            ));
+        };
+        let marker_start = origin.prefix.start;
+        let marker_end = origin.suffix.end;
+        let Some(marker) = source.get(marker_start..marker_end) else {
+            return Ok(Err(
+                "invalid generated Mermaid shapeData origin range".to_string()
+            ));
+        };
+        let marker_output_start = output.len();
+        if preserve_entity_markers {
+            output.push_str(marker);
+            mapped_origins.push(GeneratedEntityPlaceholder {
+                prefix: marker_output_start + origin.prefix.start - marker_start
+                    ..marker_output_start + origin.prefix.end - marker_start,
+                suffix: marker_output_start + origin.suffix.start - marker_start
+                    ..marker_output_start + origin.suffix.end - marker_start,
+            });
+        } else {
+            output.push_str(crate::entities::decode_mermaid_entities_to_unicode(marker).as_ref());
+        }
+        cursor = token_end;
+    }
+    output.push_str(&input[cursor..]);
+    Ok(Ok((output, mapped_origins)))
+}
+
+fn find_substring_controlled(
+    input: &str,
+    needle: &str,
+    from: usize,
+    control: &crate::OperationControl,
+) -> crate::OperationControlResult<Option<usize>> {
+    const CHECKPOINT_BYTES: usize = 4 * 1024;
+    let bytes = input.as_bytes();
+    let needle = needle.as_bytes();
+    if needle.is_empty() || from > bytes.len() || needle.len() > bytes.len().saturating_sub(from) {
+        return Ok(None);
+    }
+    let final_start = bytes.len() - needle.len();
+    let mut chunk_start = from;
+    while chunk_start <= final_start {
+        control.checkpoint()?;
+        let chunk_end_start = chunk_start
+            .saturating_add(CHECKPOINT_BYTES)
+            .min(final_start + 1);
+        let chunk_end = chunk_end_start.saturating_add(needle.len() - 1);
+        let haystack = &bytes[chunk_start..chunk_end];
+        if let Some(relative) = haystack
+            .windows(needle.len())
+            .position(|window| window == needle)
+        {
+            return Ok(Some(chunk_start + relative));
+        }
+        chunk_start = chunk_end_start;
+    }
+    Ok(None)
+}
