+    assert_eq!(
+        class_origin_text(&origins, 0, crate::diagram::CLASS_RELATION_TITLE1_SLOT),
+        format!("left authored {ORIGIN_MARKER} generated \"")
+    );
+    assert_eq!(
+        class_origin_text(&origins, 0, crate::diagram::CLASS_RELATION_TITLE2_SLOT),
+        format!("right authored {ORIGIN_MARKER} generated \"")
+    );
+}
