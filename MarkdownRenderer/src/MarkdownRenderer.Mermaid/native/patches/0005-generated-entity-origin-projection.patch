+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+        }
+        let Some(actor) = projected.actors.get_mut(actor_id) else {
+            continue;
+        };
+        let owner = sequence_source_owner(ordinal, "actor")?;
+        actor.description = sequence_project_source(
+            render_context.entity_label_source(EntityLabelOriginKey::new(
+                EntityLabelFamily::Sequence,
+                owner,
+                SEQUENCE_ACTOR_LABEL_SLOT,
+            )),
+            &actor.description,
+            "actor label",
+            ordinal,
+            work_meter,
+        )?;
+    }
+    for (ordinal, sequence_box) in projected.boxes.iter_mut().enumerate() {
+        if ordinal.is_multiple_of(SEQUENCE_LAYOUT_CHECKPOINT_INTERVAL) {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+        }
+        let Some(name) = sequence_box.name.as_mut() else {
+            continue;
+        };
+        let owner = sequence_source_owner(ordinal, "box")?;
+        *name = sequence_project_source(
+            render_context.entity_label_source(EntityLabelOriginKey::new(
+                EntityLabelFamily::Sequence,
+                owner,
+                SEQUENCE_BOX_TITLE_SLOT,
+            )),
+            name,
+            "box title",
+            ordinal,
+            work_meter,
+        )?;
+    }
+    for (ordinal, message) in projected.messages.iter_mut().enumerate() {
+        if ordinal.is_multiple_of(SEQUENCE_LAYOUT_CHECKPOINT_INTERVAL) {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+        }
