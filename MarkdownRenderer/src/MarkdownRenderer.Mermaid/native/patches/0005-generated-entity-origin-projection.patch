+//! Exact source provenance for parser-owned render-label projections.
+//!
+//! This module is deliberately internal-facing despite its hidden public types: family parsers
+//! create the ledger from lexer/parser spans, and renderer integrations may only ask it for a
+//! typed projection. It never discovers provenance by searching a decoded string.
+
+use crate::{
+    OperationControl, OperationControlResult, OperationPhase,
+    preprocess::GeneratedEntityPlaceholder,
+};
+use std::{collections::HashMap, ops::Range, sync::Arc};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+#[doc(hidden)]
+pub enum EntityLabelFamily {
+    Sequence,
+    State,
+    Mindmap,
+    Class,
+}
+
+/// Stable typed owner key. Ordinals are positions in the final emitted owner collection, not
+/// parser action counts or input text matches. Slots distinguish labels owned by one record.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+#[doc(hidden)]
+pub struct EntityLabelOriginKey {
+    family: EntityLabelFamily,
+    owner_ordinal: u32,
+    slot: u8,
+    part_ordinal: u32,
+}
+
+impl EntityLabelOriginKey {
+    #[doc(hidden)]
+    pub const fn new(family: EntityLabelFamily, owner_ordinal: u32, slot: u8) -> Self {
+        Self::new_part(family, owner_ordinal, slot, 0)
+    }
+
+    /// Creates a key for one separately projected part of a family-owned field, such as each
+    /// State description associated with one emitted node.
+    #[doc(hidden)]
+    pub const fn new_part(
+        family: EntityLabelFamily,
+        owner_ordinal: u32,
+        slot: u8,
+        part_ordinal: u32,
+    ) -> Self {
+        Self {
+            family,
+            owner_ordinal,
+            slot,
+            part_ordinal,
+        }
+    }
+
+    pub(crate) const fn family(self) -> EntityLabelFamily {
+        self.family
+    }
+}
+
+#[doc(hidden)]
+pub const SEQUENCE_MESSAGE_LABEL_SLOT: u8 = 0;
+#[doc(hidden)]
+pub const SEQUENCE_ACTOR_LABEL_SLOT: u8 = 1;
+#[doc(hidden)]
+pub const SEQUENCE_BOX_TITLE_SLOT: u8 = 2;
+#[doc(hidden)]
+pub const SEQUENCE_DIAGRAM_TITLE_SLOT: u8 = 3;
+#[doc(hidden)]
+pub const SEQUENCE_ACC_TITLE_SLOT: u8 = 4;
+#[doc(hidden)]
+pub const SEQUENCE_ACC_DESCRIPTION_SLOT: u8 = 5;
+#[doc(hidden)]
+pub const MINDMAP_NODE_LABEL_SLOT: u8 = 0;
+#[doc(hidden)]
+pub const STATE_NODE_LABEL_SLOT: u8 = 0;
+#[doc(hidden)]
+pub const STATE_NODE_DESCRIPTION_SLOT: u8 = 1;
+#[doc(hidden)]
+pub const STATE_EDGE_LABEL_SLOT: u8 = 2;
+#[doc(hidden)]
+pub const STATE_NOTE_LABEL_SLOT: u8 = 3;
+#[doc(hidden)]
+pub const CLASS_RELATION_TITLE_SLOT: u8 = 0;
+#[doc(hidden)]
+pub const CLASS_RELATION_TITLE1_SLOT: u8 = 1;
+#[doc(hidden)]
+pub const CLASS_RELATION_TITLE2_SLOT: u8 = 2;
+
+/// One exact label source plus the generated entity ranges that survived preprocessing.
+///
+/// `generated == None` is retained as the legacy/no-origin state; `Some([])` is authoritative
+/// evidence that this exact source contains no parser-generated entity spellings.
+#[derive(Debug, Clone)]
+#[doc(hidden)]
+pub struct OriginTrackedText {
+    text: Arc<str>,
+    generated: Option<Arc<[GeneratedEntityPlaceholder]>>,
+}
+
+impl OriginTrackedText {
+    /// Validates the preprocessor's source-wide origin table once before family parsers make
+    /// per-label projections. Later span lookups rely on this ordering and validate only ranges
+    /// they actually select, keeping a document with many labels linear in source origins.
+    pub(crate) fn validate_source_origins(
+        source: &str,
+        generated: &[GeneratedEntityPlaceholder],
+        control: &OperationControl,
+    ) -> OperationControlResult<bool> {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        let mut previous_end = 0usize;
+        for (index, origin) in generated.iter().enumerate() {
+            if index.is_multiple_of(128) {
+                control.checkpoint_at(OperationPhase::Semantic)?;
+            }
+            if !valid_origin(source, origin) || origin.prefix.start < previous_end {
+                return Ok(false);
+            }
+            previous_end = origin.suffix.end;
+        }
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        Ok(true)
+    }
+
+    /// Captures one exact UTF-8 source span and localizes only fully-contained origin ranges.
+    /// A partial origin or invalid span returns `None`; callers must preserve that as an unmapped
+    /// authoritative label rather than falling back to spelling-based decoding.
+    pub(crate) fn from_source_span(
+        source: &str,
+        span: Range<usize>,
+        generated: Option<&[GeneratedEntityPlaceholder]>,
+        control: &OperationControl,
+    ) -> OperationControlResult<Option<Self>> {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        let Some(text) = source.get(span.clone()) else {
+            return Ok(None);
+        };
+        if !source.is_char_boundary(span.start) || !source.is_char_boundary(span.end) {
+            return Ok(None);
+        }
+
+        let local_origins = match generated {
+            None => None,
+            Some(origins) => {
+                let first = origins.partition_point(|origin| origin.suffix.end <= span.start);
+                let mut selected = Vec::new();
+                let mut previous_end = span.start;
+                for (index, origin) in origins.iter().enumerate().skip(first) {
+                    if index.is_multiple_of(128) {
+                        control.checkpoint_at(OperationPhase::Semantic)?;
+                    }
+                    if origin.prefix.start >= span.end {
+                        break;
+                    }
+                    if !valid_origin(source, origin) {
+                        return Ok(None);
+                    }
+                    let envelope = origin.prefix.start..origin.suffix.end;
+                    let intersects = envelope.start < span.end && span.start < envelope.end;
+                    if !intersects {
+                        continue;
+                    }
+                    if envelope.start < span.start || envelope.end > span.end {
+                        return Ok(None);
+                    }
+                    if origin.prefix.start < previous_end {
+                        return Ok(None);
+                    }
+                    previous_end = origin.suffix.end;
+                    selected.push(GeneratedEntityPlaceholder {
+                        prefix: origin.prefix.start - span.start..origin.prefix.end - span.start,
+                        suffix: origin.suffix.start - span.start..origin.suffix.end - span.start,
+                    });
+                }
+                Some(Arc::from(selected))
+            }
+        };
+
+        let text = copy_with_checkpoints(text, || control.checkpoint_at(OperationPhase::Semantic))?;
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        Ok(Some(Self {
+            text: Arc::from(text),
+            generated: local_origins,
+        }))
+    }
+
+    /// Builds a normalized label from exact, ordered source segments. This supports operations
+    /// such as trimming each parser-owned note line and joining with LF without diffing strings.
+    /// Segments must be ordered, non-overlapping UTF-8 ranges. A generated origin must be wholly
+    /// contained in one selected segment; crossing a dropped boundary is an unmappable result.
+    pub(crate) fn from_source_segments(
+        source: &str,
+        segments: &[Range<usize>],
+        separator: &str,
+        generated: Option<&[GeneratedEntityPlaceholder]>,
+        control: &OperationControl,
+    ) -> OperationControlResult<Option<Self>> {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        let mut output_len = 0usize;
+        let mut previous_end = 0usize;
+        for (index, segment) in segments.iter().enumerate() {
+            if index.is_multiple_of(128) {
+                control.checkpoint_at(OperationPhase::Semantic)?;
+            }
+            if segment.start < previous_end
+                || segment.end < segment.start
+                || source.get(segment.clone()).is_none()
+            {
+                return Ok(None);
+            }
+            previous_end = segment.end;
+            output_len = match output_len.checked_add(segment.end - segment.start) {
+                Some(value) => value,
+                None => return Ok(None),
+            };
+            if index > 0 {
+                output_len = match output_len.checked_add(separator.len()) {
+                    Some(value) => value,
+                    None => return Ok(None),
+                };
+            }
+        }
+        // A normalized projection is allowed to be at most as large as the already-budgeted
+        // preprocessed source. This prevents caller-supplied separators from expanding retention.
+        if output_len > source.len() {
+            return Ok(None);
+        }
+
+        let mut text = String::with_capacity(output_len);
+        let mut local_origins = generated.map(|_| Vec::new());
+        let mut previous_origin_index = 0usize;
+        let mut checkpoint = || control.checkpoint_at(OperationPhase::Semantic);
+        for (segment_index, segment) in segments.iter().enumerate() {
+            if segment_index.is_multiple_of(128) {
+                control.checkpoint_at(OperationPhase::Semantic)?;
+            }
+            if segment_index > 0 {
+                append_with_checkpoints(&mut text, separator, &mut checkpoint)?;
+            }
+            let local_base = text.len();
+            let segment_text = &source[segment.clone()];
+            append_with_checkpoints(&mut text, segment_text, &mut checkpoint)?;
+
+            if let Some(origins) = generated {
+                let selected = OriginTrackedText::from_source_span(
+                    source,
+                    segment.clone(),
+                    Some(&origins[previous_origin_index..]),
+                    control,
+                )?;
+                let Some(selected) = selected else {
+                    return Ok(None);
+                };
+                let Some(selected_origins) = selected.generated.as_deref() else {
+                    return Ok(None);
+                };
+                if let Some(target) = local_origins.as_mut() {
+                    for origin in selected_origins {
+                        target.push(GeneratedEntityPlaceholder {
+                            prefix: origin.prefix.start + local_base
+                                ..origin.prefix.end + local_base,
+                            suffix: origin.suffix.start + local_base
+                                ..origin.suffix.end + local_base,
+                        });
+                    }
+                }
+                previous_origin_index =
+                    origins.partition_point(|origin| origin.suffix.end <= segment.end);
+            }
+        }
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        Ok(Some(Self {
+            text: Arc::from(text),
+            generated: local_origins.map(Arc::from),
+        }))
+    }
+
+    /// Creates an exact synthetic projection whose text is already semantic and has no generated
+    /// preprocessor entities. This is not a license to infer origins from marker spellings.
+    pub(crate) fn from_owned_semantic_text(text: String) -> Self {
+        Self {
+            text: Arc::from(text),
+            generated: Some(Arc::from([])),
+        }
+    }
+
+    /// Returns the original parser-owned source projection to internal family adapters only.
+    /// Renderer crates receive projected text through the typed protection methods instead.
+    pub(crate) fn source_text(&self) -> &str {
+        &self.text
+    }
+
+    /// Returns exact generated entity ranges for a family parser that must preserve origins
+    /// while decoding a parser-owned scalar such as a YAML alias value. This does not expose the
+    /// source text and is not available to renderer consumers.
+    pub(crate) fn generated_placeholders(&self) -> Option<&[GeneratedEntityPlaceholder]> {
+        self.generated.as_deref()
+    }
+
+    /// Resolves only preprocessor ranges recorded by preprocessing. Replacements are appended
+    /// without rescanning, so decoded text cannot synthesize another entity marker.
+    #[doc(hidden)]
+    pub(crate) fn try_semantic_text<E>(
+        &self,
+        checkpoint: impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<String>, E> {
+        let Some(origins) = self.generated.as_deref() else {
+            return copy_with_checkpoints(&self.text, checkpoint).map(Some);
+        };
+        substitute_generated_origins(&self.text, origins, checkpoint)
+    }
+
+    /// Protects authored private-use marker delimiters and carries exact generated entities as
+    /// opaque atoms until a downstream markup classifier has made its decision.
+    #[doc(hidden)]
+    pub fn protect_for_markdown<E>(
+        &self,
+        checkpoint: impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<String>, E> {
+        let Some(origins) = self.generated.as_deref() else {
+            return protect_authored_entity_render_source_controlled(&self.text, checkpoint);
+        };
+        protect_generated_entity_render_source_controlled(&self.text, origins, checkpoint)
+    }
+
+    /// Same origin-preserving projection for renderer routes that treat the value as plain text.
+    #[doc(hidden)]
+    pub fn protect_for_text<E>(
+        &self,
+        checkpoint: impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<String>, E> {
+        self.protect_for_markdown(checkpoint)
+    }
+
+    pub(crate) fn retained_bytes(&self) -> usize {
+        // Overcount Arc headers and allocations because clones in the ledger can share backing
+        // storage. Resource admission favors a conservative retained-size estimate.
+        let arc_allocation_overhead = std::mem::size_of::<usize>() * 4;
+        let text_allocation = self
+            .text
+            .len()
+            .saturating_add(arc_allocation_overhead)
+            .saturating_add(std::mem::size_of::<Arc<str>>());
+        let generated_allocation = self.generated.as_deref().map_or(0, |origins| {
+            origins
+                .len()
+                .saturating_mul(std::mem::size_of::<GeneratedEntityPlaceholder>())
+                .saturating_add(arc_allocation_overhead)
+                .saturating_add(std::mem::size_of::<Arc<[GeneratedEntityPlaceholder]>>())
+        });
+        text_allocation.saturating_add(generated_allocation)
+    }
+
+    /// Returns a conservative size bound for the protected renderer projection without
+    /// allocating it. Authored escape processing is at most 2x source bytes; generated HTML
+    /// entities decode to at most 2x their encoded bytes, then use a 23-byte atom header plus
+    /// two ASCII hex bytes per decoded byte.
+    pub(crate) fn protected_render_source_bytes_upper_bound(&self) -> Option<usize> {
+        self.text.len().checked_mul(4)?.checked_add(
+            self.generated
+                .as_deref()
+                .map_or(0, |origins| origins.len())
+                .checked_mul(23)?,
+        )
+    }
+}
+
+#[derive(Debug, Clone)]
+#[doc(hidden)]
+pub struct EntityLabelOrigins {
+    family: EntityLabelFamily,
+    entries: HashMap<EntityLabelOriginKey, OriginTrackedText>,
+    retained_label_bytes: usize,
+}
+
+impl EntityLabelOrigins {
+    pub(crate) fn new(family: EntityLabelFamily) -> Self {
+        Self {
+            family,
+            entries: HashMap::new(),
+            retained_label_bytes: 0,
+        }
+    }
+
+    pub(crate) fn insert(&mut self, key: EntityLabelOriginKey, text: OriginTrackedText) -> bool {
+        if key.family() != self.family || self.entries.contains_key(&key) {
+            return false;
+        }
+        let retained_label_bytes = text.retained_bytes();
+        self.entries.insert(key, text);
+        self.retained_label_bytes = self
+            .retained_label_bytes
+            .saturating_add(retained_label_bytes);
+        true
+    }
+
+    pub(crate) fn remove(&mut self, key: EntityLabelOriginKey) {
+        if let Some(text) = self.entries.remove(&key) {
+            self.retained_label_bytes = self
+                .retained_label_bytes
+                .saturating_sub(text.retained_bytes());
+        }
+    }
+
+    pub(crate) fn get(&self, key: EntityLabelOriginKey) -> Option<&OriginTrackedText> {
+        self.entries.get(&key)
+    }
+
+    pub(crate) const fn family(&self) -> EntityLabelFamily {
+        self.family
+    }
+
+    pub(crate) fn retained_bytes(&self) -> usize {
+        let capacity = self.entries.capacity();
+        // `HashMap::capacity()` is a logical element capacity, not the raw bucket count. Add
+        // per-entry slack for the table's load factor/control bytes plus a small allocation
+        // header allowance so this retained-size ledger remains conservative.
+        let bucket_bytes = capacity
+            .saturating_mul(
+                std::mem::size_of::<(EntityLabelOriginKey, OriginTrackedText)>().saturating_add(16),
+            )
+            .saturating_add(if capacity == 0 {
+                0
+            } else {
+                std::mem::size_of::<usize>() * 4
+            });
+        std::mem::size_of::<Self>()
+            .saturating_add(bucket_bytes)
+            .saturating_add(self.retained_label_bytes)
+    }
+}
+
+/// Parser-owned source for one typed family label.
+#[derive(Debug, Clone, Copy)]
+#[doc(hidden)]
+pub enum EntityLabelSource<'a> {
+    /// No family origin ledger was attached; retain the old direct-parser behavior.
+    Legacy,
+    /// The family parser attached exact source bytes and exact generated entity ranges.
+    Exact(&'a OriginTrackedText),
+    /// An authoritative family ledger exists, but this owner/slot is absent or mismatched.
+    Unmapped,
+}
+
+impl<'a> EntityLabelSource<'a> {
+    #[doc(hidden)]
+    pub fn protect_for_markdown<E>(
+        &self,
+        checkpoint: impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<String>, E> {
+        match self {
+            Self::Exact(source) => source.protect_for_markdown(checkpoint),
+            Self::Legacy | Self::Unmapped => Ok(None),
+        }
+    }
+
+    #[doc(hidden)]
+    pub fn protect_for_text<E>(
+        &self,
+        checkpoint: impl FnMut() -> std::result::Result<(), E>,
+    ) -> std::result::Result<Option<String>, E> {
+        match self {
+            Self::Exact(source) => source.protect_for_text(checkpoint),
+            Self::Legacy | Self::Unmapped => Ok(None),
+        }
+    }
+
+    /// Returns an allocation-free conservative bound for the exact protected projection.
+    /// Returns `None` when the source is legacy/unmapped or when checked size arithmetic
+    /// overflows; callers must not use either case as a signal to decode by spelling.
+    #[doc(hidden)]
+    pub fn protected_render_source_bytes_upper_bound(&self) -> Option<usize> {
+        match self {
+            Self::Exact(source) => source.protected_render_source_bytes_upper_bound(),
+            Self::Legacy | Self::Unmapped => None,
+        }
+    }
+}
+
+fn valid_origin(source: &str, origin: &GeneratedEntityPlaceholder) -> bool {
+    let start = origin.prefix.start;
+    let prefix_end = origin.prefix.end;
+    let suffix_start = origin.suffix.start;
+    let end = origin.suffix.end;
+    start <= prefix_end
+        && prefix_end <= suffix_start
+        && suffix_start <= end
+        && end <= source.len()
+        && source.is_char_boundary(start)
+        && source.is_char_boundary(prefix_end)
+        && source.is_char_boundary(suffix_start)
+        && source.is_char_boundary(end)
+        && matches!(source.get(start..prefix_end), Some("ﬂ°" | "ﬂ°°"))
+        && source.get(suffix_start..end) == Some("¶ß")
+}
+
+fn substitute_generated_origins<E>(
+    source: &str,
+    origins: &[GeneratedEntityPlaceholder],
+    mut checkpoint: impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<Option<String>, E> {
+    checkpoint()?;
+    if origins.is_empty() {
+        return copy_with_checkpoints(source, checkpoint).map(Some);
+    }
+    let mut output = String::with_capacity(source.len());
+    let mut cursor = 0usize;
+    for (index, origin) in origins.iter().enumerate() {
+        if index.is_multiple_of(128) {
+            checkpoint()?;
+        }
+        if !valid_origin(source, origin) || origin.prefix.start < cursor {
+            return Ok(None);
+        }
+        let Some(authored) = source.get(cursor..origin.prefix.start) else {
+            return Ok(None);
+        };
+        append_with_checkpoints(&mut output, authored, &mut checkpoint)?;
+        let Some(encoded) = source.get(origin.prefix.start..origin.suffix.end) else {
+            return Ok(None);
+        };
+        let Some(decoded) = decode_generated_entity_with_checkpoints(encoded, &mut checkpoint)?
+        else {
+            return Ok(None);
+        };
+        append_with_checkpoints(&mut output, &decoded, &mut checkpoint)?;
+        cursor = origin.suffix.end;
+    }
+    let Some(tail) = source.get(cursor..) else {
+        return Ok(None);
+    };
+    append_with_checkpoints(&mut output, tail, &mut checkpoint)?;
+    checkpoint()?;
+    Ok(Some(output))
+}
+
+fn copy_with_checkpoints<E>(
+    source: &str,
+    checkpoint: impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<String, E> {
+    let mut output = String::with_capacity(source.len());
+    let mut checkpoint = checkpoint;
+    checkpoint()?;
+    append_with_checkpoints(&mut output, source, &mut checkpoint)?;
+    checkpoint()?;
+    Ok(output)
+}
+
+fn append_with_checkpoints<E>(
+    output: &mut String,
+    value: &str,
+    checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<(), E> {
+    const CHECKPOINT_BYTES: usize = 4096;
+    let mut cursor = 0usize;
+    checkpoint()?;
+    let mut next_checkpoint = CHECKPOINT_BYTES;
+    while cursor < value.len() {
+        if cursor >= next_checkpoint {
+            checkpoint()?;
+            next_checkpoint = cursor.saturating_add(CHECKPOINT_BYTES);
+        }
+        let mut end = cursor.saturating_add(CHECKPOINT_BYTES).min(value.len());
+        while end > cursor && !value.is_char_boundary(end) {
+            end -= 1;
+        }
+        if end == cursor {
+            let ch = value[cursor..]
+                .chars()
+                .next()
+                .expect("cursor before input end has a character");
+            end = cursor + ch.len_utf8();
+        }
+        output.push_str(&value[cursor..end]);
+        cursor = end;
+    }
+    Ok(())
+}
+
+fn decode_generated_entity_with_checkpoints<E>(
+    encoded: &str,
+    checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<Option<String>, E> {
+    let (body_with_suffix, numeric) = if let Some(body) = encoded.strip_prefix("ﬂ°°") {
+        (body, true)
+    } else if let Some(body) = encoded.strip_prefix("ﬂ°") {
+        (body, false)
+    } else {
+        return Ok(None);
+    };
+    let Some(body) = body_with_suffix.strip_suffix("¶ß") else {
+        return Ok(None);
+    };
+    let extra = if numeric { 3 } else { 2 };
+    let mut entity = String::with_capacity(body.len().saturating_add(extra));
+    entity.push('&');
+    if numeric {
+        entity.push('#');
+    }
+    append_with_checkpoints(&mut entity, body, checkpoint)?;
+    entity.push(';');
+
+    let mut decoded = String::with_capacity(entity.len());
+    crate::entities::visit_decoded_html_entity_fragments_with_checkpoints(
+        &entity,
+        || checkpoint(),
+        |fragment| {
+            match fragment {
+                crate::entities::DecodedHtmlFragment::Borrowed(text) => decoded.push_str(text),
+                crate::entities::DecodedHtmlFragment::Scalar(value) => decoded.push(value),
+            }
+            Ok(())
+        },
+    )?;
+    Ok(Some(decoded))
+}
+
+pub(crate) fn protect_authored_entity_render_source_controlled<E>(
+    input: &str,
+    mut checkpoint: impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<Option<String>, E> {
+    checkpoint()?;
+    let protected = protect_authored_segment(input, &mut checkpoint)?;
+    checkpoint()?;
+    Ok(Some(protected))
+}
+
+pub(crate) fn protect_generated_entity_render_source_controlled<E>(
+    input: &str,
+    generated: &[GeneratedEntityPlaceholder],
+    mut checkpoint: impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<Option<String>, E> {
+    const ESCAPE: char = '\u{f0000}';
+    const ATOM: char = '\u{fe04}';
+
+    let mut output = String::with_capacity(input.len());
+    let mut cursor = 0usize;
+    for (index, origin) in generated.iter().enumerate() {
+        if index.is_multiple_of(128) {
+            checkpoint()?;
+        }
+        if !valid_origin(input, origin) || origin.prefix.start < cursor {
+            return Ok(None);
+        }
+        let Some(authored) = input.get(cursor..origin.prefix.start) else {
+            return Ok(None);
+        };
+        output.push_str(&protect_authored_segment(authored, &mut checkpoint)?);
+        let Some(encoded) = input.get(origin.prefix.start..origin.suffix.end) else {
+            return Ok(None);
+        };
+        let Some(decoded) = decode_generated_entity_with_checkpoints(encoded, &mut checkpoint)?
+        else {
+            return Ok(None);
+        };
+        output.push(ESCAPE);
+        output.push(ATOM);
+        use std::fmt::Write as _;
+        let _ = write!(output, "{:016X}", decoded.len());
+        for (byte_index, byte) in decoded.bytes().enumerate() {
+            if byte_index.is_multiple_of(2048) {
+                checkpoint()?;
+            }
+            let _ = write!(output, "{byte:02X}");
+        }
+        cursor = origin.suffix.end;
+    }
+    let Some(tail) = input.get(cursor..) else {
+        return Ok(None);
+    };
+    output.push_str(&protect_authored_segment(tail, &mut checkpoint)?);
+    checkpoint()?;
+    Ok(Some(output))
+}
+
+pub(crate) fn append_generated_entity_atom(output: &mut String, value: &str) {
+    const ESCAPE: char = '\u{f0000}';
+    const ATOM: char = '\u{fe04}';
+    output.push(ESCAPE);
+    output.push(ATOM);
+    use std::fmt::Write as _;
+    let _ = write!(output, "{:016X}", value.len());
+    for byte in value.bytes() {
+        let _ = write!(output, "{byte:02X}");
+    }
+}
+
+fn protect_authored_segment<E>(
+    input: &str,
+    checkpoint: &mut impl FnMut() -> std::result::Result<(), E>,
+) -> std::result::Result<String, E> {
+    const ESCAPE: char = '\u{f0000}';
+    const LITERAL_PREFIX: char = '\u{fe00}';
+    const LITERAL_NUMERIC_PREFIX: char = '\u{fe01}';
+    const LITERAL_SUFFIX: char = '\u{fe02}';
+    const ESCAPE_ESCAPE: char = '\u{fe03}';
+    const CHECKPOINT_BYTES: usize = 4096;
+
+    let mut output = String::with_capacity(input.len());
+    let mut cursor = 0usize;
+    let mut next_checkpoint = 0usize;
+    while cursor < input.len() {
+        if cursor >= next_checkpoint {
+            checkpoint()?;
+            next_checkpoint = cursor.saturating_add(CHECKPOINT_BYTES);
+        }
+        let rest = &input[cursor..];
+        if rest.starts_with("ﬂ°°") {
+            output.push(ESCAPE);
+            output.push(LITERAL_NUMERIC_PREFIX);
+            cursor += "ﬂ°°".len();
+            continue;
+        }
+        if rest.starts_with("ﬂ°") {
+            output.push(ESCAPE);
+            output.push(LITERAL_PREFIX);
+            cursor += "ﬂ°".len();
+            continue;
+        }
+        if rest.starts_with("¶ß") {
+            output.push(ESCAPE);
+            output.push(LITERAL_SUFFIX);
+            cursor += "¶ß".len();
+            continue;
+        }
+        let character = rest
+            .chars()
+            .next()
+            .expect("cursor before input end has a character");
+        if character == ESCAPE {
+            output.push(ESCAPE);
+            output.push(ESCAPE_ESCAPE);
+        } else {
+            output.push(character);
+        }
+        cursor += character.len_utf8();
+    }
+    Ok(output)
+}
