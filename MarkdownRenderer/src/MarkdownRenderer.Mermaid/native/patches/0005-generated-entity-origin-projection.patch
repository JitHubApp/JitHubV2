+            "diagram title",
+            0,
+        )?;
+    }
+    if model.acc_title.is_some() {
+        add_source_bound(
+            render_context.entity_label_source(EntityLabelOriginKey::new(
+                EntityLabelFamily::Sequence,
+                0,
+                SEQUENCE_ACC_TITLE_SLOT,
+            )),
+            "accessibility title",
+            0,
