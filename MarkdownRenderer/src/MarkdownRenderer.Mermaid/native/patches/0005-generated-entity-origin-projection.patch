+    fn malformed_private_origin_tokens_fail_closed_instead_of_leaking_to_text() {
+        let codec = OriginTokenCodec {
+            kind: OriginTokenPrefixKind::Scalar('\u{e000}'),
+            prefix: "\u{e000}".to_string(),
+            suffix_bytes: 6,
+        };
+        for input in [
+            "\u{e000}",
+            "\u{e000}\u{e000}\u{e001}",
+            "\u{e000}\u{e001}\u{e002}",
+        ] {
