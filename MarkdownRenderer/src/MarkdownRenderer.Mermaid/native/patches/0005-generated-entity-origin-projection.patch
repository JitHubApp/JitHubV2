+/// Returns the byte end of a well-framed flowchart projection token without allocating its value.
+/// This is used by the SVG word wrapper so an owned atom is never split into visible-looking
+/// frame characters while text is measured or wrapped.
+pub(crate) fn flowchart_projection_token_end(text: &str, start: usize) -> Option<usize> {
+    let rest = text.get(start..)?;
+    let mut chars = rest.chars();
+    if chars.next()? != MERMAID_LITERAL_PLACEHOLDER_ESCAPE {
+        return None;
+    }
+    let selector = chars.next()?;
+    let token_end = start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8() + selector.len_utf8();
+    match selector {
+        MERMAID_LITERAL_PLACEHOLDER_PREFIX
+        | MERMAID_LITERAL_PLACEHOLDER_NUMERIC_PREFIX
+        | MERMAID_LITERAL_PLACEHOLDER_SUFFIX
+        | MERMAID_LITERAL_PLACEHOLDER_ESCAPE_ESCAPE => Some(token_end),
+        MERMAID_GENERATED_ENTITY_ATOM => {
+            let length_end = token_end.checked_add(GENERATED_ENTITY_ATOM_LENGTH_HEX_DIGITS)?;
+            let length_text = text.get(token_end..length_end)?;
+            if !length_text.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+                return None;
+            }
+            let payload_len = usize::from_str_radix(length_text, 16).ok()?;
+            let payload_hex_len = payload_len.checked_mul(2)?;
+            let payload_end = length_end.checked_add(payload_hex_len)?;
+            let payload_hex = text.get(length_end..payload_end)?;
+            payload_hex
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+                .then_some(payload_end)
+        }
+        _ => None,
+    }
+}
+
+fn decode_ascii_hex_nibble(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        b'A'..=b'F' => Some(byte - b'A' + 10),
+        _ => None,
+    }
+}
