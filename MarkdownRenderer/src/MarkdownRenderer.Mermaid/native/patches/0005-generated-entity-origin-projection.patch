+
+    fn relative_to(
+        placeholder: &GeneratedEntityPlaceholder,
+        base: usize,
+    ) -> GeneratedEntityPlaceholder {
+        GeneratedEntityPlaceholder {
+            prefix: placeholder.prefix.start - base..placeholder.prefix.end - base,
+            suffix: placeholder.suffix.start - base..placeholder.suffix.end - base,
+        }
+    }
+
+    #[test]
+    fn label_projection_uses_the_sorted_local_range_and_preserves_option_state() {
+        let mut input = String::new();
+        let mut origins = Vec::new();
+        for _ in 0..256 {
+            origins.push(append_placeholder(&mut input));
+            input.push(' ');
+        }
+
+        let label_start = input.len();
+        input.push_str("before ");
+        let in_label = append_placeholder(&mut input);
+        origins.push(in_label.clone());
+        input.push_str(" after");
+        let label_end = input.len();
+        for _ in 0..256 {
+            input.push(' ');
+            origins.push(append_placeholder(&mut input));
+        }
+        let label = &input[label_start..label_end];
+        let span = SourceSpan::new(label_start, label_end);
+
+        let projected = generated_entity_placeholders_for_label(
+            &input,
+            span,
+            label,
+            &TitleKind::Text,
+            Some(&origins),
+        );
+        assert_eq!(projected, Some(vec![relative_to(&in_label, label_start)]));
+        assert_eq!(
+            generated_entity_placeholders_for_label(
+                &input,
+                span,
+                label,
+                &TitleKind::Text,
+                Some(&[]),
+            ),
+            Some(Vec::new())
+        );
+        assert_eq!(
+            generated_entity_placeholders_for_label(&input, span, label, &TitleKind::Text, None,),
+            None
+        );
+    }
+
+    #[test]
+    fn shape_data_segments_walk_origins_once_and_keep_partial_overlap_dropped() {
+        let mut input = String::new();
+        let mut origins = Vec::new();
+        for _ in 0..256 {
+            origins.push(append_placeholder(&mut input));
+            input.push('|');
+        }
+
+        let first_segment_start = input.len();
+        input.push_str("first=");
+        let first = append_placeholder(&mut input);
+        let crossing_prefix_start = input.len();
+        input.push_str("ﬂ°x");
+        let crossing_prefix_end = input.len();
+        input.push('"');
+        let first_segment_end = input.len();
+        let second_segment_start = input.len();
+        let crossing_suffix_start = input.len();
+        input.push_str("¶ß");
+        input.push_str("second=");
+        let second = append_placeholder(&mut input);
+        input.push('"');
+        let second_segment_end = input.len();
+        origins.push(first.clone());
+        // This malformed range intersects both segments but is fully contained in neither. Like
+        // the previous full scan, the optimized cursor must not invent a partial origin for it.
+        origins.push(GeneratedEntityPlaceholder {
+            prefix: crossing_prefix_start..crossing_prefix_end,
+            suffix: crossing_suffix_start..crossing_suffix_start + "¶ß".len(),
+        });
+        origins.push(second.clone());
+        origins.sort_by_key(|origin| origin.prefix.start);
+        assert!(origins.windows(2).all(|pair| {
+            pair[0].prefix.start <= pair[1].prefix.start
+                && pair[0].suffix.end <= pair[1].prefix.start
+        }));
+
+        let mut output = String::new();
+        let mut mapped = Vec::new();
+        let mut next_origin = 0;
+        append_shape_data_source_segment(
+            &input,
+            first_segment_start..first_segment_end,
+            Some(&origins),
+            &mut next_origin,
+            &mut output,
+            &mut mapped,
+        );
+        assert_eq!(next_origin, 258);
+        let first_output = relative_to(&first, first_segment_start);
+        assert_eq!(mapped, vec![first_output.clone()]);
+
+        let second_output_start = output.len();
+        append_shape_data_source_segment(
+            &input,
+            second_segment_start..second_segment_end,
+            Some(&origins),
+            &mut next_origin,
+            &mut output,
+            &mut mapped,
+        );
+        let mut expected_second = relative_to(&second, second_segment_start);
+        expected_second.prefix = second_output_start + expected_second.prefix.start
+            ..second_output_start + expected_second.prefix.end;
+        expected_second.suffix = second_output_start + expected_second.suffix.start
+            ..second_output_start + expected_second.suffix.end;
+        assert_eq!(mapped, vec![first_output, expected_second]);
+        assert_eq!(
+            output,
+            format!(
+                "{}{}",
+                &input[first_segment_start..first_segment_end],
+                &input[second_segment_start..second_segment_end]
+            )
+        );
+
+        // The prefix and suffix straddle the segment boundary, so it never gains an origin range.
+        assert_eq!(mapped.len(), 2);
+    }
+}
