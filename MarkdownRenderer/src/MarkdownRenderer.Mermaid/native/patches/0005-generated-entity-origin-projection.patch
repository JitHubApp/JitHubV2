+    fn origin(source: &str, spelling: &str) -> GeneratedEntityPlaceholder {
+        let start = source.find(spelling).expect("placeholder spelling");
+        let prefix = if spelling.starts_with("ﬂ°°") {
+            "ﬂ°°"
+        } else {
+            "ﬂ°"
+        };
+        GeneratedEntityPlaceholder {
+            prefix: start..start + prefix.len(),
+            suffix: start + spelling.len() - "¶ß".len()..start + spelling.len(),
+        }
+    }
