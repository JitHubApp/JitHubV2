diff --git a/crates/merman-core/src/diagrams/state/entity_label_origin_tests.rs b/crates/merman-core/src/diagrams/state/entity_label_origin_tests.rs
new file mode 100644
index 000000000..6504b0e47
--- /dev/null
+++ b/crates/merman-core/src/diagrams/state/entity_label_origin_tests.rs
@@ -0,0 +1,141 @@
+use super::{
+    parse_state_model_for_render_controlled_with_entity_label_origins, StateDiagramRenderModel,
+};
+use crate::{
+    diagram::{EntityLabelFamily, EntityLabelOriginKey, EntityLabelOrigins},
+    preprocess::GeneratedEntityPlaceholder,
+    Engine, OperationControl,
+};
+use std::convert::Infallible;
+
+const MARKER: &str = "ﬂ°quot¶ß";
+
+fn generated_every_second_marker(source: &str) -> Vec<GeneratedEntityPlaceholder> {
+    source
+        .match_indices(MARKER)
+        .enumerate()
+        .filter_map(|(index, (start, _))| {
+            (index % 2 == 1).then_some(GeneratedEntityPlaceholder {
+                prefix: start..start + "ﬂ°".len(),
+                suffix: start + "ﬂ°quot".len()..start + MARKER.len(),
+            })
+        })
+        .collect()
+}
+
+fn origin_text(
+    origins: &EntityLabelOrigins,
+    owner: usize,
+    slot: u8,
+    part: u32,
+) -> String {
+    let owner = u32::try_from(owner).expect("small test fixture owner ordinal");
+    origins
+        .get(EntityLabelOriginKey::new_part(
+            EntityLabelFamily::State,
+            owner,
+            slot,
+            part,
+        ))
+        .expect("authoritative state origin")
+        .try_semantic_text(|| Ok::<(), Infallible>(()))
+        .expect("infallible projection")
+        .expect("valid exact source mapping")
+}
+
+fn parse_with_origins(source: &str) -> (StateDiagramRenderModel, EntityLabelOrigins) {
+    let meta = Engine::new()
+        .parse_metadata_with_type_sync("stateDiagram-v2", source)
+        .expect("state metadata");
+    let generated = generated_every_second_marker(source);
+    parse_state_model_for_render_controlled_with_entity_label_origins(
+        source,
+        &meta,
+        &OperationControl::new(),
+        Some(&generated),
+    )
+    .expect("not cancelled")
+    .expect("valid state diagram")
+}
+
+#[test]
+fn generated_entities_keep_exact_state_node_description_edge_and_note_ownership() {
+    let source = concat!(
+        "stateDiagram-v2\n",
+        "state \"node authored ﬂ°quot¶ß generated ﬂ°quot¶ß\" as A\n",
+        "A : description authored ﬂ°quot¶ß generated ﬂ°quot¶ß\n",
+        "B\n",
+        "A --> B : edge authored ﬂ°quot¶ß generated ﬂ°quot¶ß\n",
+        "note right of A : note authored ﬂ°quot¶ß generated ﬂ°quot¶ß\n",
+    );
+
+    let (model, origins) = parse_with_origins(source);
+    let expected_node_label = format!("node authored {MARKER} generated \"");
+    let expected_description = format!("description authored {MARKER} generated \"");
+    let expected_edge = format!("edge authored {MARKER} generated \"");
+    let expected_note = format!("note authored {MARKER} generated \"");
+    let encoded_note = format!("note authored {MARKER} generated {MARKER}");
+
+    let node_index = model
+        .nodes
+        .iter()
+        .position(|node| node.id == "A")
+        .expect("state A");
+    assert_eq!(
+        origin_text(&origins, node_index, crate::diagram::STATE_NODE_LABEL_SLOT, 0),
+        expected_node_label
+    );
+    assert_eq!(
+        origin_text(
+            &origins,
+            node_index,
+            crate::diagram::STATE_NODE_DESCRIPTION_SLOT,
+            0,
+        ),
+        expected_description
+    );
+
+    let plain_id_index = model
+        .nodes
+        .iter()
+        .position(|node| node.id == "B")
+        .expect("state B");
+    assert_eq!(
+        origin_text(&origins, plain_id_index, crate::diagram::STATE_NODE_LABEL_SLOT, 0),
+        "B",
+        "ordinary ID-backed labels must also be mapped in an authoritative family ledger"
+    );
+
+    let edge_index = model
+        .edges
+        .iter()
+        .position(|edge| edge.label.contains("edge authored"))
+        .expect("labeled A-to-B edge");
+    assert_eq!(
+        origin_text(&origins, edge_index, crate::diagram::STATE_EDGE_LABEL_SLOT, 0),
+        expected_edge
+    );
+
+    let note_owners: Vec<_> = model
+        .nodes
+        .iter()
+        .enumerate()
+        .filter(|(_, node)| node.shape == "note" || node.shape == "noteGroup")
+        .collect();
+    assert_eq!(note_owners.len(), 2, "note group and note node are both emitted owners");
+    for (owner, node) in note_owners {
+        assert_eq!(
+            node.label.as_ref().and_then(serde_json::Value::as_str),
+            Some(encoded_note.as_str()),
+            "the legacy model retains its encoded note string; decoding is asserted on the exact source projection below"
+        );
+        assert_eq!(
+            origin_text(&origins, owner, crate::diagram::STATE_NODE_LABEL_SLOT, 0),
+            expected_note
+        );
+        assert_eq!(
+            origin_text(&origins, owner, crate::diagram::STATE_NOTE_LABEL_SLOT, 0),
+            expected_note
+        );
+    }
+}
