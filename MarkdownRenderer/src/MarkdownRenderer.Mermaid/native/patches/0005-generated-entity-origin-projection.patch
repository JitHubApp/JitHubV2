+                    }
+                },
+            };
+            if !origins.insert(
+                EntityLabelOriginKey::new(EntityLabelFamily::Sequence, ordinal, 0),
+                source,
+            ) {
+                return Ok(Err("duplicate sequence message source owner".into()));
+            }
+        }
+        Ok(Ok((self.into_render_model(), origins)))
