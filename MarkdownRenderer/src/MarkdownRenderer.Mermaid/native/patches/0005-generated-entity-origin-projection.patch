+                    && config
+                        .as_mut()
+                        .map_or(Ok(true), |text| text.resolve_span(code, control))?
+            }
+            Self::EnsureParticipant { id } | Self::SetTitle(id) => {
+                id.resolve_span(code, control)?
+            }
+            Self::SetAccTitle(text) | Self::SetAccDescr(text) => {
+                if !text.resolve_span(code, control)? {
+                    false
+                } else {
+                    text.trim_text_and_span(control)?
+                }
+            }
+            Self::ControlSignal {
+                text: description, ..
+            } => description
+                .as_mut()
+                .map_or(Ok(true), |text| text.resolve_span(code, control))?,
+            Self::AddMessage { text, .. }
+            | Self::AddNote { text, .. }
+            | Self::BoxStart { header: text } => text.resolve_span(code, control)?,
+            _ => true,
+        };
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        Ok(resolved)
+    }
+}
