+            generated_entity_placeholders: Some(vec![first]),
+        };
+        let second_key = MermaidShapeDataSourceKey {
+            yaml: source.to_owned(),
+            generated_entity_placeholders: Some(vec![second]),
+        };
+        let mut cache = std::collections::HashMap::new();
+        cache.insert(first_key, 1);
+        cache.insert(second_key, 2);
