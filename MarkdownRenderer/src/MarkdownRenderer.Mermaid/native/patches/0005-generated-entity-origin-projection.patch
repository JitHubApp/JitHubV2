+fn sequence_sanitize_accessibility_title(
+    protected_source: &str,
+    config: &MermaidConfig,
+    work_meter: &OperationWorkMeter,
+) -> Result<String> {
+    // Sequence's common-db title policy is sanitizeText followed by trimStart. Run the existing
+    // sanitizer while generated entities and authored marker-shaped text are still protected,
+    // then apply the same Unicode-whitespace trim before decoding any generated atom.
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
+    let sanitized = merman_core::sanitize::sanitize_text(protected_source, config);
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
+    let mut leading_end = 0usize;
+    let mut scanned = 0usize;
+    for (offset, character) in sanitized.char_indices() {
+        if scanned >= SEQUENCE_TEXT_CHECKPOINT_INTERVAL_BYTES {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+            scanned = 0;
+        }
+        if !character.is_whitespace() {
+            leading_end = offset;
+            break;
+        }
+        leading_end = offset + character.len_utf8();
+        scanned = scanned.saturating_add(character.len_utf8());
+    }
+    let mut output = String::with_capacity(sanitized.len().saturating_sub(leading_end));
+    append_sequence_text_with_checkpoints(&mut output, &sanitized[leading_end..], || {
+        work_meter
+            .checkpoint(OperationPhase::Layout)
+            .map_err(Error::from)
+    })?;
+    Ok(output)
+}
+
+fn sequence_sanitize_accessibility_description(
+    protected_source: &str,
+    config: &MermaidConfig,
+    work_meter: &OperationWorkMeter,
+) -> Result<String> {
+    // Sequence's common-db description policy is sanitizeText followed by
+    // `/\n\s+/g -> "\n"`. Keeping protected atoms opaque during this transform also preserves
+    // the legacy behavior where an entity-decoded newline is not collapsed a second time.
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
+    let sanitized = merman_core::sanitize::sanitize_text(protected_source, config);
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
+
+    let mut output = String::with_capacity(sanitized.len());
+    let mut characters = sanitized.chars().peekable();
+    let mut scanned = 0usize;
+    while let Some(character) = characters.next() {
+        if scanned >= SEQUENCE_TEXT_CHECKPOINT_INTERVAL_BYTES {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+            scanned = 0;
+        }
+        output.push(character);
+        scanned = scanned.saturating_add(character.len_utf8());
+        if character == '\n' {
+            while characters.peek().is_some_and(|next| next.is_whitespace()) {
+                if scanned >= SEQUENCE_TEXT_CHECKPOINT_INTERVAL_BYTES {
+                    work_meter
+                        .checkpoint(OperationPhase::Layout)
+                        .map_err(Error::from)?;
+                    scanned = 0;
+                }
+                let skipped = characters.next().expect("peeked whitespace character");
+                scanned = scanned.saturating_add(skipped.len_utf8());
+            }
+        }
+    }
+    work_meter
+        .checkpoint(OperationPhase::Layout)
+        .map_err(Error::from)?;
+    Ok(output)
+}
+
+fn append_sequence_text_with_checkpoints(
+    output: &mut String,
+    value: &str,
+    mut checkpoint: impl FnMut() -> Result<()>,
+) -> Result<()> {
+    const CHUNK_BYTES: usize = 4 * 1024;
+    let mut cursor = 0usize;
+    checkpoint()?;
+    while cursor < value.len() {
+        let mut end = cursor.saturating_add(CHUNK_BYTES).min(value.len());
+        while !value.is_char_boundary(end) {
+            end -= 1;
+        }
+        if end == cursor {
+            let character = value[cursor..]
+                .chars()
+                .next()
+                .expect("cursor before input end has a character");
+            end += character.len_utf8();
+        }
+        output.push_str(&value[cursor..end]);
+        cursor = end;
+        checkpoint()?;
+    }
+    Ok(())
+}
