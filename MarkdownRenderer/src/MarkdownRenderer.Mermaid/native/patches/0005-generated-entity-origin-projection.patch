+pub(crate) fn measure_state_markdown_label_from_flowchart_projection(
+    text: &str,
+    measurer: &dyn TextMeasurer,
+    style: &TextStyle,
+    max_width: Option<f64>,
+    wrap_mode: WrapMode,
+) -> StateLabelMeasurement {
+    let max_width = max_width.filter(|width| width.is_finite() && *width > 0.0);
+    let measure = |width: Option<f64>| match wrap_mode {
+        WrapMode::HtmlLike => {
+            crate::text::measure_markdown_with_inline_styles_from_flowchart_html_projection(
+                measurer, text, style, width, wrap_mode,
+            )
+        }
+        WrapMode::SvgLike | WrapMode::SvgLikeSingleRun => {
+            crate::text::measure_wrapped_markdown_with_inline_styles_from_flowchart_projection(
+                measurer, text, style, width, wrap_mode,
+            )
+        }
+    };
+    let natural = measure(None);
+    let mut metrics = measure(max_width);
+    let uses_html_wrapping_table = wrap_mode == WrapMode::HtmlLike
+        && max_width.is_some_and(|width| natural.width >= width - 1e-9);
+
+    if let Some(max_width) = max_width
+        && metrics.width > max_width + 1e-9
+    {
+        let reflowed = measure(Some(metrics.width));
+        metrics.width = metrics.width.max(reflowed.width);
+        metrics.height = reflowed.height;
+        metrics.line_count = reflowed.line_count;
+    }
+
+    StateLabelMeasurement {
+        metrics,
+        uses_html_wrapping_table,
+    }
+}
