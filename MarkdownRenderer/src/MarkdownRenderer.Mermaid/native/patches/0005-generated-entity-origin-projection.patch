+pub(crate) fn decode_flowchart_text_projection(text: &str) -> Cow<'_, str> {
+    if !text.contains(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        return decode_flowchart_svg_text_content_entities(text);
+    }
