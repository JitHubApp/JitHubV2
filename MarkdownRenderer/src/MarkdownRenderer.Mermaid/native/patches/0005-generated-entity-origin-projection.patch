+                message: format!(
+                    "sequence render source projection is invalid for {role} ordinal {ordinal}"
+                ),
+            }),
+        EntityLabelSource::Unmapped => Err(Error::InvalidModel {
+            message: format!("sequence render source is missing for {role} ordinal {ordinal}"),
+        }),
+    }
+}
