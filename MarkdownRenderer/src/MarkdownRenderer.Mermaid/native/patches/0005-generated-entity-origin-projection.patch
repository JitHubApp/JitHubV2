+        let source = "prefix ﬂ°quot¶ß suffix";
+        let generated = [origin(source, "ﬂ°quot¶ß")];
+        let control = OperationControl::new();
+        let exact = OriginTrackedText::from_source_span(
+            source,
+            "prefix ".len()..source.len() - " suffix".len(),
+            Some(&generated),
+            &control,
+        )
+        .expect("not cancelled")
+        .expect("full origin span");
+        assert_eq!(
+            exact
+                .try_semantic_text(|| Ok::<(), std::convert::Infallible>(()))
+                .expect("infallible projection")
+                .expect("exact generated origin"),
+            "\""
+        );
+        assert!(
+            OriginTrackedText::from_source_span(
+                source,
+                "prefix ".len().."prefix ﬂ°".len(),
+                Some(&generated),
+                &control,
+            )
+            .expect("not cancelled")
+            .is_none()
+        );
+    }
