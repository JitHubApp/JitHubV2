+        let label_origins = document
+            .label_generated_entity_placeholders
+            .as_ref()
+            .expect("preprocessed input retains provenance state");
+        assert_eq!(label_origins.len(), 1);
+        assert_eq!(label.get(label_origins[0].prefix.clone()), Some("ﬂ°"));
