+        let mut chars = codec.prefix.chars();
+        let first = chars.next().expect("first delimiter scalar");
+        let second = chars.next().expect("second delimiter scalar");
+        assert_eq!(codec.kind, OriginTokenPrefixKind::Pair(first, second));
+        assert!(chars.next().is_none());
+        assert_ne!(
+            first, second,
