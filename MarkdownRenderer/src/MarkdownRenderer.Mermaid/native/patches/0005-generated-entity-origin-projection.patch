+                CLASS_RELATION_TITLE2_SLOT,
+                relation.relation_title2.as_deref(),
+                relation.relation_title2_span,
+            )?;
+        }
+        control.checkpoint()?;
+        Ok((self.into_typed_model(meta), origins))
+    }
+}
+
+fn add_class_relation_origin(
+    origins: &mut EntityLabelOrigins,
+    source: &str,
+    generated: Option<&[GeneratedEntityPlaceholder]>,
+    control: &OperationControl,
+    owner_ordinal: u32,
+    slot: u8,
+    value: Option<&str>,
+    span: Option<SourceSpan>,
+) -> OperationControlResult<()> {
+    let Some(value) = value else {
+        return Ok(());
+    };
+    let Some(span) = span else {
+        if !value.is_empty() {
+            return Ok(());
+        }
+        let key = EntityLabelOriginKey::new_part(EntityLabelFamily::Class, owner_ordinal, slot, 0);
+        let _ = origins.insert(
+            key,
+            OriginTrackedText::from_owned_semantic_text(String::new()),
+        );
+        return Ok(());
+    };
+    let range = if slot == CLASS_RELATION_TITLE_SLOT {
+        cleaned_relation_title_source_range(source, span)
+    } else {
+        source_trimmed_range(source, span)
+    };
+    let Some(range) = range else {
+        return Ok(());
+    };
+    let Some(tracked) = OriginTrackedText::from_source_span(source, range, generated, control)?
+    else {
+        return Ok(());
+    };
+    let key = EntityLabelOriginKey::new_part(EntityLabelFamily::Class, owner_ordinal, slot, 0);
+    let _ = origins.insert(key, tracked);
+    Ok(())
+}
+
+fn source_trimmed_range(source: &str, span: SourceSpan) -> Option<Range<usize>> {
+    let text = source.get(span.start..span.end)?;
+    let leading = text.len().saturating_sub(text.trim_start().len());
+    let trailing = text.trim_end().len();
+    Some(span.start.checked_add(leading)?..span.start.checked_add(trailing)?)
+}
+
+fn cleaned_relation_title_source_range(source: &str, span: SourceSpan) -> Option<Range<usize>> {
+    let range = source_trimmed_range(source, span)?;
+    let text = source.get(range.clone())?;
+    let range = if text.starts_with(':') {
+        let start = range.start.checked_add(':'.len_utf8())?;
+        start..range.end
+    } else {
+        range
+    };
+    source_trimmed_range(
+        source,
+        SourceSpan::new(range.start, range.end),
+    )
 }
