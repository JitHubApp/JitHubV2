+fn generated_entity_placeholders_for_label(
+    input: &str,
+    content_span: SourceSpan,
+    value: &str,
+    kind: &TitleKind,
+    generated_entity_placeholders: Option<&[GeneratedEntityPlaceholder]>,
+) -> Option<Vec<GeneratedEntityPlaceholder>> {
+    let generated_entity_placeholders = generated_entity_placeholders?;
+    let Some(raw) = input.get(content_span.start..content_span.end) else {
+        return Some(Vec::new());
+    };
+    let Some(value_range) = normalized_label_value_range(raw, value, kind) else {
+        return Some(Vec::new());
+    };
+    let Some(value_start) = content_span.start.checked_add(value_range.start) else {
+        return Some(Vec::new());
+    };
+    let Some(value_end) = content_span.start.checked_add(value_range.end) else {
+        return Some(Vec::new());
+    };
+
+    // Provenance is sorted by source offset. Restrict validation to the label's candidate window
+    // instead of scanning every entity in the diagram for each projected label.
+    let first = generated_entity_placeholders
+        .partition_point(|placeholder| placeholder.prefix.start < value_start);
+    let candidate_count = generated_entity_placeholders[first..]
+        .partition_point(|placeholder| placeholder.prefix.start < value_end);
+    let candidates = &generated_entity_placeholders[first..first + candidate_count];
+
+    Some(
+        candidates
+            .iter()
+            .filter_map(|placeholder| {
+                if placeholder.suffix.end > value_end
+                    || placeholder.prefix.end > placeholder.suffix.start
+                {
+                    return None;
+                }
+                if input.get(placeholder.prefix.clone())
+                    != Some(if placeholder.prefix.len() == "ﬂ°".len() {
+                        "ﬂ°"
+                    } else {
+                        "ﬂ°°"
+                    })
+                    || input.get(placeholder.suffix.clone()) != Some("¶ß")
+                {
+                    return None;
+                }
+
+                let value_offset = |offset: usize| offset.checked_sub(value_start);
+                Some(GeneratedEntityPlaceholder {
+                    prefix: value_offset(placeholder.prefix.start)?
+                        ..value_offset(placeholder.prefix.end)?,
+                    suffix: value_offset(placeholder.suffix.start)?
+                        ..value_offset(placeholder.suffix.end)?,
+                })
+            })
+            .collect(),
+    )
+}
+
+fn normalized_label_value_range(raw: &str, value: &str, kind: &TitleKind) -> Option<Range<usize>> {
+    let mut start = 0usize;
+    let mut end = raw.len();
+    let quoted = raw.starts_with('"') && raw.ends_with('"');
+    if quoted {
+        start += 1;
+        end = end.checked_sub(1)?;
+    }
+
+    if quoted && *kind == TitleKind::Markdown {
+        let inner = raw.get(start..end)?;
+        if inner.starts_with('`') && inner.ends_with('`') {
+            start += 1;
+            end = end.checked_sub(1)?;
+        }
+    }
+
+    while start < end {
+        let ch = raw.get(start..end)?.chars().next()?;
+        if !is_ecmascript_trim_char(ch) {
+            break;
+        }
+        start += ch.len_utf8();
+    }
+    while start < end {
+        let ch = raw.get(start..end)?.chars().next_back()?;
+        if !is_ecmascript_trim_char(ch) {
+            break;
+        }
+        end -= ch.len_utf8();
+    }
+
+    (raw.get(start..end)? == value).then_some(start..end)
+}
