+            render_context.entity_label_source(EntityLabelOriginKey::new(
+                EntityLabelFamily::Sequence,
+                0,
+                SEQUENCE_ACC_DESCRIPTION_SLOT,
+            )),
+            "accessibility description",
+            0,
+        )?;
+    }
+    for (ordinal, actor_id) in model.actor_order.iter().enumerate() {
+        if ordinal.is_multiple_of(SEQUENCE_LAYOUT_CHECKPOINT_INTERVAL) {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+        }
+        if model.actors.contains_key(actor_id) {
+            let owner = sequence_source_owner(ordinal, "actor")?;
+            add_source_bound(
+                render_context.entity_label_source(EntityLabelOriginKey::new(
+                    EntityLabelFamily::Sequence,
+                    owner,
+                    SEQUENCE_ACTOR_LABEL_SLOT,
+                )),
+                "actor label",
+                ordinal,
+            )?;
+        }
+    }
+    for (ordinal, sequence_box) in model.boxes.iter().enumerate() {
+        if ordinal.is_multiple_of(SEQUENCE_LAYOUT_CHECKPOINT_INTERVAL) {
+            work_meter
+                .checkpoint(OperationPhase::Layout)
+                .map_err(Error::from)?;
+        }
+        if sequence_box.name.is_some() {
+            let owner = sequence_source_owner(ordinal, "box")?;
+            add_source_bound(
+                render_context.entity_label_source(EntityLabelOriginKey::new(
+                    EntityLabelFamily::Sequence,
+                    owner,
+                    SEQUENCE_BOX_TITLE_SLOT,
+                )),
+                "box title",
