+fn append_shape_data_source_segment(
+    input: &str,
+    source: Range<usize>,
+    generated_entity_placeholders: Option<&[GeneratedEntityPlaceholder]>,
+    next_placeholder: &mut usize,
+    output: &mut String,
+    mapped_placeholders: &mut Vec<GeneratedEntityPlaceholder>,
+) {
+    let output_start = output.len();
+    output.push_str(&input[source.clone()]);
+    let Some(generated_entity_placeholders) = generated_entity_placeholders else {
+        return;
+    };
+
+    // Shape-data segments are appended in source order. Advance through the sorted provenance
+    // once, instead of rescanning the document-wide placeholder list for every quote/newline.
+    while generated_entity_placeholders
+        .get(*next_placeholder)
+        .is_some_and(|placeholder| placeholder.suffix.end <= source.start)
+    {
+        *next_placeholder += 1;
+    }
+    while let Some(placeholder) = generated_entity_placeholders.get(*next_placeholder) {
+        if placeholder.prefix.start >= source.end {
+            break;
+        }
+        *next_placeholder += 1;
+        if source.start <= placeholder.prefix.start && placeholder.suffix.end <= source.end {
+            let offset = |position: usize| output_start + position - source.start;
+            mapped_placeholders.push(GeneratedEntityPlaceholder {
+                prefix: offset(placeholder.prefix.start)..offset(placeholder.prefix.end),
+                suffix: offset(placeholder.suffix.start)..offset(placeholder.suffix.end),
+            });
+        }
+    }
