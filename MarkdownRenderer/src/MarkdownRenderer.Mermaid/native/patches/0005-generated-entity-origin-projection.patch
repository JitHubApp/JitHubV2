+/// Writes already-projected plain text without re-running Mermaid entity decoding or Markdown
+/// classification. This is used by State's `rectWithTitle` labels, whose legacy contract is plain
+/// text with explicit `<br>` handling rather than Markdown.
+pub(in crate::svg::parity) fn write_svg_text_plain_from_final_text_source_with_style(
+    out: &mut String,
+    text: &str,
+    style: Option<&str>,
+    center_text: bool,
+) {
+    // The caller has already normalized literal source `<br>` tags while generated atoms were
+    // opaque. Do not call `normalized_text_lines` here: it would reinterpret a decoded literal
+    // `&lt;br&gt;` as layout markup after provenance has been finalized.
+    let mut lines = text.split('\n').map(str::to_string).collect::<Vec<_>>();
+    while lines.len() > 1
+        && lines.last().is_some_and(|line| {
+            crate::text::trim_html_collapsible_ascii_whitespace(line).is_empty()
+        })
+    {
+        lines.pop();
+    }
+    let lines = lines
+        .into_iter()
+        .map(|line| {
+            crate::text::non_markdown_svg_words(&line)
+                .map(str::to_string)
+                .collect::<Vec<_>>()
+        })
+        .collect::<Vec<_>>();
+    write_svg_text_source_word_lines_impl(
+        out,
+        &lines,
+        style,
+        center_text,
+        SvgTextEntityMode::MarkdownFinalText,
+    );
+}
