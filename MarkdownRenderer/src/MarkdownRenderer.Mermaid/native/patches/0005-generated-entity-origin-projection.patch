+    #[test]
+    fn family_ledger_keeps_missing_owner_authoritative() {
+        let source = "ﬂ°quot¶ß";
+        let control = OperationControl::new();
+        let exact =
+            OriginTrackedText::from_source_span(source, 0..source.len(), Some(&[]), &control)
+                .expect("not cancelled")
+                .expect("valid span");
+        let key = EntityLabelOriginKey::new(EntityLabelFamily::Sequence, 0, 0);
+        let mut ledger = EntityLabelOrigins::new(EntityLabelFamily::Sequence);
+        assert!(ledger.insert(key, exact));
+        assert!(ledger.get(key).is_some());
