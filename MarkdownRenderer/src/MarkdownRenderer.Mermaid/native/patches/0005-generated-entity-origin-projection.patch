+            .map(|scalar| format!(r#"\u{scalar:04X}"#))
+            .collect();
+        let yaml = format!(r#"label: "{authored_private_use} {marker}""#);
+        let origin = generated_origin_at(&yaml, marker, 0);
+        let document = parse_mermaid_inline_shape_data_controlled(
+            &yaml,
+            Some(&[origin]),
+            &crate::OperationControl::new(),
+        )
+        .expect("active control")
+        .expect("valid YAML with every PUA scalar escaped");
+
+        let expected_private_use: String = (0xE000..0xF900).filter_map(char::from_u32).collect();
+        assert_eq!(
+            document.value["label"],
+            format!("{expected_private_use} {marker}")
+        );
