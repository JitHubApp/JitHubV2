+        let first_start = source.find("first").expect("first");
+        let first_end = source.find("  \n").expect("line end");
+        let second_start = source.find("second").expect("second");
+        let second_end = source.len();
+        let generated = [origin(source, "ﬂ°quot¶ß")];
+        let control = OperationControl::new();
+        let exact = OriginTrackedText::from_source_segments(
+            source,
+            &[first_start..first_end, second_start..second_end],
+            "\n",
+            Some(&generated),
+            &control,
+        )
+        .expect("not cancelled")
