+/// Resolves typed flowchart Markdown projection tokens after the Markdown source has been
+/// classified. Authored placeholder delimiters and generated entity atoms have disjoint private
+/// selectors, so authored marker-shaped Unicode cannot be mistaken for a generated entity.
+pub(crate) fn decode_flowchart_markdown_projection_tokens(text: &str) -> Cow<'_, str> {
+    if !text.contains(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        return Cow::Borrowed(text);
+    }
+
+    let mut output = String::with_capacity(text.len());
+    let mut cursor = 0usize;
+    let mut decoded_any = false;
+    while let Some(relative_start) = text[cursor..].find(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        let start = cursor + relative_start;
+        output.push_str(&text[cursor..start]);
+        match decode_flowchart_projection_token(text, start) {
+            Ok(Some((end, value))) => {
+                output.push_str(&value);
+                cursor = end;
+                decoded_any = true;
+            }
+            Ok(None) => {
+                output.push(MERMAID_LITERAL_PLACEHOLDER_ESCAPE);
+                cursor = start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8();
+            }
+            Err(()) => {
+                append_invalid_flowchart_projection_as_visible_text(&text[start..], &mut output);
+                cursor = text.len();
+                decoded_any = true;
+            }
+        }
+    }
+
+    output.push_str(&text[cursor..]);
+    if decoded_any {
+        Cow::Owned(output)
+    } else {
+        Cow::Borrowed(text)
+    }
+}
