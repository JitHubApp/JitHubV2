+#[derive(Debug, Clone, Default)]
+struct CapturedNodeLabelSources {
+    label_span: Option<SourceSpan>,
+    description_spans: Vec<Option<SourceSpan>>,
+    synthetic_label: bool,
+}
+
+#[derive(Debug, Default)]
+struct StateOriginCapture {
+    node_labels: HashMap<String, CapturedNodeLabelSources>,
+    note_label_spans: HashMap<String, Vec<SourceSpan>>,
+    edge_label_spans: Vec<Option<SourceSpan>>,
+}
+
+impl StateOriginCapture {
+    fn into_origins(
+        self,
+        model: &StateDiagramRenderModel,
+        source: &str,
+        generated: Option<&[GeneratedEntityPlaceholder]>,
+        control: &OperationControl,
+    ) -> OperationControlResult<EntityLabelOrigins> {
+        let mut origins = EntityLabelOrigins::new(EntityLabelFamily::State);
+        for (ordinal, node) in model.nodes.iter().enumerate() {
+            if ordinal.is_multiple_of(128) {
+                control.checkpoint()?;
+            }
+            let Ok(owner) = u32::try_from(ordinal) else {
+                continue;
+            };
+            let Some(label) = node.label.as_ref().and_then(Value::as_str) else {
+                continue;
+            };
+            let label_key = EntityLabelOriginKey::new(
+                EntityLabelFamily::State,
+                owner,
+                STATE_NODE_LABEL_SLOT,
+            );
+            let note_spans = self.note_label_spans.get(&node.id);
+            let tracked_label = if let Some(spans) = note_spans {
+                tracked_segments(source, spans, generated, control)?
+            } else if let Some(captured) = self.node_labels.get(&node.id) {
+                match captured.label_span {
+                    Some(span) => tracked_state_span(source, span, generated, control)?,
+                    None if captured.synthetic_label => {
+                        Some(OriginTrackedText::from_owned_semantic_text(label.to_string()))
+                    }
+                    None => None,
+                }
+            } else {
+                None
+            };
+            if let Some(tracked) = tracked_label {
+                let _ = origins.insert(label_key, tracked);
+            }
+
+            if let Some(captured) = self.node_labels.get(&node.id) {
+                if let Some(description_parts) = node.description.as_ref() {
+                    for (part, _description) in description_parts.iter().enumerate() {
+                        if part.is_multiple_of(128) {
+                            control.checkpoint()?;
+                        }
+                        let Ok(part_ordinal) = u32::try_from(part) else {
+                            continue;
+                        };
+                        let Some(span) = captured.description_spans.get(part).copied().flatten()
+                        else {
+                            continue;
+                        };
+                        let Some(tracked) =
+                            tracked_state_span(source, span, generated, control)?
+                        else {
+                            continue;
+                        };
+                        let key = EntityLabelOriginKey::new_part(
+                            EntityLabelFamily::State,
+                            owner,
+                            STATE_NODE_DESCRIPTION_SLOT,
+                            part_ordinal,
+                        );
+                        let _ = origins.insert(key, tracked);
+                    }
+                }
+            }
+
+            if let Some(spans) = note_spans {
+                let Some(tracked) = tracked_segments(source, spans, generated, control)? else {
+                    continue;
+                };
+                let key = EntityLabelOriginKey::new(
+                    EntityLabelFamily::State,
+                    owner,
+                    STATE_NOTE_LABEL_SLOT,
+                );
+                let _ = origins.insert(key, tracked);
+            }
+        }
+
+        for (ordinal, edge) in model.edges.iter().enumerate() {
+            if ordinal.is_multiple_of(128) {
+                control.checkpoint()?;
+            }
+            let Ok(owner) = u32::try_from(ordinal) else {
+                continue;
+            };
+            let tracked = match self.edge_label_spans.get(ordinal).copied().flatten() {
+                Some(span) => tracked_state_span(source, span, generated, control)?,
+                None if edge.label.is_empty() => Some(
+                    OriginTrackedText::from_owned_semantic_text(String::new()),
+                ),
+                None => None,
+            };
+            if let Some(tracked) = tracked {
+                let key = EntityLabelOriginKey::new(
+                    EntityLabelFamily::State,
+                    owner,
+                    STATE_EDGE_LABEL_SLOT,
+                );
+                let _ = origins.insert(key, tracked);
+            }
+        }
+
+        control.checkpoint()?;
+        Ok(origins)
+    }
+}
+
+fn tracked_segments(
+    source: &str,
+    spans: &[SourceSpan],
+    generated: Option<&[GeneratedEntityPlaceholder]>,
+    control: &OperationControl,
+) -> OperationControlResult<Option<OriginTrackedText>> {
+    let mut ranges = Vec::with_capacity(spans.len());
+    for (index, span) in spans.iter().enumerate() {
+        if index.is_multiple_of(128) {
+            control.checkpoint()?;
+        }
+        let Some(range) = trimmed_source_range(source, *span) else {
+            return Ok(None);
+        };
+        ranges.push(range);
+    }
+    OriginTrackedText::from_source_segments(source, &ranges, "\n", generated, control)
+}
+
+fn tracked_state_span(
+    source: &str,
+    span: SourceSpan,
+    generated: Option<&[GeneratedEntityPlaceholder]>,
+    control: &OperationControl,
+) -> OperationControlResult<Option<OriginTrackedText>> {
+    let Some(range) = trimmed_source_range(source, span) else {
+        return Ok(None);
+    };
+    OriginTrackedText::from_source_span(source, range, generated, control)
+}
+
+fn trimmed_source_range(source: &str, span: SourceSpan) -> Option<std::ops::Range<usize>> {
+    let text = source.get(span.start..span.end)?;
+    let leading = text.len().saturating_sub(text.trim_start().len());
+    let trailing = text.trim_end().len();
+    Some(span.start.checked_add(leading)?..span.start.checked_add(trailing)?)
+}
+
 fn apply_state_descriptions(
     entry: &mut NodeScratch,
     item_id: &str,
     primary_description: Option<&str>,
+    primary_description_span: Option<SourceSpan>,
     additional_descriptions: &[String],
+    additional_description_spans: &[SourceSpan],
