+fn append_invalid_flowchart_projection_as_visible_text(text: &str, output: &mut String) {
+    use std::fmt::Write as _;
+
+    for character in text.chars() {
+        if character == MERMAID_LITERAL_PLACEHOLDER_ESCAPE
+            || matches!(character, '\u{fe00}'..='\u{fe05}')
+        {
+            let _ = write!(output, "\\u{{{:X}}}", character as u32);
+        } else {
+            output.push(character);
+        }
+    }
+}
