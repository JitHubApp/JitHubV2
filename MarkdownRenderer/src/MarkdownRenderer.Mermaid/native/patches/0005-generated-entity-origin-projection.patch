+    let mut output = String::with_capacity(text.len());
+    let mut cursor = 0usize;
+    while let Some(relative_start) = text[cursor..].find(MERMAID_LITERAL_PLACEHOLDER_ESCAPE) {
+        let start = cursor + relative_start;
+        output.push_str(decode_flowchart_svg_text_content_entities(&text[cursor..start]).as_ref());
+        match decode_flowchart_projection_token(text, start) {
+            Ok(Some((end, value))) => {
+                output.push_str(&value);
+                cursor = end;
+            }
+            Ok(None) => {
+                output.push(MERMAID_LITERAL_PLACEHOLDER_ESCAPE);
+                cursor = start + MERMAID_LITERAL_PLACEHOLDER_ESCAPE.len_utf8();
+            }
+            Err(()) => {
+                append_invalid_flowchart_projection_as_visible_text(&text[start..], &mut output);
+                return Cow::Owned(output);
+            }
+        }
+    }
+
+    output.push_str(decode_flowchart_svg_text_content_entities(&text[cursor..]).as_ref());
+    Cow::Owned(output)
+}
