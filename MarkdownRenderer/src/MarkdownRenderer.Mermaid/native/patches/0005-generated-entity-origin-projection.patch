+/// Exact parser-input ranges emitted for one entity by Mermaid's preprocessing pass.
+///
+/// These ranges are provenance, not a spelling-based guess: they are recorded while the `#` and
+/// `;` bytes are replaced, before the resulting private-use delimiters can be confused with
+/// authored Unicode or synthesized later by a YAML escape.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub(crate) struct GeneratedEntityPlaceholder {
+    pub(crate) prefix: Range<usize>,
+    pub(crate) suffix: Range<usize>,
+}
+
+fn remap_generated_entity_placeholders(
+    placeholders: &[GeneratedEntityPlaceholder],
+    edits: &[SourceEdit],
+    checkpoints: &mut ControlledEditRebuildCheckpoints<'_>,
+) -> OperationControlResult<Vec<GeneratedEntityPlaceholder>> {
+    debug_assert!(placeholders.windows(2).all(|pair| {
+        pair[0].prefix.start <= pair[1].prefix.start && pair[0].suffix.end <= pair[1].prefix.start
+    }));
+    let mut remapped = Vec::with_capacity(placeholders.len());
+    let mut edit_index = 0usize;
+    let mut byte_delta = 0isize;
+
+    // Both lists are emitted in source order. Sweep them together so an input containing many
+    // entities and many later rewrites remains O(entities + edits), not O(entities * edits).
+    for placeholder in placeholders {
+        checkpoints.processed_item()?;
+        let envelope = placeholder.prefix.start..placeholder.suffix.end;
+        while let Some(edit) = edits.get(edit_index) {
+            let precedes = if edit.range.is_empty() {
+                edit.range.start <= envelope.start
+            } else {
+                edit.range.end <= envelope.start
+            };
+            if !precedes {
+                break;
+            }
+            // Source and replacement lengths are capped by the parser's existing input/output
+            // budgets, so converting those byte counts to isize is safe on supported targets.
+            byte_delta +=
+                edit.replacement.len() as isize - (edit.range.end - edit.range.start) as isize;
+            edit_index += 1;
+        }
+
+        let overlaps_next_edit = edits.get(edit_index).is_some_and(|edit| {
+            // Empty insertions strictly inside the generated spelling alter it; insertions at
+            // either boundary do not. Non-empty edits use ordinary half-open intersection.
+            if edit.range.is_empty() {
+                envelope.start < edit.range.start && edit.range.start < envelope.end
+            } else {
+                edit.range.start < envelope.end && envelope.start < edit.range.end
+            }
+        });
+        if overlaps_next_edit {
+            // A later source edit changed bytes participating in this entity. The spelling is
+            // no longer known to have been emitted intact by the preprocessing pass.
+            continue;
+        }
+
+        let shift = |offset: usize| -> Option<usize> {
+            if byte_delta >= 0 {
+                offset.checked_add(byte_delta as usize)
+            } else {
+                offset.checked_sub(byte_delta.unsigned_abs())
+            }
