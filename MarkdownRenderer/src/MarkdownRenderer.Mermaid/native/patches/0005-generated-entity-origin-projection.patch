+            start.get_or_insert(offset);
+            last_non_whitespace_end = offset + ch.len_utf8();
+        }
+    }
+    control.checkpoint_at(OperationPhase::Semantic)?;
+    let start = start.unwrap_or(value.len());
+    if start == value.len() {
+        Ok(&value[start..start])
+    } else {
+        Ok(&value[start..last_non_whitespace_end])
+    }
+}
+
+fn trim_rust_whitespace_bounds(
+    value: &str,
+    control: &OperationControl,
+) -> OperationControlResult<(usize, usize)> {
+    let mut start = value.len();
+    let mut next_checkpoint = 4096usize;
+    for (offset, ch) in value.char_indices() {
+        if offset >= next_checkpoint {
+            control.checkpoint_at(OperationPhase::Semantic)?;
+            next_checkpoint = offset.saturating_add(4096);
+        }
+        if !ch.is_whitespace() {
+            start = offset;
+            break;
+        }
+    }
+    control.checkpoint_at(OperationPhase::Semantic)?;
+
+    if start == value.len() {
+        return Ok((start, start));
+    }
+
+    let mut end = start;
+    next_checkpoint = value.len().saturating_sub(4096);
+    for (offset, ch) in value.char_indices().rev() {
+        if offset < next_checkpoint {
+            control.checkpoint_at(OperationPhase::Semantic)?;
+            next_checkpoint = offset.saturating_sub(4096);
+        }
+        if !ch.is_whitespace() {
+            end = offset + ch.len_utf8();
+            break;
+        }
+    }
+    control.checkpoint_at(OperationPhase::Semantic)?;
+    Ok((start, end))
+}
+
+fn copy_with_checkpoints(
+    value: &str,
+    control: &OperationControl,
+) -> OperationControlResult<String> {
+    control.checkpoint_at(OperationPhase::Semantic)?;
+    let mut output = String::with_capacity(value.len());
+    let mut copied = 0usize;
+    while copied < value.len() {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        let mut end = (copied + 4096).min(value.len());
+        while !value.is_char_boundary(end) {
+            end -= 1;
+        }
+        if end == copied {
+            // `copied` is a valid boundary and the input is non-empty here, so the next
+            // scalar always advances by at least one byte. Keep the fallback lossless even
+            // if the chunk-size logic changes later.
+            let Some(next) = value[copied..].chars().next() else {
+                break;
+            };
+            end = copied + next.len_utf8();
+        }
+        output.push_str(&value[copied..end]);
+        copied = end;
+    }
+    control.checkpoint_at(OperationPhase::Semantic)?;
+    Ok(output)
+}
+
+fn equals_with_control(
+    left: &str,
+    right: &str,
+    control: &OperationControl,
+) -> OperationControlResult<bool> {
+    if left.len() != right.len() {
+        return Ok(false);
+    }
+    for (left, right) in left
+        .as_bytes()
+        .chunks(4096)
+        .zip(right.as_bytes().chunks(4096))
+    {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        if left != right {
+            return Ok(false);
+        }
+    }
+    control.checkpoint_at(OperationPhase::Semantic)?;
+    Ok(true)
+}
