+        ));
+    }
+
+    #[test]
+    fn family_ledger_retained_byte_accounting_is_constant_time_and_tracks_removal() {
+        let mut ledger = EntityLabelOrigins::new(EntityLabelFamily::Sequence);
+        let empty_bytes = ledger.retained_bytes();
+        let key = EntityLabelOriginKey::new(EntityLabelFamily::Sequence, 0, 0);
+        assert!(ledger.insert(
+            key,
+            OriginTrackedText::from_owned_semantic_text("retained label".into())
+        ));
+        let populated_bytes = ledger.retained_bytes();
+        assert!(populated_bytes > empty_bytes);
+
+        ledger.remove(key);
+        let removed_bytes = ledger.retained_bytes();
+        assert!(removed_bytes >= empty_bytes);
+        assert!(removed_bytes < populated_bytes);
+    }
+
+    #[test]
+    fn projection_decodes_only_owned_ranges_and_protects_authored_private_frames() {
+        const ESCAPE: char = '\u{f0000}';
+        const ATOM: char = '\u{fe04}';
+        const ESCAPE_ESCAPE: char = '\u{fe03}';
+        let authored_frame = format!("{ESCAPE}{ATOM}0000000000000004F09F9880");
+        let source = format!("{authored_frame}|&quot;|ﬂ°quot¶ß");
+        let generated = [origin(&source, "ﬂ°quot¶ß")];
+        let control = OperationControl::new();
+        let exact = OriginTrackedText::from_source_span(
+            &source,
+            0..source.len(),
+            Some(&generated),
+            &control,
+        )
+        .expect("not cancelled")
+        .expect("all generated ranges are exact");
+
+        assert_eq!(
+            exact
+                .try_semantic_text(|| Ok::<(), std::convert::Infallible>(()))
+                .expect("infallible projection")
+                .expect("exact generated range"),
+            format!("{authored_frame}|&quot;|\"")
+        );
+        let protected = exact
+            .protect_for_text(|| Ok::<(), std::convert::Infallible>(()))
+            .expect("infallible protection")
+            .expect("exact generated range");
+        assert!(
+            exact
+                .protected_render_source_bytes_upper_bound()
+                .is_some_and(|bound| bound >= protected.len())
+        );
+        assert!(protected.starts_with(&format!("{ESCAPE}{ESCAPE_ESCAPE}{ATOM}")));
+        assert!(protected.contains("|&quot;|"));
+        assert!(protected.ends_with(&format!("{ESCAPE}{ATOM}000000000000000122")));
+    }
+
+    #[test]
+    fn typed_origin_projection_preserves_authored_html_entity_spelling() {
+        let source = "authored &quot; and generated ﬂ°quot¶ß";
+        let generated = [origin(source, "ﬂ°quot¶ß")];
+        let tracked = OriginTrackedText::from_source_span(
+            source,
+            0..source.len(),
+            Some(&generated),
+            &OperationControl::new(),
+        )
+        .expect("not cancelled")
+        .expect("valid exact source");
+
+        assert_eq!(
+            tracked
+                .try_semantic_text(|| Ok::<(), std::convert::Infallible>(()))
+                .expect("infallible projection")
+                .expect("exact generated range"),
+            "authored &quot; and generated \""
+        );
+    }
+
+    #[test]
+    fn exact_projection_rejects_malformed_origin_metadata_without_fallback() {
+        let tracked = OriginTrackedText {
+            text: std::sync::Arc::from("literal ﬂ°quot¶ß"),
+            generated: Some(std::sync::Arc::from([GeneratedEntityPlaceholder {
+                prefix: 9..12,
+                suffix: 12..15,
+            }])),
+        };
+
+        assert!(
+            tracked
+                .try_semantic_text(|| Ok::<(), std::convert::Infallible>(()))
+                .expect("infallible projection")
+                .is_none()
+        );
+        assert!(
+            tracked
+                .protect_for_markdown(|| Ok::<(), std::convert::Infallible>(()))
+                .expect("infallible protection")
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn exact_projection_checks_cancellation_during_large_text_copies() {
+        let tracked = OriginTrackedText {
+            text: std::sync::Arc::from("x".repeat(20_000)),
+            generated: Some(std::sync::Arc::from([])),
+        };
+        let mut checkpoints = 0usize;
+        let result = tracked.try_semantic_text(|| {
+            checkpoints += 1;
+            if checkpoints == 3 {
+                Err("cancelled")
+            } else {
+                Ok(())
+            }
+        });
+
+        assert_eq!(result, Err("cancelled"));
+        assert_eq!(checkpoints, 3);
+    }
+}
