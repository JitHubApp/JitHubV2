+        let source = "label: \"ﬂ°lt¶ß + ﬂ°lt¶ß\"";
+        let first = generated_origin_at(source, "ﬂ°lt¶ß", 0);
+        let second = generated_origin_at(source, "ﬂ°lt¶ß", 1);
