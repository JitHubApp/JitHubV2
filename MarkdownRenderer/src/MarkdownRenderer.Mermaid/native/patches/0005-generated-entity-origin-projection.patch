+use crate::{OperationControl, OperationControlResult, OperationPhase};
+use std::ops::Range;
+
+/// Parser-owned text and its exact token payload envelope. Trimming and wrap directives are
+/// projected by the DB using offsets within this envelope, never by finding a decoded label.
+#[derive(Debug, Clone)]
+pub(crate) struct SourceText {
+    pub text: String,
+    pub span: Option<Range<usize>>,
+    span_match: SpanMatch,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum SpanMatch {
+    TrimmedEnvelope,
+    TrimmedTokenTail,
+    ExactBeforeClosingBrace,
+}
+
+impl SourceText {
+    pub(crate) fn spanned(text: String, start: usize, end: usize) -> Self {
+        Self {
+            text,
+            span: Some(start..end),
+            span_match: SpanMatch::TrimmedEnvelope,
+        }
+    }
+
+    pub(crate) fn spanned_token_tail(text: String, start: usize, end: usize) -> Self {
+        Self {
+            text,
+            span: Some(start..end),
+            span_match: SpanMatch::TrimmedTokenTail,
+        }
+    }
+
+    pub(crate) fn spanned_exact_before_closing_brace(
+        text: String,
+        start: usize,
+        end: usize,
+    ) -> Self {
+        Self {
+            text,
+            span: Some(start..end),
+            span_match: SpanMatch::ExactBeforeClosingBrace,
+        }
+    }
+
+    pub(super) fn resolve_span(
+        &mut self,
+        source: &str,
+        control: &OperationControl,
+    ) -> OperationControlResult<bool> {
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        let Some(envelope) = self.span.clone() else {
+            return Ok(true);
+        };
+        let Some(raw) = source.get(envelope.clone()) else {
+            return Ok(false);
+        };
+
+        match self.span_match {
+            SpanMatch::TrimmedEnvelope => {
+                let trimmed = trim_ecmascript_with_control(raw, control)?;
+                if !equals_with_control(trimmed, &self.text, control)? {
+                    return Ok(false);
+                }
+                let offset = trimmed.as_ptr() as usize - raw.as_ptr() as usize;
+                let start = envelope.start + offset;
+                self.span = Some(start..start + trimmed.len());
+            }
+            SpanMatch::TrimmedTokenTail => {
+                let Some(raw) = source.get(envelope.clone()) else {
+                    return Ok(false);
+                };
+                // Accessibility tokens include their directive prefix in the lexer span, while
+                // their payload is trimmed on both sides. Trim this known token envelope first,
+                // then map the payload as an exact suffix; do not search the source for text.
+                let trimmed_envelope = trim_ecmascript_with_control(raw, control)?;
+                let Some(end) = envelope.start.checked_add(trimmed_envelope.len()) else {
+                    return Ok(false);
+                };
+                let Some(start) = end.checked_sub(self.text.len()) else {
+                    return Ok(false);
+                };
+                let Some(tail) = source.get(start..end) else {
+                    return Ok(false);
+                };
+                if start < envelope.start || !equals_with_control(tail, &self.text, control)? {
+                    return Ok(false);
+                }
+                self.span = Some(start..end);
+            }
+            SpanMatch::ExactBeforeClosingBrace => {
+                let Some(end) = envelope.end.checked_sub('}'.len_utf8()) else {
+                    return Ok(false);
+                };
+                let Some(body) = source.get(envelope.start..end) else {
+                    return Ok(false);
+                };
+                if end < envelope.start
+                    || source.get(end..envelope.end) != Some("}")
+                    || !equals_with_control(body, &self.text, control)?
+                {
+                    return Ok(false);
+                }
+                self.span = Some(envelope.start..end);
+            }
+        }
+        control.checkpoint_at(OperationPhase::Semantic)?;
+        Ok(true)
+    }
+
+    /// Applies the existing DB's Unicode `str::trim()` semantics while shifting an exact source
+    /// span by byte offsets. The source text remains parser-owned; no delimiter search is used.
+    pub(super) fn trim_text_and_span(
+        &mut self,
+        control: &OperationControl,
+    ) -> OperationControlResult<bool> {
+        let (start, end) = trim_rust_whitespace_bounds(&self.text, control)?;
+        if let Some(span) = self.span.as_mut() {
+            let Some(trimmed_start) = span.start.checked_add(start) else {
+                return Ok(false);
+            };
+            let Some(trimmed_end) = trimmed_start.checked_add(end - start) else {
+                return Ok(false);
+            };
+            if trimmed_end > span.end {
+                return Ok(false);
+            }
+            span.start = trimmed_start;
+            span.end = trimmed_end;
+        }
+        self.text = copy_with_checkpoints(&self.text[start..end], control)?;
+        Ok(true)
+    }
+}
+
+impl From<String> for SourceText {
+    fn from(text: String) -> Self {
+        Self {
+            text,
+            span: None,
+            span_match: SpanMatch::TrimmedEnvelope,
+        }
+    }
+}
