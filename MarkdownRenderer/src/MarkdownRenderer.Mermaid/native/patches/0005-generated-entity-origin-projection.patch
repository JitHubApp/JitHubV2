+                .expect("infallible projection")
+                .expect("exact generated origin"),
+            "first \"\nsecond  "
+        );
+        assert!(exact.generated.is_some());
+
+        let legacy = OriginTrackedText::from_source_span(source, 0..source.len(), None, &control)
+            .expect("not cancelled")
+            .expect("valid span");
+        let authoritative_empty =
+            OriginTrackedText::from_source_span(source, 0..source.len(), Some(&[]), &control)
+                .expect("not cancelled")
