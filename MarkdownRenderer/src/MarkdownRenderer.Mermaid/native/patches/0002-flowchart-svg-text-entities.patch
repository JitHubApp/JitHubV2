+    #[test]
+    fn flowchart_svg_text_context_retains_mermaid_entity_placeholders_separately() {
+        // These marker spellings are the parser-owned representation produced by Mermaid's
+        // `encodeEntities` preprocessing. Passing them directly here isolates the core projection
+        // from preprocessing while exercising the exact value it transports to the renderer.
+        let source = concat!(
+            "flowchart LR\n",
+            "Quote[\"ﬂ°quot¶ß\"]\n",
+            "Numeric[\"ﬂ°°160¶ß\"]\n",
+            "Unicode[\"ﬂ°eacute¶ß\"]\n",
+            "LiteralEntity[\"&quot;\"]\n",
+            "DoubleEncoded[\"&amp;quot;\"]\n",
+            "RawBreak[\"A<br>B\"]\n",
+            "EncodedBreak[\"Aﬂ°lt¶ßbrﬂ°gt¶ßB\"]\n",
+            "Shape@{ label: \"ﬂ°quot¶ß\", labelType: \"string\", shape: \"rect\" }\n",
+            "A -->|ﬂ°quot¶ß| B\n",
+            "subgraph SG[\"ﬂ°quot¶ß\"]\n",
+            "  Inside\n",
+            "end\n",
+        );
+        let meta = flowchart_test_meta("flowchart-v2");
+        let (model, sources) =
+            parse_flowchart_model_with_render_context(source, &meta).expect("flowchart model");
+
+        let node = |id: &str| {
+            model
+                .nodes
+                .iter()
+                .find(|node| node.id == id)
+                .unwrap_or_else(|| panic!("missing node {id}"))
+        };
+
+        let quote = node("Quote");
+        assert_eq!(quote.label.as_deref(), Some("\""));
+        assert_eq!(sources.node_label_for_render(quote), Some("&quot;"));
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(quote),
+            Some("ﬂ°quot¶ß")
+        );
+
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(node("Numeric")),
+            Some("ﬂ°°160¶ß")
+        );
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(node("Unicode")),
+            Some("ﬂ°eacute¶ß")
+        );
+
+        // Literal HTML entity spellings were not introduced by Mermaid's placeholder pass, so
+        // they continue through the existing HTML-safe source projection unchanged.
+        let literal_entity = node("LiteralEntity");
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(literal_entity),
+            None
+        );
+        assert_eq!(
+            sources.node_label_for_render(literal_entity),
+            Some("&quot;")
+        );
+        let double_encoded = node("DoubleEncoded");
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(double_encoded),
+            None
+        );
+        assert_eq!(
+            sources.node_label_for_render(double_encoded),
+            Some("&amp;quot;")
+        );
+        assert!(
+            sources
+                .node_label_for_render(double_encoded)
+                .expect("double-encoded source")
+                .contains("quot;")
+        );
+
+        // Classification must occur after the distinction has been retained: literal `<br>` is
+        // still a break candidate, while Mermaid-encoded angle brackets are SVG text characters.
+        let raw_break = node("RawBreak");
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(raw_break),
+            None
+        );
+        assert_eq!(sources.node_label_for_render(raw_break), Some("A<br/>B"));
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(node("EncodedBreak")),
+            Some("Aﬂ°lt¶ßbrﬂ°gt¶ßB")
+        );
+
+        // The same typed projection follows final model identity for shape-data labels, edge
+        // labels, and subgraph titles; it is not reconstructed from displayed text.
+        assert_eq!(
+            sources.node_mermaid_svg_text_source_for_render(node("Shape")),
+            Some("ﬂ°quot¶ß")
+        );
+        let edge = model
+            .edges
+            .iter()
+            .find(|edge| edge.from == "A" && edge.to == "B")
+            .expect("quoted edge label");
+        assert_eq!(sources.edge_label_for_render(edge), Some("&quot;"));
+        assert_eq!(
+            sources.edge_mermaid_svg_text_source_for_render(edge),
+            Some("ﬂ°quot¶ß")
+        );
+        let subgraph = model
+            .subgraphs
+            .iter()
+            .find(|subgraph| subgraph.id == "SG")
+            .expect("quoted subgraph title");
+        assert_eq!(sources.subgraph_title_for_render(0, subgraph), "&quot;");
+        assert_eq!(
+            sources.subgraph_mermaid_svg_text_source_for_render(0, subgraph),
+            Some("ﬂ°quot¶ß")
+        );
+    }
