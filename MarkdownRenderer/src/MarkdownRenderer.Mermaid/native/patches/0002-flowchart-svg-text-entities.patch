+/// Decodes the ordinary sanitizer entities plus Mermaid preprocessing placeholders that were
+/// retained by the flowchart SVG-text projection. The placeholder path is deliberately separate
+/// from [`decode_svg_text_content_entities`]: HTML-safe sources and other diagram families must
+/// not interpret marker-shaped user text as preprocessing metadata.
+pub(crate) fn decode_flowchart_svg_text_content_entities(text: &str) -> Cow<'_, str> {
+    match decode_svg_text_content_entities(text) {
+        Cow::Borrowed(sanitized) => decode_mermaid_placeholders_only(sanitized),
+        Cow::Owned(sanitized) => match decode_mermaid_placeholders_only(&sanitized) {
+            Cow::Borrowed(_) => Cow::Owned(sanitized),
+            Cow::Owned(decoded) => Cow::Owned(decoded),
+        },
+    }
+}
+
+pub(crate) fn mermaid_preprocessor_placeholder_end(text: &str, start: usize) -> Option<usize> {
+    const OPEN: &str = "ﬂ°";
+    const NUMERIC_OPEN: &str = "ﬂ°°";
+    const CLOSE: &str = "¶ß";
+
+    let tail = text.get(start..)?;
+    if !tail.starts_with(OPEN) {
+        return None;
+    }
+    let payload_start = start
+        + if tail.starts_with(NUMERIC_OPEN) {
+            NUMERIC_OPEN.len()
+        } else {
+            OPEN.len()
+        };
+    let bytes = text.as_bytes();
+    let mut payload_end = payload_start;
+    while payload_end < bytes.len()
+        && (bytes[payload_end].is_ascii_alphanumeric() || matches!(bytes[payload_end], b'_' | b'+'))
+    {
+        payload_end += 1;
+    }
+    if payload_end == payload_start || !text.get(payload_end..)?.starts_with(CLOSE) {
+        return None;
+    }
+    Some(payload_end + CLOSE.len())
+}
+
+fn decode_mermaid_placeholders_only(text: &str) -> Cow<'_, str> {
+    const OPEN: &str = "ﬂ°";
+
+    if !text.contains(OPEN) {
+        return Cow::Borrowed(text);
+    }
+
+    let mut out = String::with_capacity(text.len());
+    let mut cursor = 0usize;
+    let mut decoded_any = false;
+
+    while let Some(relative_start) = text[cursor..].find(OPEN) {
+        let start = cursor + relative_start;
+        out.push_str(&text[cursor..start]);
+        if let Some(end) = mermaid_preprocessor_placeholder_end(text, start) {
+            let token = &text[start..end];
+            let restored = merman_core::entities::restore_mermaid_entity_spelling(token);
+            let decoded = merman_core::entities::decode_html_entities_to_unicode(restored.as_ref());
+            if decoded.as_ref() != restored.as_ref() {
+                out.push_str(decoded.as_ref());
+                decoded_any = true;
+            } else {
+                // Mermaid's own decoder restores unknown placeholders to their literal entity
+                // spelling. Keep that contract, but never leak its private sentinel bytes.
+                out.push_str(restored.as_ref());
+                decoded_any |= restored.as_ref() != token;
+            }
+            cursor = end;
+        } else {
+            out.push_str(OPEN);
+            cursor = start + OPEN.len();
+        }
+    }
+
+    out.push_str(&text[cursor..]);
+    if decoded_any {
+        Cow::Owned(out)
+    } else {
+        Cow::Borrowed(text)
+    }
+}
