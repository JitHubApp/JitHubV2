<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MarkdownRenderer.Mermaid</RootNamespace>
    <AssemblyName>MarkdownRenderer.Mermaid</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnablePackageValidation>true</EnablePackageValidation>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>MarkdownRenderer.Mermaid</PackageId>
    <Description>Native Mermaid scene contracts and hardened MMIR interop for MarkdownRenderer.</Description>
    <PackageTags>markdown;winui;mermaid;diagram;native;windows</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <MarkdownRendererPackageReadme>$(MSBuildProjectDirectory)\README.md</MarkdownRendererPackageReadme>
    <!-- native\Build-Native.ps1 leaves Cargo's default target directory
         inside this project folder; it holds Rust build output only. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);native\target\**</DefaultItemExcludes>
    <!-- RuntimeIdentifier is the consumer's deployment architecture and must
         win over the solution's default x64 Platform during `dotnet publish -r`. -->
    <MarkdownRendererMermaidNativeRid Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</MarkdownRendererMermaidNativeRid>
    <MarkdownRendererMermaidNativeRid Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</MarkdownRendererMermaidNativeRid>
    <MarkdownRendererMermaidNativeRid Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</MarkdownRendererMermaidNativeRid>
    <MarkdownRendererMermaidNativeRid Condition="'$(MarkdownRendererMermaidNativeRid)' == '' and '$(Platform)' == 'x86'">win-x86</MarkdownRendererMermaidNativeRid>
    <MarkdownRendererMermaidNativeRid Condition="'$(MarkdownRendererMermaidNativeRid)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">win-arm64</MarkdownRendererMermaidNativeRid>
    <MarkdownRendererMermaidNativeRid Condition="'$(MarkdownRendererMermaidNativeRid)' == ''">win-x64</MarkdownRendererMermaidNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MarkdownRenderer.Mermaid.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer\MarkdownRenderer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="MERMAN_PROVENANCE.json" Pack="true" PackagePath="provenance\MERMAN_PROVENANCE.json" />
    <None Update="MERMAN_PATCH_LEDGER.md" Pack="true" PackagePath="provenance\MERMAN_PATCH_LEDGER.md" />
    <None Update="MERMAN_PARITY_BASELINE.md" Pack="true" PackagePath="provenance\MERMAN_PARITY_BASELINE.md" />
    <None Update="MMIR_FORMAT.md" Pack="true" PackagePath="build\native\MMIR_FORMAT.md" />
    <None Update="NATIVE_RUST_DEPENDENCIES.json" Pack="true" PackagePath="provenance\NATIVE_RUST_DEPENDENCIES.json" />
    <None Update="licenses\MERMAN-LICENSE-MIT.txt" Pack="true" PackagePath="licenses\MERMAN-LICENSE-MIT.txt" />
    <None Update="licenses\MERMAN-THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="licenses\MERMAN-THIRD-PARTY-NOTICES.md" />
    <None Update="licenses\MPL2-SOURCE.md" Pack="true" PackagePath="licenses\MPL2-SOURCE.md" />
    <None Update="native\abi\mmir-v1.json" Pack="true" PackagePath="build\native\abi\mmir-v1.json" />
    <None Update="native\include\markdown_renderer_mermaid.h" Pack="true" PackagePath="build\native\include\markdown_renderer_mermaid.h" />
    <None Update="native\Cargo.lock" Pack="true" PackagePath="provenance\native\Cargo.lock" />
    <None Update="native\patches\MERMAN_SOURCE_PATCHES.json" Pack="true" PackagePath="provenance\native\patches\MERMAN_SOURCE_PATCHES.json" />
    <None Update="native\patches\0001-final-node-source-provenance.patch" Pack="true" PackagePath="provenance\native\patches\0001-final-node-source-provenance.patch" />
    <None Update="native\patches\0002-flowchart-svg-text-entities.patch" Pack="true" PackagePath="provenance\native\patches\0002-flowchart-svg-text-entities.patch" />
    <None Update="native\patches\0003-final-markdown-text-and-self-loop-labels.patch" Pack="true" PackagePath="provenance\native\patches\0003-final-markdown-text-and-self-loop-labels.patch" />
    <None Update="native\patches\0004-final-markdown-entity-whitespace.patch" Pack="true" PackagePath="provenance\native\patches\0004-final-markdown-entity-whitespace.patch" />
    <None Update="native\patches\0005-generated-entity-origin-projection.patch" Pack="true" PackagePath="provenance\native\patches\0005-generated-entity-origin-projection.patch" />
    <None Update="runtimes\win-x86\native\MarkdownRenderer.Mermaid.Native.dll" Pack="true" PackagePath="runtimes\win-x86\native\MarkdownRenderer.Mermaid.Native.dll" />
    <None Update="runtimes\win-x64\native\MarkdownRenderer.Mermaid.Native.dll" Pack="true" PackagePath="runtimes\win-x64\native\MarkdownRenderer.Mermaid.Native.dll" />
    <None Update="runtimes\win-arm64\native\MarkdownRenderer.Mermaid.Native.dll" Pack="true" PackagePath="runtimes\win-arm64\native\MarkdownRenderer.Mermaid.Native.dll" />
    <None Update="runtimes\win-x86\native\MarkdownRenderer.Mermaid.Native.dll" Condition="'$(MarkdownRendererMermaidNativeRid)' == 'win-x86'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="MarkdownRenderer.Mermaid.Native.dll" />
    <None Update="runtimes\win-x64\native\MarkdownRenderer.Mermaid.Native.dll" Condition="'$(MarkdownRendererMermaidNativeRid)' == 'win-x64'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="MarkdownRenderer.Mermaid.Native.dll" />
    <None Update="runtimes\win-arm64\native\MarkdownRenderer.Mermaid.Native.dll" Condition="'$(MarkdownRendererMermaidNativeRid)' == 'win-arm64'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="MarkdownRenderer.Mermaid.Native.dll" />
  </ItemGroup>
</Project>
