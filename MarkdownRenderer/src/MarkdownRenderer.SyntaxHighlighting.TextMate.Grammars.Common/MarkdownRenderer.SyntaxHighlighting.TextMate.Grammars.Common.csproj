    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.python.syntaxes.MagicRegExp.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.ruby.syntaxes.ruby.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.rust.syntaxes.rust.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.shaderlab.syntaxes.shaderlab.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.shellscript.syntaxes.shell-unix-bash.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.sql.syntaxes.sql.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.swift.syntaxes.swift.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.typescriptbasics.syntaxes.TypeScript.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.typescriptbasics.syntaxes.TypeScriptReact.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.typescriptbasics.syntaxes.jsdoc.js.injection.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.typescriptbasics.syntaxes.jsdoc.ts.injection.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.vb.syntaxes.asp-vb-net.tmlanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.xml.syntaxes.xml.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.xml.syntaxes.xsl.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Grammars.yaml.syntaxes.yaml.tmLanguage.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Themes.dark_vs.json" />
    <_CommonTextMateResource Include="TextMateSharp.Grammars.Resources.Themes.light_vs.json" />
  </ItemGroup>

  <UsingTask TaskName="ExtractCommonTextMateResources"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceAssembly ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <ResourceNames ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ExtractedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        var assembly = Assembly.LoadFrom(SourceAssembly);
        var extracted = new List<ITaskItem>(ResourceNames.Length);

        foreach (var resourceItem in ResourceNames)
        {
            var resourceName = resourceItem.ItemSpec;
            using var input = assembly.GetManifestResourceStream(resourceName);
            if (input is null)
            {
                Log.LogError("TextMateSharp.Grammars resource '{0}' was not found in '{1}'.", resourceName, SourceAssembly);
                continue;
            }

            var safeName = new string(resourceName
                .Select(character => char.IsLetterOrDigit(character) ? character : '_')
                .ToArray());
            var outputPath = Path.Combine(OutputDirectory, safeName + ".json");
            using (var output = File.Create(outputPath))
            {
                input.CopyTo(output);
            }

            var extractedItem = new TaskItem(outputPath);
            extractedItem.SetMetadata("LogicalName", resourceName);
            extracted.Add(extractedItem);
        }

        ExtractedFiles = extracted.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="EmbedCommonTextMateResources" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TextMateSharpGrammarsAssembly>$(PkgTextMateSharp_Grammars)\lib\netstandard2.0\TextMateSharp.Grammars.dll</_TextMateSharpGrammarsAssembly>
      <_CommonTextMateResourceOutput>$(IntermediateOutputPath)CuratedTextMateResources</_CommonTextMateResourceOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(_TextMateSharpGrammarsAssembly)')"
           Text="The pinned TextMateSharp.Grammars resource assembly was not restored at '$(_TextMateSharpGrammarsAssembly)'." />
    <ExtractCommonTextMateResources SourceAssembly="$(_TextMateSharpGrammarsAssembly)"
                                    OutputDirectory="$(_CommonTextMateResourceOutput)"
                                    ResourceNames="@(_CommonTextMateResource)">
      <Output TaskParameter="ExtractedFiles" ItemName="_ExtractedCommonTextMateResource" />
    </ExtractCommonTextMateResources>
    <ItemGroup>
      <_CoreCompileResourceInputs Include="@(_ExtractedCommonTextMateResource)">
        <ManifestResourceName>%(_ExtractedCommonTextMateResource.LogicalName)</ManifestResourceName>
      </_CoreCompileResourceInputs>
    </ItemGroup>
  </Target>
</Project>
