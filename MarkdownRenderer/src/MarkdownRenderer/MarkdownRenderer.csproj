<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MarkdownRenderer</RootNamespace>
    <AssemblyName>MarkdownRenderer</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The compatibility facade is intentionally used by the implementation and
         its two explicit-viewport subclasses; consumers still receive MR1001. -->
    <NoWarn>$(NoWarn);MR1001</NoWarn>
    <PackageId>MarkdownRenderer.WinUI</PackageId>
    <Description>Native Win2D layout, painting, input, selection, UI Automation, raster images, and Fluent styling for MarkdownRenderer.</Description>
    <PackageTags>markdown;winui;win2d;windows;accessibility</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MarkdownRenderer.GitHub.Tests" />
    <InternalsVisibleTo Include="MarkdownRenderer.Html.Tests" />
    <InternalsVisibleTo Include="MarkdownRenderer.Svg.Resvg.Tests" />
    <InternalsVisibleTo Include="MarkdownRenderer.Tests" />
    <InternalsVisibleTo Include="MarkdownRenderer.Benchmarks" />
    <InternalsVisibleTo Include="MarkdownRenderer.PixelTests" ProjectStructureException="Test project whose name lacks the .Tests suffix; step 6 renames it to MarkdownRenderer.Pixel.Tests." />
    <InternalsVisibleTo Include="MarkdownRenderer.Gfm" ProjectStructureException="Gfm plugs in through internal renderer hooks (extension registry, layout context and boxes); step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.GitHub" ProjectStructureException="GitHub plugs in through internal renderer hooks (extension registry, layout context, source projections); step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.Html" ProjectStructureException="Html renders through internal layout boxes, source projections and safe-HTML hooks; step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.Performance" ProjectStructureException="Performance drives internal layout snapshots, vector scenes and control hooks; step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.Svg.Resvg" ProjectStructureException="resvg plugs in through internal SVG host and raster budget contracts; step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.SyntaxHighlighting.TextMate" ProjectStructureException="TextMate installs its highlighter through internal control and builder hooks; step 2 makes them public extension API." />
    <InternalsVisibleTo Include="MarkdownRenderer.PerformanceHarness" ProjectStructureException="The performance harness reads internal pipeline timing snapshots and the performance sink; step 2 replaces them with EventSource or an injected observer." />
    <InternalsVisibleTo Include="MarkdownRenderer.Sample" ProjectStructureException="The sample reads internal control and theme snapshots for its diagnostics pages; step 2 exposes them through public diagnostics API." />
    <InternalsVisibleTo Include="JitHub.WinUI" ProjectStructureException="The JitHub app waits for control disposal through internal MarkdownRendererControl members; step 2 makes them public API so the library no longer names the app." />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer.Core\MarkdownRenderer.Core.csproj" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="FilterPublicXmlDocumentationForPack" BeforeTargets="GenerateNuspec"
          Condition="Exists('$(TargetPath)') and Exists('$(TargetDir)$(AssemblyName).xml')">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Filter-PublicXmlDocumentation.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot; -XmlPath &quot;$(TargetDir)$(AssemblyName).xml&quot;" />
  </Target>

</Project>
