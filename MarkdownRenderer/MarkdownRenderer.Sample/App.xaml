<Application
    x:Class="MarkdownRenderer.Sample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sample-shell layout tokens. Feature content owns its viewport;
                 these values only describe the stable application chrome. -->
            <Thickness x:Key="SamplePageHeaderMargin">8,0,8,0</Thickness>
            <Thickness x:Key="SampleEditorPadding">8</Thickness>
            <Thickness x:Key="SampleRendererPadding">12,8,12,8</Thickness>
            <Thickness x:Key="SampleDiagnosticsMargin">8,0,8,8</Thickness>
            <x:Double x:Key="SampleEditorFontSize">13</x:Double>
            <x:Double x:Key="SampleDiagnosticsMaxHeight">144</x:Double>
            <x:Double x:Key="SampleWorkspaceSplitterWidth">4</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
