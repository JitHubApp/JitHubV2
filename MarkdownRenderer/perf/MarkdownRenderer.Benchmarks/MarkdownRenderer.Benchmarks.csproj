<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Declare the measured architectures before restore. Otherwise the
         Windows App SDK build props (imported only after a restore) default
         RuntimeIdentifiers to win-x86;win-x64;win-arm64, the next Visual
         Studio restore no longer matches the locked Release graph (NU1004),
         the failed restore drops those props again, and NuGet reports a
         restore loop. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The WinUI renderer assembly (VerticalViewportIndex) brings the Windows
         App SDK in transitively. Reference its framework runtime package so the
         benchmark host and BenchmarkDotNet's generated child project stay
         framework-dependent instead of defaulting to a self-contained,
         architecture-specific Windows App SDK deployment. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <ProjectReference Include="..\..\src\MarkdownRenderer\MarkdownRenderer.csproj" />
    <ProjectReference Include="..\..\src\MarkdownRenderer.Math\MarkdownRenderer.Math.csproj" />
  </ItemGroup>
</Project>
