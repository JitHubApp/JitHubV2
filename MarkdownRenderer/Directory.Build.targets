<Project>
  <PropertyGroup>
    <_MarkdownRendererRootDirectory>$(MSBuildThisFileDirectory)</_MarkdownRendererRootDirectory>
  </PropertyGroup>

  <!--
    Code structure check for the renderer's own projects, the ones whose folder
    props set MarkdownRendererProject (src, tests, samples, perf and tools). The
    eng\ restore helper and the consumers that release-evidence scripts generate
    under artifacts\ do not set it and are not checked.

    It enforces the rules from AGENTS.md "Code Structure Standards" that a
    project's own build can see:

      MRS0001  A project compiles only files under its own folder. Every
               Compile, Page and ApplicationDefinition item must be under the
               project directory.
      MRS0002  InternalsVisibleTo is granted only to the renderer's own
               test and performance projects, which never ship: the grantee
               is a project at tests\<name>\<name>.csproj or
               perf\<name>\<name>.csproj.

    Sources the project does not author are skipped by path: files generated
    into the project's intermediate output (outside the project folder when a
    build sets ArtifactsPath or BaseIntermediateOutputPath) and sources that
    NuGet packages add from the package folder, such as the Windows App SDK
    initializers. An item may break a rule only with ProjectStructureException
    metadata that gives the reason and how the exception is removed.
    eng\Test-ProjectStructure.ps1 checks what no single project build sees.

    The check runs before PrepareForBuild, the first step of every build, test,
    pack and publish, so a violation stops the build before anything is
    compiled; the CoreCompile hook covers builds that start at compilation. It
    reads only evaluated items, so it adds no measurable time. It is skipped in
    design-time builds: the IDE runs those to configure the language service,
    failing one degrades IntelliSense instead of reporting the problem, and the
    next real build reports it.
  -->
  <Target Name="CheckMarkdownRendererProjectStructure"
          BeforeTargets="PrepareForBuild;CoreCompile"
          Condition="'$(MarkdownRendererProject)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_MarkdownRendererProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_MarkdownRendererProjectDirectory>
      <_MarkdownRendererBaseIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))</_MarkdownRendererBaseIntermediateDirectory>
      <_MarkdownRendererIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_MarkdownRendererIntermediateDirectory>
      <_MarkdownRendererPackageDirectory Condition="'$(NuGetPackageRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)'))</_MarkdownRendererPackageDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_MarkdownRendererSourceItem Include="@(Compile)" StructureItemType="Compile" />
      <_MarkdownRendererSourceItem Include="@(Page)" StructureItemType="Page" />
      <_MarkdownRendererSourceItem Include="@(ApplicationDefinition)" StructureItemType="ApplicationDefinition" />

      <_MarkdownRendererSourceOutsideProject Include="@(_MarkdownRendererSourceItem)"
          Condition="'%(_MarkdownRendererSourceItem.ProjectStructureException)' == ''
                     and !$([System.String]::Copy('%(_MarkdownRendererSourceItem.FullPath)').StartsWith('$(_MarkdownRendererProjectDirectory)', StringComparison.OrdinalIgnoreCase))
                     and !$([System.String]::Copy('%(_MarkdownRendererSourceItem.FullPath)').StartsWith('$(_MarkdownRendererBaseIntermediateDirectory)', StringComparison.OrdinalIgnoreCase))
                     and !$([System.String]::Copy('%(_MarkdownRendererSourceItem.FullPath)').StartsWith('$(_MarkdownRendererIntermediateDirectory)', StringComparison.OrdinalIgnoreCase))
                     and ('$(_MarkdownRendererPackageDirectory)' == ''
                          or !$([System.String]::Copy('%(_MarkdownRendererSourceItem.FullPath)').StartsWith('$(_MarkdownRendererPackageDirectory)', StringComparison.OrdinalIgnoreCase)))" />

      <_MarkdownRendererUnlistedGrant Include="@(InternalsVisibleTo)"
          Condition="'%(InternalsVisibleTo.ProjectStructureException)' == ''
                     and !Exists('$(_MarkdownRendererRootDirectory)tests\%(InternalsVisibleTo.Identity)\%(InternalsVisibleTo.Identity).csproj')
                     and !Exists('$(_MarkdownRendererRootDirectory)perf\%(InternalsVisibleTo.Identity)\%(InternalsVisibleTo.Identity).csproj')" />
    </ItemGroup>

    <!-- Report both rules in one build, then stop. -->
    <PropertyGroup>
      <_MarkdownRendererContinueAfterSourceCheck>false</_MarkdownRendererContinueAfterSourceCheck>
      <_MarkdownRendererContinueAfterSourceCheck Condition="'@(_MarkdownRendererUnlistedGrant)' != ''">ErrorAndContinue</_MarkdownRendererContinueAfterSourceCheck>
    </PropertyGroup>

    <Error Condition="'@(_MarkdownRendererSourceOutsideProject)' != ''"
           Code="MRS0001"
           File="$(MSBuildProjectFullPath)"
           ContinueOnError="$(_MarkdownRendererContinueAfterSourceCheck)"
           Text="Source outside the project folder: @(_MarkdownRendererSourceOutsideProject->'%(StructureItemType) %(Identity)', '; '). A project compiles only files under its own folder: move the file into this project, or into a library that both projects reference. A temporary exception needs ProjectStructureException=&quot;reason; how it is removed&quot; metadata on the item. See AGENTS.md, &quot;Code Structure Standards&quot;." />
    <Error Condition="'@(_MarkdownRendererUnlistedGrant)' != ''"
           Code="MRS0002"
           File="$(MSBuildProjectFullPath)"
           Text="InternalsVisibleTo grant to an assembly that is not one of the renderer's test or performance projects: @(_MarkdownRendererUnlistedGrant, ', '). Internals are visible only to projects at tests\&lt;name&gt;\&lt;name&gt;.csproj or perf\&lt;name&gt;\&lt;name&gt;.csproj, which never ship: make what the grantee needs public extension API, or move it to a lower assembly. A temporary exception needs ProjectStructureException=&quot;reason; how it is removed&quot; metadata on the grant. See AGENTS.md, &quot;Code Structure Standards&quot;." />
  </Target>
</Project>
