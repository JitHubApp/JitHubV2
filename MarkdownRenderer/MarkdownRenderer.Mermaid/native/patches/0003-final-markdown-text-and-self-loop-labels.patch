+#[test]
+fn flowchart_shape_data_entity_labels_keep_the_public_semantic_and_render_projections() {
+    for (text, expected_label_type, expect_svg_entity_source) in [
+        (
+            "flowchart LR\nA@{ shape: rect, label: \"#quot;\" }\n",
+            "markdown",
+            false,
+        ),
+        (
+            "flowchart LR\nA@{ shape: rect, label: \"#quot;\", labelType: string }\n",
+            "string",
+            true,
+        ),
+    ] {
+        let parsed = parse_flowchart_render(text);
+        let crate::RenderSemanticModel::Flowchart(model) = parsed.model() else {
+            panic!("expected flowchart model for {text:?}");
+        };
+        let node = model
+            .nodes
+            .iter()
+            .find(|node| node.id == "A")
+            .expect("shapeData node");
+        assert_eq!(
+            node.label_type.as_deref(),
+            Some(expected_label_type),
+            "{text:?}"
+        );
+        assert_eq!(node.label.as_deref(), Some("\""), "{text:?}");
+
+        let context = parsed
+            .flowchart_render_context()
+            .expect("flowchart render context");
+        assert_eq!(
+            context.node_label_for_render(node),
+            Some("&quot;"),
+            "{text:?}"
+        );
+        assert_eq!(
+            context.node_mermaid_svg_text_source_for_render(node),
+            expect_svg_entity_source.then_some("ﬂ°quot¶ß"),
+            "{text:?}"
+        );
+    }
+}
