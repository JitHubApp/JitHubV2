+#[test]
+fn self_loop_flowchart_entity_keeps_logical_source_for_layout_and_svg() {
+    let source = r#"%%{init: {"htmlLabels": false, "flowchart": {"htmlLabels": false}}}%%
+flowchart LR
+A -->|#quot;| A
+B -->|#quot;| C
+"#;
+    let engine = Engine::new();
+    let parsed = block_on(engine.parse_diagram_for_render_model(source, ParseOptions::default()))
+        .expect("parse succeeds")
+        .expect("detects flowchart");
+    let model = flowchart_model(&parsed);
+    let self_loop_id = model
+        .edges
+        .iter()
+        .find(|edge| edge.from == "A" && edge.to == "A")
+        .expect("self-loop edge")
+        .id
+        .clone();
+    let ordinary_id = model
+        .edges
+        .iter()
+        .find(|edge| edge.from == "B" && edge.to == "C")
+        .expect("ordinary edge")
+        .id
+        .clone();
+    let layout = layout_flowchart_render_model(
+        parsed,
+        &LayoutOptions::default(),
+        RenderEnvironment::deterministic()
+            .begin_session()
+            .expect("begin layout session"),
+    )
+    .expect("layout succeeds");
+    let edge_label_width = |id: &str| {
+        layout
+            .edges
+            .iter()
+            .find(|edge| edge.id == id)
+            .and_then(|edge| edge.label.as_ref())
+            .expect("edge label geometry")
+            .width
+    };
+    assert_eq!(
+        edge_label_width(&self_loop_id),
+        edge_label_width(&ordinary_id),
+        "identical typed labels must have identical layout widths"
+    );
+
+    let svg = render_flowchart_svg_from_text(source);
+    let document = roxmltree::Document::parse(&svg).expect("valid flowchart SVG");
+    let final_texts = document
+        .descendants()
+        .filter(|node| {
+            node.has_tag_name("text") && node.attribute("data-mmir-final-text") == Some("true")
+        })
+        .map(|node| {
+            node.descendants()
+                .filter_map(|descendant| descendant.text().filter(|_| descendant.is_text()))
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        final_texts.len(),
+        2,
+        "both edge labels retain final-text mode: {svg}"
+    );
+    assert!(
+        final_texts.iter().all(|text| text == "\""),
+        "the self-loop and ordinary edge render the same decoded quote: {final_texts:?}\n{svg}"
+    );
+}
