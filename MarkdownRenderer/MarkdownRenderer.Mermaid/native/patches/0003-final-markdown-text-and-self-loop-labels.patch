+/// Parses Markdown before decoding the entities that represent its final text content.
+///
+/// This order is important for SVG Markdown labels: an encoded `<b>` is authored text, not a
+/// formatting tag. Markdown tokenization must classify the source first; only then may the
+/// resulting text fragments be decoded for display. The returned strings are final text and must
+/// not be entity-decoded again.
+pub(crate) fn mermaid_markdown_to_svg_final_text_words(
+    markdown: &str,
+    markdown_auto_wrap: bool,
+) -> Vec<Vec<MermaidMarkdownWord>> {
+    mermaid_markdown_to_word_tokens(markdown, markdown_auto_wrap)
+        .into_iter()
+        .map(|line| {
+            line.into_iter()
+                .map(|mut word| {
+                    word.text = merman_core::entities::decode_html_entities_to_unicode(&word.text)
+                        .into_owned();
+                    word
+                })
+                .collect()
+        })
+        .collect()
+}
