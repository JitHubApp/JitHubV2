<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MarkdownRenderer.Svg.ThorVG</RootNamespace>
    <AssemblyName>MarkdownRenderer.Svg.ThorVG</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <!-- One architecture-neutral managed facade selects the consuming app's
         RID-native asset. Never stamp the library itself x64. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>MarkdownRenderer.Svg.ThorVG</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Authors>nerocui</Authors>
    <Description>Optional ThorVG native SVG rasterization assets for MarkdownRenderer.</Description>
    <PackageTags>markdown;winui;svg;thorvg;windows</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JitHubApp/JitHubV2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/JitHubApp/JitHubV2/tree/main/docs/markdown-renderer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-192.png</PackageIcon>
    <!-- RuntimeIdentifier wins over the solution's default x64 Platform so
         `dotnet publish -r win-arm64` can never pick the x64 native DLL. -->
    <MarkdownRendererNativeArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</MarkdownRendererNativeArch>
    <MarkdownRendererNativeArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</MarkdownRendererNativeArch>
    <MarkdownRendererNativeArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</MarkdownRendererNativeArch>
    <MarkdownRendererNativeArch Condition="'$(MarkdownRendererNativeArch)' == '' and ('$(Platform)' == 'x86')">x86</MarkdownRendererNativeArch>
    <MarkdownRendererNativeArch Condition="'$(MarkdownRendererNativeArch)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">arm64</MarkdownRendererNativeArch>
    <MarkdownRendererNativeArch Condition="'$(MarkdownRendererNativeArch)' == ''">x64</MarkdownRendererNativeArch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer\MarkdownRenderer.csproj" />
    <!-- Keep the DLL a native runtime asset, not WinUI PRI content. Marking it
         Content causes a generated library PRI to reference a nonexistent
         lib/<tfm>/MarkdownRenderer.Svg.ThorVG/thorvg.dll in package consumers. -->
    <None Include="..\MarkdownRenderer\native\win-$(MarkdownRendererNativeArch)\thorvg.dll"
          Condition="'$(MarkdownRendererNativeArch)' != '' and Exists('..\MarkdownRenderer\native\win-$(MarkdownRendererNativeArch)\thorvg.dll')">
      <Link>native\win-$(MarkdownRendererNativeArch)\thorvg.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>thorvg.dll</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-$(MarkdownRendererNativeArch)\native\thorvg.dll</PackagePath>
    </None>
    <None Include="..\MarkdownRenderer\native\win-x86\thorvg.dll" Pack="true" PackagePath="runtimes\win-x86\native\thorvg.dll" Visible="false" Condition="'$(MarkdownRendererNativeArch)' != 'x86'" />
    <None Include="..\MarkdownRenderer\native\win-x64\thorvg.dll" Pack="true" PackagePath="runtimes\win-x64\native\thorvg.dll" Visible="false" Condition="'$(MarkdownRendererNativeArch)' != 'x64'" />
    <None Include="..\MarkdownRenderer\native\win-arm64\thorvg.dll" Pack="true" PackagePath="runtimes\win-arm64\native\thorvg.dll" Visible="false" Condition="'$(MarkdownRendererNativeArch)' != 'arm64'" />
    <None Include="..\MarkdownRenderer\native\THORVG_LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
    <None Include="THORVG_PROVENANCE.json" Pack="true" PackagePath="THORVG_PROVENANCE.json" Visible="false" />
    <None Include="..\..\JitHub.Web\wwwroot\icon-192.png" Pack="true" PackagePath="icon-192.png" Visible="false" />
  </ItemGroup>

  <Target Name="ValidateThorVgNativeAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\MarkdownRenderer\native\win-x86\thorvg.dll')" Text="Missing ThorVG native asset for win-x86." />
    <Error Condition="!Exists('..\MarkdownRenderer\native\win-x64\thorvg.dll')" Text="Missing ThorVG native asset for win-x64." />
    <Error Condition="!Exists('..\MarkdownRenderer\native\win-arm64\thorvg.dll')" Text="Missing ThorVG native asset for win-arm64." />
  </Target>
</Project>
