<Project>
  <!-- One build policy for the repository: lock files, NuGet audit with
       vulnerabilities as errors, locked restore in Release, and the Windows
       SDK build-tools version (JitHubWindowsSdkBuildToolsVersion). Debug
       restores write their lock file under obj\Debug, so they never rewrite
       the committed Release lock graph. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Code defaults for the renderer's own projects. The src, tests, samples,
       perf and tools folder props opt in by setting MarkdownRendererProject
       before they import this file. Projects that merely live under this
       folder do not: the eng\ restore helper, and the package and
       project-reference consumers that release-evidence scripts generate under
       artifacts\ to model external applications. -->
  <PropertyGroup Condition="'$(MarkdownRendererProject)' == 'true'">
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Outside a solution build (which maps Any CPU explicitly), build for
         x64 rather than AnyCPU. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Trim, single-file and NativeAOT analysis warnings that fail the build
         of every AOT-compatible library (src) and NativeAOT smoke (tests/aot). -->
    <MarkdownRendererTrimAndAotWarningsAsErrors>IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</MarkdownRendererTrimAndAotWarningsAsErrors>
  </PropertyGroup>

  <!-- Opt-in layout-diagnostics build for the projects that compile
       MARKDOWN_LAYOUT_DIAGNOSTICS code. -->
  <PropertyGroup Condition="'$(EnableMarkdownLayoutDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);MARKDOWN_LAYOUT_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
</Project>
